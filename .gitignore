node_modules/
dist/
build/
coverage/
.turbo/
*.log
.DS_Store
.env
.env.*
!.env.example
packages/*/out/

# extension build output (bundler copies the icon pack beside dist/)
packages/vscode/pack-*/
*.vsix

# SPA pack assets are copied from packages/pack-* by scripts/sync-packs.ts
apps/spa/public/pack-*.json
apps/spa/public/*-icons/

# the lookbook site page + its images are generated from lookbook/README.md
# and lookbook/out/ by scripts/sync-lookbook.ts
apps/spa/lookbook/
apps/spa/public/lookbook/

# the site's brand assets are copied from docs/assets by
# apps/spa/scripts/sync-media.ts — docs/assets stays the one committed copy.
# favicon.svg is docs/assets/mark.svg, serving as both tab icon and page logo.
apps/spa/public/favicon.svg
apps/spa/public/prompt-light.gif
apps/spa/public/prompt-dark.gif
apps/spa/public/zoom-light.gif
apps/spa/public/zoom-dark.gif

# scratch frames for scripts/hero-gif.mts and scripts/prompt-gif.mts
.hero-tmp/
.prompt-tmp/

# per-prompt sandboxes + transcripts for gauntlet/run.ts
gauntlet/.run/
# before/after renders for scripts/gallery.mts
.compare-tmp/

# playwright: browsers are cached globally, runs are disposable
packages/core/test-results/
packages/core/playwright-report/
apps/spa/test-results/
apps/spa/playwright-report/
