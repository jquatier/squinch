pack aws

system checkout "Checkout" {
  description: "Checkout and fulfilment kickoff"

  api     = aws/api-gateway "API Gateway"
  cart    = aws/lambda      "Cart Lambda"
  payment = aws/lambda      "Payment Lambda"
  db      = aws/dynamodb    "Orders Table"
  queue   = aws/sqs         "Order Events Queue"
  worker  = aws/lambda      "Fulfilment Worker"

  api -> cart
  cart -> payment
  payment -> db "write order"
  payment ~> queue "order placed"
  queue ~> worker
}

flow checkout_flow "Checkout journey" {
  api -> cart -> payment -> db
  payment ~> queue ~> worker
}

view checkout {
  show flow checkout_flow
  legend auto

  layout {
    rows [api] [cart] [payment] [db] [worker]
    place queue right-of db
    route payment ~> queue from east to west
  }
}
