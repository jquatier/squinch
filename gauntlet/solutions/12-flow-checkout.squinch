pack aws

system shop "Checkout" {
  api    = aws/api-gateway "API Gateway"
  cart   = aws/lambda      "Cart Handler"
  pay    = aws/lambda      "Payment Handler"
  db     = aws/dynamodb    "Orders Table" datastore
  queue  = aws/sqs         "Fulfilment Queue"
  worker = aws/lambda      "Fulfilment Worker"

  api -> cart
  cart -> pay
  pay -> db
  pay ~> queue
  queue ~> worker
}

flow checkout "Checkout" {
  api -> cart -> pay -> db
  pay ~> queue ~> worker
}

view shop {
  show flow checkout
  legend auto
}
