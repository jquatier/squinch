pack aws

gw      = aws/api-gateway "API Gateway"
cart    = aws/lambda "Cart" 
pay     = aws/lambda "Payment"
orders  = aws/dynamodb "DynamoDB" datastore
queue   = aws/sqs "Fulfilment Queue"
worker  = sys/cog "Fulfilment Worker"

gw -> cart
cart -> pay
pay -> orders
pay ~> queue
queue -> worker

flow checkout "Checkout" {
  gw -> cart -> pay -> orders
  pay ~> queue
  queue -> worker
}

view checkout {
  title "Checkout path"
  include *
  show flow checkout
  legend auto
}
