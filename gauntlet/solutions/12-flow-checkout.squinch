pack aws

api    = aws/api-gateway "API Gateway"
cart   = aws/lambda "Cart"
pay    = aws/lambda "Payment"
db     = aws/dynamodb "DynamoDB" datastore
queue  = aws/sqs "Fulfilment Queue"
worker = aws/lambda "Fulfilment Worker"

api -> cart
cart -> pay
pay -> db "writes"
pay ~> queue "publishes"
queue ~> worker "drains"

flow checkout "Checkout journey" {
  api -> cart -> pay -> db
  pay ~> queue
  queue ~> worker
}

view landscape {
  title "Checkout Path"
  include *
  show flow checkout
  legend auto
}
