pack aws

gw     = aws/api-gateway "API Gateway"
cart   = aws/lambda "Cart" 
pay    = aws/lambda "Payment"
db     = aws/dynamodb "DynamoDB" datastore
queue  = aws/sqs "Fulfilment Queue"
worker = sys/cog "Fulfilment Worker"

gw -> cart
cart -> pay
pay -> db "writes"
pay ~> queue "publishes"
queue ~> worker "drains"

flow checkout "Checkout" {
  gw -> cart
  cart -> pay
  pay -> db
  pay ~> queue
  queue ~> worker
}

view checkout {
  title "Checkout Path"
  include *
  show flow checkout
  legend {
    ->  "Request / response"
    ~>  "Asynchronous"
  }
}
