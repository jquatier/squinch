// Checkout flow diagram
pack aws

// Components
apigw = aws/api-gateway "API Gateway"
cart = aws/lambda "Cart Handler"
payment = aws/lambda "Payment Handler"
db = aws/dynamodb "Orders DB" datastore
queue = aws/sqs "Order Queue"
worker = aws/lambda "Fulfilment Worker"

// Connections
apigw -> cart
cart -> payment
payment -> db
payment ~> queue
queue ~> worker

// Numbered flow
flow checkout "Checkout Journey" {
  apigw -> cart -> payment -> db
  payment ~> queue ~> worker
}

// View
view main {
  title "Checkout Flow"
  show flow checkout
  legend auto
  layout {
    rows [apigw] [cart] [payment] [db queue] [worker]
  }
}
