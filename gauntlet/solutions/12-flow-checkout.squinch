pack aws

person customer "Customer"

gw      = aws/api-gateway "API Gateway"
cart    = aws/lambda       "Cart Handler"
payment = aws/lambda       "Payment Handler"
db      = aws/dynamodb     "Orders" datastore
queue   = aws/sqs          "Fulfillment Queue"
worker  = aws/lambda       "Fulfillment Worker"

customer -> gw "checkout"
gw -> cart
cart -> payment
payment -> db "write order"
payment ~> queue "order confirmed"
queue ~> worker

flow checkout "Checkout Journey" {
  customer -> gw -> cart -> payment -> db
  payment ~> queue ~> worker
}

view main {
  title "Checkout Flow"
  show flow checkout
  legend auto
}
