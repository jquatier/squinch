// Checkout flow diagram
pack aws

system checkout "Checkout System" {
  description: "E-commerce checkout and fulfilment"

  api      = aws/api-gateway "API Gateway"
  cart     = aws/lambda       "Cart Handler"
  payment  = aws/lambda       "Payment Handler"
  db       = aws/dynamodb     "Orders Table" datastore
  queue    = aws/sqs          "Fulfilment Queue"
  worker   = aws/lambda       "Fulfilment Worker"

  api -> cart
  cart -> payment
  payment -> db
  payment ~> queue
  queue -> worker
}

flow checkout_journey "Checkout Journey" {
  checkout.api -> checkout.cart -> checkout.payment -> checkout.db
  checkout.payment ~> checkout.queue -> checkout.worker
}

view checkout {
  scope checkout
  show flow checkout_journey
  legend auto
  layout {
    rows [api] [cart payment] [db queue worker]
  }
}
