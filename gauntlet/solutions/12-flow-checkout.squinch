pack aws

system checkout "Checkout Service" {
  api     = aws/api-gateway "API Gateway"
  cart    = aws/lambda       "Cart Handler"
  payment = aws/lambda       "Payment Handler"
  db      = aws/dynamodb     "Orders" datastore
  queue   = aws/sqs          "Fulfillment Queue"
  worker  = aws/lambda       "Fulfillment Worker"

  api -> cart
  cart -> payment
  payment -> db
  payment ~> queue
  queue ~> worker

  layout {
    rows [api] [cart] [payment] [db queue] [worker]
  }
}

flow checkout "Checkout Journey" {
  checkout.api -> checkout.cart -> checkout.payment -> checkout.db
  checkout.payment ~> checkout.queue ~> checkout.worker
}

view checkout {
  title "Checkout Flow"
  show flow checkout
  legend auto
}
