pack aws

system checkout "Checkout Service" {
  description: "Order checkout and fulfillment"

  api     = aws/api-gateway "API Gateway"
  cart    = aws/lambda       "Cart Handler"
  payment = aws/lambda       "Payment Handler"
  db      = aws/dynamodb     "Orders Table" datastore
  queue   = aws/sqs          "Fulfillment Queue"
  worker  = aws/lambda       "Fulfillment Worker"

  api -> cart
  cart -> payment
  payment -> db
  payment ~> queue
  queue ~> worker
}

flow checkout "Checkout Journey" {
  api -> cart -> payment -> db
  payment ~> queue ~> worker
}

view checkout {
  show flow checkout
  legend auto
}
