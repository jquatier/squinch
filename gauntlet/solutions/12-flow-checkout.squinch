pack aws

gw     = aws/api-gateway "API Gateway"
cart   = aws/lambda "Cart" { subtitle: "Lambda" }
pay    = aws/lambda "Payment" { subtitle: "Lambda" }
db     = aws/dynamodb "DynamoDB" datastore
queue  = aws/sqs "Queue"
worker = sys/cog "Fulfilment Worker"

gw -> cart
cart -> pay
pay -> db "writes"
pay ~> queue "publishes"
queue ~> worker "drains"

flow checkout "Checkout journey" {
  gw -> cart
  cart -> pay
  pay -> db
  pay ~> queue
  queue ~> worker
}

view landscape {
  title "Checkout path"
  include *
  show flow checkout
  legend auto
}
