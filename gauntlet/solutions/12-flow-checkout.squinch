// Checkout flow diagram
pack aws

// Components
gw      = aws/api-gateway  "API Gateway"
cart    = aws/lambda       "Cart Handler" {
  subtitle: "Lambda · Node 20"
}
payment = aws/lambda       "Payment Handler" {
  subtitle: "Lambda · Node 20"
}
db      = aws/dynamodb     "Orders Table" datastore
queue   = aws/sqs          "Fulfillment Queue"
worker  = aws/lambda       "Fulfillment Worker" {
  subtitle: "Lambda · Node 20"
}

// Connections
gw -> cart
cart -> payment
payment -> db
payment ~> queue "order confirmed"
queue ~> worker

// Checkout flow with numbered steps
flow checkout "Checkout Journey" {
  gw -> cart
  cart -> payment
  payment -> db
  payment ~> queue
  queue ~> worker
}

// Main view with the flow
view checkout {
  title "Checkout Flow"
  show flow checkout
  legend auto
  layout {
    rows [gw] [cart] [payment] [db queue] [worker]
  }
}
