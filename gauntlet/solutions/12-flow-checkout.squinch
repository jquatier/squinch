pack aws

gw     = aws/api-gateway "API Gateway"
cart   = aws/lambda "Cart" { subtitle: "Lambda" }
pay    = aws/lambda "Payment" { subtitle: "Lambda" }
orders = aws/dynamodb "DynamoDB" datastore
queue  = aws/sqs "SQS Queue"
worker = box "Fulfilment Worker"

gw -> cart
cart -> pay
pay -> orders "writes"
pay ~> queue "publishes"
queue ~> worker "drains"

flow checkout "Checkout" {
  gw -> cart
  cart -> pay
  pay -> orders
  pay ~> queue
  queue ~> worker
}

view checkout {
  title "Checkout Flow"
  include *
  show flow checkout
  legend {
    -> "Synchronous call"
    ~> "Asynchronous message"
  }
}
