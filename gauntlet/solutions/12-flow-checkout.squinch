pack aws

system checkout "Checkout Service" {
  api = aws/api-gateway "API Gateway"
  cart = aws/lambda "Cart Handler"
  payment = aws/lambda "Payment Handler"
  db = aws/dynamodb "Orders" datastore
  queue = aws/sqs "Fulfilment Queue"
  worker = aws/lambda "Fulfilment Worker"

  api -> cart
  cart -> payment
  payment -> db
  payment ~> queue
  queue ~> worker
}

flow checkout "Checkout Journey" {
  api -> cart
  cart -> payment
  payment -> db
  payment ~> queue
  queue ~> worker
}

view checkout {
  show flow checkout
  legend auto
  layout {
    direction down
    rows [api] [cart] [payment] [db queue] [worker]
  }
}
