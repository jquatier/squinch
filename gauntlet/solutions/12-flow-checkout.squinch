pack aws

system checkout "Checkout Service" {
  api = aws/api-gateway "API Gateway"
  cart = aws/lambda "Cart Handler" {
    subtitle: "Lambda · Node"
  }
  payment = aws/lambda "Payment Handler" {
    subtitle: "Lambda · Node"
  }
  db = aws/dynamodb "Orders" datastore
  queue = aws/sqs "Fulfillment Queue"
  worker = aws/lambda "Fulfillment Worker" {
    subtitle: "Lambda · Node"
  }

  api -> cart
  cart -> payment
  payment -> db
  payment ~> queue
  queue ~> worker

  layout {
    rows [api] [cart] [payment] [db queue] [worker]
  }
}

flow checkout_journey "Checkout Journey" {
  checkout.api -> checkout.cart
  checkout.cart -> checkout.payment
  checkout.payment -> checkout.db
  checkout.payment ~> checkout.queue
  checkout.queue ~> checkout.worker
}

view main {
  title "Checkout Flow"
  expand checkout
  show flow checkout_journey
  legend auto
}
