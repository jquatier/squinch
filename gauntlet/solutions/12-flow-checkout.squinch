pack aws

// Checkout flow components
api = aws/api-gateway "API Gateway"
cart = aws/lambda "Cart Service" {
  subtitle: "Lambda · Node 20"
}
payment = aws/lambda "Payment Service" {
  subtitle: "Lambda · Node 20"
}
db = aws/dynamodb "Orders" datastore
queue = aws/sqs "Fulfilment Queue"
worker = aws/lambda "Fulfilment Worker" {
  subtitle: "Lambda · Node 20"
}

// Connections
api -> cart
cart -> payment
payment -> db
payment ~> queue
queue ~> worker

// Checkout flow with numbered steps
flow checkout "Checkout Journey" {
  api -> cart -> payment -> db
  payment ~> queue ~> worker
}

view main {
  title "Checkout Flow"
  show flow checkout
  legend auto
  layout {
    rows [api] [cart] [payment] [db queue] [worker]
  }
}
