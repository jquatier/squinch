pack aws

// Checkout system components
api = aws/api-gateway "API Gateway"
cart = aws/lambda "Cart Service"
payment = aws/lambda "Payment Service"
db = aws/dynamodb "Orders" datastore
queue = aws/sqs "Fulfilment Queue"
worker = aws/lambda "Fulfilment Worker"

// Synchronous flow
api -> cart
cart -> payment
payment -> db

// Asynchronous flow
payment ~> queue
queue ~> worker

// Numbered flow for the checkout journey
flow checkout "Checkout Journey" {
  api -> cart
  cart -> payment
  payment -> db
  payment ~> queue
  queue ~> worker
}

view default {
  title "Checkout Flow"
  show flow checkout
  legend auto
  layout {
    rows [api] [cart] [payment] [db queue] [worker]
    place queue right-of db
  }
}
