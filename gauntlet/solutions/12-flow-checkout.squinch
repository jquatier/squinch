pack aws

// Checkout system components
api = aws/api-gateway "API Gateway"
cart = aws/lambda "Cart Handler"
payment = aws/lambda "Payment Handler"
db = aws/dynamodb "Orders Table" datastore
queue = aws/sqs "Fulfilment Queue"
worker = aws/lambda "Fulfilment Worker"

// Connections
api -> cart
cart -> payment
payment -> db
payment ~> queue
queue ~> worker

// Numbered checkout flow
flow checkout "Checkout Journey" {
  api -> cart
  cart -> payment
  payment -> db
  payment ~> queue
  queue ~> worker
}

// View with flow visualization and legend
view main {
  title "Checkout Flow"
  show flow checkout
  legend auto
}
