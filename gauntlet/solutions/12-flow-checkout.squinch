// Checkout flow diagram
pack aws

// Components
api = aws/api-gateway "API Gateway"
cart = aws/lambda "Cart Service"
payment = aws/lambda "Payment Service"
db = aws/dynamodb "Orders" datastore
queue = aws/sqs "Fulfillment Queue"
worker = aws/lambda "Fulfillment Worker"

// Connections
api -> cart
cart -> payment
payment -> db
payment ~> queue
queue ~> worker

// Numbered flow showing the checkout journey
flow checkout "Checkout Journey" {
  api -> cart -> payment -> db
  payment ~> queue ~> worker
}

// View with the flow and legend
view main {
  title "Checkout Flow"
  show flow checkout
  legend auto
  layout {
    rows [api] [cart] [payment] [db queue] [worker]
  }
}
