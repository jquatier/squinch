pack aws

system checkout "Checkout System" {
  gw = aws/api-gateway "API Gateway"
  cart = aws/lambda "Cart Handler"
  payment = aws/lambda "Payment Handler"
  db = aws/dynamodb "Orders DB" datastore
  queue = aws/sqs "Fulfilment Queue"
  worker = aws/lambda "Fulfilment Worker"

  gw -> cart
  cart -> payment
  payment -> db
  payment ~> queue
  queue ~> worker
}

flow checkout "Checkout Journey" {
  gw -> cart -> payment -> db
  payment ~> queue ~> worker
}

view checkout {
  scope checkout
  show flow checkout
  legend auto
}
