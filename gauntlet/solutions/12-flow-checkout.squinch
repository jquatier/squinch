pack aws

// Checkout flow components
api = aws/api-gateway "API Gateway"
cart = aws/lambda "Cart Service" {
  subtitle: "Lambda · Node 20"
}
payment = aws/lambda "Payment Service" {
  subtitle: "Lambda · Node 20"
}
db = aws/dynamodb "Orders" datastore
queue = aws/sqs "Fulfillment Queue"
fulfillment = aws/lambda "Fulfillment Worker" {
  subtitle: "Lambda · Node 20"
}

// Edges defining the checkout path
api -> cart
cart -> payment
payment -> db
payment ~> queue
queue -> fulfillment

// Numbered flow showing the checkout journey
flow checkout "Checkout Journey" {
  api -> cart -> payment -> db
  payment ~> queue -> fulfillment
}

view default {
  title "Checkout Flow"
  show flow checkout
  legend auto
  layout {
    direction right
  }
}
