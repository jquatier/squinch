pack aws

system checkout "Checkout Service" {
  description: "Customer checkout and order processing"

  gw = aws/api-gateway "API Gateway"
  cart = aws/lambda "Cart Lambda"
  payment = aws/lambda "Payment Lambda"
  db = aws/dynamodb "Orders" datastore
  queue = aws/sqs "Fulfillment Queue"
  worker = aws/lambda "Fulfillment Worker"

  gw -> cart
  cart -> payment
  payment -> db
  payment ~> queue
  queue ~> worker
}

flow checkout "Checkout Journey" {
  gw -> cart -> payment -> db
  payment ~> queue ~> worker
}

view checkout {
  show flow checkout
  legend auto
}
