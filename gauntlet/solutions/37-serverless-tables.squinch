pack aws

system notifications "Notifications Service" {
  description: "Email notification pipeline with preferences and logging"

  api = aws/api-gateway "API Gateway"
  handler = aws/lambda "API Handler"
  queue = aws/sqs "Send Queue"
  sender = aws/lambda "Sender Worker"
  ses = aws/ses "SES"

  preferences = aws/dynamodb "preferences" datastore
  delivery_log = aws/dynamodb "delivery-log" datastore

  api -> handler
  handler -> preferences "read"
  handler ~> queue "enqueue"
  queue ~> sender
  sender -> ses "send email"
  sender -> delivery_log "write"
}

view notifications {
  title "Notifications Service"
}
