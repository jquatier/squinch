pack aws

system notifications "Notifications Service" {
  description: "Accepts send requests and delivers them by email"

  api      = aws/api-gateway "API Gateway"
  intake   = aws/lambda "Intake Lambda"
  queue    = aws/sqs "Send Queue"
  sender   = aws/lambda "Sender Lambda"
  ses      = aws/ses "SES"
  prefs    = aws/dynamodb "preferences" datastore
  log      = aws/dynamodb "delivery-log" datastore

  api -> intake "send request"
  intake -> prefs "reads"
  intake ~> queue "enqueues"
  queue ~> sender "triggers"
  sender -> ses "sends"
  sender -> log "writes"
}

view landscape {
  title "Notifications Service"
  include *
}

view notifications {
  title "Notifications Service"
}
