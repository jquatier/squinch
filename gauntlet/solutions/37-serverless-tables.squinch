pack aws

system notifications "Notifications Service" {
  description: "Email notifications via SES"

  api = aws/api-gateway "API Gateway"
  receive = aws/lambda "Receive Handler" {
    subtitle: "Lambda"
  }
  queue = aws/sqs "Send Queue"
  sender = aws/lambda "Sender Worker" {
    subtitle: "Lambda"
  }
  ses = aws/ses "SES"

  container preferences_db "Preferences Table" {
    icon: aws/dynamodb
    preferences = sys/table "preferences" datastore
  }

  container delivery_db "Delivery Log Table" {
    icon: aws/dynamodb
    delivery_log = sys/table "delivery-log" datastore
  }

  api -> receive
  receive -> preferences_db.preferences "reads"
  receive ~> queue
  queue ~> sender
  sender -> ses "sends"
  sender -> delivery_db.delivery_log "writes"

  layout {
    rows [api] [receive] [queue] [sender] [ses]
    place preferences_db right-of receive
    place delivery_db right-of sender
  }
}

view notifications {
  title "Notifications Service"
}
