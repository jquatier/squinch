pack aws

system notifications "Notification Service" {
  description: "Async email delivery pipeline"

  api = aws/api-gateway "API Gateway"

  receiver = aws/lambda "Request Handler" {
    subtitle: "Validates and enqueues"
  }

  queue = aws/sqs "Send Queue"

  sender = aws/lambda "Sender Worker" {
    subtitle: "Processes and delivers"
  }

  ses = aws/ses "SES" {
    description: "Email delivery service"
  }

  container prefs_db "Preferences" {
    icon: aws/dynamodb
    description: "DynamoDB · 1 table"
    preferences = sys/table "preferences" datastore
  }

  container log_db "Delivery Log" {
    icon: aws/dynamodb
    description: "DynamoDB · 1 table"
    delivery_log = sys/table "delivery-log" datastore
  }

  api -> receiver
  receiver -> prefs_db.preferences "reads"
  receiver ~> queue "enqueues"
  sender -> queue "polls"
  sender -> ses "sends"
  sender -> log_db.delivery_log "writes"
}

view notifications {
  title "Notification Service"
  layout {
    rows [api] [receiver] [queue sender] [ses]
    place prefs_db.preferences right-of receiver
    place log_db.delivery_log right-of sender
  }
}
