// Modern application stack using product logos
pack logos

person dev "Developer"

frontend = logos/nextdotjs "Next.js Frontend"
api = logos/nestjs "NestJS API"
db = logos/postgresql "PostgreSQL" datastore
cache = logos/redis "Redis" datastore
events = logos/kafka "Kafka"
monitoring = logos/grafana "Grafana"
vcs = logos/github "GitHub"
platform = logos/kubernetes "Kubernetes"

// Developer workflow
dev -> vcs "pushes code"
vcs -> platform "deploys to"

// Application architecture
frontend -> api "API requests"
api -> db "queries"
api -> cache "caches"
api ~> events "publishes events"
monitoring -> api "monitors"
monitoring -> db "monitors"
monitoring -> cache "monitors"

// Deployment
platform -> frontend "runs"
platform -> api "runs"

view stack {
  title "Application Stack"
  layout {
    direction down
    rows [dev] [vcs] [monitoring] [platform] [frontend] [api] [db cache events]
  }
}
