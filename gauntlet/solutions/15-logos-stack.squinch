pack logos
pack k8s

person dev "Developer"

system app "Application Stack" {
  frontend = logos/nextdotjs "Next.js Frontend"
  api      = logos/nestjs    "NestJS API"
  db       = logos/postgres  "PostgreSQL" datastore
  cache    = logos/redis     "Redis" datastore
  events   = logos/kafka     "Kafka"
  monitor  = logos/grafana   "Grafana"

  frontend -> api "API requests"
  api -> db "queries"
  api -> cache "caching"
  api ~> events "publishes events"
  api -> monitor "metrics"
  frontend -> monitor "metrics"
  db -> monitor "metrics"
}

system cicd "CI/CD" {
  repo = logos/github "GitHub"
  cluster = logos/kubernetes "Kubernetes"

  repo -> cluster "deploys"
}

dev -> cicd.repo "pushes code"
cicd.cluster -> app.frontend "hosts"
cicd.cluster -> app.api "hosts"

view landscape {
  title "Technology Stack"
  include *
  layout {
    rows [dev] [cicd] [app]
  }
}

view detail {
  title "Stack Detail"
  expand app
  layout {
    rows [dev] [cicd.repo cicd.cluster] [app.frontend] [app.api] [app.cache app.events] [app.db] [app.monitor]
  }
}
