// Technology stack architecture
pack logos

// Development & Deployment
person devs "Developers"
gh = logos/github "GitHub"
k8s = logos/kubernetes "Kubernetes Cluster" {
  description: "Container orchestration"
}

// Application Layer
frontend = logos/nextjs "Next.js Frontend" {
  description: "React SSR application"
}
backend = logos/nestjs "NestJS API" {
  description: "Node.js backend service"
}

// Data Layer
db = logos/postgresql "PostgreSQL" datastore {
  description: "Primary database"
}
cache = logos/redis "Redis" datastore {
  description: "Caching layer"
}

// Messaging & Observability
events = logos/kafka "Kafka" {
  description: "Event streaming"
}
monitoring = logos/grafana "Grafana" {
  description: "Observability platform"
}

// Connections
devs -> gh "push code"
gh -> k8s "deploy"
k8s -> frontend
k8s -> backend

frontend -> backend "API calls"
backend -> db "queries"
backend -> cache "read/write"
backend ~> events "publish events"

frontend -> monitoring "metrics"
backend -> monitoring "metrics"
db -> monitoring "metrics"
cache -> monitoring "metrics"
events -> monitoring "metrics"

view stack {
  title "Technology Stack"
  include *
  layout {
    direction down
    rows [devs] [gh] [k8s] [frontend] [backend] [db cache events] [monitoring]
  }
}
