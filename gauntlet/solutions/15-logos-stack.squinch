pack logos

person dev "Developers"
gh      = logos/github "GitHub"
web     = logos/nextjs "Next.js Frontend"
api     = logos/nestjs "NestJS API"
pg      = logos/postgresql "PostgreSQL" datastore
cache   = logos/redis "Redis Cache" datastore
bus     = logos/apachekafka "Kafka"
graf    = logos/grafana "Grafana"

zone k8s "Kubernetes" cloud {
  icon: logos/kubernetes
  contains web, api
}

dev -> gh "push"
gh -> web, api "deploys"
web -> api
api -> pg
api -> cache
api ~> bus "events"
graf -> web, api, pg, cache, bus "monitors"

view landscape {
  title "Product Stack"
  include *
}
