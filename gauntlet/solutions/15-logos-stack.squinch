pack logos
pack k8s

person developer "Developer"

system stack "Application Stack" {
  frontend = logos/nextdotjs "Next.js Frontend"
  api      = logos/nestjs   "NestJS API"
  db       = logos/postgres "PostgreSQL" datastore
  cache    = logos/redis    "Redis Cache" datastore
  events   = logos/kafka    "Kafka Events" datastore
  monitor  = logos/grafana  "Grafana"

  frontend -> api
  api -> db
  api -> cache
  api ~> events "publish events"
  monitor -> api "scrape metrics"
  monitor -> db "query metrics"
}

github = logos/github "GitHub"
cluster = logos/kubernetes "Kubernetes Cluster"

developer -> github "push code"
github ~> cluster "deploy"
cluster -> stack.frontend
cluster -> stack.api

view landscape {
  title "Application Stack"
  layout {
    rows [developer github] [cluster] [stack.frontend] [stack.api] [stack.db stack.cache stack.events] [stack.monitor]
  }
}
