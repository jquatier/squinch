pack logos

person dev "Developers"

gh   = logos/github "GitHub"
k8s  = logos/kubernetes "Kubernetes"
web  = logos/nextdotjs "Next.js Frontend"
api  = logos/nestjs "NestJS API"
pg   = logos/postgresql "PostgreSQL" datastore
cache = logos/redis "Redis Cache" datastore
kafka = logos/apachekafka "Kafka"
graf = logos/grafana "Grafana"

dev -> gh "push"
gh -> k8s "deploys"
web -> api
api -> pg
api -> cache "caching"
api ~> kafka "events"
graf -> web, api, pg, cache, kafka "monitors"

view landscape {
  title "Product Stack"
  include *
}
