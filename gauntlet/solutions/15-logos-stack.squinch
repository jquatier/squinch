pack logos

person dev "Developer"

github = logos/github "GitHub"

system stack "App Stack" {
  icon: logos/kubernetes

  fe   = logos/nextdotjs "Frontend" { subtitle: "Next.js" }
  api  = logos/nestjs    "API"      { subtitle: "NestJS" }
  db   = logos/postgres  "Database" datastore { subtitle: "PostgreSQL" }
  cache = logos/redis    "Cache"    datastore { subtitle: "Redis" }
  bus  = logos/kafka     "Events"   datastore { subtitle: "Kafka" }
  mon  = logos/grafana   "Monitoring" { subtitle: "Grafana" }

  fe -> api
  api -> db
  api -> cache
  api ~> bus "publishes events"

  fe    -> mon "metrics"
  api   -> mon "metrics"
  db    -> mon "metrics"
  cache -> mon "metrics"
  bus   -> mon "metrics"

  layout {
    rows [fe] [api] [db cache bus] [mon]
  }
}

dev -> github "push"
github -> stack "deploys"

view landscape {
  title "System Landscape"
  include *
}

