pack logos

person dev "Developers"

gh   = logos/github "GitHub"
k8s  = logos/kubernetes "Kubernetes"
web  = logos/nextjs "Next.js Frontend"
api  = logos/nestjs "NestJS API"
pg   = logos/postgresql "PostgreSQL" datastore
rd   = logos/redis "Redis Cache" datastore
kf   = logos/apachekafka "Kafka"
graf = logos/grafana "Grafana"

dev -> gh "push"
gh -> k8s "deploys"
web -> api
api -> pg
api -> rd "cache"
api ~> kf "events"
graf -> api "monitors"
graf -> kf "monitors"
graf -> pg "monitors"
graf -> rd "monitors"

view landscape {
  title "Logos Stack"
  include *
}
