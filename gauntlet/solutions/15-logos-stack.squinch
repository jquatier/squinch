// Stack diagram with product logos
pack logos

person developer "Developer"

system app "Application" {
  frontend = logos/nextdotjs "Next.js Frontend"
  api = logos/nestjs "NestJS API"
  db = logos/postgres "PostgreSQL" datastore
  cache = logos/redis "Redis Cache" datastore
  events = logos/kafka "Kafka Events" datastore

  frontend -> api
  api -> db
  api -> cache
  api ~> events
}

monitor = logos/grafana "Grafana Monitoring"
github = logos/github "GitHub"
k8s = logos/kubernetes "Kubernetes"

developer -> github "pushes code"
github -> k8s "deploys to"
k8s -> app
monitor -> app "watches"

view landscape {
  title "Application Stack"
  include *

  layout {
    direction down
    rows [developer] [github] [k8s] [app monitor]
  }
}

view app {
  title "Application Architecture"
  show descriptions

  layout {
    direction down
    rows [frontend] [api] [db cache events]
  }
}
