pack logos
pack k8s

person dev "Developer"

github = logos/github "GitHub"
k8s_cluster = logos/kubernetes "Kubernetes Cluster"

system app "Application" {
  description: "Next.js + NestJS stack"

  frontend = logos/nextjs "Frontend" {
    subtitle: "Next.js"
  }

  api = logos/nestjs "API" {
    subtitle: "NestJS"
  }

  db = logos/postgresql "Database" datastore {
    subtitle: "PostgreSQL"
  }

  cache = logos/redis "Cache" datastore {
    subtitle: "Redis"
  }

  events = logos/kafka "Event Bus" {
    subtitle: "Kafka"
  }

  frontend -> api
  api -> db
  api -> cache
  api ~> events "publishes events"
}

monitor = logos/grafana "Monitoring" {
  subtitle: "Grafana"
}

dev -> github "pushes code"
github -> k8s_cluster "deploys"
k8s_cluster -> app.frontend
k8s_cluster -> app.api
app ~> monitor "metrics"

zone cluster "Kubernetes Cluster" cloud {
  contains app
}

view landscape {
  title "Application Stack"
  include *
  expand app
}
