// Stack diagram using real product logos (logos pack)
pack logos

person dev "Developer"

system stack "Application Stack" {
  description: "Next.js frontend with NestJS backend"

  frontend = logos/nextdotjs "Frontend" {
    subtitle: "Next.js"
  }

  api = logos/nestjs "API" {
    subtitle: "NestJS"
  }

  db = logos/postgres "Database" datastore {
    subtitle: "PostgreSQL"
  }

  cache = logos/redis "Cache" datastore {
    subtitle: "Redis"
  }

  events = logos/kafka "Event Bus" {
    subtitle: "Kafka"
  }

  frontend -> api "requests"
  api -> db "queries"
  api -> cache "reads/writes"
  api ~> events "publishes events"
}

monitoring = logos/grafana "Monitoring" {
  subtitle: "Grafana"
}

github = logos/github "GitHub" {
  subtitle: "Source Control"
}

k8s = logos/kubernetes "Kubernetes" {
  subtitle: "Container Orchestration"
}

dev -> github "pushes code"
github ~> k8s "CI/CD deployment"
k8s -> stack "runs"
monitoring -> stack "observes"

view landscape {
  title "Application Stack"
  include *
  layout {
    rows [dev] [github] [k8s] [stack monitoring]
  }
}
