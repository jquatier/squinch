pack logos
pack k8s

person dev "Developer"

system stack "Application Stack" {
  frontend = logos/nextdotjs "Next.js Frontend"
  api = logos/nestjs "NestJS API"
  db = logos/postgres "PostgreSQL" datastore
  cache = logos/redis "Redis Cache" datastore
  events = logos/kafka "Kafka Events" datastore
  monitor = logos/grafana "Grafana"

  frontend -> api
  api -> db
  api -> cache
  api ~> events
  monitor -> api
  monitor -> db
}

github = logos/github "GitHub" external
cluster = logos/kubernetes "Kubernetes" external

dev -> github "push code"
github ~> cluster "deploy"
cluster -> stack.frontend
cluster -> stack.api

view landscape {
  title "Tech Stack"
  include *
}

view stack {
  layout {
    rows [frontend] [api monitor] [cache db events]
  }
}
