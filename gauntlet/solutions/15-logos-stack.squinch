pack logos

person dev "Developer"

system platform "Application Platform" {
  frontend = logos/nextdotjs "Next.js Frontend"
  api      = logos/nestjs   "NestJS API"
  cache    = logos/redis    "Redis Cache" datastore
  db       = logos/postgres "PostgreSQL" datastore
  events   = logos/kafka    "Kafka Events" datastore
  monitor  = logos/grafana  "Grafana Monitoring"

  frontend -> api "API calls"
  api -> cache "cache reads"
  api -> db "queries"
  api ~> events "publishes events"
  monitor -> api "metrics"
  monitor -> db "metrics"
  monitor -> cache "metrics"

  layout {
    rows [frontend] [api monitor] [cache db events]
  }
}

repo = logos/github     "GitHub Repository"
cluster = logos/kubernetes "Kubernetes Cluster"

dev -> repo "pushes code"
repo ~> cluster "deploys"
cluster -> platform "runs"

view landscape {
  title "Application Stack"
  include *
  layout {
    rows [dev] [repo] [cluster] [platform]
  }
}
