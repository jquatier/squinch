pack logos
pack k8s

person developer "Developer"

system app "Application" {
  description: "Next.js + NestJS stack"

  frontend = logos/nextdotjs "Frontend" {
    subtitle: "Next.js"
  }

  api = logos/nestjs "API" {
    subtitle: "NestJS"
  }

  cache = logos/redis "Cache" datastore {
    subtitle: "Redis"
  }

  db = logos/postgres "Database" datastore {
    subtitle: "PostgreSQL"
  }

  events = logos/kafka "Events" {
    subtitle: "Kafka"
  }

  frontend -> api
  api -> cache
  api -> db
  api ~> events "publishes"

  layout {
    rows [frontend] [api] [cache db] [events]
  }
}

vcs = logos/github "GitHub" {
  description: "Source control and CI/CD"
}

cluster = logos/kubernetes "Kubernetes" {
  description: "Container orchestration"
}

monitoring = logos/grafana "Grafana" {
  description: "Observability"
}

developer -> vcs "pushes code"
vcs -> cluster "deploys to"
cluster -> app.frontend
cluster -> app.api
app.api -> monitoring "metrics"
app.events -> monitoring "metrics"

view landscape {
  title "Application Stack"
  expand app

  layout {
    rows [developer] [vcs] [cluster] [app] [monitoring]
  }
}
