pack logos
pack k8s

person dev "Developer"
person user "User"

system platform "Application Platform" {
  description: "Modern web application stack"

  frontend = logos/nextdotjs "Frontend" {
    subtitle: "Next.js"
  }

  api = logos/nestjs "API" {
    subtitle: "NestJS"
  }

  db = logos/postgres "Database" datastore {
    subtitle: "PostgreSQL"
  }

  cache = logos/redis "Cache" datastore {
    subtitle: "Redis"
  }

  events = logos/kafka "Event Bus" {
    subtitle: "Kafka"
  }

  monitoring = logos/grafana "Monitoring" {
    subtitle: "Grafana"
  }

  user -> frontend "browses"
  frontend -> api "API calls"
  api -> db "queries"
  api -> cache "caches"
  api ~> events "publishes events"
  api -> monitoring "metrics"
  frontend -> monitoring "metrics"
  db -> monitoring "metrics"
}

system cicd "CI/CD Pipeline" {
  description: "Deployment automation"

  repo = logos/github "Repository" {
    subtitle: "GitHub"
  }

  cluster = logos/kubernetes "Cluster" {
    subtitle: "Kubernetes"
  }

  repo ~> cluster "deploys"
}

dev -> cicd.repo "pushes code"
cicd.cluster -> platform "hosts"

view landscape {
  title "Application Stack"
  include *
}
