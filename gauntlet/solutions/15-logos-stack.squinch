// Stack diagram with product logos
pack logos

person dev "Developer"

frontend = logos/nextdotjs "Next.js Frontend"
api = logos/nestjs "NestJS API"
db = logos/postgres "PostgreSQL" datastore
cache = logos/redis "Redis Cache" datastore
events = logos/kafka "Kafka" datastore
monitor = logos/grafana "Grafana"
scm = logos/github "GitHub"
platform = logos/k8s "Kubernetes"

dev -> scm "pushes code"
scm ~> platform "deploys to"
platform -> frontend
platform -> api
frontend -> api
api -> db
api -> cache
api ~> events "publishes events"
monitor -> api "monitors"
monitor -> db "monitors"
monitor -> cache "monitors"
