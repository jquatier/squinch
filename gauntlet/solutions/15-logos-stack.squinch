pack logos

person dev "Developer"

github = logos/github "GitHub"

system k8s "Kubernetes Cluster" {
  icon: logos/kubernetes

  web   = logos/nextdotjs "Frontend" { subtitle: "Next.js" }
  api   = logos/nestjs    "API"      { subtitle: "NestJS" }
  db    = logos/postgres  "Database" datastore
  cache = logos/redis     "Cache" datastore
  bus   = logos/kafka     "Events" datastore
  mon   = logos/grafana   "Monitoring"

  web -> api
  api -> db
  api -> cache
  api ~> bus "publishes events"

  api ~> mon "metrics"
  db ~> mon "metrics"
  cache ~> mon "metrics"
  bus ~> mon "metrics"

  layout {
    rows [web] [api] [cache bus] [db] [mon]
  }
}

dev -> github "pushes code"
github -> k8s "deploys"

view landscape {
  title "Stack Overview"
  include *
}

view k8s {
  title "Kubernetes Cluster"
}
