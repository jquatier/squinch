pack logos

person dev "Developer"
github = box "GitHub" external

system stack "Application Stack" {
  frontend = logos/nextdotjs "Next.js Frontend"
  api      = logos/nestjs "NestJS API"
  db       = logos/postgres "PostgreSQL" datastore
  cache    = logos/redis "Redis Cache" datastore
  events   = logos/kafka "Kafka Events" datastore
  monitor  = logos/grafana "Grafana"

  frontend -> api
  api -> db
  api -> cache
  api ~> events "publish events"
  monitor -> api "metrics"
  monitor -> db "metrics"
  monitor -> cache "metrics"
  monitor -> events "metrics"
}

k8s = logos/kubernetes "Kubernetes Cluster"

dev -> github "push code"
github ~> k8s "deploy"
k8s -> stack "runs"
