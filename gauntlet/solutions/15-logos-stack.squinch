pack logos

person dev "Developers"

gh   = logos/github "GitHub"
k8s  = logos/kubernetes "Kubernetes"
web  = logos/nextjs "Next.js" { subtitle: "Frontend" }
api  = logos/nestjs "NestJS" { subtitle: "API" }
pg   = logos/postgresql "PostgreSQL" datastore
rd   = logos/redis "Redis" datastore { subtitle: "Cache" }
kf   = logos/apachekafka "Kafka" { subtitle: "Events" }
graf = logos/grafana "Grafana" { subtitle: "Monitoring" }

dev -> gh "push"
gh -> k8s "deploys"
web -> api
api -> pg
api -> rd "cache"
api ~> kf "events"
graf -> web, api, pg, rd, kf

view landscape {
  title "Open-source Stack"
  include *
  layout { rows [dev gh k8s] [web] [api] [pg rd kf] [graf] }
}
