pack logos

person dev "Developers"

web   = logos/nextdotjs "Next.js Frontend"
api   = logos/nestjs "NestJS API"
db    = logos/postgresql "PostgreSQL" datastore
cache = logos/redis "Redis Cache" datastore
bus   = logos/apachekafka "Kafka"
graf  = logos/grafana "Grafana"
gh    = logos/github "GitHub"
k8s   = logos/kubernetes "Kubernetes"

web -> api
api -> db
api -> cache "caching"
api ~> bus "events"

dev -> gh "push"
gh -> k8s "deploys"

graf -> web, api, db, cache, bus "monitors"

view landscape {
  title "Logos Stack"
  include *
  layout {
    rows [dev web graf] [gh api] [k8s db cache bus]
  }
}
