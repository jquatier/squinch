pack logos
pack k8s

person developer "Developer"

github = logos/github "GitHub" {
  subtitle: "Version Control"
}

system app "Application Stack" {
  frontend = logos/nextdotjs "Next.js Frontend" {
    subtitle: "React · SSR"
  }
  api = logos/nestjs "NestJS API" {
    subtitle: "Node.js · REST"
  }
  db = logos/postgres "PostgreSQL" datastore {
    subtitle: "Primary Database"
  }
  cache = logos/redis "Redis" datastore {
    subtitle: "Session & Cache"
  }
  events = logos/kafka "Kafka" {
    subtitle: "Event Bus"
  }

  frontend -> api
  api -> db
  api -> cache
  api ~> events "publishes events"
}

k8s_cluster = logos/kubernetes "Kubernetes Cluster" {
  subtitle: "Container Orchestration"
}

monitoring = logos/grafana "Grafana" {
  subtitle: "Metrics & Dashboards"
}

developer -> github "pushes code"
github ~> k8s_cluster "CI/CD deployment"
k8s_cluster -> app
monitoring -> app "observes"

view landscape {
  title "Technology Stack"
  layout {
    rows [developer] [github] [k8s_cluster] [app monitoring]
  }
}
