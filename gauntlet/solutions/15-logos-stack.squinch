pack logos

person developer "Developer"

github = logos/github "GitHub" external
k8s = logos/kubernetes "Kubernetes Cluster"

system app "Application Stack" {
  frontend = logos/nextdotjs "Next.js Frontend"
  api = logos/nestjs "NestJS API"
  db = logos/postgres "PostgreSQL" datastore
  cache = logos/redis "Redis Cache" datastore
  events = logos/kafka "Kafka" datastore
  monitor = logos/grafana "Grafana"

  frontend -> api
  api -> db
  api -> cache
  api ~> events
  monitor -> frontend
  monitor -> api
  monitor -> db
}

developer -> github "pushes code"
github ~> k8s "deploys"
k8s -> app.frontend
k8s -> app.api
