// Technology stack with real product logos
pack logos

person developer "Developer"
person customer "Customer"

frontend = logos/nextdotjs "Web Frontend" {
  subtitle: "Next.js"
}

api = logos/nestjs "API Server" {
  subtitle: "NestJS"
}

db = logos/postgres "Database" datastore {
  subtitle: "PostgreSQL"
}

cache = logos/redis "Cache" datastore {
  subtitle: "Redis"
}

events = logos/kafka "Event Stream" {
  subtitle: "Kafka"
}

monitor = logos/grafana "Monitoring" {
  subtitle: "Grafana"
}

vcs = logos/github "Source Control" external {
  subtitle: "GitHub"
}

cluster = logos/kubernetes "Container Platform" {
  subtitle: "Kubernetes"
}

// User interactions
customer -> frontend "browses"
developer -> vcs "pushes code"

// Application flow
frontend -> api "API requests"
api -> db "queries"
api -> cache "reads/writes"
api ~> events "publishes events"

// Deployment
vcs ~> cluster "deploys"

// Deployment relationships
cluster -> frontend
cluster -> api

// Monitoring
monitor -> api "scrapes metrics"
monitor -> db "monitors"
monitor -> cache "monitors"

view stack {
  title "Application Stack"
  layout {
    rows [developer] [customer] [vcs] [cluster] [frontend api monitor] [db cache events]
  }
}
