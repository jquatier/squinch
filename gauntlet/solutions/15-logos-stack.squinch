pack logos

person dev "Developers"
gh   = logos/github "GitHub"
k8s  = logos/kubernetes "Kubernetes"
web  = logos/nextjs "Frontend" { subtitle: "Next.js" }
api  = logos/nestjs "API" { subtitle: "NestJS" }
pg   = logos/postgresql "PostgreSQL" datastore
cache = logos/redis "Redis" datastore { subtitle: "Cache" }
kafka = logos/kafka "Kafka" { subtitle: "Events" }
graf = logos/grafana "Grafana"

dev -> gh "push"
gh -> k8s "deploys"
web -> api
api -> pg
api -> cache
api ~> kafka "events"
graf -> web, api, pg, cache, kafka "watches"

view landscape {
  title "Product Stack"
  include *
  legend auto
  layout { rows [dev gh k8s] [web] [api] [pg cache kafka] [graf] }
}
