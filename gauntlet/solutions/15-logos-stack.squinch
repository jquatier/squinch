pack logos

person dev "Developer"

github = logos/github "GitHub"
k8s    = logos/kubernetes "Kubernetes Cluster"

system app "Application" {
  frontend = logos/nextdotjs "Next.js Frontend"
  api      = logos/nestjs   "NestJS API"
  db       = logos/postgres "PostgreSQL" datastore
  cache    = logos/redis    "Redis" datastore
  events   = logos/kafka    "Kafka" datastore
  monitor  = logos/grafana  "Grafana"

  frontend -> api "API calls"
  api -> db "queries"
  api -> cache "cache ops"
  api ~> events "publishes events"
  monitor -> api "metrics"
  monitor -> db "metrics"
  monitor -> cache "metrics"
}

dev -> github "pushes code"
github ~> k8s "deploys"
k8s -> app.frontend
k8s -> app.api
