pack azure

person shopper "Shopper"

system order_system "Order Processing" {
  apim = azure/api-management "API Management"
  create_fn = azure/functions "Create Order Function"
  cosmos = azure/cosmos "Orders DB" datastore
  bus = azure/service-bus "Order Queue"
  fulfill_fn = azure/functions "Fulfilment Function"

  apim -> create_fn
  create_fn -> cosmos
  create_fn ~> bus
  bus ~> fulfill_fn
}

shopper -> order_system.apim "places order"

flow order_flow "Order Journey" {
  shopper -> order_system.apim
  order_system.apim -> order_system.create_fn
  order_system.create_fn -> order_system.cosmos
  order_system.create_fn ~> order_system.bus
  order_system.bus ~> order_system.fulfill_fn
}

view order_system {
  title "Order Processing Flow"
  show flow order_flow
  layout {
    rows [apim] [create_fn] [cosmos bus] [fulfill_fn]
    place bus right-of cosmos
  }
}
