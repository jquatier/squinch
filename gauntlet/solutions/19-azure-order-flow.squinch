pack azure

person shopper "Shopper"

system order "Order Flow" {
  apim    = azure/api-management "API Management"
  orderFn = azure/functions      "Order Function"
  cosmos  = azure/cosmos         "Orders" datastore
  bus     = azure/service-bus    "Order Events"
  fulfilFn = azure/functions     "Fulfilment Function"

  apim -> orderFn
  orderFn -> cosmos "write order"
  orderFn ~> bus "publish order"
  bus ~> fulfilFn "consume order"
}

shopper -> order.apim "places order"

flow checkout "Order Checkout" {
  shopper -> order.apim
  order.apim -> order.orderFn
  order.orderFn -> order.cosmos
  order.orderFn ~> order.bus
  order.bus ~> order.fulfilFn
}

view landscape {
  title "Order Flow — Azure"
  include *
  show flow checkout
  legend auto
}
