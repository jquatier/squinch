pack azure

person shopper "Shopper"

system order "Order Processing" {
  tags: #core

  apim = azure/api-management "API Management"
  process = azure/functions "Order Function" {
    description: "Validates and persists orders"
  }
  db = azure/cosmos "Cosmos DB" datastore {
    description: "Order storage"
  }
  bus = azure/service-bus "Service Bus" {
    description: "Order events"
  }
  fulfil = azure/functions "Fulfillment Function" {
    description: "Handles order fulfillment"
  }

  apim -> process
  process -> db
  process ~> bus
  bus ~> fulfil
}

shopper -> order.apim "places order"

flow checkout "Order Flow" {
  shopper -> order.apim -> order.process -> order.db
  order.process ~> order.bus ~> order.fulfil
}

view landscape {
  title "Order System Landscape"
  include *
}

view order {
  show flow checkout
  layout {
    rows [apim] [process] [db bus] [fulfil]
    place bus right-of db
  }
}
