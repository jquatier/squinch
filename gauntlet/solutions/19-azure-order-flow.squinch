pack azure

person shopper "Shopper"

system orders "Order System" {
  tags: #core

  apim = azure/api-management "API Management"
  create_fn = azure/functions "Create Order Function"
  db = azure/cosmos "Orders DB" datastore
  bus = azure/service-bus "Order Events" datastore
  fulfil_fn = azure/functions "Fulfilment Function"

  apim -> create_fn
  create_fn -> db
  create_fn ~> bus
  bus ~> fulfil_fn
}

shopper -> orders.apim "places order"

flow order_flow "Order Flow" {
  shopper -> orders.apim -> orders.create_fn -> orders.db
  orders.create_fn ~> orders.bus ~> orders.fulfil_fn
}

view orders {
  show flow order_flow
  layout {
    rows [apim] [create_fn] [db bus] [fulfil_fn]
  }
}
