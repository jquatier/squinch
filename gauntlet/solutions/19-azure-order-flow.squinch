pack azure

person shopper "Shopper"

system orders "Order System" {
  description: "Azure-based order processing"

  apim = azure/api-management "API Management"
  create = azure/functions "Create Order"
  db = azure/cosmos "Orders DB" datastore
  bus = azure/service-bus "Order Events"
  fulfill = azure/functions "Fulfillment Handler"

  apim -> create
  create -> db
  create ~> bus
  bus ~> fulfill
}

shopper -> orders.apim "places order"

flow order_journey "Order Journey" {
  shopper -> orders.apim
  orders.apim -> orders.create
  orders.create -> orders.db
  orders.create ~> orders.bus
  orders.bus ~> orders.fulfill
}

view orders {
  show flow order_journey
  layout {
    rows [apim] [create] [db bus] [fulfill]
    place bus right-of db
  }
}
