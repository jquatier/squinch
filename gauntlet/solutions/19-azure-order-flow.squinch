pack azure

person shopper "Shopper"

apim = azure/api-management "API Management"
create = azure/functions "Create Order Function" {
  subtitle: "Azure Functions · Node"
}
db = azure/cosmos "Orders DB" datastore
bus = azure/service-bus "Order Events"
fulfil = azure/functions "Fulfilment Function" {
  subtitle: "Azure Functions · Node"
}

shopper -> apim "place order"
apim -> create
create -> db
create ~> bus "order created"
bus ~> fulfil

flow order "Order Flow" {
  apim -> create -> db
  create ~> bus ~> fulfil
}

view default {
  title "Azure Order Flow"
  show flow order
  layout {
    rows [apim] [create] [db bus] [fulfil]
  }
}
