pack azure

person shopper "Shopper"

apim = azure/api-management "API Management"
order_fn = azure/functions "Order Function" {
  description: "Creates orders"
}
cosmos = azure/cosmos "Orders DB" datastore
bus = azure/service-bus "Order Events"
fulfil_fn = azure/functions "Fulfillment Function" {
  description: "Handles fulfillment"
}

shopper -> apim "places order"
apim -> order_fn
order_fn -> cosmos "write order"
order_fn ~> bus "publish event"
bus ~> fulfil_fn

flow order_flow "Order Processing" {
  shopper -> apim -> order_fn -> cosmos
  order_fn ~> bus ~> fulfil_fn
}

view landscape {
  title "Azure Order Flow"
  show flow order_flow
  layout {
    rows [shopper] [apim] [order_fn] [cosmos bus] [fulfil_fn]
    place bus right-of cosmos
  }
}
