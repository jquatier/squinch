pack azure

person shopper "Shopper"
apim   = azure/api-management "API Management"
orders = azure/functions "Order Function" { subtitle: "Azure Functions" }
db     = azure/cosmos "Orders" datastore { subtitle: "Cosmos DB" }
bus    = azure/service-bus "Order Messages" { subtitle: "Service Bus" }
fulfil = azure/functions "Fulfilment Function" { subtitle: "Azure Functions" }

shopper -> apim "places order"
apim -> orders
orders -> db "writes order"
orders ~> bus "publishes message"
bus ~> fulfil "picks up"

flow order "Order path" {
  shopper -> apim -> orders -> db
  orders ~> bus ~> fulfil
}

view landscape {
  title "Order Flow"
  include *
  show flow order
}
