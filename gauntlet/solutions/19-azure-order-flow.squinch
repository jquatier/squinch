pack azure

person shopper "Shopper"

system orders "Order System" {
  apim = azure/api-management "API Management"
  create_fn = azure/functions "Create Order"
  cosmos = azure/cosmos "Orders DB" datastore
  bus = azure/service-bus "Order Events"
  fulfil_fn = azure/functions "Fulfil Order"

  apim -> create_fn
  create_fn -> cosmos
  create_fn ~> bus
  bus ~> fulfil_fn

  layout {
    rows [apim] [create_fn] [cosmos bus] [fulfil_fn]
  }
}

shopper -> orders.apim "place order"

flow order_flow "Order Flow" {
  shopper -> orders.apim -> orders.create_fn -> orders.cosmos
  orders.create_fn ~> orders.bus ~> orders.fulfil_fn
}

view main {
  title "Azure Order Flow"
  expand orders
  show flow order_flow
}
