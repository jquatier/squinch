// Azure order flow system
pack azure

person shopper "Shopper"

system order_system "Order Processing" {
  description: "Processes customer orders end-to-end"

  apim = azure/api-management "API Management"
  order_fn = azure/functions "Order Function" {
    description: "Validates and persists orders"
  }
  cosmos = azure/cosmos "Orders DB" datastore
  bus = azure/service-bus "Order Events"
  fulfil_fn = azure/functions "Fulfilment Function" {
    description: "Handles order fulfilment"
  }

  apim -> order_fn
  order_fn -> cosmos
  order_fn ~> bus
  bus ~> fulfil_fn
}

shopper -> order_system.apim "places order"

flow order_journey "Order Journey" {
  shopper -> order_system.apim
  order_system.apim -> order_system.order_fn
  order_system.order_fn -> order_system.cosmos
  order_system.order_fn ~> order_system.bus
  order_system.bus ~> order_system.fulfil_fn
}

view order_system {
  show flow order_journey
  show descriptions
}
