pack azure

person shopper "Shopper"

apim = azure/api-management "API Management"
createfn = azure/functions "Order Function" {
  subtitle: "Azure Function"
}
db = azure/cosmos "Orders" datastore {
  subtitle: "Cosmos DB"
}
bus = azure/service-bus "Order Events" {
  subtitle: "Service Bus"
}
fulfilfn = azure/functions "Fulfillment Function" {
  subtitle: "Azure Function"
}

shopper -> apim
apim -> createfn
createfn -> db
createfn ~> bus
bus ~> fulfilfn

flow order "Order Flow" {
  shopper -> apim -> createfn -> db
  createfn ~> bus ~> fulfilfn
}

view main {
  title "Azure Order Flow"
  show flow order
  layout {
    rows [shopper] [apim] [createfn] [db bus] [fulfilfn]
  }
}
