pack azure

person shopper "Shopper"

system orders "Order Flow" {
  apim    = azure/api-management "API Management"
  place   = azure/functions "Order Function" { subtitle: "Azure Functions" }
  cosmos  = azure/cosmos "Cosmos DB" datastore
  bus     = azure/service-bus "Service Bus"
  fulfil  = azure/functions "Fulfilment Function" { subtitle: "Azure Functions" }

  apim -> place
  place -> cosmos "writes order"
  place ~> bus "publishes message"
  bus ~> fulfil "picks up"
}

shopper -> orders.apim "places order"

flow order "Order path" {
  shopper -> orders.apim
  orders.apim -> orders.place
  orders.place -> orders.cosmos
  orders.place ~> orders.bus
  orders.bus ~> orders.fulfil
}

view landscape {
  title "Order flow"
  include *
}

view orders {
  title "Order path, step by step"
  scope orders
  show flow order
}
