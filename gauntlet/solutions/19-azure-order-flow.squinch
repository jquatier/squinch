pack azure

person customer "Shopper"

system order "Order Service" {
  apim        = azure/api-management "API Management"
  createOrder = azure/functions      "Create Order Function"
  db          = azure/cosmos         "Orders" datastore
  bus         = azure/service-bus    "Order Events"
  fulfil      = azure/functions      "Fulfilment Function"

  apim -> createOrder
  createOrder -> db
  createOrder ~> bus "order created"
  bus ~> fulfil

  layout {
    rows [apim] [createOrder] [db bus] [fulfil]
  }
}

customer -> order.apim "places order"

flow checkout "Order Checkout" {
  customer -> order.apim
  order.apim -> order.createOrder
  order.createOrder -> order.db
  order.createOrder ~> order.bus
  order.bus ~> order.fulfil
}

view order {
  scope order
  title "Order Checkout Flow"
  show flow checkout
  legend auto
}
