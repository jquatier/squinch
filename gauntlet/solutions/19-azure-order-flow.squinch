pack azure

person shopper "Shopper"

apim = azure/api-management "API Management"
order_fn = azure/functions "Order Function" {
  subtitle: "Node.js"
}
cosmos = azure/cosmos "Orders DB" datastore
bus = azure/service-bus "Event Bus"
fulfillment_fn = azure/functions "Fulfillment Function" {
  subtitle: "Node.js"
}

shopper -> apim
apim -> order_fn
order_fn -> cosmos
order_fn ~> bus
bus ~> fulfillment_fn

flow order_flow "Order Flow" {
  shopper -> apim -> order_fn -> cosmos
  order_fn ~> bus ~> fulfillment_fn
}

view order {
  title "Azure Order Flow"
  show flow order_flow
  layout {
    rows [shopper apim] [order_fn] [cosmos bus] [fulfillment_fn]
  }
}
