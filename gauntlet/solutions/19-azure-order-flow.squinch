// Azure Order Flow - step-by-step order processing
pack azure

person shopper "Shopper"

system orders "Order System" {
  description: "Processes and fulfils customer orders"
  tags: #core

  apim = azure/api-management "API Management"
  orderFn = azure/functions "Order Handler" {
    description: "Validates and persists orders"
  }
  db = azure/cosmos "Orders DB" datastore
  bus = azure/service-bus "Order Queue"
  fulfilFn = azure/functions "Fulfilment Handler" {
    description: "Processes order fulfilment"
  }

  apim -> orderFn
  orderFn -> db
  orderFn ~> bus
  bus ~> fulfilFn
}

shopper -> orders.apim "places order"

flow order_journey "Order Journey" {
  shopper -> orders.apim -> orders.orderFn -> orders.db
  orders.orderFn ~> orders.bus ~> orders.fulfilFn
}

view orders {
  show flow order_journey
  layout {
    rows [apim] [orderFn] [db] [fulfilFn]
    place bus right-of db
  }
}
