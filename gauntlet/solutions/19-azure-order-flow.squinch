pack azure

person shopper "Shopper"
apim   = azure/api-management "API Management"
orders = azure/functions "Order Function"
db     = azure/cosmos "Cosmos DB" datastore
bus    = azure/service-bus "Service Bus"
fulfil = azure/functions "Fulfilment Function"

shopper -> apim "places order"
apim -> orders
orders -> db "writes order"
orders ~> bus "publishes message"
bus ~> fulfil "picks up"

flow order "Order path" {
  shopper -> apim
  apim -> orders
  orders -> db
  orders ~> bus
  bus ~> fulfil
}

view landscape {
  title "Order flow"
  include *
  show flow order
}
