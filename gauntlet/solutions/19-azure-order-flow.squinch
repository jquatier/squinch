pack azure

person shopper "Shopper"

system order_system "Order Processing" {
  apim = azure/api-management "API Management"
  order_fn = azure/functions "Order Function" {
    description: "Validates and persists"
  }
  db = azure/cosmos "Cosmos DB" datastore
  bus = azure/service-bus "Service Bus"
  fulfil_fn = azure/functions "Fulfilment Function" {
    description: "Handles fulfilment"
  }

  apim -> order_fn
  order_fn -> db
  order_fn ~> bus
  bus ~> fulfil_fn
}

shopper -> order_system.apim "places order"

flow order_flow "Order Journey" {
  shopper -> order_system.apim -> order_system.order_fn -> order_system.db
  order_system.order_fn ~> order_system.bus ~> order_system.fulfil_fn
}

view order_system {
  show flow order_flow
  layout {
    rows [apim] [order_fn] [db bus] [fulfil_fn]
    place bus right-of db
  }
}
