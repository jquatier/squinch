// Azure order processing flow
pack azure

person shopper "Shopper"

system order_system "Order Processing System" {
  api    = azure/api-management "API Management"
  create = azure/functions       "Create Order Function" {
    description: "Processes new orders"
  }
  db     = azure/cosmos          "Orders DB" datastore {
    description: "Order storage"
  }
  bus    = azure/service-bus     "Order Events" {
    description: "Event queue"
  }
  fulfill = azure/functions      "Fulfillment Function" {
    description: "Handles order fulfillment"
  }

  api -> create
  create -> db
  create ~> bus "order.created"
  bus ~> fulfill
}

shopper -> order_system.api "places order"

flow order_journey "Order Journey" {
  shopper -> order_system.api
  order_system.api -> order_system.create
  order_system.create -> order_system.db
  order_system.create ~> order_system.bus
  order_system.bus ~> order_system.fulfill
}

view order_system {
  show flow order_journey
  layout {
    rows [api] [create] [db bus] [fulfill]
    place bus right-of db
  }
}
