pack azure

person shopper "Shopper"

system order_system "Order System" {
  apim = azure/api-management "API Management"
  order_func = azure/functions "Order Function" {
    description: "Creates and persists order"
  }
  cosmos = azure/cosmos "Orders DB" datastore
  bus = azure/service-bus "Service Bus"
  fulfil_func = azure/functions "Fulfilment Function" {
    description: "Processes order fulfilment"
  }

  apim -> order_func
  order_func -> cosmos
  order_func ~> bus
  bus ~> fulfil_func
}

shopper -> order_system.apim "place order"

flow order_flow "Order Flow" {
  shopper -> order_system.apim -> order_system.order_func -> order_system.cosmos
  order_system.order_func ~> order_system.bus ~> order_system.fulfil_func
}

view order_system {
  show flow order_flow
}
