// Azure order flow diagram
pack azure

person shopper "Shopper"

system order_system "Order System" {
  apim = azure/api-management "API Management"
  order_fn = azure/functions "Order Function" {
    description: "Validates and persists orders"
  }
  cosmos = azure/cosmos "Orders DB" datastore
  bus = azure/service-bus "Order Queue"
  fulfil_fn = azure/functions "Fulfilment Function" {
    description: "Processes order fulfilment"
  }

  apim -> order_fn
  order_fn -> cosmos
  order_fn ~> bus
  bus ~> fulfil_fn
}

shopper -> order_system.apim "places order"

flow order_journey "Order Journey" {
  shopper -> order_system.apim -> order_system.order_fn -> order_system.cosmos
  order_system.order_fn ~> order_system.bus ~> order_system.fulfil_fn
}

view order_system {
  show flow order_journey
  show descriptions
  layout {
    rows [apim] [order_fn] [cosmos] [fulfil_fn]
    place bus right-of cosmos
    route order_fn ~> bus from south to east
    route bus ~> fulfil_fn from south
  }
}
