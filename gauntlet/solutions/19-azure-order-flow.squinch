pack azure

person shopper "Shopper"

apim = azure/api-management "API Management"
create_fn = azure/functions "Create Order Function"
db = azure/cosmos "Orders DB" datastore
bus = azure/service-bus "Order Events"
fulfil_fn = azure/functions "Fulfilment Function"

shopper -> apim "places order"
apim -> create_fn
create_fn -> db "write order"
create_fn ~> bus "publish OrderCreated"
bus ~> fulfil_fn "process fulfilment"

flow order "Order Flow" {
  shopper -> apim
  apim -> create_fn
  create_fn -> db
  create_fn ~> bus
  bus ~> fulfil_fn
}

view main {
  title "Azure Order Flow"
  show flow order
  layout {
    rows [shopper] [apim] [create_fn] [db bus] [fulfil_fn]
  }
}
