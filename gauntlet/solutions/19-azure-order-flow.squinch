pack azure

person shopper "Shopper"

system orders "Order System" {
  description: "Order processing and fulfillment"

  apim = azure/api-management "API Management"
  order_fn = azure/functions "Order Function" {
    subtitle: "Validates and persists"
  }
  db = azure/cosmos "Orders DB" datastore
  bus = azure/service-bus "Service Bus"
  fulfillment_fn = azure/functions "Fulfillment Function" {
    subtitle: "Fulfillment handler"
  }

  apim -> order_fn
  order_fn -> db
  order_fn ~> bus "order created"
  bus ~> fulfillment_fn
}

shopper -> orders.apim "places order"

flow checkout "Order Flow" {
  shopper -> orders.apim -> orders.order_fn -> orders.db
  orders.order_fn ~> orders.bus ~> orders.fulfillment_fn
}

view orders {
  title "Azure Order Flow"
  show flow checkout
  layout {
    rows [apim] [order_fn] [db bus] [fulfillment_fn]
  }
}
