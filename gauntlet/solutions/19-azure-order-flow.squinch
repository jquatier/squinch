pack azure

person shopper "Shopper"

system orders "Order System" {
  apim = azure/api-management "API Management"
  create_fn = azure/functions "Create Order Function" {
    description: "Validates and persists order"
  }
  db = azure/cosmos "Orders DB" datastore
  bus = azure/service-bus "Order Events"
  fulfill_fn = azure/functions "Fulfillment Function" {
    description: "Processes order fulfillment"
  }

  apim -> create_fn
  create_fn -> db
  create_fn ~> bus
  bus ~> fulfill_fn
}

shopper -> orders.apim "places order"

flow order_journey "Order Journey" {
  shopper -> orders.apim
  orders.apim -> orders.create_fn
  orders.create_fn -> orders.db
  orders.create_fn ~> orders.bus
  orders.bus ~> orders.fulfill_fn
}

view orders {
  show flow order_journey
  layout {
    rows [apim] [create_fn] [db bus] [fulfill_fn]
    place bus right-of db
  }
}
