pack azure

person shopper "Shopper"

system orders "Order System" {
  description: "Order processing and fulfillment"

  apim = azure/api-management "API Management"
  create_fn = azure/functions "Create Order" {
    subtitle: "Azure Functions"
  }
  db = azure/cosmos "Orders DB" datastore {
    subtitle: "Cosmos DB"
  }
  bus = azure/service-bus "Order Events" {
    subtitle: "Service Bus"
  }
  fulfill_fn = azure/functions "Fulfillment Handler" {
    subtitle: "Azure Functions"
  }

  apim -> create_fn
  create_fn -> db
  create_fn ~> bus "order created"
  bus ~> fulfill_fn
}

shopper -> orders.apim "place order"

flow checkout "Order Journey" {
  shopper -> orders.apim -> orders.create_fn -> orders.db
  orders.create_fn ~> orders.bus ~> orders.fulfill_fn
}

view order_flow {
  title "Azure Order Flow"
  show flow checkout
  titleblock {
    subtitle: "Order processing path"
  }
}
