pack azure

person shopper "Shopper"

system order_system "Order System" {
  description: "E-commerce order processing"

  apim     = azure/api-management "API Management"
  create   = azure/functions       "Create Order Function"
  cosmos   = azure/cosmos          "Orders DB" datastore
  bus      = azure/service-bus     "Order Events"
  fulfil   = azure/functions       "Fulfilment Function"

  apim -> create
  create -> cosmos
  create ~> bus
  bus ~> fulfil
}

shopper -> order_system.apim "places order"

flow order_flow "Order Processing" {
  shopper -> order_system.apim
  order_system.apim -> order_system.create
  order_system.create -> order_system.cosmos
  order_system.create ~> order_system.bus
  order_system.bus ~> order_system.fulfil
}

view order_system {
  show flow order_flow
  layout {
    rows [apim] [create] [cosmos bus] [fulfil]
    place bus right-of cosmos
  }
}
