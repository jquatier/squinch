pack azure

person shopper "Shopper"

system orders "Order System" {
  icon: azure/api-management
  description: "Order processing pipeline"

  apim = azure/api-management "API Management"
  create_fn = azure/functions "Create Order" {
    subtitle: "Azure Function"
  }
  cosmos = azure/cosmos "Orders" datastore
  bus = azure/service-bus "Order Events"
  fulfil_fn = azure/functions "Fulfil Order" {
    subtitle: "Azure Function"
  }

  apim -> create_fn
  create_fn -> cosmos
  create_fn ~> bus
  bus ~> fulfil_fn
}

shopper -> orders.apim "places order"

flow order_flow "Order Journey" {
  shopper -> orders.apim
  orders.apim -> orders.create_fn
  orders.create_fn -> orders.cosmos
  orders.create_fn ~> orders.bus
  orders.bus ~> orders.fulfil_fn
}

view main {
  title "Azure Order Flow"
  expand orders
  show flow order_flow
  layout {
    rows [orders.apim] [orders.create_fn] [orders.cosmos orders.bus] [orders.fulfil_fn]
  }
}
