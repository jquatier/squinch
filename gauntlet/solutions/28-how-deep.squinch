pack aws

person customer "Customer"

system orders "Order Service" {
  description: "Handles checkout and order processing"
  icon: aws/api-gateway

  api = aws/api-gateway "API Gateway"
  create = aws/lambda "Create Order"
  get = aws/lambda "Get Order"
  update = aws/lambda "Update Order"
  db = aws/dynamodb "Orders Table" datastore
  events = aws/eventbridge "Event Bus"

  api -> create
  api -> get
  api -> update
  create -> db
  get -> db
  update -> db
  create ~> events "order.created"
  update ~> events "order.updated"
}

system inventory "Inventory Service" {
  description: "Tracks product availability"
  icon: aws/lambda

  api = aws/api-gateway "API"
  reserve = aws/lambda "Reserve Stock"
  release = aws/lambda "Release Stock"
  db = aws/dynamodb "Inventory" datastore

  api -> reserve
  api -> release
  reserve -> db
  release -> db
}

system notifications "Notification Service" {
  description: "Sends order updates to customers"
  icon: aws/sns

  handler = aws/lambda "Event Handler"
  email = aws/sns "Email Topic"
  sms = aws/sns "SMS Topic"

  handler ~> email
  handler ~> sms
}

customer -> orders.api "places order"
orders.events ~> inventory.api "reserve stock"
orders.events ~> notifications.handler "notify customer"

view landscape {
  title "Order Platform"
  include *
  layout {
    rows [customer] [orders] [inventory notifications]
  }
}

view orders {
  title "Order Service Detail"
  scope orders
}
