person customer "Customer"

system orders "Orders" {
  description: "Takes and tracks customer orders"
  preview: [api workflow store]
  api      = sys/webhook "Orders API" { subtitle: "Entry point" }
  workflow = sys/workflow "Order Workflow" { subtitle: "Validation and status" }
  store    = sys/database "Order Store" datastore
  events   = sys/radio-tower "Order Events" { subtitle: "Publishes changes" }
  api -> workflow
  workflow -> store
  workflow ~> events
}

system inventory "Inventory" {
  description: "Stock levels and reservations"
  preview: [api stock]
  api   = sys/webhook "Inventory API"
  stock = sys/database "Stock Store" datastore
  api -> stock
}

system notifications "Notifications" {
  description: "Customer messages about orders"
  preview: [consumer sender]
  consumer = sys/workflow "Event Consumer"
  sender   = sys/send "Message Sender"
  consumer -> sender
}

customer -> orders.api "places order"
orders.workflow -> inventory.api "reserves stock"
orders.events ~> notifications.consumer "order events"

view landscape {
  title "Order Platform"
  include *
  preview *
}

view orders {
  title "Orders"
}
