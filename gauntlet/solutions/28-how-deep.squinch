// Order platform - landscape and internal details

system orders "Orders" {
  description: "Order lifecycle, cart to fulfillment"

  api = aws/api-gateway "Orders API"
  create = aws/lambda "Create Handler" {
    subtitle: "Lambda · Node 20"
  }
  get = aws/lambda "Get Handler" {
    subtitle: "Lambda · Node 20"
  }
  update = aws/lambda "Update Handler" {
    subtitle: "Lambda · Node 20"
  }
  db = aws/dynamodb "Orders Table" datastore
  events = aws/eventbridge "Order Events"

  api -> create
  api -> get
  api -> update
  create -> db
  get -> db
  update -> db
  create ~> events "order.created"
  update ~> events "order.updated"

  layout {
    rows [api] [create get update] [db events]
  }
}

system inventory "Inventory" {
  description: "Stock management and allocation"

  api = aws/api-gateway "Inventory API"
  check = aws/lambda "Stock Check" {
    subtitle: "Lambda · Python"
  }
  reserve = aws/lambda "Reserve Handler" {
    subtitle: "Lambda · Python"
  }
  db = aws/dynamodb "Inventory Table" datastore

  api -> check
  api -> reserve
  check -> db
  reserve -> db

  layout {
    rows [api] [check reserve] [db]
  }
}

system notifications "Notifications" {
  description: "Customer and admin notifications"

  processor = aws/lambda "Event Processor" {
    subtitle: "Lambda · Node 20"
  }
  email = aws/sns "Email Topic"
  sms = aws/sns "SMS Topic"

  processor ~> email
  processor ~> sms

  layout {
    rows [processor] [email sms]
  }
}

// Cross-service interactions
orders.events ~> inventory.api "stock.reserve"
orders.events ~> notifications.processor "order.events"

view landscape {
  title "Order Platform - Landscape"
  include *
}

view orders {
  title "Orders Service - Internal Detail"
}
