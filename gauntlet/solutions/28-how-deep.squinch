system orders "Orders" {
  description: "Order lifecycle, from placement to completion"
  icon: sys/package-check
  preview: [api workflow store]
  api      = sys/app-window "Orders API" { subtitle: "Entry point" }
  workflow = sys/workflow "Order Workflow" { subtitle: "Order state changes" }
  worker   = sys/cog "Order Worker" { subtitle: "Background jobs" }
  store    = sys/database "Orders Store" datastore
  api -> workflow
  workflow -> store
  workflow ~> worker "async jobs"
  worker -> store
  layout { rows [api] [workflow] [worker store] }
}
system inventory "Inventory" {
  description: "Stock levels and reservations"
  icon: sys/warehouse
  api   = sys/app-window "Inventory API"
  logic = sys/cog "Stock Logic"
  store = sys/database "Inventory Store" datastore
  api -> logic
  logic -> store
}
system notifications "Notifications" {
  description: "Messages sent to customers"
  icon: sys/radio-tower
  intake = sys/webhook "Event Intake"
  sender = sys/cog "Sender"
  queue  = sys/archive "Outbox" datastore
  intake ~> queue
  queue ~> sender
}
orders.workflow -> inventory.api "reserve stock"
orders.workflow ~> notifications.intake "order events"

view landscape {
  title "Order Platform"
  include *
  preview orders
}
view orders {
  title "Orders — how it is put together"
}
