// Order platform - onboarding view for new engineers
pack aws

person customer "Customer"

system orders "Orders Service" {
  description: "Checkout and order processing"
  glyph: sys/code

  api = aws/api-gateway "API Gateway"
  create = aws/lambda "Create Order"
  validate = aws/lambda "Validate Order"
  db = aws/dynamodb "Orders DB" datastore
  stream = aws/kinesis "Order Events"

  api -> create
  api -> validate
  create -> db
  db ~> stream "changes"
}

system inventory "Inventory Service" {
  description: "Stock management"
  glyph: sys/database

  handler = aws/lambda "Inventory Handler"
  stock = aws/dynamodb "Stock DB" datastore
}

system notifications "Notifications Service" {
  description: "Customer notifications"
  glyph: sys/workflow

  processor = aws/lambda "Notification Processor"
  queue = aws/sqs "Notifications Queue"

  queue ~> processor
}

customer -> orders.api "places order"
orders.stream ~> inventory.handler "stock update"
orders.stream ~> notifications.queue "order events"

view landscape {
  title "Order Platform Overview"
}

view orders {
  title "Orders Service Detail"
}
