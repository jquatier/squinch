pack aws

person customer "Customer"

system orders "Orders" {
  description: "Order placement and lifecycle"

  api    = aws/api-gateway "API"
  svc    = aws/lambda      "Order Service"
  db     = aws/dynamodb    "Orders Table" datastore
  events = aws/eventbridge "Order Events"

  api -> svc
  svc -> db
  svc ~> events "order placed"

  layout { rows [api] [svc] [db events] }
}

system inventory "Inventory" {
  description: "Stock levels and reservations"

  api = aws/api-gateway "API"
  svc = aws/lambda      "Inventory Service"
  db  = aws/dynamodb    "Inventory Table" datastore

  api -> svc
  svc -> db
}

system notifications "Notifications" {
  description: "Customer messaging"

  queue = aws/sqs    "Notification Queue"
  svc   = aws/lambda "Notification Service"
  email = aws/ses    "Email"

  queue -> svc
  svc -> email
}

customer -> orders.api "places order"
orders.svc -> inventory.api "check stock"
orders.events ~> notifications.queue "order placed"

view landscape {
  title "Order Platform"
  include *
}

view orders {
  title "Orders Service"
}
