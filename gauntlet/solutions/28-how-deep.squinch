// Order Platform - architecture for new engineers
pack aws

person customer "Customer"

system orders "Orders" {
  description: "Order lifecycle and fulfillment"

  api = aws/api-gateway "Orders API"
  create = aws/lambda "Create Order" {
    description: "Validates and creates orders"
    subtitle: "Lambda · Node 20"
  }
  get = aws/lambda "Get Order" {
    description: "Retrieves order details"
    subtitle: "Lambda · Node 20"
  }
  update = aws/lambda "Update Order" {
    description: "Modifies order status"
    subtitle: "Lambda · Node 20"
  }
  db = aws/dynamodb "Orders Table" datastore {
    description: "Primary order data"
  }
  queue = aws/sqs "Order Events"

  api -> create
  api -> get
  api -> update
  create -> db
  get -> db
  update -> db
  create ~> queue
  update ~> queue

  layout {
    rows [api] [create get update] [db queue]
  }
}

system inventory "Inventory" {
  description: "Stock management and allocation"

  api = aws/api-gateway "Inventory API"
  check = aws/lambda "Check Stock"
  reserve = aws/lambda "Reserve Items"
  db = aws/dynamodb "Inventory Table" datastore

  api -> check
  api -> reserve
  check -> db
  reserve -> db

  layout {
    rows [api] [check reserve] [db]
  }
}

system notifications "Notifications" {
  description: "Customer notifications"

  processor = aws/lambda "Event Processor"
  send = aws/lambda "Send Notification"
  sns = aws/sns "SNS Topic"

  processor -> send
  send ~> sns

  layout {
    rows [processor] [send] [sns]
  }
}

customer -> orders.api "places order"
orders.queue ~> inventory.api "stock check"
orders.queue ~> notifications.processor "order updates"

view landscape {
  title "Order Platform - System Landscape"
  include *
  preview orders
}

view orders {
  title "Orders Service - Internal Structure"
}
