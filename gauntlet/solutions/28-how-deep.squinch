pack aws

person customer "Customer"

system orders "Orders Service" {
  description: "Order lifecycle and checkout"
  domain: "orders"

  api    = aws/api-gateway "Orders API"
  svc    = aws/lambda      "Orders Service" { subtitle: "Lambda · Node 20" }
  db     = aws/dynamodb    "Orders Table" datastore
  events = aws/eventbridge "Order Events"

  api -> svc
  svc -> db
  svc ~> events "order placed"

  layout { rows [api] [svc] [db events] }
}

system inventory "Inventory Service" {
  description: "Stock levels and reservations"
  domain: "inventory"

  api = aws/api-gateway "Inventory API"
  svc = aws/lambda      "Inventory Service"
  db  = aws/dynamodb    "Stock Table" datastore

  api -> svc
  svc -> db
}

system notifications "Notifications Service" {
  description: "Customer order updates"
  domain: "notifications"

  queue  = aws/sqs   "Notify Queue"
  worker = aws/lambda "Notify Worker"
  email  = aws/ses    "Email"

  queue ~> worker
  worker -> email
}

customer -> orders.api "places order"
orders.svc -> inventory.api "check stock"
orders.events ~> notifications.queue "order placed"

view landscape {
  title "Order Platform"
  include *
}

view orders {
  title "Orders Service"
  scope orders
}
