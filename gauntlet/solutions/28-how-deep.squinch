// Order platform — focused on orders service internal structure

system orders "Orders Service" {
  description: "Handles order lifecycle"
  glyph: sys/box

  api = sys/webhook "Orders API"
  processor = sys/workflow "Order Processor"
  validator = sys/shield-check "Validator"
  db = sys/database "Orders DB" datastore

  api -> validator
  validator -> processor
  processor -> db
}

system inventory "Inventory Service" {
  description: "Stock and fulfillment"
  glyph: sys/warehouse

  svc = sys/server "Inventory API"
  cache = sys/database "Inventory Cache" datastore

  svc -> cache
}

system notifications "Notifications Service" {
  description: "Customer alerts"
  glyph: sys/siren

  sender = sys/route "Notification Sender"
  queue = sys/database "Event Queue" datastore

  queue ~> sender
}

// Cross-service connections
orders.processor -> inventory.svc "check stock"
orders.processor ~> notifications.queue "order events"

view landscape {
  title "Order Platform"
  include *
}

view orders {
  title "Orders Service Detail"
  scope orders
}
