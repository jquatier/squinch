system orders "Orders" {
  description: "Takes and tracks customer orders"
  preview: [api workflow store]
  api      = sys/webhook  "Orders API" { subtitle: "entry point" }
  workflow = sys/workflow "Order Workflow" { subtitle: "order lifecycle" }
  validate = sys/shield-check "Validation" { subtitle: "checks an order" }
  store    = sys/database "Orders Store" datastore
  events   = sys/radio-tower "Order Events" { subtitle: "published changes" }
  api -> validate
  api -> workflow
  workflow -> store
  workflow ~> events "order changes"
}

system inventory "Inventory" {
  description: "Tracks stock levels"
  preview: [api stock]
  api   = sys/webhook "Inventory API"
  stock = sys/database "Stock Store" datastore
  api -> stock
}

system notifications "Notifications" {
  description: "Tells customers about their orders"
  preview: [worker sender]
  worker = sys/cog "Notification Worker"
  sender = sys/send "Sender"
  worker -> sender
}

orders.workflow -> inventory.api "reserves stock"
orders.events ~> notifications.worker "order events"

view landscape {
  title "Order Platform"
  include *
  preview *
}

view orders {
  title "Orders — how it is put together"
  scope orders
}
