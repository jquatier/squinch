// Order Platform Architecture
pack aws

person customer "Customer"

system orders "Orders Service" {
  description: "Order lifecycle management"
  api = aws/api-gateway "Orders API"
  handler = aws/lambda "Order Handler" {
    subtitle: "Node 20"
  }
  db = aws/dynamodb "Orders DB" datastore
  queue = aws/sqs "Order Events"

  api -> handler
  handler -> db
  handler ~> queue "order events"
}

system inventory "Inventory Service" {
  description: "Stock and availability"
  api = aws/api-gateway "Inventory API"
  handler = aws/lambda "Inventory Handler" {
    subtitle: "Python 3.12"
  }
  db = aws/dynamodb "Inventory DB" datastore

  api -> handler
  handler -> db
}

system notifications "Notifications Service" {
  description: "Customer communications"
  processor = aws/lambda "Notification Processor" {
    subtitle: "Node 20"
  }
  delivery = aws/sns "SNS"

  processor -> delivery
}

customer -> orders.api "place order"
orders.queue ~> inventory.api "inventory check"
orders.queue ~> notifications.processor "order confirmation"

view landscape {
  title "Order Platform"
  include *
  titleblock {
    subtitle: "Platform overview"
  }
}

view orders {
  title "Orders Service Detail"
  titleblock {
    subtitle: "Order lifecycle management"
  }
}
