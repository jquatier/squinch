system orders "Orders" {
  description: "Takes and tracks customer orders"
  preview: [api workflow store]
  api      = sys/webhook  "Orders API" { subtitle: "entry point" }
  workflow = sys/workflow "Order Workflow" { subtitle: "order lifecycle" }
  store    = sys/database "Orders Store" datastore
  events   = sys/radio-tower "Order Events" { subtitle: "publishes changes" }
  api -> workflow
  workflow -> store
  workflow ~> events
}

system inventory "Inventory" {
  description: "Stock levels and reservations"
  preview: [api stock]
  api   = sys/webhook  "Inventory API"
  stock = sys/database "Stock Store" datastore
  api -> stock
}

system notifications "Notifications" {
  description: "Tells customers about their orders"
  preview: [handler sender]
  handler = sys/cog  "Event Handler"
  sender  = sys/send "Message Sender"
  handler -> sender
}

orders.workflow -> inventory.api "reserve stock"
orders.events ~> notifications.handler "order events"

view landscape {
  title "Order Platform"
  include *
  preview *
}

view orders {
  title "Orders"
  scope orders
}
