pack aws

person customer "Customer"

system orders "Orders Service" {
  description: "Manages order lifecycle"
  icon: aws/api-gateway

  api = aws/api-gateway "Orders API"
  create = aws/lambda "Create Handler"
  get = aws/lambda "Get Handler"
  update = aws/lambda "Update Handler"
  db = aws/dynamodb "Orders DB" datastore
  queue = aws/sqs "Order Events"

  api -> create
  api -> get
  api -> update
  create -> db
  get -> db
  update -> db
  create ~> queue "order.created"
  update ~> queue "order.updated"

  layout {
    rows [api] [create get update] [db queue]
  }
}

system inventory "Inventory Service" {
  description: "Tracks stock levels"
  icon: aws/lambda

  handler = aws/lambda "Inventory Handler"
  db = aws/dynamodb "Inventory DB" datastore

  handler -> db
}

system notifications "Notifications Service" {
  description: "Sends customer notifications"
  icon: aws/sns

  handler = aws/lambda "Notification Handler"
  sns = aws/sns "Email/SMS"

  handler -> sns
}

customer -> orders.api "places order"
orders.queue ~> inventory.handler "stock check"
orders.queue ~> notifications.handler "notify customer"

view landscape {
  title "Order Platform Overview"
  include *
}

view orders {
  title "Orders Service Detail"
  scope orders
}
