// Order Platform Architecture

pack aws

person customer "Customer"

system orders "Order Service" {
  description: "Order processing and management"
  glyph: sys/code

  api = aws/api-gateway "API Gateway"
  create = aws/lambda "Create Handler" {
    description: "Validates and creates orders"
  }
  query = aws/lambda "Query Handler" {
    description: "Reads order data"
  }
  process = aws/lambda "Process Handler" {
    description: "Fulfillment workflow"
  }
  db = aws/dynamodb "Orders Table" datastore
  queue = aws/sqs "Order Queue"

  api -> create
  api -> query
  create -> db
  query -> db
  create ~> queue "new order"
  queue ~> process
  process -> db
}

system inventory "Inventory Service" {
  description: "Stock tracking"
  glyph: sys/database

  svc = aws/lambda "Inventory Service"
  store = aws/dynamodb "Inventory DB" datastore

  svc -> store
}

system notifications "Notification Service" {
  description: "Customer notifications"
  glyph: sys/webhook

  notifier = aws/lambda "Notifier"
  topic = aws/sns "Events Topic"

  topic ~> notifier
}

customer -> orders.api "places order"
orders.process -> inventory.svc "check stock"
orders.process ~> notifications.topic "order event"

view landscape {
  title "Order Platform Overview"
  include *
}

view orders {
  title "Order Service Detail"
  scope orders
}
