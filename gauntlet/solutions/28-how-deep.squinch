pack aws
pack logos

person customer "Customer"

system orders "Orders" {
  description: "Order lifecycle and fulfillment"
  icon: aws/api-gateway

  api = aws/api-gateway "Orders API"
  create = aws/lambda "Create Order" {
    subtitle: "Lambda · Node 20"
  }
  update = aws/lambda "Update Order" {
    subtitle: "Lambda · Node 20"
  }
  query = aws/lambda "Query Handler" {
    subtitle: "Lambda · Node 20"
  }
  db = aws/dynamodb "Orders Table" datastore
  events = aws/eventbridge "Order Events"

  api -> create
  api -> update
  api -> query
  create -> db
  update -> db
  query -> db
  create ~> events "order.created"
  update ~> events "order.updated"

  layout {
    rows [api] [create update query] [db events]
  }
}

system inventory "Inventory" {
  description: "Stock tracking and reservation"
  icon: aws/lambda

  listener = aws/lambda "Event Listener"
  reserve = aws/lambda "Reserve Stock"
  release = aws/lambda "Release Stock"
  db = aws/dynamodb "Inventory Table" datastore

  listener -> reserve
  listener -> release
  reserve -> db
  release -> db

  layout {
    rows [listener] [reserve release] [db]
  }
}

system notifications "Notifications" {
  description: "Customer and admin notifications"
  icon: aws/sns

  listener = aws/lambda "Event Listener"
  email = aws/lambda "Email Sender" {
    subtitle: "Lambda · SES"
  }
  sms = aws/lambda "SMS Sender" {
    subtitle: "Lambda · SNS"
  }

  listener -> email
  listener -> sms

  layout {
    rows [listener] [email sms]
  }
}

customer -> orders.api "places and checks orders"
orders.events ~> inventory.listener "inventory events"
orders.events ~> notifications.listener "notification events"

view landscape {
  title "Order Platform"
  include *
  preview orders
  titleblock {
    subtitle: "Platform overview"
  }
}

view orders {
  title "Orders Service"
}
