// Order Platform — system landscape with focus on orders service internals

pack aws

person customer "Customer"

system orders "Orders Service" {
  description: "Order processing and checkout"
  glyph: sys/code

  api = aws/api-gateway "API Gateway"
  create = aws/lambda "Create Order Handler"
  get = aws/lambda "Get Order Handler"
  search = aws/lambda "Search Handler"
  db = aws/dynamodb "Orders Table" datastore
  queue = aws/sqs "Processing Queue"
  processor = aws/lambda "Order Processor"

  api -> create
  api -> get
  api -> search
  create -> db
  get -> db
  search -> db
  create ~> queue
  queue ~> processor
  processor -> db
}

system inventory "Inventory Service" {
  description: "Stock management"
  glyph: sys/database

  api = aws/api-gateway "Inventory API"
  db = aws/dynamodb "Stock Table" datastore

  api -> db
}

system notifications "Notifications Service" {
  description: "Customer notifications"
  glyph: sys/workflow

  handler = aws/lambda "Notification Handler"
  sns = aws/sns "Topics"

  handler -> sns
}

customer -> orders.api "places order"
orders.processor -> inventory.api "checks stock"
orders.processor ~> notifications.handler "sends confirmation"

view landscape {
  title "Order Platform"
  include *
}

view orders {
  title "Orders Service Detail"
  show descriptions
}
