system orders "Orders" {
  description: "Takes and tracks customer orders"
  preview: [api workflow db]
  api      = sys/webhook  "Orders API" { subtitle: "entry point" }
  workflow = sys/workflow "Order Workflow" { subtitle: "placement and status" }
  db       = sys/database "Orders Store" datastore
  events   = sys/radio-tower "Order Events"
  api -> workflow
  workflow -> db
  workflow ~> events "order changes"
}

system inventory "Inventory" {
  description: "Tracks stock levels"
  preview: [api stock]
  api   = sys/webhook  "Inventory API"
  stock = sys/database "Stock Store" datastore
  api -> stock
}

system notifications "Notifications" {
  description: "Tells customers what happened"
  preview: [consumer sender]
  consumer = sys/radio-tower "Event Consumer"
  sender   = sys/send "Sender"
  consumer -> sender
}

orders.workflow -> inventory.api "reserve stock"
orders.events ~> notifications.consumer "order events"

view landscape {
  title "Order Platform"
  include *
  preview *
}

view orders {
  title "Orders"
}
