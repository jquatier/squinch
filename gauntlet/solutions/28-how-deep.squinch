pack aws

person customer "Customer"

system orders "Orders Service" {
  description: "Checkout and order management"
  glyph: sys/code

  api = aws/api-gateway "API Gateway"
  create = aws/lambda "Create Handler" {
    description: "Validates and persists orders"
  }
  get = aws/lambda "Get Handler" {
    description: "Retrieves order details"
  }
  update = aws/lambda "Update Handler" {
    description: "Modifies order status"
  }
  db = aws/dynamodb "Orders Table" datastore
  queue = aws/sqs "Event Queue" {
    description: "Order events for downstream"
  }

  api -> create
  api -> get
  api -> update
  create -> db
  get -> db
  update -> db
  create ~> queue "order.created"
  update ~> queue "order.updated"
}

system inventory "Inventory Service" {
  description: "Stock tracking and allocation"
  glyph: sys/database

  worker = aws/lambda "Inventory Worker"
  stock_db = aws/dynamodb "Stock Table" datastore

  worker -> stock_db
}

system notifications "Notifications Service" {
  description: "Customer and internal notifications"
  glyph: sys/mail

  processor = aws/lambda "Notification Processor"
  templates = aws/s3 "Template Store" datastore

  processor -> templates
}

customer -> orders.api "places order"
orders.queue ~> inventory.worker "stock events"
orders.queue ~> notifications.processor "notification events"

view landscape {
  title "Order Platform Overview"
  include *
}

view orders {
  title "Orders Service - Internal Structure"
  scope orders
  show descriptions
}
