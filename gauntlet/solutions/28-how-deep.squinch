pack aws

person engineer "New Engineer"

system orders "Orders Service" {
  description: "Order lifecycle management"
  icon: aws/api-gateway

  api = aws/api-gateway "Orders API"
  handler = aws/lambda "Order Handler" {
    subtitle: "Lambda · Node 20"
  }
  validator = aws/lambda "Validator"
  db = aws/dynamodb "Orders DB" datastore
  queue = aws/sqs "Event Queue"

  api -> handler
  handler -> validator
  validator -> db
  handler ~> queue

  layout {
    rows [api] [handler validator] [db queue]
  }
}

system inventory "Inventory Service" {
  description: "Stock tracking and management"
  icon: aws/lambda

  api = aws/api-gateway "Inventory API"
  svc = aws/lambda "Inventory Handler"
  db = aws/dynamodb "Stock DB" datastore

  api -> svc
  svc -> db
}

system notifications "Notifications Service" {
  description: "Customer and internal alerts"
  icon: aws/sns

  processor = aws/lambda "Notification Processor"
  email = aws/sns "Email Topic"
  sms = aws/sns "SMS Topic"

  processor ~> email
  processor ~> sms
}

engineer -> orders.api "manages orders"
orders.queue ~> inventory.api "stock updates"
orders.queue ~> notifications.processor "order events"

view landscape {
  title "Order Platform"
  include *
}

view orders {
  title "Orders Service Detail"
}
