pack aws

// Order Platform Architecture

person customer "Customer"

system orders "Orders Service" {
  description: "Order processing and fulfillment"
  icon: aws/api-gateway

  api = aws/api-gateway "Orders API"
  create = aws/lambda "Create Handler" {
    description: "Validates and creates orders"
    subtitle: "Lambda · Node 20"
  }
  process = aws/lambda "Process Handler" {
    description: "Processes and fulfills orders"
    subtitle: "Lambda · Node 20"
  }
  db = aws/dynamodb "Orders Table" datastore
  queue = aws/sqs "Processing Queue"

  api -> create
  create -> db
  create ~> queue "order created"
  queue ~> process
  process -> db

  layout {
    rows [api] [create] [queue process] [db]
  }
}

system inventory "Inventory Service" {
  description: "Stock management"
  icon: aws/lambda

  api = aws/api-gateway "Inventory API"
  check = aws/lambda "Check Stock"
  update = aws/lambda "Update Stock"
  db = aws/dynamodb "Inventory Table" datastore

  api -> check
  api -> update
  check -> db
  update -> db
}

system notifications "Notifications Service" {
  description: "Customer communications"
  icon: aws/sns

  handler = aws/lambda "Notification Handler"
  email = aws/sns "Email Topic"
  sms = aws/sns "SMS Topic"

  handler ~> email
  handler ~> sms
}

customer -> orders.api "places order"
orders.create -> inventory.api "check stock"
orders.process -> inventory.api "reserve items"
orders.process ~> notifications.handler "order confirmation"

view landscape {
  title "Order Platform - System Landscape"
  include *
  titleblock {
    subtitle: "System overview"
  }
}

view orders {
  title "Orders Service - Internal Detail"
  titleblock {
    subtitle: "Detailed view"
  }
}
