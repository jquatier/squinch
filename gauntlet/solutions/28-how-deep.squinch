pack aws

person customer "Customer"

system orders "Order Service" {
  description: "Owns the order lifecycle"
  domain: "orders"

  api = aws/api-gateway "API Gateway"
  handler = aws/lambda "Order Handler" {
    subtitle: "Lambda · Node 20"
  }
  db = aws/dynamodb "Orders Table" datastore
  events = aws/eventbridge "Order Events"

  api -> handler
  handler -> db
  handler ~> events "order placed"

  layout {
    rows [api] [handler] [db events]
  }
}

system inventory "Inventory Service" {
  description: "Tracks stock levels"
  domain: "inventory"

  api = aws/api-gateway "API Gateway"
  handler = aws/lambda "Stock Handler"
  db = aws/dynamodb "Inventory Table" datastore

  api -> handler
  handler -> db
}

system notifications "Notification Service" {
  description: "Notifies customers of order updates"
  domain: "notifications"

  queue = aws/sqs "Notify Queue"
  worker = aws/lambda "Notify Worker"
  log = aws/dynamodb "Notification Log" datastore

  queue ~> worker
  worker -> log
}

customer -> orders.api "places order"
orders.events ~> inventory.handler "order placed"
orders.events ~> notifications.queue "order placed"

view landscape {
  title "Order Platform"
  include *
}
