// Order Platform - high-level view for new engineers
pack aws

person customer "Customer"

system orders "Orders Service" {
  description: "Order processing and lifecycle"
  glyph: sys/code

  api = aws/api-gateway "API Gateway"
  create = aws/lambda "Create Handler"
  get = aws/lambda "Get Handler"
  update = aws/lambda "Update Handler"
  db = aws/dynamodb "Orders Table" datastore
  stream = aws/kinesis "Event Stream"

  api -> create
  api -> get
  api -> update
  create -> db
  get -> db
  update -> db
  db ~> stream "order events"
}

system inventory "Inventory Service" {
  description: "Stock tracking"
  glyph: sys/database

  api = aws/api-gateway "API Gateway"
  sync = aws/lambda "Stock Sync"
  reserve = aws/lambda "Reserve Handler"
  db = aws/dynamodb "Inventory Table" datastore

  api -> reserve
  api -> sync
  reserve -> db
  sync -> db
}

system notifications "Notifications Service" {
  description: "Customer notifications"
  glyph: sys/workflow

  processor = aws/lambda "Event Processor"
  email = aws/sns "Email Topic"
  sms = aws/sns "SMS Topic"

  processor -> email
  processor -> sms
}

customer -> orders.api "place order"
orders.stream ~> inventory.api "stock updates"
orders.stream ~> notifications.processor "order events"
notifications.email ~> customer "order confirmation"
notifications.sms ~> customer "status updates"

view landscape {
  title "Order Platform Overview"
  include *
}

view orders {
  title "Orders Service - Internal Structure"
}
