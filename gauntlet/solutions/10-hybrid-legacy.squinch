pack aws

person admin "Administrators"

erp    = sys/server "Legacy ERP" external {
  subtitle: "On-premises"
}
worker = aws/lambda "Sync Worker"
db     = aws/rds "Admin Database" datastore
dash   = sys/app-window "Admin Dashboard" {
  subtitle: "Web app"
}

erp ~> worker "sync"
worker -> db "writes"
dash -> db "reads"
admin -> dash "use"

view landscape {
  title "ERP Sync and Admin Dashboard"
  include *
}
