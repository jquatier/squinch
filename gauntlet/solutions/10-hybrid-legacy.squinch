pack aws

person admins "Administrators"

erp    = sys/server     "Legacy ERP" external { subtitle: "On-premises" }
sync   = aws/lambda     "Sync Worker"
db     = aws/rds        "Database" datastore
dash   = sys/app-window "Admin Dashboard" { subtitle: "Web app" }

erp ~> sync "changes"
sync -> db "writes"
dash -> db "reads"
admins -> dash "use"

view landscape {
  title "Legacy ERP to Admin Dashboard"
  include *
}
