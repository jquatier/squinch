// Hybrid legacy ERP to cloud migration
pack aws

person admin "Administrator"

erp = sys/server "Legacy ERP" external {
  subtitle: "On-premises"
}

sync_worker = aws/lambda "Sync Worker" {
  description: "Syncs ERP data to cloud"
}

db = aws/rds "Admin Database" datastore {
  subtitle: "RDS Postgres"
}

dashboard = sys/app-window "Admin Dashboard" {
  description: "Web application for administrators"
  subtitle: "Web App"
}

// connections
erp ~> sync_worker "data feed"
sync_worker -> db "writes"
dashboard -> db "reads"
admin -> dashboard "uses"
