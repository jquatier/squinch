pack aws

person admin "Administrator"

erp = sys/server "Legacy ERP" external {
  description: "On-premises system"
}

sync = aws/lambda "Sync Worker" {
  description: "Processes ERP data"
}

db = aws/rds "RDS Database" datastore

dashboard = sys/app-window "Admin Dashboard" {
  description: "Web application"
}

erp ~> sync "async feed"
sync -> db
dashboard -> db
admin -> dashboard "uses"
