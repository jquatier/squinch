pack aws

person admins "Administrators"

erp = sys/server "Legacy ERP" external {
  subtitle: "On-premises"
}
worker = aws/lambda "Sync Worker"
db = aws/rds "Database" datastore
dash = sys/app-window "Admin Dashboard"

zone onprem "On-premises" onprem { contains erp }
zone cloud "AWS" cloud { contains worker, db }

erp ~> worker "sync"
worker -> db "writes"
dash -> db "reads"
admins -> dash "use"

view landscape {
  title "Hybrid ERP Sync"
  include *
}
