pack aws

person admin "Administrators"

erp    = box "Legacy ERP" external { subtitle: "On-premises" }
worker = aws/lambda "Sync Worker"
db     = aws/rds "RDS Database" datastore
dash   = sys/app-window "Admin Dashboard" { subtitle: "Web app" }

erp ~> worker "sync"
worker -> db "writes"
dash -> db "reads"
admin -> dash "use"

view landscape {
  title "Legacy ERP to Admin Dashboard"
  include *
}
