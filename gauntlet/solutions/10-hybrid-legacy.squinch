pack aws

person admin "Administrator"

erp      = sys/server      "Legacy ERP"      external { subtitle: "On-prem, no AWS icon" }
worker   = aws/lambda      "Sync Worker"
db       = aws/rds         "Orders DB"       datastore
dash     = aws/app-runner  "Admin Dashboard"

erp ~> worker "sync"
worker -> db "writes"
dash -> db "reads"
admin -> dash "manages"

zone dc    "Corporate Data Center" onprem { contains erp; icon: aws/corporate-data-center }
zone cloud "AWS Cloud"             cloud  { contains worker, db, dash }
