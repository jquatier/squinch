pack aws

person admins "Administrators"

erp = sys/server "Legacy ERP" external {
  description: "On-premises order management system"
  subtitle: "On-prem"
}

worker = aws/lambda "Sync Worker" {
  description: "Polls and syncs ERP records"
}

db = aws/rds "Orders DB" datastore

dashboard = aws/app-runner "Admin Dashboard" {
  description: "New web app for administering orders"
}

erp ~> worker "sync feed"
worker -> db "writes"
dashboard -> db "reads/writes"
admins -> dashboard "manages orders"

zone onprem_dc "On-Premises" onprem {
  contains erp
}

zone cloud_env "AWS Cloud" cloud {
  contains worker, db, dashboard
}

view landscape {
  title "Hybrid Legacy Integration"
  include *
}
