pack aws

person admins "Administrators"

erp       = sys/server     "Legacy ERP" external { subtitle: "On-premises" }
worker    = aws/lambda     "Sync Worker"
db        = aws/rds        "RDS Database" datastore
dashboard = sys/app-window "Admin Dashboard" { subtitle: "Web app" }

erp ~> worker "sync"
worker -> db "writes"
dashboard -> db "reads"
admins -> dashboard "use"

view landscape {
  title "Legacy ERP Sync"
  include *
}
