pack aws

// Legacy on-prem system
erp = sys/server "ERP System" external {
  description: "Legacy on-premises system"
}

// AWS components
sync_worker = aws/lambda "Sync Worker" {
  description: "Synchronizes data from legacy ERP"
}

db = aws/rds "Admin Database" datastore

dashboard = sys/app-window "Admin Dashboard" {
  description: "Web application for administrators"
}

// Administrators
person admin "Administrator"

// Connections
erp ~> sync_worker "data sync"
sync_worker -> db
db -> dashboard
admin -> dashboard "manages"
