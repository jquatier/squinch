pack aws

// Legacy on-premises system
erp = sys/server "Legacy ERP" external {
  description: "On-premises ERP system"
}

// AWS components
worker = aws/lambda "Sync Worker" {
  description: "Processes ERP data"
}

db = aws/rds "Admin Database" datastore

dashboard = sys/app-window "Admin Dashboard" {
  description: "Web application"
}

// Human actor
person admin "Administrator"

// Connections
erp ~> worker "data feed"
worker -> db
dashboard -> db
admin -> dashboard "uses"
