pack aws

person admins "Administrators"

erp       = sys/server     "Legacy ERP" external { subtitle: "On-premises" }
worker    = aws/lambda     "Sync Worker"
db        = aws/rds        "Admin Database" datastore
dashboard = sys/app-window "Admin Dashboard"

zone onprem "On-premises" onprem { contains erp }
zone cloud  "AWS" cloud { contains worker, db }

erp ~> worker "ERP changes"
worker -> db "writes"
dashboard -> db "reads"
admins -> dashboard "use"

view landscape {
  title "Hybrid ERP Sync"
  include *
}
