pack aws

person admin "Administrator"

erp = sys/server "Legacy ERP" external {
  description: "On-premises enterprise resource planning"
}

worker = aws/lambda "Sync Worker" {
  description: "Syncs data from ERP to RDS"
}

db = aws/rds "Admin Database" datastore {
  description: "Stores synced ERP data"
}

dashboard = sys/app-window "Admin Dashboard" {
  description: "Web application for administrators"
  subtitle: "Web App"
}

erp ~> worker "data feed"
worker -> db "writes"
dashboard -> db "queries"
admin -> dashboard "uses"
