// Hybrid legacy system with on-prem ERP feeding cloud infrastructure
pack aws

// Human actors
person admin "Administrator"

// On-premises legacy system
erp = sys/server "Legacy ERP" external {
  description: "On-premises ERP system"
}

// Cloud components
worker = aws/lambda "Sync Worker" {
  description: "Synchronizes ERP data"
}

db = aws/rds "Database" datastore

dashboard = sys/app-window "Admin Dashboard" {
  description: "Web application"
}

// Connections
erp ~> worker "async feed"
worker -> db "writes"
dashboard -> db "reads"
admin -> dashboard "uses"

// Deployment zones
zone onprem "On-Premises" onprem {
  contains erp
}

zone cloud "AWS Cloud" cloud {
  contains worker, db, dashboard
}
