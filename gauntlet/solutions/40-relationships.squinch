pack aws
pack logos

system booking "Clinic Booking" {
  api = aws/ecs "Booking API"
  container db "Postgres" {
    icon: logos/postgres
    patients     = sys/table "patients" datastore
    doctors      = sys/table "doctors" datastore
    appointments = sys/table "appointments" datastore
    clinics      = sys/table "clinics" datastore
    specialties  = sys/table "specialties" datastore

    appointments -> patients    "patient_id" { from: zero-or-many to: exactly-one }
    appointments -> doctors     "doctor_id"  { from: many         to: exactly-one }
    appointments -> clinics     "clinic_id"  { from: many         to: zero-or-one }
    doctors      -> clinics     "clinic_id"  { from: many         to: one }
    doctors      -- specialties              { from: many         to: many }
  }
  api -> db.appointments "reads, writes"
}

view landscape {
  title "Clinic Booking"
  include *
}

view db {
  title "Database tables"
  scope booking.db
}
