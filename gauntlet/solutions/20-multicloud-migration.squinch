// Multicloud migration: on-premises to Azure
pack azure
pack logos

// On-premises infrastructure
onprem_db = logos/postgres "PostgreSQL" datastore
onprem_mq = logos/rabbitmq "RabbitMQ"

// Azure infrastructure
azure_cluster = azure/aks "AKS Cluster"
azure_db = azure/sql "Azure SQL" datastore
sync_job = azure/functions "Sync Job"

// Data migration flow
onprem_db ~> sync_job "reads nightly"
sync_job ~> azure_db "writes"

// Deployment boundaries
zone onprem "On-Premises" onprem {
  contains onprem_db, onprem_mq
}

zone cloud "Azure" cloud {
  contains azure_cluster, azure_db, sync_job
}

view migration {
  title "Multi-Cloud Migration"
  include *

  layout {
    direction right
  }
}
