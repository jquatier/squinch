// Multi-cloud migration architecture
pack logos
pack azure

// On-premises infrastructure
pg = logos/postgres "PostgreSQL" datastore
mq = logos/rabbitmq "RabbitMQ"

// Azure infrastructure
aks = azure/aks "AKS Cluster"
sql = azure/sql "Azure SQL" datastore

// Sync job
sync = sys/workflow "Sync Job"

// Data migration flow (nightly async)
sync ~> pg "reads"
sync ~> sql "writes"

// Deployment boundaries
zone onprem "On-Premises" onprem {
  contains pg, mq
}

zone cloud "Azure" cloud {
  contains aks, sql, sync
}
