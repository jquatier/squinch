pack azure
pack logos

// On-premises systems
postgres = logos/postgres "PostgreSQL" datastore {
  subtitle: "Legacy database"
}
rabbitmq = logos/rabbitmq "RabbitMQ" {
  subtitle: "Message broker"
}

// Azure systems
aks = azure/aks "AKS Cluster" {
  subtitle: "New services"
}
azuresql = azure/sql "Azure SQL" datastore {
  subtitle: "Target database"
}

// Sync job
sync = box "Sync Job" {
  subtitle: "Nightly batch"
}

// Connections
postgres ~> sync "nightly sync"
sync ~> azuresql "writes"
aks -> azuresql

// Deployment boundaries
zone onprem "On-Premises" onprem {
  contains postgres, rabbitmq
}

zone cloud "Azure" cloud {
  contains aks, azuresql, sync
}

view migration {
  title "Multi-Cloud Migration"
  include *
}
