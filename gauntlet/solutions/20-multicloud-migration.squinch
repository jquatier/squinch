// Multi-cloud migration: on-premises to Azure
pack azure
pack logos

// On-premises infrastructure
postgres = logos/postgres "PostgreSQL Database" datastore
rabbit   = logos/rabbitmq "RabbitMQ Broker"

// Azure infrastructure
aks    = azure/aks "AKS Cluster"
azuresql = azure/sql "Azure SQL Database" datastore

// Migration sync job
sync = sys/workflow "Nightly Sync Job"

// Connections
postgres ~> sync "copies data"
sync ~> azuresql "loads"

// Deployment zones
zone onprem "On-Premises" onprem {
  contains postgres, rabbit
}

zone cloud "Azure" cloud {
  contains aks, azuresql
}

view landscape {
  title "Migration Architecture"
}
