pack azure
pack logos
pack k8s

pg = logos/postgres "PostgreSQL" datastore
mq = logos/rabbitmq "RabbitMQ"

system aks "AKS Cluster" {
  icon: azure/aks
  svc = k8s/deploy "New Services"
}

sql = azure/sql "Azure SQL" datastore

pg ~> sql "nightly sync" { animate: slow }

zone onprem_dc "On-Premises" onprem {
  contains pg, mq
}

zone azure_cloud "Azure" cloud {
  contains aks, sql
}

view landscape {
  title "Multi-Cloud Migration"
  include *
  legend auto
}
