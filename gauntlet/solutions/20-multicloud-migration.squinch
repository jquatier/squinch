// Multi-cloud migration: On-premises to Azure
pack azure
pack logos

// On-premises infrastructure
old_db = logos/postgres "PostgreSQL" datastore
broker = logos/rabbitmq "RabbitMQ"

// Azure infrastructure
aks = azure/aks "AKS Cluster"
new_db = azure/sql "Azure SQL" datastore

// Migration sync
sync_job = azure/functions "Sync Job"

// Connections
sync_job ~> new_db "nightly sync"
old_db ~> sync_job

// Deployment boundaries
zone onprem "On-Premises" onprem {
  contains old_db, broker
}

zone cloud "Azure" cloud {
  contains aks, new_db, sync_job
}
