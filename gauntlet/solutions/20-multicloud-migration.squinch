pack azure
pack logos

// On-premises infrastructure
pg = logos/postgres "PostgreSQL" datastore {
  description: "Legacy database"
}
rmq = logos/rabbitmq "RabbitMQ" {
  description: "Message broker"
}

// Azure infrastructure
aks = azure/aks "AKS Cluster" {
  description: "New services"
}
azuresql = azure/sql "Azure SQL" datastore {
  description: "Target database"
}

// Sync process
sync = azure/functions "Sync Job" {
  description: "Nightly migration"
}

// Connections
pg ~> sync "nightly sync"
sync ~> azuresql "writes"

// Deployment boundaries
zone onprem "On-Premises" onprem {
  contains pg, rmq
}

zone cloud "Azure" cloud {
  contains aks, azuresql, sync
}
