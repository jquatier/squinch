pack logos
pack azure

// On-premises components
pg_db = logos/postgres "PostgreSQL Database" datastore
rabbitmq = logos/rabbitmq "RabbitMQ Broker"

// Azure components
aks = azure/aks "AKS Cluster"
azure_sql = azure/sql "Azure SQL Database" datastore

// Sync job
sync_job = box "Nightly Sync Job"

// Connections
sync_job ~> azure_sql "async copy"
pg_db ~> sync_job

// Deployment boundaries
zone onprem "On-Premises" onprem {
  contains pg_db, rabbitmq
}

zone azure_cloud "Azure" cloud {
  contains aks, azure_sql
}
