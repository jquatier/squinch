pack azure
pack logos

// On-premises infrastructure
pg = logos/postgres "PostgreSQL" datastore {
  subtitle: "On-prem database"
}
rabbit = logos/rabbitmq "RabbitMQ" {
  subtitle: "Message broker"
}

// Azure infrastructure
aks = azure/aks "AKS Cluster" {
  description: "New services"
}
sql = azure/sql "Azure SQL" datastore {
  subtitle: "Target database"
}

// Sync job
sync = azure/functions "Sync Job" {
  description: "Nightly migration job"
}

// Connections
pg ~> sync "nightly copy"
sync ~> sql "writes"
rabbit -> aks "legacy messages"

// Deployment boundaries
zone onprem "On-Premises" onprem {
  contains pg, rabbit
}

zone cloud "Azure" cloud {
  contains aks, sql, sync
}
