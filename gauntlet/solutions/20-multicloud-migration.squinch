pack azure
pack logos

pg   = logos/postgres "PostgreSQL" datastore { subtitle: "Legacy database" }
rmq  = logos/rabbitmq "RabbitMQ" { subtitle: "Message broker" }
sync = sys/repeat "Sync Job" { subtitle: "Nightly copy" }
aks  = azure/aks "AKS Cluster" { subtitle: "New services" }
sql  = azure/sql "Azure SQL" datastore { subtitle: "Target database" }

pg   ~> sync "reads"
sync ~> sql  "nightly copy"

zone onprem "On-premises" onprem {
  contains pg, rmq
}
zone azure "Azure" cloud {
  contains aks, sql
}

view landscape {
  title "Multicloud Migration"
  include *
  legend auto
}
