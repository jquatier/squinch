pack azure

pg   = logos/postgres  "PostgreSQL" datastore
mq   = logos/rabbitmq  "RabbitMQ"

aks  = azure/aks       "AKS Cluster" {
  subtitle: "New services"
}
sql  = azure/sql       "Azure SQL" datastore

sync = sys/repeat      "Nightly Sync Job"

pg  ~> sync "nightly export" { animate: slow }
sync ~> sql "load"            { animate: slow }
aks  -> sql "queries"

zone onprem "On-Premises" onprem {
  contains pg, mq
}

zone azure_cloud "Azure" cloud {
  contains aks, sql
}

view landscape {
  title "Multi-Cloud Migration"
  include *
  layout {
    rows [pg mq] [sync] [aks sql]
  }
  legend auto
}
