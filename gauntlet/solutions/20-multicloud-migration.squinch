pack azure
pack logos

view landscape {
  title "Multicloud Migration"
  include *
  layout { rows [pg rabbit] [sync] [sql aks] }
}

pg     = logos/postgres "PostgreSQL" datastore { subtitle: "On-prem" }
rabbit = logos/rabbitmq "RabbitMQ" { subtitle: "On-prem broker" }
sync   = sys/repeat "Sync Job" { subtitle: "Nightly" }
sql    = azure/sql "Azure SQL" datastore { subtitle: "Migration target" }
aks    = azure/aks "AKS Cluster" { subtitle: "New services" }

pg ~> sync "reads"
sync ~> sql "nightly copy"

zone onprem "On-Premises" onprem { contains pg, rabbit }
zone azure "Azure" cloud { contains sql, aks }
