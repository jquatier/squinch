pack azure
pack logos

// On-premises infrastructure
pg_db = logos/postgres "PostgreSQL" datastore
rabbit = logos/rabbitmq "RabbitMQ"

// Azure infrastructure
aks = azure/aks "AKS Cluster"
azure_sql = azure/sql "Azure SQL" datastore
sync = box "Sync Job"

// Migration flow
pg_db ~> sync "nightly copy"
sync ~> azure_sql

// Deployment zones
zone onprem "On-Premises" onprem {
  contains pg_db, rabbit
}

zone cloud "Azure" cloud {
  contains aks, azure_sql, sync
}

view default {
  title "Multi-Cloud Migration"
  include *
}
