pack azure
pack logos

// On-premises infrastructure
pg_old = logos/postgres "Legacy Database" datastore
rabbit = logos/rabbitmq "Message Broker"

// Azure infrastructure
aks = azure/aks "AKS Cluster"
sql_new = azure/sql "Azure SQL" datastore
sync = azure/functions "Sync Job"

// Connections
sync -> pg_old "reads nightly"
sync ~> sql_new "async copy"
rabbit -> aks "messages"

// Deployment boundaries
zone onprem "On-Premises" onprem {
  contains pg_old, rabbit
}

zone azure_cloud "Azure" cloud {
  contains aks, sql_new, sync
}

view migration {
  title "Multi-Cloud Migration"
}
