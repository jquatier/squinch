// Multi-cloud migration: On-premises to Azure
pack azure
pack logos

// On-premises infrastructure
old_db = logos/postgres "Legacy Database" datastore
broker = logos/rabbitmq "Message Broker"

// Azure infrastructure
aks = azure/aks "AKS Cluster"
new_db = azure/sql "Azure SQL" datastore

// Sync job
sync = azure/functions "Nightly Sync"

// Connections
sync ~> new_db "copies data"
old_db ~> sync "reads"

// Deployment boundaries
zone onprem "On-Premises Data Center" onprem {
  contains old_db, broker
}

zone azure_cloud "Azure Cloud" cloud {
  contains aks, new_db, sync
}

view migration {
  title "On-Premises to Azure Migration"
}
