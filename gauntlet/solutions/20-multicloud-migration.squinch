// Multicloud migration diagram: on-premises to Azure
pack azure
pack logos

// On-premises infrastructure
pg_db = logos/postgres "PostgreSQL" datastore
mq = logos/rabbitmq "RabbitMQ"

// Azure infrastructure
aks = azure/aks "AKS Cluster"
azure_sql = azure/sql "Azure SQL" datastore

// Sync job
sync = sys/workflow "Nightly Sync"

// Connections
pg_db ~> sync "nightly copy"
sync ~> azure_sql

// Deployment boundaries
zone onprem "On-Premises" onprem {
  contains pg_db, mq
}

zone azure_cloud "Azure" cloud {
  contains aks, azure_sql
}
