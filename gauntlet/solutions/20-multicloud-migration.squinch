// Multi-cloud migration: On-premises to Azure
pack azure
pack logos

// On-premises infrastructure
postgres = logos/postgres "PostgreSQL" datastore {
  description: "Legacy database"
}
rabbitmq = logos/rabbitmq "RabbitMQ" {
  description: "Message broker"
}

// Azure infrastructure
aks = azure/aks "AKS Cluster" {
  description: "New services"
}
sql = azure/sql "Azure SQL" datastore {
  description: "Target database"
}

// Sync job
sync = sys/workflow "Sync Job" {
  description: "Nightly data copy"
}

// Edges
postgres ~> sync "nightly"
sync ~> sql "copy"

// Deployment boundaries
zone onprem "On-Premises" onprem {
  contains postgres, rabbitmq
}

zone cloud "Azure" cloud {
  contains aks, sql
}
