pack azure
pack logos

// On-premises infrastructure
pg_onprem   = logos/postgres  "PostgreSQL Database" datastore
rmq_onprem  = logos/rabbitmq  "RabbitMQ Broker"

// Azure infrastructure
aks         = azure/aks       "AKS Cluster"
sql_azure   = azure/sql       "Azure SQL Database" datastore

// Sync job
sync_job    = box             "Nightly Sync Job"

// Connections
sync_job ~> sql_azure "copies data"
sync_job -> pg_onprem "reads from"

// Deployment boundaries
zone onprem "On-Premises" onprem {
  contains pg_onprem, rmq_onprem
}

zone cloud "Azure" cloud {
  contains aks, sql_azure, sync_job
}

view landscape {
  title "Multi-Cloud Migration"
  include *
  layout {
    rows [onprem cloud]
  }
}
