// Multicloud migration: on-premises to Azure
pack azure
pack logos

// On-premises systems
postgres = logos/postgres "PostgreSQL" datastore
rabbit   = logos/rabbitmq "RabbitMQ"

// Azure systems
aks      = azure/aks "AKS Cluster"
azuresql = azure/sql "Azure SQL" datastore

// Sync job
sync     = box "Sync Job"

// Migration flow
sync ~> postgres "reads nightly"
sync ~> azuresql "writes"

// Zones for boundaries
zone onprem "On-Premises" onprem {
  contains postgres, rabbit
}

zone cloud "Azure" cloud {
  contains aks, azuresql, sync
}
