pack azure
pack logos

// On-premises systems
pg_db = logos/postgres "PostgreSQL" datastore
rabbit = logos/rabbitmq "RabbitMQ"

// Azure systems
aks = azure/aks "AKS Cluster"
sql_db = azure/sql "Azure SQL" datastore

// Sync job
sync_job = sys/workflow "Nightly Sync"

// Connections
pg_db ~> sync_job "sync"
sync_job ~> sql_db

// Deployment boundaries
zone onprem "On-Premises" onprem {
  contains pg_db, rabbit
}

zone cloud "Azure" cloud {
  contains aks, sql_db, sync_job
}
