// Multicloud migration architecture
pack azure

// On-premises components
pg = logos/postgres "PostgreSQL" datastore
rabbit = logos/rabbitmq "RabbitMQ"

// Azure components
aks = azure/aks "AKS Cluster"
sql = azure/sql "Azure SQL" datastore

// Sync job - using box as it's a custom migration component
sync = box "Sync Job"

// Async nightly sync from on-prem to Azure
pg ~> sync "nightly"
sync ~> sql

// Deployment boundaries
zone onprem "On-Premises" onprem {
  contains pg, rabbit
}

zone cloud "Azure" cloud {
  contains aks, sql, sync
}
