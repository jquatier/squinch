pack logos
pack azure

// On-premises infrastructure
pg_db = logos/postgres "Legacy Database" datastore
mq    = logos/rabbitmq "Message Broker"
sync  = sys/workflow "Nightly Sync Job"

// Azure infrastructure
aks     = azure/aks "AKS Cluster"
azure_sql = azure/sql "Azure SQL" datastore

// Async nightly sync from on-prem to Azure
sync -> pg_db
sync ~> azure_sql "copy data"

// Deployment boundaries
zone onprem "On-Premises Data Center" onprem {
  contains pg_db, mq, sync
}

zone cloud "Azure" cloud {
  contains aks, azure_sql
}

view migration {
  title "Multi-Cloud Migration"
  include *
}
