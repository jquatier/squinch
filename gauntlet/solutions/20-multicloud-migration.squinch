pack azure
pack logos

// On-premises infrastructure
pg_old   = logos/postgres "Legacy PostgreSQL" datastore
rabbit   = logos/rabbitmq "RabbitMQ" datastore

// Azure infrastructure
aks      = azure/aks "AKS Cluster"
sql_new  = azure/sql "Azure SQL" datastore
sync_job = azure/functions "Nightly Sync Job"

// Async migration flow
pg_old ~> sync_job "nightly copy"
sync_job ~> sql_new "write"

// Deployment boundaries
zone onprem_dc "On-Premises" onprem {
  contains pg_old, rabbit
}

zone azure_cloud "Azure" cloud {
  contains aks, sql_new, sync_job
}
