// Warehouse automation system - physical infrastructure

// Actors
supervisor = person "Shift Supervisor"

// Packing bench scanners
bench1 = sys/scan "Bench 1 Scanner"
bench2 = sys/scan "Bench 2 Scanner"
bench3 = sys/scan "Bench 3 Scanner"

// Local controller
controller = sys/server "Packing Controller" {
  description: "Local automation controller"
}

// Output devices
sorter = sys/route "Conveyor Sorter" {
  description: "Automated package sorter"
}
printer = sys/printer "Label Printer"

// Monitoring
board = sys/monitor "Status Board"

// External system
erp = sys/database "ERP System" external {
  description: "Enterprise resource planning"
}

// Barcode scanners feed the controller
bench1 -> controller "scans"
bench2 -> controller "scans"
bench3 -> controller "scans"

// Controller drives automation
controller -> sorter "routes packages"
controller -> printer "prints labels"

// Controller syncs to ERP periodically
controller ~> erp "sync batch"

// Supervisor monitors the system
controller -> board "status updates"
board -> supervisor "displays status"

// Network boundary
zone site "Site Network" network {
  contains controller, erp
}

view landscape {
  title "Warehouse Automation"
  layout {
    rows [bench1 bench2 bench3] [site] [sorter printer board]
    place supervisor right-of board
  }
}
