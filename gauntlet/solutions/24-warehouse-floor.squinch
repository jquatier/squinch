// Warehouse floor automation system

person supervisor "Shift Supervisor"

system floor "Warehouse Floor" {
  description: "Packing automation and control"

  // Packing benches with barcode scanners
  bench1 = sys/monitor "Packing Bench 1" {
    subtitle: "Barcode scanner"
  }
  bench2 = sys/monitor "Packing Bench 2" {
    subtitle: "Barcode scanner"
  }
  bench3 = sys/monitor "Packing Bench 3" {
    subtitle: "Barcode scanner"
  }

  // Local controller
  controller = sys/server "Floor Controller" {
    description: "Orchestrates packing and sorting"
    subtitle: "On-premise"
  }

  // Output devices
  sorter = sys/route "Conveyor Sorter" {
    description: "Routes packages by destination"
  }
  printer = sys/printer "Label Printer"

  // Status monitoring
  board = sys/monitor "Status Board" {
    description: "Real-time floor status display"
  }

  // Barcode scanners feed the controller
  bench1 -> controller "scan events"
  bench2 -> controller "scan events"
  bench3 -> controller "scan events"

  // Controller drives automation
  controller -> sorter "routing commands"
  controller -> printer "print jobs"

  // Supervisor watches status
  controller -> board "status updates"

  layout {
    rows [bench1 bench2 bench3] [controller] [sorter printer board]
  }
}

// External ERP system
erp = box "ERP System" external {
  description: "Enterprise resource planning"
  subtitle: "Site network"
}

// Controller syncs to ERP
floor.controller ~> erp "sync batch (every minute)"

// Supervisor watches the board
supervisor -> floor.board "monitors"

zone site_network "Site Network" network {
  contains floor, erp
}

view warehouse {
  title "Warehouse Floor Automation"
  expand floor
  titleblock {
    subtitle: "Physical automation system"
  }
}
