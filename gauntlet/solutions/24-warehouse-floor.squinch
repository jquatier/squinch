person supervisor "Shift Supervisor"

scan1 = sys/barcode "Barcode Scanner" { subtitle: "Packing bench 1" }
scan2 = sys/barcode "Barcode Scanner" { subtitle: "Packing bench 2" }
scan3 = sys/barcode "Barcode Scanner" { subtitle: "Packing bench 3" }
ctrl = sys/cpu "Local Controller"
sorter = sys/package-check "Conveyor Sorter"
printer = sys/printer "Label Printer"
erp = sys/server "ERP" external
board = sys/monitor "Status Board"

scan1 ~> ctrl "scans"
scan2 ~> ctrl "scans"
scan3 ~> ctrl "scans"
ctrl -> sorter "drives"
ctrl -> printer "drives"
ctrl -> erp "syncs once a minute, site network"
supervisor -> board "watches"

view landscape {
  title "Warehouse Floor"
  include *
}
