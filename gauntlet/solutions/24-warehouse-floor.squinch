bench1 = sys/scan   "Bench 1 Scanner"
bench2 = sys/scan   "Bench 2 Scanner"
bench3 = sys/scan   "Bench 3 Scanner"
controller = sys/server-cog "Line Controller"
sorter  = sys/route   "Conveyor Sorter"
printer = sys/printer "Label Printer"
board   = sys/screen  "Status Board"
erp     = sys/server  "ERP System" external
supervisor = person "Shift Supervisor"

bench1 ~> controller "scan"
bench2 ~> controller "scan"
bench3 ~> controller "scan"
controller -> sorter, printer "drives"
controller ~> board "status feed"
controller ~> erp "sync" { animate: slow }
supervisor -> board "watches"

zone site_net "Site Network" network {
  contains controller, erp
}

view landscape {
  title "Warehouse Floor Automation"
  include *
  layout {
    rows [bench1 bench2 bench3] [site_net] [sorter printer board]
    channel bench1, bench2, bench3 -> controller
  }
}
