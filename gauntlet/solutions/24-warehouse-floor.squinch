// Warehouse floor automation system

person supervisor "Shift Supervisor"

system floor "Warehouse Floor" {
  description: "Physical automation and control"
  glyph: sys/warehouse

  bench1  = sys/smartphone "Bench 1 Scanner"
  bench2  = sys/smartphone "Bench 2 Scanner"
  bench3  = sys/smartphone "Bench 3 Scanner"

  ctrl    = sys/server     "Floor Controller" {
    description: "Local automation controller"
  }

  sorter  = sys/workflow   "Conveyor Sorter" {
    description: "Automated sorting system"
  }
  printer = sys/printer    "Label Printer"
  board   = sys/monitor    "Status Board"

  bench1  -> ctrl "scan"
  bench2  -> ctrl "scan"
  bench3  -> ctrl "scan"

  ctrl    -> sorter "route"
  ctrl    -> printer "print label"
  ctrl    -> board "status updates"
}

erp = box "ERP System" external

floor.ctrl ~> erp "sync" {
  description: "Once per minute"
}

supervisor -> floor.board "monitors"

zone site "Site Network" network {
  contains floor.ctrl, erp
}

view landscape {
  title "Warehouse Automation"
  layout {
    rows [floor.bench1 floor.bench2 floor.bench3] [floor.ctrl] [floor.sorter floor.printer floor.board] [erp]
  }
}
