// Warehouse automation system - local physical setup

supervisor = person "Shift Supervisor"
board = sys/monitor "Status Board"

system warehouse_floor "Warehouse Floor Automation" {
  description: "Local packing and sorting control"
  glyph: sys/warehouse

  bench1 = sys/scan "Packing Bench 1"
  bench2 = sys/scan "Packing Bench 2"
  bench3 = sys/scan "Packing Bench 3"

  controller = sys/cpu "Local Controller" {
    description: "Orchestrates packing operations"
  }

  sorter = sys/route "Conveyor Sorter"
  printer = sys/printer "Label Printer"
}

erp = sys/server "ERP System" external {
  description: "Enterprise resource planning"
}

// Scanning workflow
warehouse_floor.bench1 -> warehouse_floor.controller "scan event"
warehouse_floor.bench2 -> warehouse_floor.controller "scan event"
warehouse_floor.bench3 -> warehouse_floor.controller "scan event"

// Controller drives automation
warehouse_floor.controller -> warehouse_floor.sorter "routing commands"
warehouse_floor.controller -> warehouse_floor.printer "print job"

// Periodic sync to ERP
warehouse_floor.controller ~> erp "batch sync (1min)" {
  animate: pulse
}

// Supervisor monitoring
supervisor -> board "monitors"
warehouse_floor.controller -> board "status updates" {
  animate: pulse
}

zone site_network "Site Network" network {
  contains warehouse_floor.controller, erp
}

view landscape {
  title "Warehouse Automation System"
  include *
  show descriptions
  legend auto
  layout {
    direction down
    density comfortable
    rows [supervisor board] [warehouse_floor.bench1 warehouse_floor.bench2 warehouse_floor.bench3] [warehouse_floor.controller] [warehouse_floor.sorter warehouse_floor.printer erp]
  }
}
