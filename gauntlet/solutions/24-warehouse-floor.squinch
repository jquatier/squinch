// Warehouse floor automation system - physical automation stack

person supervisor "Shift Supervisor"

// Packing benches with barcode scanners
scanner1 = sys/barcode "Scanner 1" { subtitle: "Packing Bench A" }
scanner2 = sys/barcode "Scanner 2" { subtitle: "Packing Bench B" }
scanner3 = sys/barcode "Scanner 3" { subtitle: "Packing Bench C" }

// Local controller
controller = sys/server "Floor Controller" {
  subtitle: "Automation logic"
  description: "Routes packages and manages devices"
}

// Warehouse equipment
sorter = sys/workflow "Conveyor Sorter" {
  subtitle: "Automated routing"
}
printer = sys/printer "Label Printer"
board = sys/monitor "Status Board"

// External ERP
erp = box "ERP System" external {
  description: "Enterprise resource planning"
}

// Data flow
scanner1 -> controller "scan events"
scanner2 -> controller "scan events"
scanner3 -> controller "scan events"

controller -> sorter "routing commands"
controller -> printer "print jobs"
controller ~> erp "inventory sync · every 1 min"

controller -> board "status updates"
supervisor -> board "monitors"

view floor {
  title "Warehouse Floor Automation"
  layout {
    rows [scanner1 scanner2 scanner3] [controller] [sorter printer board] [erp]
  }
  titleblock {
    subtitle: "Physical automation"
  }
}
