// Warehouse automation system
pack sys

person supervisor "Shift Supervisor"

system warehouse "Warehouse Floor" {
  description: "Automated packing and sorting"

  bench1 = sys/barcode "Packing Bench 1"
  bench2 = sys/barcode "Packing Bench 2"
  bench3 = sys/barcode "Packing Bench 3"

  controller = sys/server "Local Controller" {
    subtitle: "PLC · site network"
    description: "Coordinates packing stations and sorting"
  }

  sorter = sys/workflow "Conveyor Sorter" {
    description: "Automated package routing"
  }

  printer = sys/printer "Label Printer"

  board = sys/monitor "Status Board" {
    description: "Real-time operations display"
  }

  bench1 -> controller "scan events"
  bench2 -> controller "scan events"
  bench3 -> controller "scan events"

  controller -> sorter "routing commands"
  controller -> printer "print jobs"
  controller -> board "status updates"
}

erp = sys/database "ERP System" {
  subtitle: "on-premises"
  description: "Enterprise resource planning"
}

warehouse.controller ~> erp "sync batch"

supervisor -> warehouse.board "monitors"

view floor {
  title "Warehouse Floor Automation"
  scope warehouse
  layout {
    rows [bench1 bench2 bench3] [controller] [sorter printer board]
  }
}

view overview {
  title "Warehouse System Overview"
  include *
  layout {
    rows [supervisor] [warehouse] [erp]
  }
}
