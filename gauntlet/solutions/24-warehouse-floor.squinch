person supervisor "Shift Supervisor"

scan1 = sys/barcode "Bench 1 Scanner"
scan2 = sys/barcode "Bench 2 Scanner"
scan3 = sys/barcode "Bench 3 Scanner"
ctrl = sys/cpu "Local Controller"
sorter = sys/workflow "Conveyor Sorter"
printer = sys/printer "Label Printer"
erp = sys/server "ERP" external
board = sys/monitor "Status Board"

scan1 -> ctrl "scans"
scan2 -> ctrl "scans"
scan3 -> ctrl "scans"
ctrl -> sorter "drives"
ctrl -> printer "drives"
ctrl ~> erp "sync, every minute"
supervisor -> board "watches"

view landscape {
  title "Warehouse Automation"
  include *
  layout { rows [scan1 scan2 scan3] [ctrl] [sorter printer erp supervisor] [board] }
}
