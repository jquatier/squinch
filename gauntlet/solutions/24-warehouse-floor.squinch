// Warehouse automation system - physical deployment
pack logos

supervisor = person "Shift Supervisor"

scanner1 = sys/smartphone "Scanner 1" { subtitle: "Bench A" }
scanner2 = sys/smartphone "Scanner 2" { subtitle: "Bench B" }
scanner3 = sys/smartphone "Scanner 3" { subtitle: "Bench C" }

controller = sys/server "Local Controller" { subtitle: "On-prem server" }

sorter   = sys/router    "Conveyor Sorter"
printer  = sys/printer   "Label Printer"
board    = sys/monitor   "Status Board"
erp      = box           "ERP" external { subtitle: "Corporate" }

scanner1 -> controller "scan data"
scanner2 -> controller "scan data"
scanner3 -> controller "scan data"

controller -> sorter   "sort commands"
controller -> printer  "print labels"
controller -> board    "status updates"
controller ~> erp      "sync batch · 1 min"

supervisor -> board    "monitors"

zone floor "Warehouse Floor" onprem {
  contains scanner1, scanner2, scanner3, controller, sorter, printer, board
  icon: sys/warehouse
}

view landscape {
  title "Warehouse Automation"
  layout {
    rows [supervisor] [controller] [erp]
  }
}
