// Warehouse floor automation system - on-premises physical automation

person supervisor "Shift Supervisor"

system warehouse "Warehouse Floor" {
  description: "Packing and sorting automation"
  glyph: sys/warehouse

  scanner1 = sys/workflow "Scanner A" { description: "Packing bench 1" }
  scanner2 = sys/workflow "Scanner B" { description: "Packing bench 2" }
  scanner3 = sys/workflow "Scanner C" { description: "Packing bench 3" }

  controller = sys/cpu "Floor Controller" { description: "Local automation logic" }

  sorter  = sys/route "Conveyor Sorter"
  printer = sys/printer "Label Printer"
  board   = sys/monitor "Status Board"
}

erp = box "ERP System" external { description: "Corporate system" }

warehouse.scanner1 -> warehouse.controller "scan event"
warehouse.scanner2 -> warehouse.controller "scan event"
warehouse.scanner3 -> warehouse.controller "scan event"

warehouse.controller -> warehouse.sorter "routing command"
warehouse.controller -> warehouse.printer "print job"
warehouse.controller -> warehouse.board "status update"
warehouse.controller ~> erp "sync batch" { animate: slow }

supervisor -> warehouse.board "monitors"

view main {
  title "Warehouse Automation System"
  scope warehouse

  layout {
    direction down
    density comfortable
    rows [scanner1 scanner2 scanner3] [controller] [sorter printer board]
  }
}
