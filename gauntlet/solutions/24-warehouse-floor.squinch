supervisor = person "Shift Supervisor"

scanner1 = sys/scan "Bench 1 Scanner"
scanner2 = sys/scan "Bench 2 Scanner"
scanner3 = sys/scan "Bench 3 Scanner"

controller = sys/cpu "Line Controller" {
  description: "Local controller on the packing line"
}
sorter  = sys/route   "Conveyor Sorter"
printer = sys/printer "Label Printer"
board   = sys/monitor "Status Board"

erp = box "ERP" external

scanner1 -> controller
scanner2 -> controller
scanner3 -> controller

controller -> sorter
controller -> printer
controller -> board "status"

controller ~> erp "sync" { animate: slow }

supervisor -> board "watches"

view default {
  layout {
    rows [scanner1 scanner2 scanner3] [controller supervisor] [sorter printer erp board]
    align supervisor board
  }
}
