// Warehouse automation system
pack logos

person supervisor "Shift Supervisor"

// Packing benches with scanners
scanner1 = sys/smartphone "Scanner 1"
scanner2 = sys/smartphone "Scanner 2"
scanner3 = sys/smartphone "Scanner 3"

// Local controller
controller = sys/server "Local Controller" {
  description: "Automation controller"
}

// Physical automation equipment
sorter  = sys/workflow "Conveyor Sorter"
printer = sys/printer "Label Printer"

// Status display
board = sys/monitor "Status Board"

// External ERP system
erp = sys/database "ERP System" external {
  description: "Enterprise resource planning"
}

// Data flows from scanners to controller
scanner1 -> controller "scan data"
scanner2 -> controller "scan data"
scanner3 -> controller "scan data"

// Controller drives equipment
controller -> sorter "routing"
controller -> printer "print job"

// Supervisor monitors status
controller -> board "status updates"
supervisor -> board "monitors"

// Periodic sync to ERP (async - it happens in the background on a schedule)
controller ~> erp "sync (1/min)"

view warehouse {
  title "Warehouse Floor Automation"
  layout {
    rows [scanner1 scanner2 scanner3] [controller] [sorter printer board] [erp]
    place supervisor left-of board
  }
}
