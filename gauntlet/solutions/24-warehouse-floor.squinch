person supervisor "Shift Supervisor"

bench1 = sys/barcode "Bench 1 Scanner" { subtitle: "Packing bench" }
bench2 = sys/barcode "Bench 2 Scanner" { subtitle: "Packing bench" }
bench3 = sys/barcode "Bench 3 Scanner" { subtitle: "Packing bench" }
controller = sys/cpu "Local Controller"
sorter = sys/workflow "Conveyor Sorter"
printer = sys/printer "Label Printer"
erp = sys/database "ERP" external
board = sys/monitor "Status Board"

bench1 -> controller
bench2 -> controller
bench3 -> controller
controller -> sorter
controller -> printer
controller ~> erp "sync, once a minute" { tags: #site-network }
controller -> board
supervisor -> board "watches"

view landscape {
  title "Warehouse Floor"
  include *
}
