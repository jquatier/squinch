person supervisor "Shift Supervisor"

b1 = sys/barcode "Bench 1 Scanner" { subtitle: "Packing bench" }
b2 = sys/barcode "Bench 2 Scanner" { subtitle: "Packing bench" }
b3 = sys/barcode "Bench 3 Scanner" { subtitle: "Packing bench" }
ctrl = sys/cpu "Local Controller"
sorter = sys/workflow "Conveyor Sorter"
printer = sys/printer "Label Printer"
board = sys/monitor "Status Board"
erp = box "ERP" external

b1 -> ctrl
b2 -> ctrl
b3 -> ctrl
ctrl -> sorter
ctrl -> printer
ctrl -> board
ctrl ~> erp "syncs every minute · site network"
supervisor -> board "watches"

view landscape {
  title "Warehouse Floor"
  include *
}
