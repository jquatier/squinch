// Warehouse floor automation diagram

pack sys

// Human actors
supervisor = person "Shift Supervisor"

// Packing bench scanners
scanner1 = sys/smartphone "Scanner 1"
scanner2 = sys/smartphone "Scanner 2"
scanner3 = sys/smartphone "Scanner 3"

// Local controller
controller = sys/server "Local Controller" {
  description: "Aggregates scans, drives automation"
}

// Automation equipment
sorter  = sys/workflow "Conveyor Sorter"
printer = sys/printer  "Label Printer"

// Monitoring
board = sys/monitor "Status Board"

// Enterprise system
erp = sys/database "ERP System" external {
  description: "Syncs every minute"
}

// Connections
scanner1 -> controller "scan events"
scanner2 -> controller "scan events"
scanner3 -> controller "scan events"

controller -> sorter "sort commands"
controller -> printer "print jobs"

controller ~> erp "sync batch" {
  description: "Once per minute"
}

controller -> board "status updates"
supervisor -> board

// Layout
view default {
  title "Warehouse Floor Automation"
  layout {
    rows [scanner1 scanner2 scanner3] [controller] [sorter printer] [erp board supervisor]
  }
}
