// Warehouse automation system - on-premises physical infrastructure
pack logos

supervisor = person "Shift Supervisor"

system warehouse "Warehouse Floor" {
  description: "Physical automation on-site"
  glyph: sys/warehouse

  bench1 = sys/smartphone "Scanner Bench 1"
  bench2 = sys/smartphone "Scanner Bench 2"
  bench3 = sys/smartphone "Scanner Bench 3"

  controller = sys/server "Local Controller" {
    description: "Drives sorter and printer"
  }

  sorter = sys/workflow "Conveyor Sorter" {
    description: "Routes packages"
  }

  printer = sys/printer "Label Printer"

  board = sys/monitor "Status Board" {
    description: "Live floor status"
  }

  bench1 -> controller "scanned items"
  bench2 -> controller "scanned items"
  bench3 -> controller "scanned items"

  controller -> sorter "routing instructions"
  controller -> printer "print labels"
  controller -> board "status updates"
}

erp = box "ERP System" external {
  description: "Enterprise resource planning"
}

supervisor -> warehouse.board "monitors floor"
warehouse.controller ~> erp "sync once per minute"

view landscape {
  title "Warehouse Automation"
  include *
  show descriptions
  legend auto
  titleblock {
    version: "2026-08"
  }
  layout {
    direction down
    density comfortable
    rows [supervisor] [warehouse.board] [warehouse.controller] [erp]
  }
}

view warehouse {
  show descriptions
  layout {
    direction down
    density comfortable
    rows [bench1 bench2 bench3] [controller] [sorter printer] [board]
  }
}
