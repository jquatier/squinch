// Warehouse automation system — physical on-prem equipment

person supervisor "Shift Supervisor"

system warehouse "Warehouse Floor" {
  scanner1 = sys/scan "Scanner 1"
  scanner2 = sys/scan "Scanner 2"
  scanner3 = sys/scan "Scanner 3"

  controller = sys/cpu "Local Controller"

  sorter  = sys/route "Conveyor Sorter"
  printer = sys/printer "Label Printer"

  board = sys/monitor "Status Board"

  scanner1 -> controller
  scanner2 -> controller
  scanner3 -> controller

  controller -> sorter
  controller -> printer
  controller -> board
}

erp = sys/database "ERP" external

warehouse.controller ~> erp "sync" { animate: slow }

supervisor -> warehouse.board "monitors"

view warehouse {
  title "Warehouse Floor Automation"
  layout {
    rows [scanner1 scanner2 scanner3] [controller] [sorter printer board]
  }
}
