person supervisor "Shift Supervisor"

scan1 = sys/barcode "Bench 1 Scanner"
scan2 = sys/barcode "Bench 2 Scanner"
scan3 = sys/barcode "Bench 3 Scanner"
ctrl = sys/cpu "Local Controller"
sorter = sys/cog "Conveyor Sorter"
printer = sys/printer "Label Printer"
board = sys/monitor "Status Board"
erp = sys/database "ERP" external

scan1 -> ctrl "scans"
scan2 -> ctrl "scans"
scan3 -> ctrl "scans"
ctrl -> sorter "drives"
ctrl -> printer "drives"
ctrl -> erp "syncs once a minute" { style: dotted }
ctrl -> board "status"
supervisor -> board "watches"

zone site "Warehouse Site" onprem {
  contains scan1, scan2, scan3, ctrl, sorter, printer, board
}

view landscape {
  title "Warehouse Floor"
  include *
}
