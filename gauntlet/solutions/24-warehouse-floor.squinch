person supervisor "Shift Supervisor"

system floor "Packing Floor" {
  bench1 = sys/barcode "Bench 1 Scanner"
  bench2 = sys/barcode "Bench 2 Scanner"
  bench3 = sys/barcode "Bench 3 Scanner"
  ctrl   = sys/cpu "Local Controller"
  sorter = sys/workflow "Conveyor Sorter"
  printer = sys/printer "Label Printer"
  board  = sys/monitor "Status Board"

  bench1 ~> ctrl "scans"
  bench2 ~> ctrl
  bench3 ~> ctrl
  ctrl -> sorter
  ctrl -> printer
  ctrl -> board
}

erp = sys/server "ERP"

floor.ctrl -> erp "syncs once a minute (site network)"
supervisor -> floor.board "watches"

view landscape {
  title "Warehouse Floor"
  include *
  expand floor
}
