// Warehouse floor automation system

person supervisor "Shift Supervisor"

system floor "Warehouse Floor" {
  description: "Automated packing and sorting"

  // Packing stations
  scan1 = sys/router "Scanner 1" {
    subtitle: "Bench A"
  }
  scan2 = sys/router "Scanner 2" {
    subtitle: "Bench B"
  }
  scan3 = sys/router "Scanner 3" {
    subtitle: "Bench C"
  }

  // Local control system
  ctrl = sys/server "Floor Controller" {
    description: "Coordinates packing floor automation"
    subtitle: "Local PLC"
  }

  // Automation equipment
  sorter = sys/workflow "Conveyor Sorter" {
    description: "Routes packages to shipping lanes"
  }
  printer = sys/printer "Label Printer" {
    description: "Shipping labels"
  }

  // Monitoring
  board = sys/monitor "Status Board" {
    description: "Live floor status display"
  }

  // Scanners feed controller
  scan1 -> ctrl
  scan2 -> ctrl
  scan3 -> ctrl

  // Controller drives equipment
  ctrl -> sorter
  ctrl -> printer

  // Controller updates status board
  ctrl -> board

  layout {
    rows [scan1 scan2 scan3] [ctrl] [sorter printer board]
  }
}

// Enterprise system (off-site or back office)
erp = sys/database "ERP System" external {
  description: "Enterprise resource planning"
}

// Controller syncs to ERP periodically
floor.ctrl ~> erp "sync batch (every 60s)"

// Supervisor monitors status
supervisor -> floor.board "watches"

zone site "Site Network" network {
  contains floor, erp
}

view main {
  title "Warehouse Floor Automation"
  expand floor
  layout {
    rows [supervisor] [site]
  }
}
