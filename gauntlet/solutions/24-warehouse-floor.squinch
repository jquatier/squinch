// Warehouse floor automation system

supervisor = person "Shift Supervisor"

scanner1 = sys/scan "Packing Bench 1" {
  subtitle: "Barcode Scanner"
}
scanner2 = sys/scan "Packing Bench 2" {
  subtitle: "Barcode Scanner"
}
scanner3 = sys/scan "Packing Bench 3" {
  subtitle: "Barcode Scanner"
}

controller = sys/cpu "Floor Controller" {
  description: "Orchestrates packing automation"
  subtitle: "Local PLC"
}

sorter = sys/route "Conveyor Sorter" {
  description: "Routes packages to lanes"
}

printer = sys/printer "Label Printer"

board = sys/monitor "Status Board" {
  description: "Real-time floor status"
}

erp = sys/server "ERP System" {
  description: "Enterprise resource planning"
  subtitle: "Site Network"
}

// Scanners feed controller in real-time
scanner1 ~> controller "scan events"
scanner2 ~> controller "scan events"
scanner3 ~> controller "scan events"

// Controller drives physical devices
controller -> sorter "routing commands"
controller -> printer "print jobs"

// Controller syncs to ERP periodically
controller ~> erp "sync every minute"

// Supervisor monitors the floor
controller -> board "status updates"
board -> supervisor

view warehouse {
  title "Warehouse Floor Automation"
  layout {
    rows [scanner1 scanner2 scanner3] [controller] [sorter printer] [board] [supervisor] [erp]
  }
}
