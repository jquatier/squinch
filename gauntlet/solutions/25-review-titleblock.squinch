pack aws

gw = aws/api-gateway "API Gateway"
auth = aws/lambda "Auth Service"
ledger = aws/rds "Ledger" datastore {
  subtitle: "Postgres"
}
settlement = aws/lambda "Settlement Worker" {
  subtitle: "Nightly batch"
}
bank = box "Bank" external

gw -> auth
gw -> ledger
settlement -> ledger "reads"
settlement -> bank "batches"

view payments {
  title "Payments Architecture"
  titleblock {
    version: "2.1"
    owner: "payments team"
    date: "Q4 2026"
  }
}
