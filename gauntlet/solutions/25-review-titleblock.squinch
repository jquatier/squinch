// Payments architecture for design review
pack logos

gw = sys/router "API Gateway"
auth = sys/shield "Auth Service"
ledger = sys/database "Ledger" datastore {
  badge: logos/postgres
  subtitle: "PostgreSQL"
}
settlement = sys/workflow "Settlement Worker" {
  description: "Batches payments overnight"
}
bank = box "Bank" external

gw -> auth "authenticate"
gw -> ledger "record transaction"
ledger ~> settlement "settlement batch"
settlement -> bank "batch payout"

view payments {
  title "Payments Architecture"
  titleblock {
    version: "2.1"
    owner: "payments team"
    subtitle: "Q1 2026"
  }
  layout {
    rows [gw auth] [ledger] [settlement] [bank]
  }
}
