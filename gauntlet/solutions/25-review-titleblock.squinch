pack aws
pack logos

system payments "Payments System" {
  description: "Handles payment processing and settlement"

  gw = aws/api-gateway "API Gateway"
  auth = sys/lock "Auth Service"
  ledger = logos/postgres "Ledger" datastore
  worker = aws/lambda "Settlement Worker"
  bank = box "Bank API" external

  gw -> auth "authenticate"
  gw -> ledger "record transaction"
  ledger ~> worker "batch overnight"
  worker -> bank "settle"
}

view payments {
  title "Payments Architecture"
  scope payments
  titleblock {
    version: "2.1"
    owner: "payments team"
    subtitle: "Q3 2026"
  }
  layout {
    rows [gw auth] [ledger] [worker] [bank]
  }
}
