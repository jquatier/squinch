// Payments architecture for design review
pack aws
pack logos

gw = aws/api-gateway "API Gateway"
auth = sys/lock-keyhole "Auth Service"
ledger = logos/postgres "Ledger" datastore
worker = sys/workflow "Settlement Worker"
bank = box "Bank" external

gw -> auth "authenticate"
gw -> ledger "record transaction"
ledger ~> worker "nightly batch"
worker -> bank "settle"

view payments {
  title "Payments Architecture"
  include *
  titleblock {
    version: "2.1"
    owner: payments-team
    status: "Q1 2026"
  }
}
