pack aws

system payments "Payments" {
  description: "Payments platform"

  gw         = aws/api-gateway "API Gateway"
  auth       = aws/lambda      "Auth Service"
  ledger     = logos/postgres  "Ledger" datastore { subtitle: "Postgres" }
  settlement = aws/lambda      "Settlement Worker"

  gw -> auth "authenticate"
  gw -> ledger "post transaction"
  ledger ~> settlement "nightly batch" { animate: slow }
}

bank = box "Bank" external

payments.settlement ~> bank "settlement file" { animate: slow }

view payments {
  title "Payments Architecture"
  scope payments
  titleblock {
    subtitle: "Design review"
    version: "2.1"
    date: "Q3 2026"
    owner: payments-team
  }
}
