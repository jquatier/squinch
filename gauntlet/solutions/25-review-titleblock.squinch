pack aws
pack logos

// Payments architecture for design review
gw = aws/api-gateway "API Gateway"
auth = sys/lock "Auth Service"
ledger = logos/postgres "Ledger" datastore
settlement = sys/workflow "Settlement Worker"
bank = box "Bank" external

// Flow: API gateway authenticates, writes to ledger, settlement batches overnight
gw -> auth "authenticate"
gw -> ledger "record transaction"
ledger ~> settlement "nightly batch"
settlement -> bank "settle"

view main {
  title "Payments Architecture"
  titleblock {
    version: "2.1"
    owner: "payments team"
    subtitle: "Q1 2026"
  }
  layout {
    rows [gw auth] [ledger] [settlement] [bank]
  }
}
