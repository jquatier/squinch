pack aws
pack logos

system payments "Payments Architecture" {
  gw = aws/api-gateway "API Gateway"
  auth = sys/shield-check "Auth Service"
  ledger = logos/postgres "Ledger" datastore
  worker = sys/workflow "Settlement Worker"
  bank = box "Bank" external

  gw -> auth "authenticate"
  gw -> ledger "record payment"
  auth -> ledger "verify"
  ledger ~> worker "nightly batch"
  worker -> bank "settle"
}

view payments {
  scope payments
  titleblock {
    version: "2.1"
    owner: payments-team
    date: "Q3 2026"
  }
}
