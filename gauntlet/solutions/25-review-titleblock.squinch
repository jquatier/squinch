pack aws
pack logos

system payments "Payments Architecture" {
  gw = aws/api-gateway "API Gateway"
  auth = sys/shield "Auth Service"
  ledger = sys/code "Ledger Service"
  db = logos/postgres "Ledger DB" datastore
  worker = sys/workflow "Settlement Worker"
  bank = box "Bank" external

  gw -> auth
  gw -> ledger
  ledger -> db
  worker ~> bank "overnight batches"
  ledger ~> worker
}

view payments {
  title "Payments Architecture"
  show descriptions
  titleblock {
    version: "2.1"
    owner: payments-team
  }
  layout {
    rows [gw] [auth ledger] [db worker] [bank]
  }
}
