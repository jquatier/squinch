gw     = sys/network "API Gateway"
auth   = sys/key-round "Auth Service"
ledger = logos/postgres "Ledger" datastore {
  subtitle: "Postgres"
}
settle = sys/cog "Settlement Worker"
bank   = sys/bank "Bank" external

gw -> auth
gw -> ledger
settle -> ledger "reads"
settle ~> bank "nightly batch"

view landscape {
  title "Payments Architecture"
  include *
  titleblock {
    version: "2.1"
    date: "2026 Q4"
    owner: "payments team"
  }
}
