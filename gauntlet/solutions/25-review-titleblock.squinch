gw     = sys/api "API Gateway"
auth   = sys/lock "Auth Service"
ledger = logos/postgres "Ledger" datastore {
  subtitle: "Postgres"
}
worker = sys/worker "Settlement Worker" {
  subtitle: "Overnight batches"
}
bank   = box "Bank" external

gw -> auth
gw -> ledger
worker -> ledger "reads"
worker ~> bank "overnight batch"

view landscape {
  title "Payments Architecture"
  include *
  titleblock {
    version: "2.1"
    owner: "Payments team"
    date: "2026 Q4"
  }
}
