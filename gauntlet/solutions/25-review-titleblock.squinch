gw     = sys/router    "API Gateway"
auth   = sys/key-round "Auth Service"
ledger = logos/postgres "Ledger" datastore {
  subtitle: "Postgres"
}
worker = sys/cog       "Settlement Worker" {
  subtitle: "Overnight batch"
}
bank   = box           "Bank" external

gw -> auth
gw -> ledger
worker -> ledger "reads settled entries"
worker ~> bank "overnight batch"

view landscape {
  title "Payments Architecture"
  include *
  titleblock {
    version: "2.1"
    date: "2026 Q4"
    owner: "Payments team"
  }
}
