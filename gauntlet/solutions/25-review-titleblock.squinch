// Payments architecture for design review
pack aws
pack logos

system payments "Payments System" {
  gw = aws/api-gateway "API Gateway"
  auth = sys/shield-check "Auth Service"
  ledger = logos/postgres "Ledger" datastore
  worker = sys/cog "Settlement Worker"
  bank = box "Bank System" external

  gw -> auth
  gw -> ledger
  worker -> ledger
  worker ~> bank "overnight batch"
}

view payments {
  title "Payments Architecture"
  show descriptions
  titleblock {
    version: "2.1"
    owner: payments-team
    date: "Q1 2026"
  }
}
