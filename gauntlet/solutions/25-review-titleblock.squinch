pack aws

person reviewer "Reviewer"

system payments "Payments Architecture" {
  gw = aws/api-gateway "API Gateway"
  auth = aws/lambda "Auth Service" {
    subtitle: "Auth & Authz"
  }
  ledger = aws/rds "Ledger" datastore {
    subtitle: "Postgres"
  }
  worker = aws/lambda "Settlement Worker" {
    subtitle: "Batch processor"
  }
  bank = box "Bank API" external

  gw -> auth
  gw -> ledger "transactions"
  auth -> ledger "validate"
  worker -> ledger "query pending"
  worker -> bank "batch settlement"
}

reviewer -> payments.gw "review design"

view payments {
  title "Payments Architecture"
  titleblock {
    version: "2.1"
    owner: "payments team"
    subtitle: "Q1 2026"
  }
}
