pack aws

system payments "Payments Platform" {
  description: "Payments architecture"
  domain: "payments"

  gw         = aws/api-gateway  "API Gateway"
  auth       = sys/lock-keyhole "Auth Service"
  ledger     = logos/postgres   "Ledger" datastore { subtitle: "Postgres" }
  settlement = aws/batch        "Settlement Worker" { subtitle: "Nightly batch" }

  gw -> auth "authenticate"
  gw -> ledger "record transaction"
  ledger ~> settlement "nightly ledger export"
}

bank = box "Bank" external

payments.settlement ~> bank "overnight settlement batch"

view payments {
  scope payments
  title "Payments Architecture"
  titleblock {
    version: "2.1"
    date: "Q3 2026"
    owner: team-payments
  }
}
