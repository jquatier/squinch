pack aws
pack logos

// Payments architecture for design review
system payments "Payments Service" {
  description: "Payment processing and settlement"

  gw   = aws/api-gateway "API Gateway"
  auth = box "Auth Service"
  ledger = sys/database "Ledger" datastore {
    badge: logos/postgres
    subtitle: "PostgreSQL"
  }
  worker = aws/lambda "Settlement Worker" {
    description: "Batches transactions for bank settlement"
    subtitle: "Overnight batch"
  }
  bank = box "Bank API" external

  gw -> auth "authenticate"
  gw -> ledger "read/write transactions"
  auth -> ledger "verify account"
  worker -> ledger "fetch pending"
  worker -> bank "settle batch"
}

view payments {
  title "Payments Architecture"
  titleblock {
    version: "2.1"
    owner: "payments team"
    subtitle: "Q3 2026"
  }
  layout {
    rows [gw auth] [ledger worker] [bank]
  }
}
