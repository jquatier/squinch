// Payments architecture for design review

system payments "Payments System" {
  gw   = aws/api-gateway "API Gateway"
  auth = aws/lambda      "Auth Service"
  api  = aws/lambda      "Payment API"
  ledger = sys/database  "Ledger" datastore {
    subtitle: "Postgres"
  }
  worker = aws/lambda    "Settlement Worker" {
    description: "Batches payments overnight"
  }
  bank = box             "Bank" external

  gw -> auth
  gw -> api
  api -> ledger "records transaction"
  worker -> ledger "reads batch"
  worker -> bank "settles overnight"
}

view payments {
  title "Payments Architecture"
  titleblock {
    version: "2.1"
    owner: payments-team
    date: "Q1 2026"
  }
  layout {
    rows [gw] [auth api] [ledger worker] [bank]
  }
}
