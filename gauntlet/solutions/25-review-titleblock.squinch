pack aws
pack logos

// Payments architecture components
gw   = aws/api-gateway "API Gateway"
auth = sys/lock "Auth Service"
ledger = logos/postgres "Ledger" datastore
worker = sys/workflow "Settlement Worker"
bank = box "Bank" external

// Connections
gw -> auth "authenticate"
gw -> ledger "record payment"
ledger ~> worker "batch records"
worker -> bank "settle"

view payments {
  title "Payments Architecture"
  titleblock {
    version: "2.1"
    owner: "payments team"
  }
}
