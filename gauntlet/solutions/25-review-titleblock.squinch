pack logos

gw     = sys/webhook "API Gateway"
auth   = sys/key-round "Auth Service"
ledger = logos/postgres "Ledger" datastore {
  subtitle: "Postgres"
}
settle = sys/clock "Settlement Worker" {
  subtitle: "Nightly batch"
}
bank   = box "Bank" external

gw -> auth
gw -> ledger
settle -> ledger "reads"
settle ~> bank "overnight batch"

view landscape {
  title "Payments Architecture"
  include *
  titleblock {
    version: "2.1"
    date: "2026 Q4"
    owner: "Payments team"
  }
}
