pack aws

person customer "Customer"

storefront = aws/cloudfront "Storefront"
gw = aws/api-gateway "API Gateway"

system catalog "Catalog Service" {
  description: "Product catalog"
  glyph: sys/database

  handler = aws/lambda "Catalog Handler"
  db = aws/dynamodb "Catalog DB" datastore

  handler -> db
}

system orders "Orders Service" {
  description: "Order management"
  glyph: sys/code
  tags: #core

  handler = aws/lambda "Orders Handler"
  db = aws/dynamodb "Orders DB" datastore
  bus = aws/eventbridge "Order Events"

  handler -> db
  handler ~> bus "publishes order events"
}

system payments "Payments Service" {
  description: "Payment processing"
  glyph: sys/lock
  tags: #sensitive

  handler = aws/lambda "Payment Handler" {
    tags: #sensitive
  }
  db = aws/dynamodb "Payments DB" datastore {
    tags: #sensitive
  }

  handler -> db {
    tags: #sensitive
  }
}

fulfillment = aws/lambda "Fulfillment Worker" {
  description: "Processes orders"
}

customer -> storefront "browses"
storefront -> gw
gw -> catalog.handler "catalog requests"
gw -> orders.handler "order requests"
gw -> payments.handler "payment requests" {
  tags: #sensitive
}
orders.bus ~> fulfillment "order created"

zone prod_vpc "Production VPC" vpc {
  contains gw, catalog, orders, payments, fulfillment
}

view landscape {
  title "Order Platform - System Landscape"
  include *
  legend auto
}

view orders {
  title "Orders Service - Detail"
  scope orders
  highlight #core
  show descriptions
  legend auto
}
