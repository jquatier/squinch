// Order platform architecture
pack aws

person customer "Customer"
cdn = aws/cloudfront "CloudFront"
storefront = sys/app-window "Storefront"
apigw = aws/api-gateway "API Gateway"

system catalog "Catalog Service" {
  glyph: sys/database
  description: "Product catalog"

  lambda = aws/lambda "Catalog Handler"
  db = aws/dynamodb "Products Table" datastore

  lambda -> db
}

system orders "Orders Service" {
  glyph: sys/workflow
  description: "Order processing"
  tags: #core

  lambda = aws/lambda "Orders Handler"
  db = aws/dynamodb "Orders Table" datastore
  events = aws/eventbridge "Event Bus"

  lambda -> db
  lambda ~> events "order.created"
}

system payments "Payments Service" {
  glyph: sys/lock
  description: "Payment processing"
  tags: #sensitive

  lambda = aws/lambda "Payments Handler" {
    tags: #sensitive
  }
  db = aws/dynamodb "Payments Table" datastore {
    tags: #sensitive
  }

  lambda -> db {
    tags: #sensitive
  }
}

system fulfilment "Fulfilment Service" {
  glyph: sys/package
  description: "Order fulfilment"

  worker = aws/lambda "Fulfilment Worker"
  db = aws/dynamodb "Fulfilment Table" datastore

  worker -> db
}

// Connections
customer -> cdn "browse"
cdn -> storefront
storefront -> apigw "API requests"
apigw -> catalog.lambda "GET /products"
apigw -> orders.lambda "POST /orders"
apigw -> payments.lambda "POST /payments" {
  tags: #sensitive
}
orders.events ~> fulfilment.worker "order events"

// VPC boundary
zone prod_vpc "Production VPC" vpc {
  contains apigw, catalog, orders, payments, fulfilment
}

// Views
view landscape {
  title "Order Platform Landscape"
  include *
  highlight #sensitive

  titleblock {
    version: "2026-07"
    owner: platform-team
  }

  legend auto
}

view orders {
  title "Orders Service Detail"
  scope orders
  show descriptions

  note right-of events "Publishes domain events"

  titleblock {
    version: "2026-07"
    owner: orders-team
  }
}
