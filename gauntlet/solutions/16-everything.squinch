// Order platform architecture
pack aws

// External entry point
person customer "Customer"
storefront = aws/cloudfront "Storefront"

// API Gateway
apigw = aws/api-gateway "API Gateway"

// Catalog service
system catalog "Catalog Service" {
  description: "Product browsing"
  glyph: sys/database

  handler = aws/lambda "Catalog Handler"
  db = aws/dynamodb "Catalog DB" datastore

  handler -> db
}

// Orders service
system orders "Orders Service" {
  description: "Order processing"
  glyph: sys/code
  tags: #core

  handler = aws/lambda "Orders Handler"
  db = aws/dynamodb "Orders DB" datastore {
    tags: #core
  }

  handler -> db
}

// Payments service
system payments "Payments Service" {
  description: "Payment processing"
  glyph: sys/lock
  tags: #sensitive

  handler = aws/lambda "Payments Handler" {
    tags: #sensitive
  }
  db = aws/dynamodb "Payments DB" datastore {
    tags: #sensitive
  }

  handler -> db {
    tags: #sensitive
  }
}

// Event bus and fulfilment
eventbridge = aws/eventbridge "Event Bus"
fulfilment = aws/lambda "Fulfilment Worker" {
  description: "Order fulfilment"
}

// Connections
customer -> storefront "browses"
storefront -> apigw "API calls"
apigw -> catalog.handler
apigw -> orders.handler
apigw -> payments.handler {
  tags: #sensitive
}

orders.handler ~> eventbridge "order events"
eventbridge ~> fulfilment "consumes"

// Production VPC zone
zone prod_vpc "Production VPC" vpc {
  contains apigw, catalog, orders, payments, eventbridge, fulfilment
}

// Landscape view - all top-level entities
view landscape {
  title "Order Platform Landscape"
  include *
  titleblock {
    version: "1.0"
  }
}

// Zoomed view of orders service
view orders {
  title "Orders Service Detail"
  scope orders
  show descriptions
  titleblock {
    version: "1.0"
  }
}
