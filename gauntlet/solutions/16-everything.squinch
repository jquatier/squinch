pack aws

person customer "Customer"

storefront = aws/cloudfront "Storefront"

gw = aws/api-gateway "API Gateway"

system catalog "Catalog Service" {
  description: "Product catalog"
  glyph: sys/code

  lambda = aws/lambda "Catalog Handler"
  db = aws/dynamodb "Catalog DB" datastore

  lambda -> db
}

system orders "Orders Service" {
  description: "Order management"
  glyph: sys/code
  tags: #orders

  lambda = aws/lambda "Orders Handler" { tags: #sensitive }
  db = aws/dynamodb "Orders DB" datastore { tags: #sensitive }

  lambda -> db
}

system payments "Payments Service" {
  description: "Payment processing"
  glyph: sys/code
  tags: #sensitive

  lambda = aws/lambda "Payments Handler"
  db = aws/dynamodb "Payments DB" datastore

  lambda -> db
}

bus = aws/eventbridge "EventBridge"

fulfillment = aws/lambda "Fulfillment Worker"

customer -> storefront "browse"
storefront -> gw
gw -> catalog.lambda
gw -> orders.lambda
gw -> payments.lambda { tags: #sensitive }
orders.lambda ~> bus "order events"
bus ~> fulfillment

zone prod_vpc "Production VPC" vpc {
  contains gw, catalog, orders, payments, bus, fulfillment
}

view landscape {
  title "System Landscape"
  include *
}

view orders {
  scope orders
  titleblock {
    version: "2026-08"
  }
}
