// Order platform architecture
pack aws

// Actors
person customer "Customer"

// Edge infrastructure
cdn = aws/cloudfront "CloudFront CDN"
storefront = aws/s3 "Storefront" {
  description: "Static web app"
}

// API Gateway
gw = aws/api-gateway "API Gateway"

// Catalog service
system catalog "Catalog Service" {
  description: "Product catalog"
  glyph: sys/database

  handler = aws/lambda "Catalog Handler"
  db = aws/dynamodb "Catalog DB" datastore

  handler -> db
}

// Orders service
system orders "Orders Service" {
  description: "Order management"
  glyph: sys/code
  tags: #sensitive

  handler = aws/lambda "Orders Handler" {
    tags: #sensitive
  }
  db = aws/dynamodb "Orders DB" datastore {
    tags: #sensitive
  }
  events = aws/eventbridge "Event Bus"

  handler -> db
  handler ~> events "order events"
}

// Payments service
system payments "Payments Service" {
  description: "Payment processing"
  glyph: sys/lock
  tags: #sensitive

  handler = aws/lambda "Payments Handler" {
    tags: #sensitive
  }
  db = aws/dynamodb "Payments DB" datastore {
    tags: #sensitive
  }

  handler -> db
}

// Fulfilment worker
fulfilment = aws/lambda "Fulfilment Worker" {
  description: "Order fulfilment"
}

// Connections
customer -> cdn "browses"
cdn -> storefront
customer -> gw "API requests"
gw -> catalog.handler "catalog queries"
gw -> orders.handler "place order"
gw -> payments.handler "process payment"
orders.events ~> fulfilment "consume events"

// Production VPC - contains everything except CDN and storefront
zone prod_vpc "Production VPC" vpc {
  contains gw, catalog, orders, payments, fulfilment
}

// Views
view landscape {
  title "Order Platform - System Landscape"
  include *
  titleblock {
    version: "2026-07"
    owner: platform-team
  }
}

view orders {
  title "Orders Service - Detail View"
  scope orders
  show descriptions
  titleblock {
    version: "2026-07"
    owner: orders-team
  }
}
