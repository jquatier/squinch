// Order platform architecture
pack aws

// Customer actor
person customer "Customer"

// Storefront (outside VPC)
storefront = aws/cloudfront "Storefront"

// API Gateway
apigw = aws/api-gateway "API Gateway"

// Catalog service
system catalog "Catalog Service" {
  tags: #core
  handler = aws/lambda "Catalog Handler"
  db = aws/dynamodb "Catalog DB" datastore

  handler -> db
}

// Orders service
system orders "Orders Service" {
  tags: #core
  handler = aws/lambda "Orders Handler"
  db = aws/dynamodb "Orders DB" datastore

  handler -> db { tags: #sensitive }
  handler ~> bridge "publish order events" { tags: #sensitive }
}

// Payments service
system payments "Payments Service" {
  tags: #core
  handler = aws/lambda "Payments Handler"
  db = aws/dynamodb "Payments DB" datastore

  handler -> db { tags: #sensitive }
}

// EventBridge
bridge = aws/eventbridge "EventBridge"

// Fulfilment worker
fulfilment = aws/lambda "Fulfilment Worker"

// Connections
customer -> storefront "browse"
storefront -> apigw "API requests"
apigw -> catalog.handler "catalog requests"
apigw -> orders.handler "order requests" { tags: #sensitive }
apigw -> payments.handler "payment requests" { tags: #sensitive }
bridge ~> fulfilment "order events"

// Production VPC zone (everything except storefront)
zone prod_vpc "Production VPC" vpc {
  contains apigw, catalog, orders, payments, bridge, fulfilment
}

// Landscape view
view landscape {
  title "Order Platform Landscape"
  include *
}

// Orders service zoomed view
view orders {
  scope orders
  show descriptions
  highlight #sensitive
}
