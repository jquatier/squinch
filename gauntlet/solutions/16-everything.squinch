pack aws

person customer "Customer"

storefront = aws/cloudfront "Storefront"
gw = aws/api-gateway "API Gateway"

system catalog "Catalog Service" {
  description: "Product browsing"
  glyph: sys/search

  fn = aws/lambda "Catalog Handler"
  db = aws/dynamodb "Products" datastore

  fn -> db
}

system orders "Orders Service" {
  description: "Order management"
  glyph: sys/code

  fn = aws/lambda "Orders Handler"
  db = aws/dynamodb "Orders" datastore #sensitive

  fn -> db
}

system payments "Payments Service" {
  description: "Payment processing"
  glyph: sys/lock
  tags: #sensitive

  fn = aws/lambda "Payments Handler" #sensitive
  db = aws/dynamodb "Payments" datastore #sensitive

  fn -> db
}

bus = aws/eventbridge "Event Bus"
worker = aws/lambda "Fulfillment Worker"

customer -> storefront "browse"
storefront -> gw
gw -> catalog.fn "catalog requests"
gw -> orders.fn "order requests"
gw -> payments.fn "payment requests" #sensitive

orders.fn ~> bus "order events"
bus ~> worker "fulfillment events"

zone prod_vpc "Production VPC" vpc {
  contains gw, catalog, orders, payments, bus, worker
}

view landscape {
  title "Order Platform Landscape"
  include *
  titleblock {
    version: "2026-08"
    owner: platform-team
  }
}

view orders {
  scope orders
  highlight #sensitive
  show descriptions
  titleblock {
    version: "2026-08"
    owner: orders-team
  }
}
