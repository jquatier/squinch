pack aws

person customer "Customer"

storefront = aws/cloudfront "Storefront"
gateway    = aws/api-gateway "API Gateway"

system catalog "Catalog Service" {
  fn = aws/lambda   "Catalog Handler"
  db = aws/dynamodb "Catalog Table" datastore
  fn -> db
}

system orders "Order Service" {
  fn = aws/lambda   "Order Handler"
  db = aws/dynamodb "Orders Table" datastore
  fn -> db
}

system payments "Payment Service" {
  tags: #sensitive
  fn = aws/lambda   "Payment Handler"
  db = aws/dynamodb "Payments Table" datastore
  fn -> db
}

events      = aws/eventbridge "Order Events"
fulfilment  = aws/lambda      "Fulfilment Worker"

customer          -> storefront   "browses"
storefront        -> gateway      "API calls"
gateway           -> catalog.fn
gateway           -> orders.fn
gateway           -> payments.fn { tags: #sensitive }
orders.fn         ~> events       "order placed"
events            ~> fulfilment   "order events"

zone prod_vpc "Production VPC" vpc {
  contains gateway, catalog, orders, payments, events, fulfilment
}

view landscape {
  title "Order Platform — Landscape"
  include *
  color #sensitive red
  legend auto
}

view orders {
  scope orders
  title "Order Service"
  legend auto
}
