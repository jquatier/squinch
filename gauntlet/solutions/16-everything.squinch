pack aws

person customer "Customer"

cdn = aws/cloudfront "CloudFront"
store = sys/app-window "Storefront"

api = aws/api-gateway "API Gateway"
bus = aws/eventbridge "EventBridge"
worker = sys/cog "Fulfilment Worker"

system catalog "Catalog" {
  description: "Product catalog service"
  fn = aws/lambda "Catalog Lambda"
  db = sys/database "Catalog DB" datastore
  fn -> db
}

system orders "Orders" {
  description: "Order service"
  fn = aws/lambda "Orders Lambda"
  db = sys/database "Orders DB" datastore
  fn -> db
}

system payments "Payments" {
  description: "Payment service"
  tags: #sensitive
  fn = aws/lambda "Payments Lambda"
  db = sys/database "Payments DB" datastore
  fn -> db
}

customer -> cdn "browses"
cdn -> store
store -> api
api -> catalog.fn
api -> orders.fn
api -> payments.fn "payments path" { tags: #sensitive }
orders.fn ~> bus "order events"
bus ~> worker "consumes"

zone prod "Production VPC" vpc {
  contains api, catalog, orders, payments, bus, worker
}

view landscape {
  title "Order Platform"
  include *
  color #sensitive red
  legend auto
}

view orders {
  title "Orders Service"
  scope orders
}
