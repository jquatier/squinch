pack aws

person customer "Customer"

storefront = aws/cloudfront "Storefront"
apigw = aws/api-gateway "API Gateway"

system catalog "Catalog Service" {
  description: "Product browsing"
  glyph: sys/database

  handler = aws/lambda "Catalog Handler"
  db = aws/dynamodb "Products Table" datastore

  handler -> db
}

system orders "Orders Service" {
  description: "Order processing"
  glyph: sys/code
  tags: #core

  handler = aws/lambda "Order Handler"
  db = aws/dynamodb "Orders Table" datastore
  bus = aws/eventbridge "Event Bus"

  handler -> db
  handler ~> bus "order placed"
}

system payments "Payments Service" {
  description: "Payment processing"
  glyph: sys/lock
  tags: #sensitive

  handler = aws/lambda "Payment Handler" {
    tags: #sensitive
  }
  db = aws/dynamodb "Payments Table" datastore {
    tags: #sensitive
  }

  handler -> db { tags: #sensitive }
}

fulfillment = aws/lambda "Fulfillment Worker" {
  description: "Order fulfillment"
}

customer -> storefront "browse"
storefront -> apigw
apigw -> catalog.handler "get products"
apigw -> orders.handler "place order"
apigw -> payments.handler "process payment" { tags: #sensitive }
orders.bus ~> fulfillment "consume events"

zone prod_vpc "Production VPC" vpc {
  contains apigw, catalog, orders, payments, fulfillment
}

view landscape {
  title "Order Platform Landscape"
  include *
  legend auto
}

view orders {
  scope orders
  title "Orders Service Detail"
  show descriptions
  legend auto
}
