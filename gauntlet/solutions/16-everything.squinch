pack aws

person customer "Customer"

cdn = aws/cloudfront "CloudFront"
storefront = box "Storefront"

gw = aws/api-gateway "API Gateway"

system catalog "Catalog Service" {
  description: "Product catalog and search"
  icon: aws/lambda

  api = aws/lambda "Catalog Handler"
  db = aws/dynamodb "Catalog DB" datastore

  api -> db
}

system orders "Orders Service" {
  description: "Order management and processing"
  icon: aws/lambda

  api = aws/lambda "Orders Handler"
  db = aws/dynamodb "Orders DB" datastore

  api -> db
  api ~> bus "order events"
}

system payments "Payments Service" {
  description: "Payment processing"
  icon: aws/lambda
  tags: #sensitive

  api = aws/lambda "Payments Handler" { tags: #sensitive }
  db = aws/dynamodb "Payments DB" datastore { tags: #sensitive }

  api -> db { tags: #sensitive }
}

bus = aws/eventbridge "Event Bus"
fulfillment = aws/lambda "Fulfillment Worker"

customer -> cdn "browses"
cdn -> storefront
storefront -> gw "API calls"
gw -> catalog.api
gw -> orders.api
gw -> payments.api { tags: #sensitive }
orders.api ~> bus
bus ~> fulfillment "order events"

zone prod_vpc "Production VPC" vpc {
  contains gw, catalog, orders, payments, bus, fulfillment
}

view landscape {
  title "Order Platform - Landscape"
  include *
  color #sensitive amber
}

view orders {
  title "Orders Service - Detail"
  scope orders
}
