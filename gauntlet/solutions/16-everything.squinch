// Order platform architecture
pack aws

person customer "Customer"

storefront = aws/cloudfront "Storefront"

system catalog "Catalog Service" {
  description: "Product catalog and search"
  icon: aws/lambda
  api = aws/lambda "Catalog Handler"
  db = aws/dynamodb "Products" datastore

  api -> db
}

system orders "Orders Service" {
  description: "Order processing and management"
  icon: aws/lambda
  api = aws/lambda "Orders Handler"
  db = aws/dynamodb "Orders" datastore

  api -> db
  api ~> events "order events"
}

system payments "Payments Service" {
  description: "Payment processing"
  icon: aws/lambda
  tags: #sensitive
  api = aws/lambda "Payment Handler" #sensitive
  db = aws/dynamodb "Transactions" datastore #sensitive

  api -> db { tags: #sensitive }
}

gw = aws/api-gateway "API Gateway"
events = aws/eventbridge "Event Bus"
fulfilment = aws/lambda "Fulfilment Worker"

customer -> storefront "browse"
storefront -> gw "API calls"
gw -> catalog.api "catalog requests"
gw -> orders.api "order requests"
gw -> payments.api "payment requests" { tags: #sensitive }
events ~> fulfilment "order events"

zone prod_vpc "Production VPC" vpc {
  contains gw, catalog, orders, payments, events, fulfilment
}

view landscape {
  title "Order Platform - Landscape"
  include *
  color #sensitive amber
  legend auto
}

view orders {
  title "Orders Service - Detail"
  legend auto
}
