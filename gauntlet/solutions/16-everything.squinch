pack aws

person customer "Customer"

store = aws/cloudfront "Storefront" { subtitle: "CloudFront" }
api   = aws/api-gateway "API Gateway"
bus   = aws/eventbridge "Order Events"
worker = sys/cog "Fulfilment Worker"

system catalog "Catalog Service" {
  description: "Product catalog"
  fn = aws/lambda "Catalog Lambda"
  db = sys/database "Catalog DB" datastore
  fn -> db
}

system orders "Orders Service" {
  description: "Order intake and events"
  fn = aws/lambda "Orders Lambda"
  db = sys/database "Orders DB" datastore
  fn -> db
}

system payments "Payments Service" {
  description: "Payment processing"
  tags: #sensitive
  fn = aws/lambda "Payments Lambda"
  db = sys/database "Payments DB" datastore
  fn -> db
}

customer -> store "browses"
store -> api
api -> catalog.fn
api -> orders.fn
api -> payments.fn { tags: #sensitive }
orders.fn ~> bus "publishes order events"
bus ~> worker "consumes"

zone prod_vpc "Production VPC" vpc {
  contains api, catalog, orders, payments, bus, worker
}

view landscape {
  title "Order Platform"
  include *
  color #sensitive red
  legend auto
}

view orders {
  title "Orders Service"
}
