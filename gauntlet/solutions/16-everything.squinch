pack aws

person customer "Customer"

storefront = aws/cloudfront "Storefront"

gw = aws/api-gateway "API Gateway"

system catalog "Catalog Service" {
  description: "Product listings"
  glyph: sys/database

  handler = aws/lambda "Catalog Handler"
  db = aws/dynamodb "Catalog DB" datastore

  handler -> db
}

system orders "Orders Service" {
  description: "Order processing"
  glyph: sys/workflow
  tags: #core

  handler = aws/lambda "Orders Handler"
  db = aws/dynamodb "Orders DB" datastore
  bus = aws/eventbridge "Order Events"

  handler -> db
  handler ~> bus "publish order events"
}

system payments "Payments Service" {
  description: "Payment processing"
  glyph: sys/lock
  tags: #sensitive

  handler = aws/lambda "Payments Handler" {
    tags: #sensitive
  }
  db = aws/dynamodb "Payments DB" datastore {
    tags: #sensitive
  }

  handler -> db { tags: #sensitive }
}

fulfillment = aws/lambda "Fulfillment Worker" {
  description: "Processes orders"
}

customer -> storefront "browses and orders"
storefront -> gw
gw -> catalog.handler "product requests"
gw -> orders.handler "order requests"
gw -> payments.handler "payment requests" { tags: #sensitive }
orders.bus ~> fulfillment "consume events"

zone vpc "Production VPC" vpc {
  contains gw, catalog, orders, payments, fulfillment
}

view landscape {
  title "Order Platform Landscape"
  include *
  titleblock {
    version: "1.0"
  }
}

view orders {
  scope orders
  title "Orders Service Detail"
  show descriptions
  titleblock {
    version: "1.0"
  }
}
