// Order platform architecture
pack aws

person customer "Customer"

// Storefront (outside VPC)
storefront = aws/cloudfront "Storefront CDN"

// API Gateway (inside VPC)
apigw = aws/api-gateway "API Gateway"

// Catalog service
system catalog "Catalog Service" {
  glyph: sys/database
  description: "Product catalog"

  handler = aws/lambda "Catalog Handler"
  db = aws/dynamodb "Catalog DB" datastore

  handler -> db
}

// Orders service
system orders "Orders Service" {
  glyph: sys/box
  description: "Order processing"
  tags: #core

  handler = aws/lambda "Orders Handler"
  db = aws/dynamodb "Orders DB" datastore
  events = aws/eventbridge "Event Bus"

  handler -> db
  handler ~> events "order events"
}

// Payments service
system payments "Payments Service" {
  glyph: sys/lock
  description: "Payment processing"
  tags: #sensitive

  handler = aws/lambda "Payments Handler" {
    tags: #sensitive
  }
  db = aws/dynamodb "Payments DB" datastore {
    tags: #sensitive
  }

  handler -> db {
    tags: #sensitive
  }
}

// Fulfilment worker
fulfilment = aws/lambda "Fulfilment Worker"

// Connections
customer -> storefront "browse"
storefront -> apigw
apigw -> catalog.handler "catalog API"
apigw -> orders.handler "orders API"
apigw -> payments.handler "payments API" {
  tags: #sensitive
}
orders.events ~> fulfilment "consume events"

// VPC zone
zone prod_vpc "Production VPC" vpc {
  contains apigw, catalog, orders, payments, fulfilment
}

// Landscape view
view landscape {
  title "Order Platform Landscape"
  include *
}

// Orders service zoomed view
view orders {
  title "Orders Service Detail"
  scope orders
  show descriptions
}
