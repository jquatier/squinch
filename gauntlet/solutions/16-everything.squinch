// Order platform architecture
pack aws

// Customer
person customer "Customer"

// Edge layer
storefront = aws/cloudfront "Storefront"

// API Gateway
gw = aws/api-gateway "API Gateway"

// Catalog service
system catalog "Catalog Service" {
  description: "Product catalog"
  glyph: sys/database

  handler = aws/lambda "Catalog Handler"
  db = aws/dynamodb "Products" datastore

  handler -> db
}

// Orders service
system orders "Orders Service" {
  description: "Order management"
  glyph: sys/code
  tags: #core

  handler = aws/lambda "Orders Handler"
  db = aws/dynamodb "Orders" datastore
  bus = aws/eventbridge "Event Bus"

  handler -> db
  handler ~> bus "order events"
}

// Payments service
system payments "Payments Service" {
  description: "Payment processing"
  glyph: sys/lock
  tags: #sensitive

  handler = aws/lambda "Payments Handler" { tags: #sensitive }
  db = aws/dynamodb "Payments" datastore { tags: #sensitive }

  handler -> db { tags: #sensitive }
}

// Fulfilment worker
fulfilment = aws/lambda "Fulfilment Worker"

// Connections
customer -> storefront "browse"
storefront -> gw
gw -> catalog.handler
gw -> orders.handler
gw -> payments.handler "checkout" { tags: #sensitive }
orders.bus ~> fulfilment "consume events"

// Production VPC boundary
zone prod_vpc "Production VPC" vpc {
  contains gw, catalog, orders, payments, fulfilment
}

// Landscape view
view landscape {
  title "Order Platform Landscape"
  include *
}

// Orders service view
view orders {
  title "Orders Service"
  scope orders
  highlight #core
}
