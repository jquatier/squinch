// Order platform architecture
pack aws

person customer "Customer"

// Frontend
storefront = aws/cloudfront "Storefront"

// API Gateway
apigw = aws/api-gateway "API Gateway"

// Catalog service
system catalog "Catalog Service" {
  description: "Product browsing and search"
  glyph: sys/database

  handler = aws/lambda "Catalog Handler"
  db = aws/dynamodb "Catalog DB" datastore

  handler -> db
}

// Orders service
system orders "Orders Service" {
  description: "Order management"
  glyph: sys/code
  tags: #core

  handler = aws/lambda "Orders Handler" {
    tags: #sensitive
  }
  db = aws/dynamodb "Orders DB" datastore {
    tags: #sensitive
  }
  events = aws/eventbridge "Order Events"

  handler -> db
  handler ~> events "publish order events"
}

// Payments service
system payments "Payments Service" {
  description: "Payment processing"
  glyph: sys/lock
  tags: #sensitive

  handler = aws/lambda "Payments Handler" {
    tags: #sensitive
  }
  db = aws/dynamodb "Payments DB" datastore {
    tags: #sensitive
  }

  handler -> db
}

// Fulfillment worker
fulfillment = aws/lambda "Fulfillment Worker"

// Connections
customer -> storefront "browse"
storefront -> apigw "API calls"
apigw -> catalog.handler "catalog requests"
apigw -> orders.handler "order requests" { tags: #sensitive }
apigw -> payments.handler "payment requests" { tags: #sensitive }
orders.events ~> fulfillment "order events"

// VPC zone
zone prod_vpc "Production VPC" vpc {
  contains apigw, catalog, orders, payments, fulfillment
}

// Landscape view
view landscape {
  title "Order Platform Landscape"
  include *
  legend auto
}

// Orders service detail view
view orders {
  scope orders
  show descriptions
  legend auto
}
