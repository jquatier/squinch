// Order platform architecture
pack aws

person customer "Customer"

// Frontend
storefront = aws/cloudfront "Storefront"

// API Gateway
gw = aws/api-gateway "API Gateway"

// Services
system catalog "Catalog Service" {
  description: "Product catalog"
  glyph: sys/database

  handler = aws/lambda "Catalog Handler"
  db = aws/dynamodb "Products Table" datastore

  handler -> db
}

system orders "Orders Service" {
  description: "Order processing"
  glyph: sys/code
  tags: #core

  handler = aws/lambda "Orders Handler" {
    tags: #sensitive
  }
  db = aws/dynamodb "Orders Table" datastore {
    tags: #sensitive
  }
  events = aws/eventbridge "Order Events"

  handler -> db
  handler ~> events "publish order"
}

system payments "Payments Service" {
  description: "Payment processing"
  glyph: sys/lock
  tags: #sensitive

  handler = aws/lambda "Payment Handler" {
    tags: #sensitive
  }
  db = aws/dynamodb "Payments Table" datastore {
    tags: #sensitive
  }

  handler -> db
}

// Fulfilment
fulfilment = aws/lambda "Fulfilment Worker" {
  description: "Process orders"
}

// Connections
customer -> storefront "browse"
storefront -> gw
gw -> catalog.handler
gw -> orders.handler
gw -> payments.handler
orders.events ~> fulfilment "order created"

// VPC boundary
zone prod_vpc "Production VPC" vpc {
  contains gw, catalog, orders, payments, fulfilment
}

// Views
view landscape {
  title "Order Platform Landscape"
  include *
}

view orders {
  title "Orders Service Detail"
  scope orders
  highlight #sensitive
  show descriptions

  layout {
    direction down
    density comfortable
  }
}
