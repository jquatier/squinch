pack aws
pack logos

person customer "Customer"

cdn = aws/cloudfront "CloudFront"
storefront = box "Storefront"

system catalog "Catalog Service" {
  icon: aws/lambda
  description: "Product catalog and search"

  api = aws/lambda "Catalog Handler"
  db = aws/dynamodb "Catalog DB" datastore

  api -> db
}

system orders "Orders Service" {
  icon: aws/lambda
  description: "Order management and checkout"

  api = aws/lambda "Orders Handler" { tags: #sensitive }
  db = aws/dynamodb "Orders DB" datastore { tags: #sensitive }
  bus = aws/eventbridge "Order Events" { tags: #sensitive }

  api -> db
  api ~> bus "order created"
}

system payments "Payments Service" {
  icon: aws/lambda
  description: "Payment processing"

  api = aws/lambda "Payments Handler" { tags: #sensitive }
  db = aws/dynamodb "Payments DB" datastore { tags: #sensitive }

  api -> db
}

system fulfillment "Fulfillment Service" {
  icon: aws/lambda
  description: "Order fulfillment and shipping"

  worker = aws/lambda "Fulfillment Worker"
  db = aws/dynamodb "Fulfillment DB" datastore

  worker -> db
}

gw = aws/api-gateway "API Gateway"

customer -> cdn "browses"
cdn -> storefront
storefront -> gw "API calls"
gw -> catalog.api
gw -> orders.api
gw -> payments.api
orders.bus ~> fulfillment.worker "order events"

zone prod_vpc "VPC Production" vpc {
  contains gw, catalog, orders, payments, fulfillment
}

view landscape {
  title "Order Platform Landscape"
  include *
  titleblock {
    subtitle: "End-to-end architecture"
  }
}

view orders {
  title "Orders Service Detail"
  color #sensitive amber
}
