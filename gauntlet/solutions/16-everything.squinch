// Order platform architecture
pack aws

// Actors
person customer "Customer"

// Edge infrastructure
cdn = aws/cloudfront "CloudFront"
gw = aws/api-gateway "API Gateway"

// Services
system catalog "Catalog Service" {
  description: "Product browsing"
  glyph: sys/code

  lambda = aws/lambda "Catalog Handler"
  db = aws/dynamodb "Products Table" datastore

  lambda -> db
}

system orders "Orders Service" {
  description: "Order processing"
  glyph: sys/code
  tags: #sensitive

  lambda = aws/lambda "Orders Handler" {
    tags: #sensitive
  }
  db = aws/dynamodb "Orders Table" datastore {
    tags: #sensitive
  }

  lambda -> db
  lambda ~> bus "publish order events"
}

system payments "Payments Service" {
  description: "Payment processing"
  glyph: sys/code
  tags: #sensitive

  lambda = aws/lambda "Payments Handler" {
    tags: #sensitive
  }
  db = aws/dynamodb "Payments Table" datastore {
    tags: #sensitive
  }

  lambda -> db
}

// Event infrastructure
bus = aws/eventbridge "EventBridge"
fulfilment = aws/lambda "Fulfilment Worker"

// Connections
customer -> cdn "browse & order"
cdn -> gw
gw -> catalog.lambda "GET /products"
gw -> orders.lambda "POST /orders"
gw -> payments.lambda "POST /payments"
bus ~> fulfilment "order events"

// Deployment boundary
zone prod_vpc "VPC prod" vpc {
  contains gw, catalog, orders, payments, bus, fulfilment
}

// Views
view landscape {
  title "System Landscape"
  include *
}

view orders {
  scope orders
  show descriptions
}
