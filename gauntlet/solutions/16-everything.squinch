// Order platform architecture
pack aws
pack logos

// Actors
person customer "Customer"

// Frontend
storefront = aws/cloudfront "Storefront"

// API layer
gw = aws/api-gateway "API Gateway"

// Catalog service
system catalog "Catalog Service" {
  description: "Product catalog"
  glyph: sys/database

  handler = aws/lambda "Catalog Handler"
  db = aws/dynamodb "Product DB" datastore

  handler -> db
}

// Orders service
system orders "Orders Service" {
  description: "Order processing"
  glyph: sys/box

  handler = aws/lambda "Orders Handler" #sensitive
  db = aws/dynamodb "Orders DB" datastore #sensitive

  handler -> db
}

// Payments service
system payments "Payments Service" {
  description: "Payment processing"
  glyph: sys/lock
  tags: #sensitive

  handler = aws/lambda "Payment Handler"
  db = aws/dynamodb "Payments DB" datastore

  handler -> db
}

// Event system
bus = aws/eventbridge "Event Bus"

// Fulfilment
fulfilment = aws/lambda "Fulfilment Worker"

// Connections
customer -> storefront "browses"
storefront -> gw "API calls"
gw -> catalog.handler
gw -> orders.handler
gw -> payments.handler

orders.handler ~> bus "order events"
bus ~> fulfilment "order created"

// VPC boundary
zone prod_vpc "Production VPC" vpc {
  contains gw, catalog, orders, payments, bus, fulfilment
}

// Views
view landscape {
  title "Order Platform Landscape"
  include *
  legend auto
}

view orders {
  scope orders
  show descriptions
  highlight #sensitive
  legend auto
}
