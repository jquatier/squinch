// Order platform architecture
pack aws
pack logos

// External actors
person customer "Customer"

// Edge storefront (outside VPC)
storefront = aws/cloudfront "Storefront"

// API Gateway
gw = aws/api-gateway "API Gateway"

// Catalog service
system catalog "Catalog Service" {
  description: "Product catalog and search"
  glyph: sys/search

  handler = aws/lambda "Catalog Handler"
  db = aws/dynamodb "Catalog Table" datastore

  handler -> db
}

// Orders service
system orders "Orders Service" {
  description: "Order management and tracking"
  glyph: sys/database
  tags: #core

  handler = aws/lambda "Orders Handler"
  db = aws/dynamodb "Orders Table" datastore
  bus = aws/eventbridge "Order Events"

  handler -> db
  handler ~> bus "order.placed"
}

// Payments service
system payments "Payments Service" {
  description: "Payment processing"
  glyph: sys/lock
  tags: #sensitive

  handler = aws/lambda "Payment Handler" {
    tags: #sensitive
  }
  db = aws/dynamodb "Payments Table" datastore {
    tags: #sensitive
  }

  handler -> db { tags: #sensitive }
}

// Fulfilment worker
fulfil = aws/lambda "Fulfilment Worker"

// Connections
customer -> storefront "browses"
storefront -> gw "API calls"
gw -> catalog.handler "catalog requests"
gw -> orders.handler "order requests"
gw -> payments.handler "payment requests" { tags: #sensitive }
orders.bus ~> fulfil "consumes events"

// Production VPC boundary (everything except storefront)
zone prod_vpc "Production VPC" vpc {
  contains gw, catalog, orders, payments, fulfil
}

// Landscape view
view landscape {
  title "Order Platform Landscape"
  include *
  titleblock {
    version: "2026-08"
  }
}

// Orders service detail view
view orders {
  scope orders
  highlight #core
  titleblock {
    version: "2026-08"
    owner: team-orders
  }
}
