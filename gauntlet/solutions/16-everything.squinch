pack aws

person customer "Customer"

cdn = aws/cloudfront "CloudFront CDN"
storefront = box "Storefront"

gw = aws/api-gateway "API Gateway"

system catalog "Catalog Service" {
  description: "Product catalog"
  icon: aws/lambda

  svc = aws/lambda "Catalog Handler"
  db = aws/dynamodb "Products Table" datastore

  svc -> db
}

system orders "Orders Service" {
  description: "Order processing"
  icon: aws/lambda
  tags: #core

  svc = aws/lambda "Orders Handler"
  db = aws/dynamodb "Orders Table" datastore
  bus = aws/eventbridge "Order Events"

  svc -> db
  svc ~> bus "publishes"
}

system payments "Payments Service" {
  description: "Payment processing"
  icon: aws/lambda
  tags: #sensitive

  svc = aws/lambda "Payment Handler" {
    tags: #sensitive
  }
  db = aws/dynamodb "Payments Table" datastore {
    tags: #sensitive
  }

  svc -> db

  layout {
    rows [svc] [db]
  }
}

fulfillment = aws/lambda "Fulfillment Worker"

customer -> cdn "browses"
cdn -> storefront
storefront -> gw "API calls"
gw -> catalog.svc "catalog requests"
gw -> orders.svc "order requests"
gw -> payments.svc "payment requests" {
  tags: #sensitive
}
orders.bus ~> fulfillment "consumes"

zone vpc "VPC prod" vpc {
  contains gw, catalog, orders, payments, fulfillment
}

view landscape {
  title "Order Platform Landscape"
  include *
  color #sensitive red
  legend auto

  layout {
    rows [customer] [cdn] [storefront] [vpc]
  }
}

view orders {
  title "Orders Service Detail"
  scope orders
}
