pack aws

person customer "Customer"

storefront = aws/cloudfront "Storefront"

gw = aws/api-gateway "API Gateway"

system catalog "Catalog Service" {
  description: "Product catalog and search"
  icon: aws/lambda

  lambda = aws/lambda "Catalog Handler"
  db = aws/dynamodb "Catalog DB" datastore

  lambda -> db
}

system orders "Orders Service" {
  description: "Order processing and management"
  icon: aws/lambda
  tags: #orders

  lambda = aws/lambda "Orders Handler"
  db = aws/dynamodb "Orders DB" datastore

  lambda -> db
  lambda ~> bus "order events"
}

system payments "Payments Service" {
  description: "Payment processing"
  icon: aws/lambda
  tags: #sensitive

  lambda = aws/lambda "Payments Handler" #sensitive
  db = aws/dynamodb "Payments DB" datastore #sensitive

  lambda -> db
}

bus = aws/eventbridge "EventBridge"
fulfillment = aws/lambda "Fulfillment Worker"

customer -> storefront "browse and shop"
storefront -> gw "API calls"
gw -> catalog.lambda "get products"
gw -> orders.lambda "place order" #sensitive
gw -> payments.lambda "process payment" #sensitive

bus ~> fulfillment "order placed"

zone prod_vpc "Production VPC" vpc {
  contains gw, catalog, orders, payments, bus, fulfillment
}

view landscape {
  title "Order Platform Landscape"
  include *
  color #sensitive amber
}

view orders {
  title "Orders Service Detail"
  scope orders
  color #sensitive amber
}
