// Order platform architecture
pack aws

// External actors and edge services
person customer "Customer"
storefront = aws/cloudfront "Storefront"

// API Gateway
gw = aws/api-gateway "API Gateway"

// Catalog service
system catalog "Catalog Service" {
  description: "Product catalog"
  glyph: sys/database

  handler = aws/lambda "Catalog Handler"
  db = aws/dynamodb "Catalog Table" datastore

  handler -> db
}

// Orders service
system orders "Orders Service" {
  description: "Order processing"
  glyph: sys/code
  tags: #sensitive

  handler = aws/lambda "Orders Handler"
  db = aws/dynamodb "Orders Table" datastore
  bus = aws/eventbridge "Order Events"

  handler -> db
  handler ~> bus "publish events"
}

// Payments service
system payments "Payments Service" {
  description: "Payment processing"
  glyph: sys/lock
  tags: #sensitive

  handler = aws/lambda "Payments Handler"
  db = aws/dynamodb "Payments Table" datastore

  handler -> db
}

// Fulfilment worker
fulfil = aws/lambda "Fulfilment Worker"

// Connections
customer -> storefront "browse"
storefront -> gw "API calls"
gw -> catalog.handler "catalog requests"
gw -> orders.handler "order requests"
gw -> payments.handler "payment requests" { tags: #sensitive }
orders.bus ~> fulfil "consume events"

// VPC boundary - contains everything except storefront
zone prod_vpc "VPC prod" vpc {
  contains gw, catalog, orders, payments, fulfil
}

// Landscape view - all systems collapsed
view landscape {
  title "System Landscape"
  include *
  show descriptions
  titleblock {
    version: "2026-07"
    owner: platform-team
  }
}

// Orders service zoomed view
view orders {
  scope orders
  highlight #sensitive
  show descriptions
  titleblock {
    version: "2026-07"
    owner: team-orders
  }
}
