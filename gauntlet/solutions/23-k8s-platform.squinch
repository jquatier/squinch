pack k8s

person user "User"

ingress = k8s/ing "Nginx Ingress"

web_svc = k8s/svc "Web Service"
web_deploy = k8s/deploy "Web" {
  description: "Web frontend"
}

api_svc = k8s/svc "API Service"
api_deploy = k8s/deploy "API" {
  description: "API backend"
}

worker_svc = k8s/svc "Worker Service"
worker_deploy = k8s/deploy "Worker" {
  description: "Background worker"
}

postgres = k8s/sts "Postgres" datastore {
  description: "Database"
}

redis = k8s/sts "Redis" datastore {
  description: "Cache"
}

prune_job = k8s/cronjob "Prune Job" {
  description: "Nightly cleanup"
}

user -> ingress
ingress -> web_svc
ingress -> api_svc
web_svc -> web_deploy
api_svc -> api_deploy
worker_svc -> worker_deploy
api_deploy -> postgres "read/write"
api_deploy -> redis "cache"
prune_job -> postgres "cleanup"

view cluster {
  title "Kubernetes Platform"
  layout {
    rows [ingress] [web_svc api_svc worker_svc] [web_deploy api_deploy worker_deploy] [postgres redis prune_job]
  }
}
