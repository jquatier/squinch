pack k8s

ingress = k8s/ing "nginx Ingress"

web_svc = k8s/svc "web Service"
web_deploy = k8s/deploy "web"

api_svc = k8s/svc "api Service"
api_deploy = k8s/deploy "api"

worker_svc = k8s/svc "worker Service"
worker_deploy = k8s/deploy "worker"

postgres = k8s/sts "Postgres" datastore
redis = k8s/deploy "Redis" datastore

pruner = k8s/cronjob "Prune Job"

ingress -> web_svc
ingress -> api_svc

web_svc -> web_deploy
api_svc -> api_deploy
worker_svc -> worker_deploy

api_deploy -> postgres
api_deploy -> redis

pruner -> postgres
