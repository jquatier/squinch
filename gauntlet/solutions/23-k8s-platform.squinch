pack k8s
pack logos

ingress = logos/nginx "NGINX Ingress" {
  subtitle: "Ingress"
}

web_svc    = k8s/svc "web" { subtitle: "Service" }
api_svc    = k8s/svc "api" { subtitle: "Service" }
worker_svc = k8s/svc "worker" { subtitle: "Service" }

web    = k8s/deploy "web" { subtitle: "Deployment" }
api    = k8s/deploy "api" { subtitle: "Deployment" }
worker = k8s/deploy "worker" { subtitle: "Deployment" }

postgres = k8s/sts "Postgres" datastore {
  subtitle: "StatefulSet"
  badge: logos/postgres
}
redis = logos/redis "Redis" datastore {
  subtitle: "Cache"
}
prune = k8s/cronjob "Prune old records" {
  subtitle: "CronJob · nightly"
}

ingress -> web_svc, api_svc, worker_svc
web_svc -> web
api_svc -> api
worker_svc -> worker
api -> postgres "reads / writes"
api -> redis "caches"
prune -> postgres "deletes old rows"

zone cluster "Kubernetes cluster" custom {
  icon: logos/kubernetes
  contains ingress, web_svc, api_svc, worker_svc, web, api, worker, postgres, redis, prune
}

view landscape {
  title "Kubernetes Cluster"
  include *
}
