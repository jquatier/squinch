pack k8s

person user "User"

ingress = k8s/ing "Nginx Ingress"

web_svc = k8s/svc "Web Service"
api_svc = k8s/svc "API Service"
worker_svc = k8s/svc "Worker Service"

web = k8s/deploy "Web" {
  subtitle: "Deployment"
}

api = k8s/deploy "API" {
  subtitle: "Deployment"
}

worker = k8s/deploy "Worker" {
  subtitle: "Deployment"
}

postgres = k8s/sts "Postgres" datastore {
  subtitle: "StatefulSet"
}

redis = k8s/deploy "Redis" datastore {
  subtitle: "Deployment"
}

prune = k8s/cronjob "Prune Job" {
  description: "Nightly cleanup of old records"
}

user -> ingress
ingress -> web_svc
ingress -> api_svc
web_svc -> web
api_svc -> api
worker_svc -> worker
api -> postgres "read/write"
api -> redis "cache"
prune -> postgres "cleanup"

view cluster {
  title "Kubernetes Platform"
  layout {
    rows [user] [ingress] [web_svc api_svc worker_svc] [web api worker] [redis] [postgres prune]
  }
}
