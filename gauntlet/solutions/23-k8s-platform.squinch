pack k8s

// ingress layer
ingress = k8s/ing "nginx-ingress"

// application deployments
web    = k8s/deploy "web"
api    = k8s/deploy "api"
worker = k8s/deploy "worker"

// services
web_svc    = k8s/svc "web-service"
api_svc    = k8s/svc "api-service"
worker_svc = k8s/svc "worker-service"

// data layer
postgres = k8s/sts "Postgres" datastore
redis    = k8s/deploy "Redis" datastore

// scheduled jobs
prune = k8s/cronjob "prune-job" {
  description: "Nightly cleanup"
}

// ingress to services
ingress -> web_svc
ingress -> api_svc

// services to deployments
web_svc    -> web
api_svc    -> api
worker_svc -> worker

// api interactions
api -> postgres "read/write"
api -> redis "cache"

// cronjob cleanup
prune -> postgres "delete old records"
