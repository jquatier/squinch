// Kubernetes cluster architecture
pack k8s

// Ingress layer
ingress = k8s/ing "Nginx Ingress" {
  subtitle: "ingress-nginx"
}

// Application services
web_svc = k8s/svc "Web Service" {
  subtitle: "ClusterIP"
}
api_svc = k8s/svc "API Service" {
  subtitle: "ClusterIP"
}
worker_svc = k8s/svc "Worker Service" {
  subtitle: "ClusterIP"
}

// Deployments
web = k8s/deploy "Web" {
  subtitle: "Frontend"
}
api = k8s/deploy "API" {
  subtitle: "Backend"
}
worker = k8s/deploy "Worker" {
  subtitle: "Background jobs"
}

// Data layer
postgres = k8s/sts "Postgres" datastore {
  subtitle: "StatefulSet"
}
redis = k8s/deploy "Redis" datastore {
  subtitle: "Cache"
}

// Cron job
prune_job = k8s/cronjob "Prune Job" {
  subtitle: "Nightly cleanup"
}

// Traffic flow
ingress -> web_svc
ingress -> api_svc

web_svc -> web
api_svc -> api
worker_svc -> worker

// API data connections
api -> postgres "read/write"
api -> redis "cache"

// Cronjob connection
prune_job -> postgres "prune old records"

view cluster {
  title "Kubernetes Cluster Architecture"
  layout {
    rows [ingress] [web_svc api_svc worker_svc] [web api worker] [redis postgres prune_job]
  }
}
