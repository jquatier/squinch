pack k8s

person user "User"

// Ingress layer
ingress = k8s/ing "nginx-ingress"

// Services
web_svc = k8s/svc "web-service"
api_svc = k8s/svc "api-service"
worker_svc = k8s/svc "worker-service"

// Deployments
web = k8s/deploy "web" {
  subtitle: "Frontend"
}
api = k8s/deploy "api" {
  subtitle: "REST API"
}
worker = k8s/deploy "worker" {
  subtitle: "Background jobs"
}

// Data layer
postgres = k8s/sts "postgres" datastore {
  subtitle: "StatefulSet"
}
redis = k8s/deploy "redis" datastore {
  subtitle: "Cache"
}

// Scheduled jobs
prune = k8s/cronjob "prune-job" {
  subtitle: "Nightly cleanup"
}

// Traffic flow
user -> ingress
ingress -> web_svc
ingress -> api_svc
web_svc -> web
api_svc -> api
worker_svc -> worker

// API data access
api -> redis "cache"
api -> postgres "read/write"

// Job data access
prune -> postgres "delete old records"
