pack k8s
pack logos

ingress = k8s/ing "Ingress" { badge: logos/nginx, subtitle: "NGINX" }

web_svc    = k8s/svc "Web Service"
api_svc    = k8s/svc "API Service"
worker_svc = k8s/svc "Worker Service"

web    = k8s/deploy "Web"
api    = k8s/deploy "API"
worker = k8s/deploy "Worker"

db    = k8s/sts "Postgres" datastore { badge: logos/postgres }
cache = logos/redis "Redis" datastore

prune = k8s/cronjob "Prune Job" {
  subtitle: "Nightly"
  description: "Prunes old records"
}

ingress -> web_svc, api_svc, worker_svc
web_svc    -> web
api_svc    -> api
worker_svc -> worker

api -> db
api -> cache
prune -> db "prunes old records"

zone cluster "Kubernetes Cluster" custom {
  icon: logos/kubernetes
  contains ingress, web_svc, api_svc, worker_svc, web, api, worker, db, cache, prune
}
