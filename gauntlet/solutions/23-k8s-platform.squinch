// Kubernetes cluster platform diagram
pack k8s

// Ingress
ingress = k8s/ing "nginx-ingress"

// Services
web_svc = k8s/svc "web-service"
api_svc = k8s/svc "api-service"
worker_svc = k8s/svc "worker-service"

// Deployments
web = k8s/deploy "web"
api = k8s/deploy "api"
worker = k8s/deploy "worker"

// Stateful data stores
postgres = k8s/sts "Postgres" datastore
redis = k8s/sts "Redis" datastore

// Maintenance job
prune = k8s/cronjob "Prune old records"

// Traffic flow
ingress -> web_svc
ingress -> api_svc
web_svc -> web
api_svc -> api
worker_svc -> worker

// API data access
api -> postgres "read/write"
api -> redis "cache"

// Maintenance
prune -> postgres "cleanup"
