pack k8s

// Ingress layer
ingress = k8s/ing "nginx-ingress"

// Services
web_svc = k8s/svc "web-service"
api_svc = k8s/svc "api-service"
worker_svc = k8s/svc "worker-service"

// Deployments
web = k8s/deploy "web"
api = k8s/deploy "api"
worker = k8s/deploy "worker"

// Data layer
postgres = k8s/sts "postgres" datastore
redis = k8s/sts "redis" datastore

// Scheduled jobs
pruner = k8s/cronjob "pruner" {
  description: "Nightly record cleanup"
}

// Traffic flow
ingress -> web_svc
ingress -> api_svc
ingress -> worker_svc

// Services to deployments
web_svc -> web
api_svc -> api
worker_svc -> worker

// API data access
api -> postgres "read/write"
api -> redis "cache"

// Cronjob access
pruner ~> postgres "prune old records"

view cluster {
  title "Kubernetes Platform"
  layout {
    rows [ingress] [web_svc api_svc worker_svc] [web api worker] [postgres redis pruner]
    place redis right-of postgres
  }
}
