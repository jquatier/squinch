pack k8s

// Ingress layer
ingress = k8s/ing "Nginx Ingress"

// Services
web_svc = k8s/svc "Web Service"
api_svc = k8s/svc "API Service"
worker_svc = k8s/svc "Worker Service"

// Deployments
web = k8s/deploy "Web" {
  description: "Frontend deployment"
}
api = k8s/deploy "API" {
  description: "API deployment"
}
worker = k8s/deploy "Worker" {
  description: "Background worker"
}

// Data layer
postgres = k8s/sts "Postgres" datastore {
  description: "Database StatefulSet"
}
redis = k8s/sts "Redis" datastore {
  description: "Cache layer"
}

// Scheduled job
prune = k8s/cronjob "Prune Job" {
  description: "Nightly cleanup"
}

// Traffic flow
ingress -> web_svc
ingress -> api_svc
web_svc -> web
api_svc -> api
worker_svc -> worker

// API data access
api -> postgres "read/write"
api -> redis "cache"

// Cleanup job
prune -> postgres "prune old records"

view cluster {
  title "Kubernetes Cluster"
  layout {
    rows [ingress] [web_svc api_svc worker_svc] [web api worker] [redis] [postgres prune]
  }
}
