pack k8s

// Ingress
ingress = k8s/ing "nginx Ingress"

// Services
web_svc = k8s/svc "web Service"
api_svc = k8s/svc "api Service"
worker_svc = k8s/svc "worker Service"

// Deployments
web = k8s/deploy "web"
api = k8s/deploy "api"
worker = k8s/deploy "worker"

// Data layer
postgres = k8s/sts "Postgres" datastore
redis = k8s/deploy "Redis" datastore

// Scheduled jobs
prune = k8s/cronjob "Prune old records"

// Ingress routing
ingress -> web_svc
ingress -> api_svc

// Service to deployment connections
web_svc -> web
api_svc -> api
worker_svc -> worker

// API data access
api -> postgres "read/write"
api -> redis "cache"

// Cronjob to database
prune -> postgres "cleanup"
