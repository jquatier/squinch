pack logos

person analyst "Analyst"

kafka = logos/kafka "Kafka" external {
  subtitle: "Order events"
}

system dbx "Databricks Lakehouse" {
  description: "Everything inside this frame is Databricks"
  icon: logos/databricks

  loader = sys/stream "Auto Loader" {
    badge: logos/databricks
  }
  bronze = sys/table "Bronze Orders" datastore {
    badge: logos/databricks
    subtitle: "Delta table"
  }
  job = sys/job "Nightly Merge" {
    badge: logos/databricks
    subtitle: "Databricks job"
  }
  silver = sys/table "Silver Customers" datastore {
    badge: logos/databricks
    subtitle: "Delta table"
  }
  uc = sys/catalog "Unity Catalog" {
    badge: logos/databricks
  }
  wh = sys/database "SQL Warehouse" {
    badge: logos/databricks
    subtitle: "Databricks SQL"
  }
  vs = sys/vector-search "Vector Search Index" {
    badge: logos/databricks
  }
  serving = sys/model "Model Serving Endpoint" {
    badge: logos/databricks
  }

  loader -> bronze "lands"
  job -> bronze "reads"
  job -> silver "merges"
  uc -> silver "governs"
  wh -> silver "queries"
  vs ~> serving "feeds"
}

kafka ~> dbx.loader "order events"
analyst -> dbx.wh "SQL"

view landscape {
  title "Databricks Lakehouse"
  include *
  expand dbx
  legend auto
}
