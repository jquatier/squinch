// Databricks lakehouse architecture
pack logos

// External data source (not Databricks)
kafka = logos/kafka "Order Events" external

// Databricks ingestion and storage
autoloader = sys/workflow "Auto Loader" {
  badge: logos/databricks
  description: "Streaming ingestion"
}
bronze = sys/table "Bronze Delta" datastore {
  badge: logos/databricks
  description: "Raw order events"
}
job = sys/workflow "Nightly Merge Job" {
  badge: logos/databricks
}
silver = sys/table "Silver Customers" datastore {
  badge: logos/databricks
  description: "Curated customer data"
}
catalog = sys/catalog "Unity Catalog" {
  badge: logos/databricks
  description: "Data governance"
}

// Analytics and ML
warehouse = sys/database "SQL Warehouse" {
  badge: logos/databricks
}
person analyst "Analyst"

vector = sys/waypoints "Vector Search Index" {
  badge: logos/databricks
}
model = sys/model "Model Serving" {
  badge: logos/databricks
}

// Data flow
kafka ~> autoloader "stream"
autoloader ~> bronze
bronze ~> job "daily batch"
job -> silver
catalog -> silver "governs"
silver -> warehouse
warehouse -> analyst "queries"
silver -> vector "indexes"
vector -> model "embeddings"

view lakehouse {
  title "Databricks Lakehouse Architecture"
  layout {
    direction down
    rows [kafka] [autoloader] [bronze] [job] [silver catalog] [warehouse vector] [analyst model]
  }
}