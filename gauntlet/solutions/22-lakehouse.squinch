pack logos

person analyst "Analyst"
kafka = logos/kafka "Order Events" datastore

system lakehouse "Databricks Lakehouse" {
  description: "Databricks-managed platform"
  icon: logos/databricks
  domain: "data platform"

  autoloader   = sys/stream    "Auto Loader" {
    subtitle: "Databricks Auto Loader"
    badge: logos/databricks
  }
  bronze       = sys/table     "Bronze Table" datastore {
    subtitle: "Bronze Delta table"
    badge: logos/databricks
  }
  merge_job    = sys/workflow  "Nightly Merge Job" {
    subtitle: "Databricks Workflow"
    badge: logos/databricks
  }
  silver       = sys/table     "Customers Table" datastore {
    subtitle: "Silver Delta table"
    badge: logos/databricks
  }
  catalog      = sys/catalog   "Unity Catalog" { badge: logos/databricks }
  warehouse    = sys/database  "SQL Warehouse" {
    subtitle: "Databricks SQL"
    badge: logos/databricks
  }
  vector_index = sys/waypoints "Vector Search Index" { badge: logos/databricks }
  model_serving = sys/model    "Model Serving Endpoint" { badge: logos/databricks }

  autoloader -> bronze "writes"
  merge_job -> bronze "reads"
  merge_job -> silver "merges"
  catalog -- silver "governs"
  warehouse -> silver "reads"
  silver ~> vector_index "sync embeddings"
  vector_index -> model_serving "serves"
}

kafka ~> lakehouse.autoloader "order events"
analyst -> lakehouse.warehouse "queries"
