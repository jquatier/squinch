pack logos

analyst = person "Analyst"
kafka   = logos/kafka "Order Events"

autoloader = sys/stream        "Auto Loader"          { badge: logos/databricks, subtitle: "Auto Loader" }
bronze     = sys/table         "Bronze Orders"  datastore { badge: logos/databricks, subtitle: "Delta table" }
merge      = sys/workflow      "Nightly Merge"        { badge: logos/databricks, subtitle: "Workflows job" }
silver     = sys/table         "Silver Customers" datastore { badge: logos/databricks, subtitle: "Delta table" }
uc         = sys/catalog       "Unity Catalog"        { badge: logos/databricks, subtitle: "Governance" }
warehouse  = sys/database      "SQL Warehouse"  datastore { badge: logos/databricks, subtitle: "Databricks SQL" }
vindex     = sys/vector-search "Vector Search Index"  { badge: logos/databricks }
model      = sys/model         "Model Serving Endpoint" { badge: logos/databricks }

kafka      ~> autoloader "order events"
autoloader ~> bronze     "ingest"
bronze     -> merge
merge      -> silver     "merge"
uc         -> silver     "governs"
silver     -> warehouse
analyst    -> warehouse  "queries"
silver     -> vindex
vindex     -> model      "feeds"

zone lakehouse "Databricks Lakehouse" cloud {
  contains autoloader, bronze, merge, silver, uc, warehouse, vindex, model
}

view landscape {
  title "Databricks Lakehouse"
  include *
}
