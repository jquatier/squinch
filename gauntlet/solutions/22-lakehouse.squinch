pack logos

person analyst "Analyst"

kafka  = logos/apachekafka "Order Events" external {
  subtitle: "Kafka topic"
}

loader = sys/stream "Auto Loader" {
  badge: logos/databricks
  subtitle: "Databricks"
}
bronze = sys/table "Bronze Orders" datastore {
  badge: logos/databricks
  subtitle: "Delta table"
}
job = sys/workflow "Nightly Merge" {
  badge: logos/databricks
  subtitle: "Databricks job"
}
silver = sys/table "Silver Customers" datastore {
  badge: logos/databricks
  subtitle: "Delta table"
}
uc = sys/catalog "Unity Catalog" {
  badge: logos/databricks
  subtitle: "Governance"
}
wh = sys/database "SQL Warehouse" {
  badge: logos/databricks
  subtitle: "Databricks SQL"
}
vs = sys/waypoints "Vector Search Index" {
  badge: logos/databricks
}
serving = sys/model "Model Serving Endpoint" {
  badge: logos/databricks
}

kafka ~> loader "order events"
loader ~> bronze
bronze -> job
job -> silver "merge"
uc -> silver "governs"
analyst -> wh "queries"
wh -> silver
vs ~> serving

zone dbx "Databricks" custom {
  contains loader, bronze, job, silver, uc, wh, vs, serving
  icon: logos/databricks
  color: amber
}

view landscape {
  title "Databricks Lakehouse"
  include *
  legend {
    external "Not Databricks"
    ->  "Request"
    ~>  "Event flow"
  }
}
