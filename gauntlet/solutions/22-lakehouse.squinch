pack sys

person analyst "Data Analyst"

kafka = logos/kafka "Kafka" external {
  description: "Order events stream"
}

system lakehouse "Databricks Lakehouse" {
  description: "Medallion architecture with Unity Catalog governance"
  icon: sys/database
  glyph: sys/workflow

  loader = sys/code "Auto Loader" {
    description: "Incremental ingestion from Kafka"
    subtitle: "Databricks"
    badge: logos/databricks
  }

  bronze = sys/table "Bronze Orders" datastore {
    description: "Raw order events"
    subtitle: "Delta Lake"
    badge: logos/databricks
  }

  job = sys/cog "Merge Job" {
    description: "Nightly aggregation and transformation"
    subtitle: "Databricks Job"
    badge: logos/databricks
  }

  silver = sys/table "Silver Customers" datastore {
    description: "Aggregated customer data"
    subtitle: "Delta Lake"
    badge: logos/databricks
  }

  catalog = sys/database "Unity Catalog" {
    description: "Data governance and access control"
    subtitle: "Databricks"
    badge: logos/databricks
  }

  warehouse = sys/server "SQL Warehouse" {
    description: "Query engine for analytics"
    subtitle: "Databricks"
    badge: logos/databricks
  }

  index = sys/search "Vector Search Index" {
    description: "Embedding-based search"
    subtitle: "Databricks"
    badge: logos/databricks
  }

  serving = sys/network "Model Serving" {
    description: "ML inference endpoint"
    subtitle: "Databricks"
    badge: logos/databricks
  }

  kafka ~> loader "order events"
  loader ~> bronze "append"
  bronze -> job "read"
  job -> silver "merge"
  catalog -> silver "governs"
  silver -> warehouse "query"
  silver -> index "embeds"
  index -> serving "vector lookup"

  layout {
    rows [loader] [bronze] [job] [catalog] [silver] [warehouse index] [serving]
    place index right-of warehouse
  }
}

analyst -> lakehouse.warehouse "runs queries"

view landscape {
  title "Databricks Lakehouse Architecture"
  include *
  expand lakehouse
  titleblock {
    subtitle: "Medallion architecture"
    version: "2026-10"
  }
}
