pack logos

// External source
kafka = logos/kafka "Order Events" external

// Ingestion layer
autoloader = sys/workflow "Auto Loader" {
  badge: logos/databricks
  subtitle: "Streaming ingestion"
}

// Storage layer - Bronze
bronze = sys/table "Bronze Orders" datastore {
  badge: logos/databricks
  subtitle: "Raw Delta table"
}

// Processing
job = sys/workflow "Merge Job" {
  badge: logos/databricks
  subtitle: "Nightly transform"
}

// Storage layer - Silver
silver = sys/table "Silver Customers" datastore {
  badge: logos/databricks
  subtitle: "Curated Delta"
}

// Governance
catalog = sys/catalog "Unity Catalog" {
  badge: logos/databricks
  description: "Data governance"
}

// Analytics
warehouse = sys/database "SQL Warehouse" {
  badge: logos/databricks
  subtitle: "Databricks SQL"
}

// ML components
vector = sys/waypoints "Vector Search" {
  badge: logos/databricks
  description: "Embedding index"
}

serving = sys/model "Model Serving" {
  badge: logos/databricks
  description: "ML endpoint"
}

// Actors
analyst = person "Analyst"

// Data flow
kafka ~> autoloader "streams"
autoloader -> bronze "writes"
bronze -> job "reads"
job -> silver "merges"
catalog -> silver "governs"
silver -> warehouse "queries"
silver -> vector "indexes"
vector -> serving "powers"
analyst -> warehouse "queries"

view lakehouse {
  title "Databricks Lakehouse Architecture"
  layout {
    rows [kafka] [autoloader] [bronze] [job] [silver catalog] [warehouse vector] [serving]
    place analyst left-of warehouse
    place catalog right-of silver
  }
}
