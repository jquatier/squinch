// Databricks lakehouse architecture
pack logos

// External data source
kafka = logos/kafka "Order Events" external

// Databricks components - using sys/* icons with databricks badge
autoloader = sys/code "Auto Loader" { badge: logos/databricks }
bronze = sys/table "Bronze Delta Table" datastore { badge: logos/databricks }
job = sys/workflow "Nightly Merge Job" { badge: logos/databricks }
silver = sys/table "Silver Customers Table" datastore { badge: logos/databricks }
catalog = sys/catalog "Unity Catalog" { badge: logos/databricks }
warehouse = sys/database "SQL Warehouse" { badge: logos/databricks }
vector = sys/waypoints "Vector Search Index" { badge: logos/databricks }
serving = sys/model "Model Serving Endpoint" { badge: logos/databricks }

// Analysts
person analyst "Analysts"

// Connections
kafka ~> autoloader "stream events"
autoloader ~> bronze "ingest"
job -> bronze "read"
job -> silver "merge"
catalog -> silver "governs"
analyst -> warehouse "query"
warehouse -> silver "read"
silver -> vector "index"
vector -> serving "feeds"
