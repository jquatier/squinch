pack logos

person analyst "Analyst"

kafka = logos/kafka "Kafka" external {
  subtitle: "Order events"
}

system dbx "Databricks" {
  description: "Lakehouse platform"
  icon: logos/databricks

  loader  = sys/stream    "Auto Loader" { badge: logos/databricks }
  bronze  = sys/table     "Bronze Orders" datastore { badge: logos/databricks, subtitle: "Delta table" }
  job     = sys/workflow  "Nightly Merge" { badge: logos/databricks, subtitle: "Workflows job" }
  silver  = sys/table     "Silver Customers" datastore { badge: logos/databricks, subtitle: "Delta table" }
  uc      = sys/catalog   "Unity Catalog" { badge: logos/databricks }
  wh      = sys/database  "SQL Warehouse" { badge: logos/databricks, subtitle: "Databricks SQL" }
  vs      = sys/waypoints "Vector Search Index" { badge: logos/databricks }
  serving = sys/model     "Model Serving Endpoint" { badge: logos/databricks }

  loader ~> bronze "lands"
  bronze -> job "reads"
  job -> silver "merges"
  uc -> silver "governs"
  wh -> silver "queries"
  vs ~> serving "feeds"
}

kafka ~> dbx.loader "order events"
analyst -> dbx.wh "queries"

view lakehouse {
  title "Databricks Lakehouse"
  include *
  expand dbx
  legend auto
  note right-of kafka "Hatched = not Databricks; badge = Databricks-owned"
}
