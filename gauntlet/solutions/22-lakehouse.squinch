pack logos

person analyst "Data Analyst"

kafka = logos/kafka "Order Events" external

system bronze "Bronze Layer" {
  description: "Raw ingestion zone"
  loader = sys/workflow "Auto Loader" { badge: logos/databricks, subtitle: "Databricks" }
  bronze_table = sys/table "Bronze Orders" datastore { badge: logos/databricks }

  loader -> bronze_table
}

system silver "Silver Layer" {
  description: "Cleaned and merged data"
  job = sys/workflow "Nightly Merge" { badge: logos/databricks, subtitle: "Databricks Job" }
  customers = sys/table "Customers" datastore { badge: logos/databricks }

  job -> customers
}

system serving "ML Serving" {
  description: "Vector search and model serving"
  vector = sys/waypoints "Vector Search" { badge: logos/databricks }
  model = sys/model "Model Endpoint" { badge: logos/databricks, subtitle: "Databricks" }

  vector -> model
}

catalog = sys/catalog "Unity Catalog" { badge: logos/databricks }
warehouse = sys/database "SQL Warehouse" { badge: logos/databricks, subtitle: "Databricks SQL" }

kafka ~> bronze.loader "order events"
bronze.bronze_table ~> silver.job "stream"
silver.customers -> catalog "governed by"
catalog -> warehouse "queries"
silver.customers -> serving.vector "indexed"
warehouse -> analyst "analytics"
serving.model -> analyst "predictions"

view landscape {
  title "Databricks Lakehouse"
  layout {
    rows [kafka] [bronze] [silver catalog] [serving warehouse] [analyst]
    place warehouse right-of serving
  }
}
