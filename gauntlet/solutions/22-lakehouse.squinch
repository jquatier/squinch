// Databricks Lakehouse Architecture
pack logos

// External systems
kafka = logos/kafka "Kafka Order Events"

// Databricks components (using sys/* with badges per SKILL.md guidance)
loader = sys/workflow "Auto Loader" { badge: logos/databricks }
bronze = sys/table "Bronze Delta Table" datastore { badge: logos/databricks }
job = sys/workflow "Merge Job" {
  badge: logos/databricks
  description: "Nightly merge"
}
silver = sys/table "Silver Customers Table" datastore { badge: logos/databricks }
catalog = sys/catalog "Unity Catalog" { badge: logos/databricks }
warehouse = sys/database "SQL Warehouse" datastore { badge: logos/databricks }
vector = sys/waypoints "Vector Search Index" { badge: logos/databricks }
model = sys/model "Model Serving Endpoint" { badge: logos/databricks }

// Analysts
analyst = person "Analyst"

// Edges - Kafka to bronze is streaming (async), rest are sync/data flows
kafka ~> loader "stream events"
loader ~> bronze "write raw"
bronze -> job "read"
job -> silver "merge"
silver -> catalog "governed by"
catalog -> warehouse
analyst -> warehouse "queries"
silver -> vector "indexes"
vector -> model "feeds"

view main {
  title "Databricks Lakehouse Architecture"
  layout {
    rows [kafka] [loader] [bronze] [job] [silver catalog] [warehouse analyst vector] [model]
  }
}
