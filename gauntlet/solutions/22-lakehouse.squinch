// Databricks Lakehouse Architecture
pack logos

// External data source
kafka = logos/kafka "Order Events" {
  description: "Kafka topic with order data"
}

// Databricks components
system lakehouse "Databricks Lakehouse" {
  description: "Data processing and analytics platform"
  icon: sys/database

  // Ingestion
  autoloader = sys/stream "Auto Loader" {
    badge: logos/databricks
    subtitle: "Databricks Auto Loader"
    description: "Incrementally loads data from Kafka"
  }

  // Bronze layer
  bronze = sys/table "Bronze Table" datastore {
    badge: logos/databricks
    subtitle: "Delta Lake"
    description: "Raw order events"
  }

  // Processing job
  merge_job = sys/workflow "Nightly Merge Job" {
    badge: logos/databricks
    subtitle: "Databricks Workflows"
    description: "Merges bronze data into silver"
  }

  // Silver layer
  silver = sys/table "Silver Customers Table" datastore {
    badge: logos/databricks
    subtitle: "Delta Lake"
    description: "Clean, merged customer data"
  }

  // Governance
  catalog = sys/catalog "Unity Catalog" {
    badge: logos/databricks
    subtitle: "Unity Catalog"
    description: "Data governance and access control"
  }

  // Analytics
  warehouse = sys/database "SQL Warehouse" {
    badge: logos/databricks
    subtitle: "Databricks SQL"
    description: "Query engine for analysts"
  }

  // Vector search
  vector_index = sys/waypoints "Vector Search Index" {
    badge: logos/databricks
    subtitle: "Vector Search"
    description: "Embeddings for similarity search"
  }

  // Model serving
  model = sys/model "Model Serving" {
    badge: logos/databricks
    subtitle: "Model Serving"
    description: "ML endpoint powered by vector search"
  }

  // Data flow
  autoloader -> bronze
  bronze ~> merge_job "scheduled"
  merge_job -> silver
  catalog -> silver "governs"
  silver -> warehouse
  silver -> vector_index
  vector_index -> model

  layout {
    rows [autoloader] [bronze] [merge_job] [catalog] [silver] [warehouse vector_index] [model]
  }
}

// Actors
person analyst "Analyst"

// External connections
kafka ~> lakehouse.autoloader "order events"
analyst -> lakehouse.warehouse "queries"

view architecture {
  title "Databricks Lakehouse Architecture"
  expand lakehouse
  titleblock {
    subtitle: "Data processing flow"
    version: "2026-09"
  }
}
