// Databricks Lakehouse Architecture
pack logos

// External data source (not Databricks)
kafka = logos/kafka "Kafka" external

// Databricks components
system lakehouse "Lakehouse Platform" {
  description: "Databricks-managed data platform"
  glyph: sys/database

  // Ingestion
  loader = sys/webhook "Auto Loader" {
    description: "Event ingestion"
    badge: logos/databricks
  }

  // Storage layers
  bronze = sys/table "Bronze Delta Table" datastore {
    description: "Raw order events"
    badge: logos/databricks
  }

  silver = sys/table "Silver Customers Table" datastore {
    description: "Cleansed customer data"
    badge: logos/databricks
  }

  // Processing
  job = sys/workflow "Nightly Merge Job" {
    description: "ETL pipeline"
    badge: logos/databricks
  }

  // Governance
  catalog = sys/catalog "Unity Catalog" {
    description: "Data governance"
    badge: logos/databricks
  }

  // Analytics
  warehouse = sys/database "SQL Warehouse" {
    description: "Query engine"
    badge: logos/databricks
  }

  // ML components
  vector = sys/waypoints "Vector Search Index" {
    description: "Embeddings index"
    badge: logos/databricks
  }

  serving = sys/model "Model Serving" {
    description: "Inference endpoint"
    badge: logos/databricks
  }
}

// Actors
analyst = person "Analyst"

// Data flow
kafka ~> lakehouse.loader "order events"
lakehouse.loader ~> lakehouse.bronze "stream to bronze"
lakehouse.job -> lakehouse.bronze "read raw"
lakehouse.job -> lakehouse.silver "merge nightly"
lakehouse.catalog -> lakehouse.silver "governs"
lakehouse.warehouse -> lakehouse.silver "queries"
analyst -> lakehouse.warehouse "runs queries"
lakehouse.silver ~> lakehouse.vector "feeds embeddings"
lakehouse.vector -> lakehouse.serving "powers inference"

view landscape {
  title "Databricks Lakehouse"
  include *
  show descriptions
  legend auto
}
