pack logos

person analyst "Analyst"

kafka = logos/kafka "Order Events" external {
  subtitle: "Kafka · not Databricks"
}

system dbx "Databricks Lakehouse" {
  description: "Everything inside this frame is Databricks' own"
  icon: logos/databricks

  loader = sys/stream "Auto Loader" { badge: logos/databricks }
  bronze = sys/table "Bronze Orders" datastore {
    badge: logos/databricks
    subtitle: "Delta table"
  }
  job    = sys/workflow "Nightly Merge" {
    badge: logos/databricks
    subtitle: "Workflows job"
  }
  silver = sys/table "Silver Customers" datastore {
    badge: logos/databricks
    subtitle: "Delta table"
  }
  uc     = sys/catalog "Unity Catalog" { badge: logos/databricks }
  wh     = sys/database "SQL Warehouse" {
    badge: logos/databricks
    subtitle: "Databricks SQL"
  }
  vs     = sys/waypoints "Vector Search Index" { badge: logos/databricks }
  serve  = sys/model "Model Serving Endpoint" { badge: logos/databricks }

  loader -> bronze "lands"
  job -> bronze "reads"
  job -> silver "merges"
  uc -> silver "governs"
  wh -> silver "queries"
  vs ~> serve "feeds"
}

kafka ~> dbx.loader "order events"
analyst -> dbx.wh "queries"

view landscape {
  title "Databricks Lakehouse"
  include *
  expand dbx
  about """
  Hatched box = **not Databricks** (Kafka). Everything inside the frame, marked with the Databricks badge, is Databricks' own.
  """
}
