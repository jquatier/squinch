// Databricks Lakehouse Architecture
pack logos

person analyst "Data Analyst"

// External data source
kafka = logos/kafka "Kafka Orders Topic" external

// Databricks ingestion and storage layers
autoloader = sys/workflow "Auto Loader" {
  description: "Ingests streaming data"
  badge: logos/databricks
}

bronze = sys/table "Bronze Orders" datastore {
  description: "Raw order events"
  badge: logos/databricks
}

job = sys/workflow "Nightly Merge Job" {
  description: "Transforms and merges"
  badge: logos/databricks
}

silver = sys/table "Silver Customers" datastore {
  description: "Curated customer data"
  badge: logos/databricks
}

catalog = sys/catalog "Unity Catalog" {
  description: "Data governance"
  badge: logos/databricks
}

warehouse = sys/database "SQL Warehouse" {
  description: "Query engine"
  badge: logos/databricks
}

vectorsearch = sys/waypoints "Vector Search Index" {
  badge: logos/databricks
}

modelserving = sys/model "Model Serving" {
  description: "ML inference endpoint"
  badge: logos/databricks
}

// Data flows
kafka ~> autoloader "stream events"
autoloader ~> bronze "land raw"
bronze -> job "read"
job -> silver "merge"
catalog -> silver "governs"
analyst -> warehouse "queries"
warehouse -> silver "read"
silver -> vectorsearch "index"
vectorsearch -> modelserving "embeddings"
