pack aws

system crud "Items API" {
  api    = aws/api-gateway "API Gateway"
  create = aws/lambda "Create"
  read   = aws/lambda "Read"
  update = aws/lambda "Update"
  delete = aws/lambda "Delete"
  search = aws/lambda "Search"
  table  = aws/dynamodb "Table" datastore

  api -> create, read, update, delete, search
  create -> table
  read -> table
  update -> table
  delete -> table
  search -> table
}

view crud {
  title "Items API"
  layout {
    channel create, read, update, delete, search -> table
  }
}
