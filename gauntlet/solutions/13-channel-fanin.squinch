pack aws

system api "REST API" {
  gw = aws/api-gateway "API Gateway"

  create = aws/lambda "Create Handler"
  read = aws/lambda "Read Handler"
  update = aws/lambda "Update Handler"
  delete = aws/lambda "Delete Handler"
  search = aws/lambda "Search Handler"

  db = aws/dynamodb "Items Table" datastore

  gw -> create, read, update, delete, search
  create -> db
  read -> db
  update -> db
  delete -> db
  search -> db
}

view api {
  layout {
    rows [gw] [create read update delete search] [db]
    channel create, read, update, delete, search -> db
  }
}
