pack aws

gw = aws/api-gateway "API Gateway"
create = aws/lambda "Create Handler"
read = aws/lambda "Read Handler"
update = aws/lambda "Update Handler"
delete = aws/lambda "Delete Handler"
search = aws/lambda "Search Handler"
table = aws/dynamodb "Orders Table" datastore

gw -> create
gw -> read
gw -> update
gw -> delete
gw -> search

create -> table
read -> table
update -> table
delete -> table
search -> table

view main {
  title "Lambda Fan-in Architecture"
  layout {
    rows [gw] [create read update delete search] [table]
    channel create, read, update, delete, search -> table
  }
}
