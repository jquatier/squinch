pack aws

system items "Item Service" {
  api    = aws/api-gateway "API Gateway"
  create = aws/lambda "Create Handler"
  read   = aws/lambda "Read Handler"
  update = aws/lambda "Update Handler"
  delete = aws/lambda "Delete Handler"
  search = aws/lambda "Search Handler"
  table  = aws/dynamodb "Table" datastore

  api -> create, read, update, delete, search
  create -> table "writes"
  read -> table "writes"
  update -> table "writes"
  delete -> table "writes"
  search -> table "writes"
}

view items {
  title "Item Service"
  layout {
    channel items.create, items.read, items.update, items.delete, items.search -> items.table
  }
}
