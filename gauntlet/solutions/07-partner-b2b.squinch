pack aws

partner = box "Partner System" external

gw   = aws/api-gateway   "Public API Gateway"
wf   = aws/step-functions "Request Workflow"
val  = aws/lambda        "Validation"
bill = aws/lambda        "Billing"
db   = aws/aurora        "Aurora" datastore

partner -> gw "calls"
gw -> wf "starts"
wf -> val "validates"
wf -> bill "bills"
bill -> db "writes"

view landscape {
  title "Partner B2B API"
  include *
}
