pack aws

partner = box "Partner System" external

system integration "Partner Integration" {
  gw       = aws/api-gateway    "API Gateway"
  workflow = aws/step-functions "Orchestration Workflow"
  validate = aws/lambda         "Validation Handler"
  billing  = aws/lambda         "Billing Handler"
  db       = aws/aurora         "Billing Database" datastore

  gw -> workflow
  workflow -> validate
  workflow -> billing
  billing -> db
}

partner -> integration.gw "API calls"
