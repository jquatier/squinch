pack aws

partner = box "Partner System" external

system b2b "B2B Integration" {
  gw       = aws/api-gateway    "API Gateway"
  workflow = aws/step-functions "Partner Workflow"
  validate = aws/lambda         "Validation Handler"
  billing  = aws/lambda         "Billing Handler"
  db       = aws/aurora         "Aurora DB" datastore

  gw -> workflow
  workflow -> validate
  workflow -> billing
  billing -> db
}

partner -> b2b.gw "API request"
