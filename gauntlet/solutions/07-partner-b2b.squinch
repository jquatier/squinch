pack aws

partner = box "Partner System" external

system orders "Order Service" {
  api      = aws/api-gateway    "API Gateway"
  workflow = aws/step-functions "Order Workflow"
  validate = aws/lambda         "Validation Lambda"
  billing  = aws/lambda         "Billing Lambda"
  db       = aws/aurora         "Orders DB" datastore

  api -> workflow
  workflow -> validate
  workflow -> billing
  billing -> db
}

partner -> orders.api "submits order"
