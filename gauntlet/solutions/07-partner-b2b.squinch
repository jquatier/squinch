pack aws

partner = box "Partner System" external

system api_integration "B2B Integration" {
  description: "Partner API integration workflow"

  gw = aws/api-gateway "Public API Gateway"
  wf = aws/step-functions "Orchestration Workflow"
  validate = aws/lambda "Validation"
  billing = aws/lambda "Billing"
  db = aws/aurora "Aurora DB" datastore

  gw -> wf
  wf -> validate
  wf -> billing
  billing -> db
}

partner -> api_integration.gw "API request"
