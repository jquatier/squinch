pack aws

partner = box "Partner System" external

gw = aws/api-gateway "API Gateway"
workflow = aws/step-functions "Partner Workflow" {
  description: "Orchestrates validation and billing"
}
validate = aws/lambda "Validation Handler" {
  subtitle: "Input validation"
}
billing = aws/lambda "Billing Handler" {
  subtitle: "Transaction processing"
}
db = aws/aurora "Billing Database" datastore

partner -> gw "API request"
gw -> workflow
workflow -> validate
workflow -> billing
billing -> db "writes"

view integration {
  title "Partner B2B Integration"
}
