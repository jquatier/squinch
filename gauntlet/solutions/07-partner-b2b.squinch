pack aws

partner = box "Partner System" external

system integration "Partner Integration" {
  api = aws/api-gateway "API Gateway"
  workflow = aws/step-functions "Request Orchestrator"
  validator = aws/lambda "Validation"
  billing = aws/lambda "Billing"
  db = aws/aurora "Orders DB" datastore

  api -> workflow
  workflow -> validator
  workflow -> billing
  billing -> db
}

partner -> integration.api "API request"
