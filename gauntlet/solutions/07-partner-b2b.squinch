pack aws

partner = box "Partner System" external

system integration "B2B Integration" {
  gw       = aws/api-gateway    "API Gateway"
  workflow = aws/step-functions "Request Workflow"
  validate = aws/lambda         "Validation"
  billing  = aws/lambda         "Billing"
  db       = aws/aurora         "Billing Database" datastore

  gw -> workflow
  workflow -> validate
  workflow -> billing
  billing -> db
}

partner -> integration.gw "API request"
