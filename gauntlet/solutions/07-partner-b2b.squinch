pack aws

partner = box "Partner System" external

gw       = aws/api-gateway "Public API Gateway"
workflow = aws/step-functions "Request Workflow"
validate = aws/lambda "Validation Lambda"
billing  = aws/lambda "Billing Lambda"
db       = aws/aurora "Aurora" datastore

partner -> gw "calls"
gw -> workflow "starts"
workflow -> validate
workflow -> billing
billing -> db "writes"

view landscape {
  title "Partner B2B API"
  include *
}
