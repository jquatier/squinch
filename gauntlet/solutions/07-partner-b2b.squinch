pack aws

partner = box "Partner System" external

api   = aws/api-gateway "Public API Gateway"
wf    = aws/step-functions "Request Workflow"
valid = aws/lambda "Validation"
bill  = aws/lambda "Billing"
db    = aws/aurora "Aurora" datastore

partner -> api "calls"
api -> wf "starts workflow"
wf -> valid
wf -> bill
bill -> db "writes"

view landscape {
  title "Partner B2B Flow"
  include *
}
