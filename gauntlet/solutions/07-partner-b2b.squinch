pack aws

partner = box "Partner System" external

gw = aws/api-gateway "API Gateway"
workflow = aws/step-functions "Integration Workflow"
validate = aws/lambda "Validation"
billing = aws/lambda "Billing"
db = aws/aurora "Aurora DB" datastore

partner -> gw "API request"
gw -> workflow
workflow -> validate "1. validate"
workflow -> billing "2. bill"
billing -> db "write"
