pack aws

// External partner system
partner = box "Partner System" external

// Our infrastructure
gw       = aws/api-gateway     "API Gateway"
workflow = aws/step-functions  "Orchestration Workflow"
validate = aws/lambda          "Validation Lambda"
billing  = aws/lambda          "Billing Lambda"
db       = aws/aurora          "Aurora DB" datastore

// Connections
partner -> gw "API request"
gw -> workflow
workflow -> validate
workflow -> billing
billing -> db

view default {
  title "Partner B2B Integration"
  layout {
    rows [partner] [gw] [workflow] [validate billing] [db]
  }
}
