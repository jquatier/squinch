pack aws

partner = box "Partner System" external

system api "B2B Integration" {
  gw = aws/api-gateway "API Gateway"
  workflow = aws/step-functions "Workflow Orchestrator"
  validate = aws/lambda "Validation"
  billing = aws/lambda "Billing"
  db = aws/aurora "Billing DB" datastore

  gw -> workflow
  workflow -> validate
  workflow -> billing
  billing -> db
}

partner -> api.gw "API request"
