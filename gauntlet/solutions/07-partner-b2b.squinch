pack aws

// External partner calls our B2B API
partner = box "Partner System" external

// Our B2B integration system
system b2b "B2B Integration" {
  description: "Partner request processing"

  api = aws/api-gateway "API Gateway"
  workflow = aws/step-functions "Request Orchestrator"
  validate = aws/lambda "Validation"
  billing = aws/lambda "Billing"
  db = aws/aurora "Database" datastore

  api -> workflow
  workflow -> validate
  workflow -> billing
  billing -> db
}

partner -> b2b.api "API request"
