pack aws

partner = box "Partner ERP" external

system billing "Billing Integration" {
  gw       = aws/api-gateway   "Public API"
  wf       = aws/step-functions "Billing Workflow"
  validate = aws/lambda        "Validate Request"
  bill     = aws/lambda        "Create Invoice"
  db       = aws/aurora        "Invoices"

  gw -> wf "start execution"
  wf -> validate
  wf -> bill
  bill -> db
}

partner -> billing.gw "B2B API calls"

view billing {
  layout {
    rows [gw] [wf] [validate bill] [db]
  }
}
