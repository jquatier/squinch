pack aws

partner = box "Partner System" external

gw  = aws/api-gateway "Public API Gateway"
sfn = aws/step-functions "Request Workflow"
validate = aws/lambda "Validation"
billing  = aws/lambda "Billing"
db = aws/aurora "Aurora" datastore

partner -> gw "calls API"
gw -> sfn "starts workflow"
sfn -> validate
sfn -> billing
billing -> db "writes"

view landscape {
  title "Partner B2B Flow"
  include *
}
