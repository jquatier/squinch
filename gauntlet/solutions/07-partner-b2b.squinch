pack aws

partner = box "Partner System" external
api = aws/api-gateway "Public API"
wf = aws/step-functions "Request Workflow"
validate = aws/lambda "Validation"
billing = aws/lambda "Billing"
db = aws/aurora "Aurora" datastore

partner -> api "calls"
api -> wf "starts"
wf -> validate
wf -> billing
billing -> db "writes"

view main {
  title "Partner B2B"
  include *
}
