pack aws

partner = box "Partner System" external

system platform "Our Platform" {
  gw         = aws/api-gateway "Public API"
  workflow   = aws/step-functions "Request Workflow"
  validate   = aws/lambda "Validation"
  billing    = aws/lambda "Billing"
  db         = aws/aurora "Aurora" datastore

  gw -> workflow
  workflow -> validate
  workflow -> billing
  billing -> db "writes"
}

partner -> platform.gw "calls"

view landscape {
  title "Partner B2B Integration"
  include *
  expand platform
}
