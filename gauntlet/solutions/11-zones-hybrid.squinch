pack aws

person operator "Operators"

system datacenter "On-Prem Data Center" {
  description: "Legacy on-premises infrastructure"
  glyph: aws/corporate-data-center

  erp = box "Oracle ERP" datastore

  operator -> erp "uses"
}

system aws_estate "AWS" {
  ingest = aws/lambda "Ingestion Lambda"
  aurora = aws/aurora  "Aurora"

  ingest -> aurora "writes"
}

datacenter.erp ~> aws_estate.ingest "feeds"

zone onprem_zone "On-Premises" onprem {
  contains datacenter, operator
}

zone aws_zone "AWS" cloud {
  contains aws_estate
}

zone db_vpc "Database VPC" vpc {
  contains aws_estate.aurora
}

view landscape {
  title "Hybrid Estate"
  include *
  expand datacenter
}
