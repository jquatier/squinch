pack aws
pack logos

person operator "Operator"
system erp "ERP System" external {
  app = box "Legacy ERP" {
    subtitle: "Oracle-style"
  }
}

ingest = aws/lambda "Ingestion Handler"
db = aws/aurora "Aurora DB" datastore

ingest -> db

operator -> erp.app "uses"
erp.app -> ingest "feeds data"

zone onprem "On-Premises" onprem {
  contains operator, erp
}

zone aws_cloud "AWS" cloud {
  contains ingest, db
}

zone vpc "VPC" vpc {
  contains db
}

view landscape {
  title "Hybrid Estate Architecture"
  include *
}
