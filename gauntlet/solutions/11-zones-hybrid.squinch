// Hybrid estate: on-premises ERP feeding AWS cloud ingestion
pack aws
pack logos

// On-premises side
person operator "Operators"
erp = box "Legacy ERP" {
  description: "Oracle-style system"
  tags: #onprem
}

// AWS cloud side
ingest = aws/lambda "Ingestion Lambda" {
  tags: #cloud
}
db = aws/aurora "Aurora Database" datastore {
  tags: #cloud
}

// Connections
operator -> erp
erp -> ingest "feeds data"
ingest -> db

// Deployment boundaries
zone datacenter "On-Premises Data Center" onprem {
  contains operator, erp
}

zone aws_cloud "AWS Cloud" cloud {
  contains ingest, db
}

zone prod_vpc "VPC" vpc {
  contains db
}
