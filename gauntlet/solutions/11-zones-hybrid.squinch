pack aws

// On-premises components
person ops "Operators"
erp = box "Legacy ERP" datastore {
  description: "Oracle-style system"
}

// AWS cloud components
ingest = aws/lambda "Ingestion Lambda"
db = aws/aurora "Aurora DB" datastore

// Connections
ops -> erp
erp -> ingest "feeds data"
ingest -> db "writes"

// Deployment boundaries
zone onprem "On-Premises Data Centre" onprem {
  contains ops, erp
}

zone aws_cloud "AWS Cloud" cloud {
  contains ingest, db
}

zone db_vpc "Database VPC" vpc {
  contains db
}

// Default view showing the hybrid architecture
view landscape {
  title "Hybrid Architecture"
  include *
}
