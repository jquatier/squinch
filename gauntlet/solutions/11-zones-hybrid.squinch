// Hybrid estate: on-premises legacy system feeding AWS cloud
pack aws

// On-premises components
person ops "Operators"
erp = box "Legacy ERP" external {
  description: "Oracle-style ERP"
}

// AWS cloud components
ingest = aws/lambda "Ingestion Lambda"
db = aws/aurora "Aurora Database" datastore

// Connections
ops -> erp "uses"
erp -> ingest "feeds data"
ingest -> db "writes"

// Deployment boundaries
zone onprem "On-Premises Data Center" onprem {
  contains ops, erp
}

zone cloud "AWS Cloud" cloud {
  contains ingest, db
}

zone vpc "VPC" vpc {
  contains db
}
