pack aws
pack logos

person ops "Operators"

erp = sys/database "Legacy ERP" {
  subtitle: "Oracle-style"
}

ingest = aws/lambda "Ingestion Handler"
db = aws/aurora "Aurora DB" datastore

ops -> erp "operates"
erp -> ingest "feeds data"
ingest -> db "writes"

zone onprem "On-Premises Data Center" onprem {
  contains erp
  icon: sys/building-2
}

zone aws_cloud "AWS Cloud" cloud {
  contains ingest, db
}

zone vpc "Production VPC" vpc {
  contains db
}
