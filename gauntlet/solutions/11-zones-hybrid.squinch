pack aws

person operator "Operators"

erp     = sys/database  "ERP System" datastore { subtitle: "Legacy Oracle-style" }
ingest  = aws/lambda     "Ingestion Lambda"
aurora  = aws/aurora     "Aurora DB" datastore

operator -> erp "uses"
erp -> ingest "feeds"
ingest -> aurora "writes"

zone onprem "On-Premises Data Center" onprem {
  icon: aws/corporate-data-center
  contains operator, erp
}

zone aws_cloud "AWS Cloud" cloud {
  icon: aws/cloud
  contains ingest, aurora
}

zone db_vpc "Database VPC" vpc {
  contains aurora
}
