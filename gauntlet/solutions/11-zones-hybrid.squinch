pack aws
pack logos

person operator "Operator"

erp = box "Legacy ERP" external {
  subtitle: "Oracle-style"
}
ingest = aws/lambda "Ingestion Handler"
db = aws/aurora "Orders DB" datastore

operator -> erp "uses"
erp ~> ingest "feeds data"
ingest -> db "writes"

zone onprem "On-Premises Data Center" onprem {
  contains operator, erp
}

zone cloud "AWS Cloud" cloud {
  contains ingest, db
}

zone vpc "VPC" vpc {
  contains db
}
