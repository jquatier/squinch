pack aws
pack logos

// On-premises environment
person ops "Operators"
erp = sys/database "Legacy ERP" {
  tags: #onprem
}

// AWS cloud environment
ingest = aws/lambda "Ingestion Lambda" {
  tags: #cloud
}
db = aws/aurora "Aurora Database" datastore {
  tags: #cloud
}

// Connections
ops -> erp
erp -> ingest
ingest -> db

// Deployment boundaries
zone onprem_dc "On-Premises Data Centre" onprem {
  contains ops, erp
}

zone aws_cloud "AWS Cloud" cloud {
  contains ingest, db
}

zone db_vpc "Database VPC" vpc {
  contains db
}
