pack aws

// On-premises components
person operator "Operators"
erp = sys/database "Legacy ERP" external

// AWS components
ingest = aws/lambda "Ingestion Lambda"
db = aws/aurora "Aurora Database" datastore

// Connections
operator -> erp
erp ~> ingest "feeds data"
ingest -> db

// Boundaries
zone onprem "On-Premises Data Centre" onprem {
  contains operator, erp
}

zone aws_cloud "AWS Cloud" cloud {
  contains ingest, db
}

zone vpc "VPC" vpc {
  contains db
}

view landscape {
  title "Hybrid Estate"
  include *
}
