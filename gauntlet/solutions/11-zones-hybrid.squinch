pack aws

person operators "Operators"

erp    = box "Legacy ERP" { subtitle: "Oracle-style" }
ingest = aws/lambda "Ingestion Lambda"
db     = aws/aurora "Aurora Database" datastore

operators -> erp "use"
erp ~> ingest "feeds data"
ingest -> db "writes"

zone dc "On-Premises Data Centre" onprem {
  contains operators, erp
}
zone cloud "AWS Cloud" cloud {
  contains ingest, db
}
zone vpc "Database VPC" vpc {
  contains db
}

view landscape {
  title "Hybrid Estate"
  include *
}
