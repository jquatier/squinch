pack aws

person operators "Operators"

erp = box "Legacy ERP" external {
  description: "Oracle-style ERP"
}

ingestion = aws/lambda "Ingestion Lambda"
db = aws/aurora "Aurora Database" datastore

operators -> erp "uses"
erp -> ingestion "feeds data"
ingestion -> db "writes"

zone onprem "On-Premises Data Center" onprem {
  contains operators, erp
}

zone cloud "AWS Cloud" cloud {
  contains ingestion, db
}

zone vpc "Database VPC" vpc {
  contains db
}
