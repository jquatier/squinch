pack aws

person operators "Operators"
erp = box "Legacy ERP" external

ingest = aws/lambda "Ingestion Lambda"
db = aws/aurora "Aurora DB" datastore

operators -> erp "uses"
erp -> ingest "feeds data"
ingest -> db "writes"

zone datacenter "On-Premises Data Center" onprem {
  contains operators, erp
}

zone cloud_zone "AWS Cloud" cloud {
  contains ingest, db
}

zone vpc "Production VPC" vpc {
  contains db
}
