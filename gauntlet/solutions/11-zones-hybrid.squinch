pack aws
pack logos

// On-premises side
operator = person "Operators"
erp = sys/database "Legacy ERP" {
  description: "Oracle-style ERP"
}

// AWS cloud side
ingest = aws/lambda "Ingestion Lambda"
db = aws/aurora "Aurora Database" datastore

// Connections
operator -> erp
erp ~> ingest "data feed"
ingest -> db

// Deployment boundaries
zone onprem "On-Premises Data Centre" onprem {
  contains operator, erp
}

zone aws_cloud "AWS Cloud" cloud {
  contains ingest, db
}

zone vpc "VPC" vpc {
  contains db
}
