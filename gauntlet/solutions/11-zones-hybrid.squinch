pack aws

// On-premises actors and systems
person operator "Operator"
erp = sys/database "Legacy ERP" external

// AWS cloud components
ingest = aws/lambda "Ingestion Lambda"
db = aws/aurora "Aurora Database" datastore

// Connections
operator -> erp "uses"
erp ~> ingest "feeds data"
ingest -> db "writes"

// Deployment boundaries
zone onprem "On-Premises Data Centre" onprem {
  contains operator, erp
}

zone cloud "AWS Cloud" cloud {
  contains ingest, db
}

zone vpc "VPC" vpc {
  contains db
}
