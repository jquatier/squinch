pack aws

person operator "Operator"
erp = sys/database "Legacy ERP" { subtitle: "Oracle-style, on-prem" }

ingest = aws/lambda  "Ingestion Lambda"
db     = aws/aurora  "Aurora Database" datastore

operator -> erp "operates"
erp ~> ingest "feeds"
ingest -> db "writes"

zone onprem "On-Premises Data Center" onprem {
  icon: aws/corporate-data-center
  contains operator, erp
}

zone cloud "AWS Cloud" cloud {
  icon: aws/cloud
  contains ingest, db
}

zone db_vpc "Database VPC" vpc {
  icon: aws/vpc
  contains db
}
