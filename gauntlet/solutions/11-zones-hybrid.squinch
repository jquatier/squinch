pack aws

person operator "Operator"
erp    = sys/database "ERP System" { description: "Legacy Oracle-style ERP" }
ingest = aws/lambda   "Ingestion Lambda"
aurora = aws/aurora   "Aurora Database" datastore

operator -> erp "manages data"
erp ~> ingest "feeds data"
ingest -> aurora "writes"

zone onprem "On-Premises Data Center" onprem {
  contains operator, erp
}

zone cloud_aws "AWS Cloud" cloud {
  contains ingest, aurora
}

zone vpc "VPC" vpc {
  contains aurora
}
