pack aws
pack logos

// On-premises side
person operator "Operator"
erp = box "Legacy ERP" external {
  subtitle: "Oracle-style system"
}

// AWS side
ingest = aws/lambda "Ingestion Lambda"
db = aws/aurora "Aurora Database" datastore

// Connections
operator -> erp
erp ~> ingest "data feed"
ingest -> db

// Boundaries
zone onprem "On-Premises Data Centre" onprem {
  contains operator, erp
}

zone aws_cloud "AWS Cloud" cloud {
  contains ingest, db
}

zone vpc "VPC" vpc {
  contains db
}
