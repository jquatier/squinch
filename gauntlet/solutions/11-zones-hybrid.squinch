// Hybrid estate: on-prem datacenter feeding AWS cloud
pack aws

// On-premises components
person operator "Operator"
erp = sys/server "Legacy ERP" {
  description: "Oracle-style system"
}

// AWS cloud components
ingest = aws/lambda "Ingestion Lambda"
db = aws/aurora "Aurora Database" datastore

// Connections
operator -> erp "uses"
erp ~> ingest "data feed"
ingest -> db "writes"

// Deployment boundaries
zone onprem "On-Premises Data Centre" onprem {
  contains operator, erp
}

zone cloud "AWS Cloud" cloud {
  contains ingest, db
}

zone vpc "VPC" vpc {
  contains db
}
