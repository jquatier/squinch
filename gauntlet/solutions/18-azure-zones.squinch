pack azure

// Application Gateway sits in front
appgw = azure/app-gateway "Application Gateway"

// AKS cluster in the private subnet
aks = azure/aks "AKS Cluster"

// Container Registry pulls images to AKS
acr = azure/acr "Container Registry"

// Azure SQL in the vnet but outside subnet
sql = azure/sql "Azure SQL"

// Connections
appgw -> aks
aks -> acr "pulls images"
aks -> sql

// Private subnet contains AKS and ACR
zone private_subnet "Private Subnet" subnet {
  contains aks, acr
}

// Virtual network contains the subnet components and SQL
zone vnet "Virtual Network" network {
  contains aks, acr, sql
}

// Subscription contains everything
zone subscription "Azure Subscription" account {
  contains aks, acr, sql, appgw
}

view default {
  include *
}
