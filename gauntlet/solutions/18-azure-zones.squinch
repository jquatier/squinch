// Azure estate with network boundaries
pack azure

// Application Gateway sits in front
appgw = azure/app-gateway "Application Gateway"

// AKS cluster in private subnet
aks = azure/aks "AKS Cluster"

// Container Registry for images
acr = azure/acr "Container Registry"

// Azure SQL database
sql = azure/sql "Azure SQL Database" datastore

// Connections
appgw -> aks
aks -> acr "pulls images"
aks -> sql

// Network boundaries
zone subscription "Azure Subscription" account {
  contains appgw, aks, acr, sql
}

zone vnet "Virtual Network" network {
  contains aks, acr, sql
}

zone subnet "Private Subnet" subnet {
  contains aks, acr
}
