pack azure

gw  = azure/app-gateway "Application Gateway"
aks = azure/aks "AKS Cluster"
acr = azure/acr "Container Registry"
sql = azure/sql "Azure SQL" datastore

gw -> aks
aks -> acr "pulls images"
aks -> sql

zone sub    "Azure Subscription" account { contains gw, aks, acr, sql }
zone vnet   "Virtual Network"    network { contains aks, acr, sql }
zone subnet "Private Subnet"     subnet  { contains aks, acr
  color: teal
}

view landscape {
  title "Azure Estate"
  include *
}
