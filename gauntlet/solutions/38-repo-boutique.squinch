pack gcp
pack logos

person shopper "Shopper" {
  description: "Browses products and checks out in the web UI"
}

load = sys/activity "Load Generator" {
  subtitle: "Python · Locust"
  description: "Simulated shoppers hitting the frontend"
}

zone cluster "Kubernetes cluster" network {
  contains frontend, ad, cart, checkout, currency, email, payment, catalog, recommend, shipping, assistant, redis, products
}

frontend  = sys/app-window "Frontend" { subtitle: "Go · HTTP :8080" }
ad        = sys/megaphone "Ad Service" { subtitle: "Java" }
cart      = sys/shopping-cart "Cart Service" { subtitle: "C#" }
checkout  = sys/package-check "Checkout Service" { subtitle: "Go" }
currency  = sys/circle "Currency Service" { subtitle: "Node.js" }
email     = sys/mail "Email Service" { subtitle: "Python" }
payment   = sys/credit-card "Payment Service" { subtitle: "Node.js" }
catalog   = sys/search "Product Catalog Service" { subtitle: "Go" }
recommend = sys/star "Recommendation Service" { subtitle: "Python" }
shipping  = sys/truck "Shipping Service" { subtitle: "Go" }
assistant = sys/cog "Shopping Assistant Service" { subtitle: "Python · Flask" }

redis    = logos/redis "redis-cart" datastore { subtitle: "Cart contents" }
products = sys/file "products.json" datastore { subtitle: "Product catalogue" }

alloydb = gcp/alloydb "AlloyDB" external datastore { subtitle: "Product vectors" }
gemini  = gcp/gemini "Gemini" external
secrets = gcp/secret-manager "Secret Manager" external

shopper -> frontend "browses, buys"
load -> frontend "simulated traffic"

frontend -> catalog, currency, cart, recommend, shipping, checkout, ad, assistant

checkout -> catalog, shipping, payment, email, currency, cart
recommend -> catalog

cart -> redis
catalog -> products
assistant -> alloydb
assistant -> gemini
assistant -> secrets

view landscape {
  title "Online Boutique"
  include *
  legend auto
}
