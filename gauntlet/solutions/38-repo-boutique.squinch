pack gcp
pack logos

// Users
person customer "Customer"

// Frontend
frontend = gcp/app-engine "Frontend" {
  subtitle: "Go · HTTP server"
  description: "Web UI for browsing and purchasing"
}

// Core services
productcatalog = gcp/app-engine "Product Catalog Service" {
  subtitle: "Go"
  description: "Product list and search"
}

currency = gcp/app-engine "Currency Service" {
  subtitle: "Node.js"
  description: "Currency conversion"
}

cart = gcp/app-engine "Cart Service" {
  subtitle: "C#"
  description: "Shopping cart management"
}

recommendation = gcp/app-engine "Recommendation Service" {
  subtitle: "Python"
  description: "Product recommendations"
}

checkout = gcp/app-engine "Checkout Service" {
  subtitle: "Go"
  description: "Order orchestration"
}

payment = gcp/app-engine "Payment Service" {
  subtitle: "Node.js"
  description: "Payment processing"
}

shipping = gcp/app-engine "Shipping Service" {
  subtitle: "Go"
  description: "Shipping cost estimates"
}

email = gcp/app-engine "Email Service" {
  subtitle: "Python"
  description: "Order confirmation emails"
}

ad = gcp/app-engine "Ad Service" {
  subtitle: "Java"
  description: "Contextual ads"
}

// Data store
redis = logos/redis "Redis" datastore {
  description: "Cart session storage"
}

// Load generator
loadgen = sys/code "Load Generator" {
  subtitle: "Python · Locust"
  description: "Simulates user traffic"
}

// User interactions
customer -> frontend "browses and purchases"
loadgen -> frontend "simulates traffic"

// Frontend calls
frontend -> productcatalog
frontend -> currency
frontend -> cart
frontend -> recommendation
frontend -> shipping
frontend -> checkout
frontend -> ad

// Cart service
cart -> redis

// Recommendation service
recommendation -> productcatalog

// Checkout service orchestration
checkout -> productcatalog
checkout -> shipping
checkout -> payment
checkout -> email
checkout -> currency
checkout -> cart

view landscape {
  title "Online Boutique - Microservices Architecture"
  include *
  layout {
    rows [customer loadgen] [frontend] [productcatalog currency cart recommendation shipping checkout ad] [payment email] [redis]
  }
}
