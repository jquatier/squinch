pack logos
pack gcp

person shopper "Shopper"

loadgen = box "Load Generator" { subtitle: "Python · Locust" }
fe = sys/app-window "Frontend" { subtitle: "Go · HTTP"; description: "Serves the website" }

checkout = sys/shopping-cart "Checkout Service" { subtitle: "Go" ; description: "Orchestrates an order" }
cart = sys/shopping-cart "Cart Service" { subtitle: "C#" }
cartdb = logos/redis "Redis Cart" datastore { description: "Cart contents" }
catalog = sys/package-check "Product Catalog Service" { subtitle: "Go"; description: "Products from a JSON file" }
currency = sys/currency "Currency Service" { subtitle: "Node.js" }
payment = sys/credit-card "Payment Service" { subtitle: "Node.js · mock" }
shipping = sys/shipping "Shipping Service" { subtitle: "Go · mock" }
email = sys/mail "Email Service" { subtitle: "Python · mock" }
reco = gcp/recommendations-ai "Recommendation Service" { subtitle: "Python" }
ads = sys/megaphone "Ad Service" { subtitle: "Java" }
assistant = sys/bot "Shopping Assistant Service" { subtitle: "Python · optional" }
vectors = gcp/alloydb "AlloyDB" datastore { description: "Vector store for the assistant" }
gemini = gcp/gemini "Gemini" external

shopper -> fe "browses, buys"
loadgen -> fe "simulated shopping"

fe -> catalog, currency, cart, reco, shipping, checkout, ads, assistant
checkout -> catalog, shipping, payment, email, currency, cart
reco -> catalog
cart -> cartdb
assistant -> vectors
assistant -> gemini

view landscape {
  title "Online Boutique"
  include *
  legend auto
}
