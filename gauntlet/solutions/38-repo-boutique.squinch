// Online Boutique - Microservices E-Commerce Demo
pack logos
pack gcp

person user "Customer"
load = sys/activity "Load Generator"

system boutique "Online Boutique" {
  description: "Cloud-native microservices e-commerce application"

  // Frontend
  fe = sys/app-window "Frontend" {
    subtitle: "Go · HTTP server"
    description: "Serves website, session management"
  }

  // Core services
  checkout = sys/shopping-bag "Checkout Service" {
    subtitle: "Go · Orchestrator"
    description: "Orchestrates order processing"
  }

  cart = sys/shopping-cart "Cart Service" {
    subtitle: "C# · gRPC"
    description: "Shopping cart operations"
  }

  product = sys/package-check "Product Catalog" {
    subtitle: "Go · gRPC"
    description: "Product listing and search"
  }

  currency = sys/coins "Currency Service" {
    subtitle: "Node.js · gRPC"
    description: "Currency conversion, highest QPS"
  }

  recommend = sys/heart "Recommendation Service" {
    subtitle: "Python · gRPC"
    description: "Product recommendations"
  }

  ad = sys/megaphone "Ad Service" {
    subtitle: "Java · gRPC"
    description: "Contextual text ads"
  }

  payment = sys/credit-card "Payment Service" {
    subtitle: "Node.js · gRPC"
    description: "Mock payment processing"
  }

  shipping = sys/truck "Shipping Service" {
    subtitle: "Go · gRPC"
    description: "Shipping cost and dispatch"
  }

  email = sys/headset "Email Service" {
    subtitle: "Python · gRPC"
    description: "Order confirmation emails"
  }

  // Shopping assistant (Gemini AI)
  assistant = sys/workflow "Shopping Assistant" {
    subtitle: "gRPC"
    description: "AI-powered product suggestions"
  }

  // Data store
  redis = logos/redis "Redis Cache" datastore {
    subtitle: "In-memory store"
    description: "Cart session data"
  }

  // User flows
  user -> fe "browses, purchases"
  load -> fe "simulates traffic"

  // Frontend connections (synchronous gRPC)
  fe -> product "get products"
  fe -> currency "convert prices"
  fe -> cart "manage cart"
  fe -> recommend "get suggestions"
  fe -> shipping "get quote"
  fe -> checkout "place order"
  fe -> ad "fetch ads"
  fe -> assistant "AI suggestions"

  // Checkout orchestration
  checkout -> cart "retrieve cart"
  checkout -> product "verify items"
  checkout -> currency "get rates"
  checkout -> payment "charge card"
  checkout -> shipping "ship items"
  checkout -> email "send confirmation"

  // Cart storage
  cart -> redis "read/write"

  // Recommendation lookups
  recommend -> product "get catalog"

  layout {
    rows [fe] [checkout] [currency cart ad assistant payment shipping email] [recommend] [product] [redis]
  }
}

view landscape {
  title "Online Boutique - Microservices Architecture"
  include *
  expand boutique
  titleblock {
    subtitle: "E-commerce demo application"
    version: "Google Cloud Platform"
  }
  layout {
    rows [user load] [boutique]
  }
  legend auto
}
