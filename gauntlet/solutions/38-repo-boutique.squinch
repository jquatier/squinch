pack gcp
pack logos

person shopper "Shopper" { description: "Browses, fills a cart, checks out" }

loadgen = sys/activity "Load Generator" { subtitle: "Python · Locust" }

fe = sys/app-window "Frontend" { subtitle: "Go · HTTP"; description: "Serves the website, generates session IDs" }

ads      = sys/megaphone "Ad Service" { subtitle: "Java" }
reco     = sys/sparkles "Recommendation Service" { subtitle: "Python" }
assist   = sys/bot "Shopping Assistant" { subtitle: "Python · optional" }
catalog  = sys/book-open "Product Catalog Service" { subtitle: "Go" }
currency = sys/coins "Currency Service" { subtitle: "Node.js" }
cart     = sys/shopping-cart "Cart Service" { subtitle: "C#" }
checkout = sys/package-check "Checkout Service" { subtitle: "Go" }
shipping = sys/truck "Shipping Service" { subtitle: "Go" }
payment  = sys/credit-card "Payment Service" { subtitle: "Node.js · mock" }
email    = sys/mail "Email Service" { subtitle: "Python · mock" }

redis     = logos/redis "Redis (redis-cart)" datastore
products  = sys/file-json "products.json" datastore { subtitle: "read at startup" }
alloydb   = gcp/alloydb "AlloyDB" datastore { subtitle: "product vectors" }
secrets   = gcp/secret-manager "Secret Manager" external
gemini    = gcp/gemini "Gemini" external

shopper -> fe "browses, checks out"
loadgen -> fe "simulated shopping flows"

fe -> ads
fe -> reco
fe -> catalog
fe -> currency
fe -> cart
fe -> checkout
fe -> shipping
fe -> assist "HTTP"

reco -> catalog
checkout -> cart
checkout -> catalog
checkout -> currency
checkout -> shipping
checkout -> payment
checkout -> email

cart -> redis
catalog -> products
assist -> alloydb
assist -> secrets
assist -> gemini

view landscape {
  title "Online Boutique"
  include *
  about """
    gRPC between services, except the shopper and load generator (HTTP) and the shopping assistant (HTTP from the frontend).

    - The shopping assistant is an optional add-on
    - Cart storage defaults to Redis; Spanner and AlloyDB are alternatives in the cart service
  """
}
