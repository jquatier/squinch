pack aws

// Nightly batch pipeline - 14 sequential Lambda steps
extract   = aws/lambda "Extract"
validate  = aws/lambda "Validate"
dedupe    = aws/lambda "Dedupe"
normalize = aws/lambda "Normalize"
enrich    = aws/lambda "Enrich"
score     = aws/lambda "Score"
aggregate = aws/lambda "Aggregate"
partition = aws/lambda "Partition"
compress  = aws/lambda "Compress"
encrypt   = aws/lambda "Encrypt"
upload    = aws/lambda "Upload"
catalog   = aws/lambda "Catalog"
verify    = aws/lambda "Verify"
notify    = aws/lambda "Notify"

// Sequential chain
extract -> validate
validate -> dedupe
dedupe -> normalize
normalize -> enrich
enrich -> score
score -> aggregate
aggregate -> partition
partition -> compress
compress -> encrypt
encrypt -> upload
upload -> catalog
catalog -> verify
verify -> notify

view pipeline {
  title "Nightly Batch Pipeline"
  include *
  layout {
    wrap 5  // fold the chain into landscape format
  }
}
