// Clickstream data pipeline
pack aws

person analyst "Analyst"

stream = aws/kinesis "Clickstream Events"
transform = aws/lambda "Event Transformer" {
  description: "Enriches and normalizes events"
}
lake = aws/s3 "Data Lake" datastore {
  description: "Partitioned Parquet files"
}
catalog = aws/glue "Glue Data Catalog" {
  description: "Schema registry"
}
query = aws/athena "Athena" {
  description: "Interactive SQL queries"
}

stream ~> transform
transform ~> lake
lake -> catalog
analyst -> query "runs queries"
query -> lake "scans"
query -> catalog "reads schema"
