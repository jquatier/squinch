pack aws

person analyst "Analyst"

stream = aws/kinesis "Clickstream" {
  description: "Real-time event stream"
}

transformer = aws/lambda "Transformer" {
  description: "Processes and enriches events"
}

lake = aws/s3 "Data Lake" datastore {
  description: "Parquet files by date"
}

catalog = aws/glue "Glue Catalog" {
  description: "Schema and partitions"
}

query = aws/athena "Athena" {
  description: "SQL query engine"
}

stream ~> transformer "events"
transformer ~> lake "parquet"
catalog -> lake "catalogs"
analyst -> query "runs queries"
query -> lake "scans"
