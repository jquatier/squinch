pack aws

person analyst "Analysts"

stream = aws/kinesis "Clickstream" { subtitle: "Kinesis stream" }
transform = aws/lambda "Transformer" { subtitle: "Lambda" }
lake = aws/s3 "Data Lake" datastore
catalog = aws/glue "Data Catalog" { subtitle: "Glue" }
athena = aws/athena "Athena"

stream ~> transform "events"
transform -> lake "lands data"
catalog -> lake "catalogs"
analyst -> athena "queries"
athena -> lake "reads"

view pipeline {
  title "Clickstream Data Pipeline"
  include *
}
