// Clickstream data pipeline
pack aws

// Human actors
person analyst "Data Analyst"

// Pipeline components
stream = aws/kinesis "Clickstream" {
  description: "Event stream"
}

transform = aws/lambda "Transformer" {
  description: "Processes events"
}

lake = aws/s3 "Data Lake" datastore {
  description: "Parquet storage"
}

catalog = aws/glue "Catalog" {
  description: "Schema registry"
}

query = aws/athena "Query Engine" {
  description: "SQL analytics"
}

// Data flow
stream ~> transform
transform ~> lake
lake -> catalog
analyst -> query
query -> catalog
query -> lake
