pack aws

person analyst "Analyst"

system pipeline "Clickstream Pipeline" {
  description: "Ingest, transform, catalog and query clickstream events"

  kinesis     = aws/kinesis "Clickstream Stream"
  transformer = aws/lambda  "Transformer" {
    subtitle: "Lambda"
  }
  lake        = aws/s3      "Data Lake" datastore
  glue        = aws/glue    "Data Catalog"
  athena      = aws/athena  "Query Engine"

  kinesis     ~> transformer "clickstream events"
  transformer -> lake        "writes records"
  lake        -> glue        "crawls & catalogs"
  glue        -> athena      "table metadata"
}

analyst -> pipeline.athena "runs SQL queries"
