// Clickstream data pipeline
pack aws

person analyst "Analyst"

stream = aws/kinesis "Clickstream Stream"
transform = aws/lambda "Transformer" {
  description: "Transforms and enriches clickstream events"
}
lake = aws/s3 "Data Lake" datastore
catalog = aws/glue "Glue Catalog" {
  description: "Metadata catalog"
}
query = aws/athena "Athena" {
  description: "Interactive query engine"
}

stream ~> transform "events"
transform ~> lake "lands data"
catalog -> lake "catalogs"
analyst -> query "queries"
query -> lake "reads"
