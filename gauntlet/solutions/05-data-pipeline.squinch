// Clickstream data pipeline
pack aws

person analyst "Analyst"

stream    = aws/kinesis "Clickstream Stream"
transform = aws/lambda "Transform Handler" {
  subtitle: "Lambda"
}
lake      = aws/s3 "Data Lake" datastore {
  subtitle: "S3"
}
catalog   = aws/glue "Data Catalog" {
  subtitle: "Glue Crawler"
}
query     = aws/athena "Query Engine"

stream ~> transform "events"
transform -> lake "writes"
lake -> catalog "crawls"
analyst -> query "runs queries"
query -> lake "reads"
