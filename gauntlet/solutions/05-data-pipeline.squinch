pack aws

person analyst "Analyst"

stream      = aws/kinesis "Clickstream"
transformer = aws/lambda  "Transformer"
lake        = aws/s3      "Data Lake" datastore
catalog     = aws/glue    "Catalog"
query       = aws/athena  "Athena"

stream ~> transformer
transformer ~> lake
catalog -> lake "catalogs"
analyst -> query "queries"
query -> lake "reads"
