pack aws

person analysts "Analysts"

stream = aws/kinesis "Clickstream"
transform = aws/lambda "Transformer"
lake = aws/s3 "Data Lake" datastore
catalog = aws/glue "Glue Catalog"
athena = aws/athena "Athena"

stream ~> transform "click events"
transform -> lake "writes"
catalog -> lake "catalogs"
athena -> lake "queries"
analysts -> athena "run queries"

view landscape {
  title "Clickstream Data Pipeline"
  include *
}
