pack aws

person analyst "Analyst"

system pipeline "Clickstream Data Pipeline" {
  stream    = aws/kinesis "Clickstream Stream"
  transform = aws/lambda  "Transformer" { subtitle: "Lambda" }
  lake      = aws/s3      "Data Lake" datastore
  catalog   = aws/glue    "Data Catalog"
  athena    = aws/athena  "Athena"

  stream ~> transform "clickstream events"
  transform -> lake "writes"
  lake -> catalog "catalogs"
  catalog -> athena "schema"
}

analyst -> pipeline.athena "queries"
