pack aws

person analyst "Analyst"

system pipeline "Clickstream Pipeline" {
  stream = aws/kinesis "Click Stream"
  xform  = aws/lambda  "Transformer"
  lake   = aws/s3      "Data Lake"
  crawler = aws/glue   "Glue Catalog"
  query  = aws/athena  "Athena"

  stream ~> xform "records"
  xform -> lake "parquet"
  crawler -> lake "crawls"
  query -> lake "scans"
}

analyst -> pipeline.query "SQL"

view pipeline {
  layout {
    rows [stream] [xform] [crawler query] [lake]
  }
}
