pack aws

stream = aws/kinesis "Event Stream"

system platform "Data Platform" {
  description: "Ingestion pipeline and catalog services"
  icon: aws/glue

  extract  = aws/lambda "Extract"
  validate = aws/lambda "Validate"
  enrich   = aws/lambda "Enrich"
  publish  = aws/lambda "Publish"
  catalog  = aws/glue   "Catalog" datastore

  extract -> validate
  validate -> enrich
  enrich -> publish
  enrich -> catalog "lookup"

  layout {
    direction right
  }
}

warehouse = aws/redshift "Warehouse" datastore

stream ~> platform.extract "events"
platform.publish -> warehouse "write"

view pipeline {
  title "Data Platform Pipeline"
  expand platform
}
