pack aws

stream = aws/kinesis "Event Stream"

system platform "Data Platform" {
  description: "Ingestion pipeline with catalog"

  extract  = aws/lambda "Extract"
  validate = aws/lambda "Validate"
  enrich   = aws/lambda "Enrich"
  publish  = aws/lambda "Publish"
  catalog  = sys/database "Catalog" datastore

  extract -> validate
  validate -> enrich
  enrich -> publish
  enrich -> catalog

  layout {
    direction right
    place catalog below enrich
  }
}

warehouse = aws/redshift "Redshift Warehouse" datastore

stream ~> platform.extract
platform.publish -> warehouse

view detail {
  title "Data Platform Pipeline"
  expand platform
}
