pack aws

stream = aws/kinesis "Event Stream" external
wh = aws/redshift "Warehouse" external datastore

system platform "Data Platform" {
  description: "Ingestion pipeline and catalog"
  extract = sys/workflow "Extract"
  validate = sys/shield-check "Validate"
  enrich = sys/cog "Enrich"
  publish = sys/share-2 "Publish"
  catalog = sys/book-open "Catalog"
  extract -> validate
  validate -> enrich
  enrich -> publish
  enrich -> catalog "lookup"
  layout { direction right }
}

stream ~> platform.extract "events"
platform.publish -> wh "writes"

view landscape {
  title "Landscape"
  include *
}

view pipeline {
  title "Data Platform"
  include *
  expand platform
  layout { rows [stream] [platform] [wh] }
}
