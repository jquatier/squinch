pack aws

stream    = aws/kinesis  "Events Stream"
warehouse = aws/redshift "Warehouse" datastore

system platform "Data Platform" {
  icon: sys/workflow

  extract  = sys/inbox      "Extract"
  validate = sys/check-check "Validate"
  enrich   = sys/sparkles   "Enrich"
  publish  = sys/send       "Publish"
  catalog  = sys/catalog    "Catalog"

  extract  -> validate
  validate -> enrich
  enrich   -> publish
  enrich   -> catalog "looks up"

  layout {
    direction right
    place catalog below enrich
  }
}

stream           ~> platform.extract "events"
platform.publish -> warehouse        "load"

view landscape {
  title "System Landscape"
  include *
}

view pipeline {
  title "Ingestion Pipeline"
  include *
  expand platform
}
