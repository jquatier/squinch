pack aws

stream    = aws/kinesis  "Event Stream"
warehouse = aws/redshift "Data Warehouse" datastore

system platform "Data Platform" {
  description: "Ingestion pipeline"

  extract  = aws/lambda "Extract"
  validate = aws/lambda "Validate"
  enrich   = aws/lambda "Enrich"
  publish  = aws/lambda "Publish"
  catalog  = sys/catalog "Catalog"

  extract  -> validate
  validate -> enrich
  enrich   -> publish
  enrich   -> catalog

  layout {
    direction right
    place catalog below enrich
  }
}

stream          ~> platform.extract "events"
platform.publish -> warehouse       "writes"

view landscape {
  title "Data Platform Landscape"
  include *
}

view pipeline {
  title "Ingestion Pipeline"
  include *
  expand platform
  layout {
    rows [stream] [platform] [warehouse]
  }
}
