pack aws

stream = aws/kinesis "Event Stream" external
warehouse = aws/redshift "Warehouse" external datastore

system platform "Data Platform" {
  description: "Ingestion pipeline and catalog"
  extract  = box "Extract"
  validate = box "Validate"
  enrich   = box "Enrich"
  publish  = box "Publish"
  catalog  = box "Catalog"
  extract -> validate
  validate -> enrich
  enrich -> publish
  enrich -> catalog "looks up"
  layout {
    direction right
  }
}

stream ~> platform.extract "events"
platform.publish -> warehouse "writes"

view landscape {
  title "System Landscape"
  include *
}

view detail {
  title "Platform opened up"
  include *
  expand platform
  layout { rows [stream] [platform] [warehouse] }
}
