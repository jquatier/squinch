pack aws

stream = aws/kinesis "Event Stream" external

system platform "Data Platform" {
  description: "Ingestion pipeline and catalog"

  system pipeline "Ingestion Pipeline" {
    extract  = sys/code "Extract"
    validate = sys/code "Validate"
    enrich   = sys/code "Enrich"
    publish  = sys/code "Publish"
    extract -> validate
    validate -> enrich
    enrich -> publish
    layout { direction right }
  }

  catalog = sys/book-open "Catalog"
  pipeline.enrich -> catalog "lookups"
}

warehouse = aws/redshift "Warehouse" external datastore

stream ~> platform.pipeline.extract "events"
platform.pipeline.publish -> warehouse "writes"

view landscape {
  title "System Landscape"
  include *
}

view platform {
  title "Data Platform"
  scope platform
  expand pipeline
}
