pack aws

stream = aws/kinesis "Event Stream" external
warehouse = aws/redshift "Warehouse" datastore external

system platform "Data Platform" {
  description: "Ingestion pipeline and catalog"
  icon: sys/workflow
  extract  = sys/cog "Extract"
  validate = sys/shield-check "Validate"
  enrich   = sys/cog "Enrich"
  publish  = sys/share-2 "Publish"
  catalog  = sys/book-open "Catalog"
  extract -> validate
  validate -> enrich
  enrich -> publish
  enrich -> catalog "looks up"
  layout { direction right
    place catalog below enrich }
}

stream ~> platform.extract "events"
platform.publish -> warehouse "writes"

view landscape {
  title "System Landscape"
  include *
}

view detail {
  title "Platform opened up"
  include *
  expand platform
  layout { rows [stream] [platform] [warehouse] }
}
