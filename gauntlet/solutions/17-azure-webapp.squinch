// Azure web application architecture
pack azure

person customer "Customer"

frontdoor = azure/front-door "Azure Front Door"
webapp = azure/app-services "App Service"
sqldb = azure/sql "Azure SQL" datastore
cache = azure/redis "Redis Cache" datastore
vault = azure/key-vault "Key Vault"
insights = azure/application-insights "Application Insights"

customer -> frontdoor "accesses"
frontdoor -> webapp "routes traffic"
webapp -> sqldb "reads/writes"
webapp -> cache "caches"
webapp -> vault "pulls secrets"
webapp ~> insights "reports telemetry"
