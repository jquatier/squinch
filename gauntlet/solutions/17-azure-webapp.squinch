pack azure

person customer "Customer"

frontdoor  = azure/front-door        "Azure Front Door"
webapp     = azure/app-services      "Web App"
sql        = azure/sql               "Azure SQL" datastore
cache      = azure/redis             "Redis Cache" datastore
vault      = azure/key-vault         "Key Vault"
insights   = azure/application-insights "Application Insights"

customer -> frontdoor "browses"
frontdoor -> webapp "routes requests"
webapp -> sql "reads/writes"
webapp -> cache "caches data"
webapp -> vault "retrieves secrets"
webapp ~> insights "telemetry"
