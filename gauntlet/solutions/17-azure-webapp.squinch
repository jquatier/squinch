pack azure

person customer "Customer"

frontdoor = azure/front-door "Azure Front Door"
app = azure/app-services "App Service"
sql = azure/sql "Azure SQL" datastore
redis = azure/redis "Redis Cache" datastore
vault = azure/key-vault "Key Vault"
insights = azure/application-insights "Application Insights"

customer -> frontdoor "accesses"
frontdoor -> app
app -> sql "reads/writes"
app -> redis "caches"
app -> vault "pulls secrets"
app ~> insights "telemetry"
