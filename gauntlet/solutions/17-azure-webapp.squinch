pack azure

person customer "Customer"

system webapp "Azure Web Application" {
  fd    = azure/front-door       "Front Door"
  app   = azure/app-services     "App Service"
  sql   = azure/sql              "Azure SQL"        datastore
  redis = azure/cache-redis      "Redis Cache"      datastore
  kv    = azure/key-vault        "Key Vault"
  ai    = azure/application-insights "App Insights"

  fd -> app
  app -> sql
  app -> redis
  app -> kv
  app ~> ai "telemetry"
}

customer -> webapp.fd "browses"
