pack azure

person customer "Customers"

fd    = azure/front-door "Azure Front Door"
app   = azure/app-service "App Service" { subtitle: "Web tier" }
sql   = azure/sql "Azure SQL" datastore
redis = azure/cache-redis "Redis" datastore
kv    = azure/key-vault "Key Vault"
ai    = azure/application-insights "Application Insights"

customer -> fd
fd -> app
app -> sql "reads/writes"
app -> redis "caches"
app -> kv "secrets"
app ~> ai "telemetry"

view landscape {
  title "Azure Web Application"
  include *
}
