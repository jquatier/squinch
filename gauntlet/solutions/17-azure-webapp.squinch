pack azure

person customer "Customer"

cdn = azure/front-door "Azure Front Door"
app = azure/app-services "Web App" {
  subtitle: "App Service"
}
db = azure/sql "SQL Database" datastore
cache = azure/cache-redis "Redis Cache" datastore
vault = azure/key-vault "Key Vault"
insights = azure/monitor "Application Insights"

customer -> cdn "accesses"
cdn -> app
app -> db "reads/writes"
app -> cache "caches"
app -> vault "pulls secrets"
app ~> insights "telemetry"
