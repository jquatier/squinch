pack azure

person customer "Customer"

cdn     = azure/front-door        "Front Door"
app     = azure/app-services      "Web App"
db      = azure/sql               "Azure SQL Database" datastore
cache   = azure/redis             "Redis Cache" datastore
vault   = azure/key-vault         "Key Vault"
insights = azure/application-insights "Application Insights"

customer -> cdn "browses"
cdn -> app
app -> db "reads/writes"
app -> cache "reads/writes"
app -> vault "pulls secrets"
app ~> insights "telemetry"
