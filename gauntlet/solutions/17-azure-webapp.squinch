pack azure

person customer "Customer"

fd  = azure/front-door       "Front Door"
app = azure/app-services     "Web App"
sql = azure/sql              "SQL Database" datastore
cache = azure/redis          "Redis Cache" datastore
kv  = azure/key-vault        "Key Vault"
ai  = azure/application-insights "Application Insights"

customer -> fd "HTTPS"
fd -> app
app -> sql "queries"
app -> cache "get/set"
app -> kv "fetch secrets"
app ~> ai "telemetry"
