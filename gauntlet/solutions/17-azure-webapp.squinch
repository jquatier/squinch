pack azure

person customer "Customer"

frontdoor = azure/front-door "Front Door"
app = azure/app-services "App Service" {
  description: "Web tier"
}
sql = azure/sql "SQL Database" datastore
cache = azure/redis "Redis Cache" datastore
vault = azure/key-vault "Key Vault"
insights = azure/application-insights "Application Insights"

customer -> frontdoor "HTTPS"
frontdoor -> app
app -> sql "read/write"
app -> cache "cache lookup"
app -> vault "fetch secrets"
app ~> insights "telemetry"

view default {
  include *
}
