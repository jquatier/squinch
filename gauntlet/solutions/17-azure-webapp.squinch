pack azure

person customer "Customers"

fd    = azure/front-door "Azure Front Door"
app   = azure/app-services "App Service" {
  subtitle: "Web tier"
}
sql   = azure/sql-database "Azure SQL" datastore
cache = azure/cache-redis "Redis" datastore
kv    = azure/key-vault "Key Vault"
ai    = azure/application-insights "Application Insights"

customer -> fd "browse"
fd -> app
app -> sql "reads / writes"
app -> cache "caches"
app -> kv "secrets"
app ~> ai "telemetry"

view landscape {
  title "Azure Web Application"
  include *
  legend {
    ->  "Request"
    ~>  "Async telemetry"
  }
}
