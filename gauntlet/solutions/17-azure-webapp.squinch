// Azure web application architecture
pack azure

person customer "Customer"

system webapp "Web Application" {
  description: "Customer-facing web application"
  tags: #core

  cdn = azure/front-door "Azure Front Door"
  app = azure/app-services "App Service" {
    description: "Web tier"
  }
  db = azure/sql "Azure SQL" datastore
  cache = azure/redis "Redis Cache" datastore
  secrets = azure/key-vault "Key Vault" external
  monitor = azure/application-insights "Application Insights" external

  cdn -> app
  app -> db "read/write"
  app -> cache
  app -> secrets "pull secrets"
  app ~> monitor "telemetry"
}

customer -> webapp.cdn "access"
