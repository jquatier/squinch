// Azure Web Application Architecture
pack azure

person customer "Customer"

system webapp "Web Application" {
  description: "Azure-hosted web service"

  frontdoor = azure/front-door "Azure Front Door"
  app = azure/app-services "App Service" {
    description: "Web tier"
  }
  sql = azure/sql "Azure SQL" datastore
  cache = azure/redis "Redis Cache" datastore
  vault = azure/key-vault "Key Vault"
  insights = azure/application-insights "Application Insights"

  frontdoor -> app
  app -> sql
  app -> cache
  app -> vault
  app ~> insights "telemetry"
}

customer -> webapp.frontdoor "accesses application"
