pack azure

person customer "Customer"

frontdoor = azure/front-door "Azure Front Door"
appservice = azure/app-services "Web App" {
  subtitle: "App Service"
}
sql = azure/sql "SQL Database" datastore
cache = azure/redis "Redis Cache" datastore
vault = azure/key-vault "Key Vault"
insights = azure/application-insights "Application Insights"

customer -> frontdoor "HTTPS"
frontdoor -> appservice "routes traffic"
appservice -> sql "read/write"
appservice -> cache "cache ops"
appservice -> vault "fetch secrets"
appservice ~> insights "telemetry"
