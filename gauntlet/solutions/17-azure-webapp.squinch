pack azure
pack logos

person customer "Customer"

frontdoor = azure/front-door "Front Door"
appservice = azure/app-services "Web App"
sql = azure/sql "SQL Database" datastore
redis = azure/redis "Redis Cache" datastore
keyvault = azure/key-vault "Key Vault"
insights = azure/application-insights "Application Insights"

customer -> frontdoor "requests"
frontdoor -> appservice
appservice -> sql "read/write"
appservice -> redis "cache"
appservice -> keyvault "secrets"
appservice ~> insights "telemetry"
