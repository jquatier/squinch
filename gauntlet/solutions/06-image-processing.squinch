pack aws

system image_pipeline "Image Processing Pipeline" {
  description: "Serverless image analysis and metadata extraction"

  uploads = aws/s3 "Upload Bucket" datastore
  processor = aws/lambda "Image Processor"
  rekognition = aws/rekognition "Rekognition"
  metadata = aws/dynamodb "Image Metadata" datastore
  notifications = aws/sns "Notifications"

  uploads ~> processor "S3 event"
  processor -> rekognition "analyze image"
  processor -> metadata "write metadata"
  processor ~> notifications "notify"
}

view image_pipeline {
  layout {
    rows [uploads] [processor rekognition] [metadata notifications]
  }
}
