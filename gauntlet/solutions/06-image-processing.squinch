// Serverless image processing pipeline
pack aws

person user "User"

system pipeline "Image Processing Pipeline" {
  description: "Serverless image analysis and metadata storage"
  glyph: aws/lambda

  bucket = aws/s3 "Upload Bucket" datastore
  processor = aws/lambda "Image Processor" {
    description: "Analyzes images and stores metadata"
  }
  rekognition = aws/rekognition "Rekognition"
  metadata = aws/dynamodb "Metadata Store" datastore
  notifications = aws/sns "Notification Topic"

  bucket ~> processor "S3 trigger"
  processor -> rekognition "analyze image"
  processor -> metadata "store labels"
  processor ~> notifications "publish result"
}

user -> pipeline.bucket "upload image"

view landscape {
  title "Image Processing Pipeline"
  include *
}

view pipeline {
  layout {
    rows [bucket] [processor rekognition] [metadata notifications]
  }
}
