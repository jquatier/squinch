pack aws

person user "User"

uploads = aws/s3 "Image Uploads" datastore
processor = aws/lambda "Image Processor"
rekognition = aws/rekognition "Rekognition"
metadata = aws/dynamodb "Image Metadata" datastore
notifications = aws/sns "SNS Topic"

user -> uploads "uploads image"
uploads ~> processor "S3 event"
processor -> rekognition "detect labels"
processor -> metadata "write metadata"
processor ~> notifications "publish event"
