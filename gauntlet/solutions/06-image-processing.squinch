pack aws

person user "User"

storage = aws/s3 "Upload Bucket" datastore
processor = aws/lambda "Image Processor"
vision = aws/rekognition "Rekognition"
metadata = aws/dynamodb "Metadata Store" datastore
notify = aws/sns "Notifications"

user -> storage "uploads image"
storage ~> processor "S3 event"
processor -> vision "analyze image"
processor -> metadata "write labels"
processor ~> notify "publish event"
