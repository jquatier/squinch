pack aws

person uploader "User"

system image_pipeline "Image Processing Pipeline" {
  description: "Serverless image analysis"

  bucket = aws/s3 "Upload Bucket" datastore
  processor = aws/lambda "Image Processor"
  rekognition = aws/rekognition "Rekognition" external
  metadata = aws/dynamodb "Metadata Store" datastore
  notifications = aws/sns "Notifications"

  bucket ~> processor "S3 event"
  processor -> rekognition "analyze image"
  processor -> metadata "write metadata"
  processor ~> notifications "publish results"
}

uploader ~> image_pipeline.bucket "upload image"
