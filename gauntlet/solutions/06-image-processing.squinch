pack aws

person user "User"

system pipeline "Image Processing Pipeline" {
  description: "Serverless image analysis and notification"

  storage = aws/s3 "Upload Bucket" datastore
  processor = aws/lambda "Image Processor" {
    subtitle: "Lambda · Python"
  }
  rekognition = aws/rekognition "Rekognition"
  metadata = aws/dynamodb "Image Metadata" datastore
  notifications = aws/sns "Notification Topic"

  storage ~> processor "S3 event"
  processor -> rekognition "analyze image"
  processor -> metadata "write labels"
  processor ~> notifications "publish"
}

user -> pipeline.storage "uploads image"

view landscape {
  title "Image Processing Pipeline"
  include *
}

view pipeline {
  title "Pipeline Detail"
  layout {
    rows [storage] [processor rekognition] [metadata notifications]
  }
}
