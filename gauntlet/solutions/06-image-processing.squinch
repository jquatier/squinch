pack aws

person subscribers "Subscribers"

bucket = aws/s3 "Image Bucket"
fn     = aws/lambda "Image Processor"
rek    = aws/rekognition "Rekognition"
db     = aws/dynamodb "Image Metadata" datastore
topic  = aws/sns "Notifications"

bucket ~> fn "object created"
fn -> rek "detect labels"
fn -> db "write metadata"
fn ~> topic "publish"
topic ~> subscribers "notify"

view landscape {
  title "Image Processing Pipeline"
  include *
}
