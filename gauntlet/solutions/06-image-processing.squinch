// Serverless image processing pipeline
pack aws

person user "User"

bucket = aws/s3 "Images Bucket"
process = aws/lambda "Image Processor" {
  description: "Processes uploaded images"
}
rekognition = aws/rekognition "Rekognition" {
  description: "Image label detection"
}
metadata = aws/dynamodb "Metadata Store" datastore
topic = aws/sns "Notifications"
subscribers = box "Subscribers" {
  description: "Email, webhook, or other notification targets"
}

user -> bucket "uploads image"
bucket ~> process "S3 event"
process -> rekognition "analyze image"
process -> metadata "write metadata"
process ~> topic "publish event"
topic ~> subscribers "notify"

view pipeline {
  title "Image Processing Pipeline"
  layout {
    rows [user] [bucket] [process] [rekognition metadata] [topic] [subscribers]
  }
}
