pack aws

person user "User"

bucket    = aws/s3 "Image Uploads" datastore
processor = aws/lambda "Image Processor" {
  description: "Analyzes images and stores metadata"
}
rekognition = aws/rekognition "Rekognition" {
  description: "Image labeling and analysis"
}
db        = aws/dynamodb "Metadata Store" datastore
topic     = aws/sns "Notification Topic"

user -> bucket "uploads image"
bucket ~> processor "S3 event"
processor -> rekognition "analyze image"
processor -> db "write metadata"
processor ~> topic "notify subscribers"
