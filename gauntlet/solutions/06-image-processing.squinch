pack aws

bucket = aws/s3 "Uploads Bucket"
fn     = aws/lambda "Image Processor"
rek    = aws/rekognition "Rekognition"
db     = aws/dynamodb "Metadata Table" datastore
topic  = aws/sns "Notifications Topic"
subs   = box "Subscribers" external

bucket ~> fn "upload event"
fn -> rek "detect labels"
fn -> db "write metadata"
fn ~> topic "publish"
topic ~> subs "notify"

view landscape {
  title "Serverless Image Pipeline"
  include *
}
