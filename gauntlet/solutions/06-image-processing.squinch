pack aws

person user "User"

bucket  = aws/s3         "Image Uploads" datastore
process = aws/lambda     "Image Processor"
vision  = aws/rekognition "Rekognition"
meta    = aws/dynamodb   "Image Metadata" datastore
notify  = aws/sns        "Notification Topic"

user   -> bucket  "uploads image"
bucket ~> process "S3 event"
process -> vision "detect labels"
process -> meta   "write metadata"
process ~> notify "publish result"

view pipeline {
  title "Image Processing Pipeline"
  layout {
    rows [user] [bucket] [process] [vision meta notify]
  }
}
