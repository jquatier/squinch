// Serverless image processing pipeline
pack aws

person user "User"

system pipeline "Image Pipeline" {
  description: "Serverless image processing"
  glyph: sys/workflow

  uploads = aws/s3 "Image Uploads" datastore
  processor = aws/lambda "Image Processor"
  rekognition = aws/rekognition "Rekognition" external
  metadata = aws/dynamodb "Image Metadata" datastore
  notifications = aws/sns "Notifications"

  uploads ~> processor "S3 event"
  processor -> rekognition "analyze image"
  processor -> metadata "write metadata"
  processor ~> notifications "publish result"
}

person subscriber "Subscriber"

user ~> pipeline.uploads "upload image"
pipeline.notifications ~> subscriber "notify"
