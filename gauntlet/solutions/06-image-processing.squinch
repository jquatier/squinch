// Serverless image processing pipeline
pack aws

uploader = person "User"
bucket   = aws/s3 "Upload Bucket" datastore
process  = aws/lambda "Image Processor"
rekognition = aws/rekognition "Rekognition"
metadata = aws/dynamodb "Image Metadata" datastore
notify   = aws/sns "Notification Topic"

uploader -> bucket "uploads image"
bucket ~> process "S3 event"
process -> rekognition "analyze image"
process -> metadata "write labels"
process ~> notify "publish result"
