pack aws

person user "User"

bucket    = aws/s3         "Image Uploads" datastore
processor = aws/lambda     "Image Processor"
rekognize = aws/rekognition "Rekognition"
metadata  = aws/dynamodb   "Metadata Store" datastore
notify    = aws/sns        "Notification Topic"

user -> bucket "uploads image"
bucket ~> processor "S3 event"
processor -> rekognize "analyze image"
processor -> metadata "write metadata"
processor ~> notify "publish result"
