pack aws

// Serverless image processing pipeline
system pipeline "Image Processing Pipeline" {
  description: "Serverless image processing with AI analysis"
  glyph: sys/workflow

  upload = aws/s3 "Upload Bucket" datastore {
    description: "Image upload storage"
  }

  processor = aws/lambda "Image Processor" {
    description: "Processes images and extracts metadata"
  }

  vision = aws/rekognition "Rekognition" external {
    description: "AI image analysis service"
  }

  metadata = aws/dynamodb "Metadata Store" datastore {
    description: "Image labels and metadata"
  }

  notifier = aws/sns "Notification Topic" {
    description: "Processing completion events"
  }

  upload ~> processor "S3 event"
  processor -> vision "analyze image"
  processor -> metadata "write metadata"
  processor ~> notifier "publish event"
}

view pipeline {
  title "Image Processing Pipeline"

  layout {
    direction down
    rows [upload] [processor] [metadata] [notifier]
    place vision left-of metadata
  }
}
