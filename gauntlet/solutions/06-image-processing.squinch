// Serverless image processing pipeline
pack aws

system image_pipeline "Image Processing Pipeline" {
  description: "Processes uploaded images"
  glyph: sys/workflow

  uploads = aws/s3 "Upload Bucket" datastore {
    description: "Image storage"
  }

  processor = aws/lambda "Image Processor" {
    description: "Processes images"
  }

  rekognition = aws/rekognition "Rekognition" external {
    description: "Label detection"
  }

  metadata = aws/dynamodb "Metadata Table" datastore {
    description: "Image metadata"
  }

  notifications = aws/sns "Notification Topic" {
    description: "Processing events"
  }

  uploads ~> processor "S3 event"
  processor -> rekognition "detect labels"
  processor -> metadata "store metadata"
  processor ~> notifications "publish event"
}

view image_pipeline {
  layout {
    rows [uploads] [processor] [rekognition metadata notifications]
  }
}
