pack aws

system pipeline "Image Processing Pipeline" {
  description: "Serverless image analysis"

  uploads = aws/s3 "Uploads Bucket" datastore
  process = aws/lambda "Process Images"
  rekognition = aws/rekognition "Rekognition"
  metadata = aws/dynamodb "Metadata" datastore
  notifications = aws/sns "Notifications"

  uploads ~> process "upload event"
  process -> rekognition "analyze image"
  process -> metadata "write metadata"
  process ~> notifications "notify subscribers"
}
