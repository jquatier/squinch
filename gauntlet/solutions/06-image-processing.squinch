pack aws

person uploader "Uploader"
person subscriber "Subscriber"

system pipeline "Image Processing Pipeline" {
  description: "Serverless image pipeline"

  bucket = aws/s3          "Uploads Bucket" datastore
  fn     = aws/lambda      "Process Image"
  rek    = aws/rekognition "Label Detection"
  table  = aws/dynamodb    "Image Metadata" datastore
  topic  = aws/sns         "Notifications"

  bucket ~> fn "object created"
  fn -> rek "detect labels"
  fn -> table "writes metadata"
  fn ~> topic "publishes result"

  layout {
    rows [bucket] [fn] [rek table] [topic]
  }
}

uploader -> pipeline.bucket "uploads image"
pipeline.topic ~> subscriber "notification"
