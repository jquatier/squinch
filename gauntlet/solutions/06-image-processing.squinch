pack aws

person uploader   "Uploader"
person subscriber "Subscriber"

system pipeline "Image Processing Pipeline" {
  description: "Serverless image pipeline"

  bucket = aws/s3         "Image Uploads"   datastore
  fn     = aws/lambda     "Image Processor"
  vision = aws/rekognition "Label Detection"
  db     = aws/dynamodb   "Image Metadata"  datastore
  topic  = aws/sns        "Notifications"

  bucket ~> fn     "object created"
  fn     -> vision "detect labels"
  fn     -> db     "write metadata"
  fn     ~> topic  "publish"

  layout {
    rows [bucket] [fn] [vision db] [topic]
  }
}

uploader -> pipeline.bucket "uploads image"
pipeline.topic ~> subscriber "notifies"
