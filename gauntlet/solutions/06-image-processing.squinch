pack aws

bucket = aws/s3 "Image Bucket"
labeler = aws/lambda "Image Labeler"
rek = aws/rekognition "Rekognition"
meta = aws/dynamodb "Image Metadata" datastore
topic = aws/sns "Notifications"
person subs "Subscribers"

bucket ~> labeler "object created"
labeler -> rek "detect labels"
labeler -> meta "writes metadata"
labeler ~> topic "publishes"
topic ~> subs "notifies"

view landscape {
  title "Serverless Image Pipeline"
  include *
}
