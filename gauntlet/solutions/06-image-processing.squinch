pack aws

person uploader "User"

system pipeline "Image Processing Pipeline" {
  description: "Serverless image analysis"
  glyph: aws/lambda

  bucket = aws/s3 "Image Uploads" datastore
  processor = aws/lambda "Image Processor" {
    description: "Analyzes and tags images"
  }
  rekognition = aws/rekognition "Rekognition" external
  metadata = aws/dynamodb "Image Metadata" datastore
  notifications = aws/sns "Notifications"

  bucket ~> processor "S3 event"
  processor -> rekognition "analyze image"
  processor -> metadata "store labels"
  processor ~> notifications "publish event"
}

uploader -> pipeline.bucket "upload image"
