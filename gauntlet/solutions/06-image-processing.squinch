// Serverless image processing pipeline
pack aws

person user "User"

system pipeline "Image Processing Pipeline" {
  description: "Serverless image analysis and metadata storage"

  bucket     = aws/s3         "Upload Bucket" datastore
  processor  = aws/lambda     "Image Processor" {
    subtitle: "Python 3.11"
  }
  rekognition = aws/rekognition "Rekognition"
  metadata   = aws/dynamodb   "Image Metadata" datastore
  notifier   = aws/sns        "Notification Topic"

  bucket ~> processor "S3 event"
  processor -> rekognition "analyze image"
  processor -> metadata "write labels"
  processor ~> notifier "publish event"
}

user -> pipeline.bucket "uploads image"

view pipeline {
  title "Image Processing Pipeline"
  layout {
    rows [bucket] [processor rekognition] [metadata notifier]
  }
}
