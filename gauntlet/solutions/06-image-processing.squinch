// Serverless image processing pipeline
pack aws

system pipeline "Image Processing Pipeline" {
  description: "Serverless image processing"
  glyph: sys/workflow

  bucket = aws/s3 "Upload Bucket" datastore
  processor = aws/lambda "Image Processor" {
    description: "Processes uploads and extracts labels"
  }
  rekognition = aws/rekognition "Rekognition"
  metadata = aws/dynamodb "Metadata Store" datastore
  notifications = aws/sns "Notification Topic"

  bucket ~> processor "S3 event"
  processor -> rekognition "analyze image"
  processor -> metadata "write metadata"
  processor ~> notifications "publish event"
}
