pack aws

person user "User"

system pipeline "Image Processing Pipeline" {
  description: "Serverless image analysis"
  glyph: aws/lambda

  bucket = aws/s3 "Upload Bucket" datastore
  process = aws/lambda "Image Processor"
  rekognition = aws/rekognition "Image Analysis"
  metadata = aws/dynamodb "Image Metadata" datastore
  notify = aws/sns "Notification Topic"

  bucket ~> process "upload event"
  process -> rekognition "analyze image"
  process -> metadata "write metadata"
  process ~> notify "publish result"
}

user -> pipeline.bucket "uploads image"
