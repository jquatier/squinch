pack aws

system pipeline "Image Processing Pipeline" {
  description: "Serverless image analysis"

  bucket = aws/s3 "Upload Bucket" datastore
  process = aws/lambda "Process Image"
  vision = aws/rekognition "Rekognition"
  metadata = aws/dynamodb "Metadata Table" datastore
  notify = aws/sns "Notifications"

  bucket ~> process "upload event"
  process -> vision "detect labels"
  process -> metadata "write metadata"
  process ~> notify "publish results"
}
