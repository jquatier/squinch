// Serverless image processing pipeline
pack aws

system pipeline "Image Pipeline" {
  description: "Serverless image processing"

  bucket = aws/s3 "Upload Bucket" datastore
  process = aws/lambda "Process Image"
  rekognition = aws/rekognition "Rekognition"
  metadata = aws/dynamodb "Metadata" datastore
  notify = aws/sns "Notifications"

  bucket ~> process "upload event"
  process -> rekognition "analyze image"
  process -> metadata "write metadata"
  process ~> notify "publish results"
}

view pipeline {
  scope pipeline
  layout {
    rows [bucket] [process] [rekognition metadata notify]
  }
}
