pack aws

system images "Image Pipeline" {
  bucket = aws/s3          "Uploads Bucket"
  fn     = aws/lambda      "Label Extractor"
  rek    = aws/rekognition "Rekognition"
  meta   = aws/dynamodb    "Image Metadata"
  topic  = aws/sns         "Subscriber Topic"

  bucket ~> fn "object created"
  fn -> rek   "detect labels"
  fn -> meta  "write metadata"
  fn -> topic "notify"
}

view images {
  layout {
    rows [bucket] [fn] [rek meta topic]
  }
}
