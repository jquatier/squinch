// Serverless image processing pipeline
pack aws

bucket = aws/s3 "Upload Bucket" datastore
process = aws/lambda "Image Processor"
ai = aws/rekognition "Rekognition"
metadata = aws/dynamodb "Metadata Store" datastore
notifications = aws/sns "Notifications"

bucket ~> process "upload event"
process -> ai "analyze image"
process -> metadata "write labels"
process ~> notifications "publish result"
