// Wide ingestion estate
pack aws

// Six collectors
c1 = aws/lambda "Collector 1"
c2 = aws/lambda "Collector 2"
c3 = aws/lambda "Collector 3"
c4 = aws/lambda "Collector 4"
c5 = aws/lambda "Collector 5"
c6 = aws/lambda "Collector 6"

// Normaliser
normaliser = aws/lambda "Normaliser"

// Targets
warehouse = aws/redshift "Warehouse" datastore
search = aws/opensearch "Search Index" datastore
alerting = aws/sns "Alerting"

// Connections: collectors feed normaliser
c1 ~> normaliser
c2 ~> normaliser
c3 ~> normaliser
c4 ~> normaliser
c5 ~> normaliser
c6 ~> normaliser

// Normaliser fans out to targets
normaliser ~> warehouse
normaliser ~> search
normaliser ~> alerting

view main {
  title "Ingestion Estate"
  layout {
    direction right
    density compact
    rows [warehouse search]
  }
}
