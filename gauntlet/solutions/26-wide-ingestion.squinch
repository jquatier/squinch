// Wide ingestion architecture

pack aws

// Six collectors
c1 = aws/kinesis "Collector 1"
c2 = aws/kinesis "Collector 2"
c3 = aws/kinesis "Collector 3"
c4 = aws/kinesis "Collector 4"
c5 = aws/kinesis "Collector 5"
c6 = aws/kinesis "Collector 6"

// Normaliser
normaliser = aws/lambda "Normaliser"

// Outputs
warehouse = aws/redshift "Warehouse" datastore
search = aws/opensearch "Search Index" datastore
alerts = aws/sns "Alerting"

// Edges - collectors to normaliser
c1 -> normaliser
c2 -> normaliser
c3 -> normaliser
c4 -> normaliser
c5 -> normaliser
c6 -> normaliser

// Edges - normaliser to outputs
normaliser -> warehouse
normaliser -> search
normaliser -> alerts

view main {
  title "Ingestion Pipeline"
  layout {
    direction right
    density compact
    rows [warehouse search] [alerts]
  }
}
