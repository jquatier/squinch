pack aws

system ingestion "Ingestion Estate" {
  c1 = aws/lambda "Collector 1"
  c2 = aws/lambda "Collector 2"
  c3 = aws/lambda "Collector 3"
  c4 = aws/lambda "Collector 4"
  c5 = aws/lambda "Collector 5"
  c6 = aws/lambda "Collector 6"

  normaliser = aws/lambda "Normaliser"

  warehouse = aws/redshift "Data Warehouse" datastore
  search = aws/opensearch "Search Index" datastore
  alerts = aws/sns "Alerting Service"

  c1 ~> normaliser
  c2 ~> normaliser
  c3 ~> normaliser
  c4 ~> normaliser
  c5 ~> normaliser
  c6 ~> normaliser

  normaliser ~> warehouse
  normaliser ~> search
  normaliser ~> alerts

  layout {
    direction right
    rows [warehouse search] [alerts]
  }
}

view ingestion {
  title "Ingestion Estate"
  layout {
    density compact
  }
}
