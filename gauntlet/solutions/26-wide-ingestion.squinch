// Ingestion estate — wide layout for slides

collector1 = sys/container "Collector 1"
collector2 = sys/container "Collector 2"
collector3 = sys/container "Collector 3"
collector4 = sys/container "Collector 4"
collector5 = sys/container "Collector 5"
collector6 = sys/container "Collector 6"

normaliser = sys/cpu "Normaliser"

warehouse = sys/database "Warehouse" datastore
search    = sys/search   "Search Index" datastore
alerting  = sys/siren    "Alerting"

collector1 ~> normaliser
collector2 ~> normaliser
collector3 ~> normaliser
collector4 ~> normaliser
collector5 ~> normaliser
collector6 ~> normaliser

normaliser ~> warehouse
normaliser ~> search
normaliser ~> alerting

view default {
  layout {
    direction right
    density compact
    rows [collector1 collector2 collector3 collector4 collector5 collector6] [normaliser] [warehouse search] [alerting]
  }
}
