// Ingestion estate — wide layout for a single slide

collector1 = sys/antenna      "Collector 1"
collector2 = sys/antenna      "Collector 2"
collector3 = sys/antenna      "Collector 3"
collector4 = sys/antenna      "Collector 4"
collector5 = sys/antenna      "Collector 5"
collector6 = sys/antenna      "Collector 6"
normaliser = sys/filter       "Normaliser"
warehouse  = sys/database     "Warehouse" datastore
search     = sys/search       "Search Index" datastore
alerting   = sys/siren        "Alerting Service"

collector1 ~> normaliser
collector2 ~> normaliser
collector3 ~> normaliser
collector4 ~> normaliser
collector5 ~> normaliser
collector6 ~> normaliser

normaliser ~> warehouse
normaliser ~> search
normaliser ~> alerting

view landscape {
  title "Ingestion Estate"
  include *
  layout {
    direction right
    density compact
  }
}
