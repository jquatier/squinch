// Wide ingestion pipeline — six collectors feeding one normaliser

c1 = sys/server "Collector 1"
c2 = sys/server "Collector 2"
c3 = sys/server "Collector 3"
c4 = sys/server "Collector 4"
c5 = sys/server "Collector 5"
c6 = sys/server "Collector 6"

normaliser = sys/workflow "Normaliser"
warehouse  = sys/database "Warehouse" datastore
search     = sys/search "Search Index" datastore
alerts     = sys/siren "Alerting"

c1 ~> normaliser
c2 ~> normaliser
c3 ~> normaliser
c4 ~> normaliser
c5 ~> normaliser
c6 ~> normaliser

normaliser ~> warehouse
normaliser ~> search
normaliser ~> alerts

view ingestion {
  title "Ingestion Pipeline"
  layout {
    direction right
    density compact
    rows [c1 c2 c3 c4 c5 c6] [normaliser] [warehouse search alerts]
  }
}
