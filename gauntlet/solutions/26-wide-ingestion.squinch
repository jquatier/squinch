c1 = sys/radio-tower "Collector 1"
c2 = sys/radio-tower "Collector 2"
c3 = sys/radio-tower "Collector 3"
c4 = sys/radio-tower "Collector 4"
c5 = sys/radio-tower "Collector 5"
c6 = sys/radio-tower "Collector 6"
norm = sys/workflow "Normaliser"
wh = sys/database "Warehouse" datastore
idx = sys/search "Search Index" datastore
alerts = sys/siren "Alerting Service"

c1 -> norm
c2 -> norm
c3 -> norm
c4 -> norm
c5 -> norm
c6 -> norm
norm -> wh, idx, alerts

view landscape {
  title "Ingestion Estate"
  include *
  layout {
    density compact
  }
}
