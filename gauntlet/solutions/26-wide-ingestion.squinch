c1 = sys/webhook "Collector 1"
c2 = sys/webhook "Collector 2"
c3 = sys/webhook "Collector 3"
c4 = sys/webhook "Collector 4"
c5 = sys/webhook "Collector 5"
c6 = sys/webhook "Collector 6"

norm = sys/workflow "Normaliser"

wh    = sys/warehouse "Warehouse" datastore
idx   = sys/search    "Search Index" datastore
alert = sys/siren     "Alerting Service"

c1 ~> norm
c2 ~> norm
c3 ~> norm
c4 ~> norm
c5 ~> norm
c6 ~> norm

norm ~> wh
norm ~> idx
norm ~> alert

view ingestion {
  title "Ingestion Estate"
  include *
  layout {
    density compact
    rows [c1 c2 c3 c4 c5 c6] [norm] [wh idx alert]
    channel c1, c2, c3, c4, c5, c6 -> norm
  }
}
