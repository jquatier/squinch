// Ingestion estate - wide layout for single slide presentation

c1 = sys/container "Collector 1"
c2 = sys/container "Collector 2"
c3 = sys/container "Collector 3"
c4 = sys/container "Collector 4"
c5 = sys/container "Collector 5"
c6 = sys/container "Collector 6"

normaliser = sys/workflow "Normaliser"

warehouse = sys/database "Warehouse" datastore
search    = sys/search   "Search Index" datastore
alerting  = sys/siren    "Alerting"

c1 ~> normaliser
c2 ~> normaliser
c3 ~> normaliser
c4 ~> normaliser
c5 ~> normaliser
c6 ~> normaliser

normaliser ~> warehouse
normaliser ~> search
normaliser ~> alerting

view main {
  layout {
    direction right
    density compact
  }
}
