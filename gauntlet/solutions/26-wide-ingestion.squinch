// Wide ingestion estate
pack sys

// Collectors
c1 = sys/server "Collector 1"
c2 = sys/server "Collector 2"
c3 = sys/server "Collector 3"
c4 = sys/server "Collector 4"
c5 = sys/server "Collector 5"
c6 = sys/server "Collector 6"

// Normaliser
norm = sys/workflow "Normaliser"

// Downstream services
wh = sys/database "Warehouse" datastore
idx = sys/search "Search Index" datastore
alert = sys/siren "Alerting"

// Edges: collectors feed normaliser (async ingestion)
c1 ~> norm
c2 ~> norm
c3 ~> norm
c4 ~> norm
c5 ~> norm
c6 ~> norm

// Normaliser fans out to downstream
norm -> wh
norm -> idx
norm -> alert

view main {
  layout {
    direction right
    density compact
    rows [c1 c2 c3 c4 c5 c6] [norm] [wh alert] [idx]
    align wh idx
  }
}
