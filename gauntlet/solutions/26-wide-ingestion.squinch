// Ingestion estate — wide layout for slide presentation
c1 = box "Collector 1"
c2 = box "Collector 2"
c3 = box "Collector 3"
c4 = box "Collector 4"
c5 = box "Collector 5"
c6 = box "Collector 6"

normaliser = box "Normaliser"

warehouse = sys/database "Warehouse" datastore
search    = sys/database "Search Index" datastore
alerting  = box "Alerting Service"

c1 -> normaliser
c2 -> normaliser
c3 -> normaliser
c4 -> normaliser
c5 -> normaliser
c6 -> normaliser

normaliser -> warehouse
normaliser -> search
normaliser -> alerting

view default {
  title "Ingestion Estate"
  layout {
    direction right
    density compact
    rows [c1 c2 c3 c4 c5 c6] [normaliser] [warehouse search] [alerting]
  }
}
