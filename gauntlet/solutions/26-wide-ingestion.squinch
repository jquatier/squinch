c1 = sys/inbox "Collector 1"
c2 = sys/inbox "Collector 2"
c3 = sys/inbox "Collector 3"
c4 = sys/inbox "Collector 4"
c5 = sys/inbox "Collector 5"
c6 = sys/inbox "Collector 6"

norm = sys/funnel "Normaliser"

wh    = sys/warehouse       "Warehouse"    datastore
idx   = sys/database-search "Search Index" datastore
alert = sys/alert           "Alerting Service"

c1 ~> norm
c2 ~> norm
c3 ~> norm
c4 ~> norm
c5 ~> norm
c6 ~> norm

norm ~> wh
norm ~> idx
norm ~> alert

view landscape {
  title "Ingestion Estate"
  include *
  layout {
    density compact
    rows [c1 c2 c3 c4 c5 c6] [norm] [wh alert] [idx]
    cols [wh idx]
    channel c1, c2, c3, c4, c5, c6 -> norm
  }
}
