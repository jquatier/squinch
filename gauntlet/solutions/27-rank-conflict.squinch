// Approval chain diagram
req    = sys/server  "Request Service"
policy = sys/cog     "Policy Engine"
approve = sys/shield-check "Approver Service"
audit  = sys/database "Audit Log" datastore

req -> policy
policy -> approve
approve -> audit

view main {
  layout {
    rows [req] [policy audit]
    place audit right-of policy
  }
}
