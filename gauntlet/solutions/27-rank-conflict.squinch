request  = sys/webhook       "Request Service"
policy   = sys/shield-check  "Policy Engine"
approver = sys/clipboard-list "Approver Service"
audit    = sys/archive       "Audit Log" datastore

request -> policy "submits request"
policy -> approver "requests approval"
approver -> audit "writes decision"

view landscape {
  title "Approval Chain"
  include *
  layout {
    rows [request] [policy approver audit]
  }
}
