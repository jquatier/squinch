request  = sys/server   "Request Service"
policy   = sys/shield-check "Policy Engine"
approver = sys/server   "Approver Service"
audit    = sys/database "Audit Log" datastore

request -> policy "hands off"
policy -> approver "calls"
approver -> audit "writes"

view landscape {
  title "Approval Chain"
  include *
  layout {
    rows [request] [policy audit] [approver]
  }
}
