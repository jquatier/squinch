// Approval chain with policy engine and audit log on same row

request  = sys/app-window "Request Service"
policy   = sys/cog       "Policy Engine"
approver = sys/shield    "Approver Service"
audit    = sys/database  "Audit Log" datastore

request -> policy
policy  -> approver
policy  -> audit
approver -> audit

view default {
  title "Approval Chain"
  layout {
    rows [request] [policy approver audit]
  }
}
