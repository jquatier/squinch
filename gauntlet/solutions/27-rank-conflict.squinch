// Approval chain with rank conflict resolution
system approval "Approval Chain" {
  request  = box "Request Service"
  policy   = box "Policy Engine"
  approver = box "Approver Service"
  audit    = box "Audit Log" datastore

  request -> policy
  policy -> approver
  approver -> audit

  layout {
    rows [request] [policy approver audit]
  }
}
