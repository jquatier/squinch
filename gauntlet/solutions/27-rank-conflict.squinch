// Approval chain with policy engine and audit log on same row

request = sys/app-window "Request Service"
policy = sys/shield-check "Policy Engine"
approver = sys/code "Approver Service"
audit = sys/database "Audit Log" datastore

request -> policy
policy -> approver
approver -> audit

view main {
  layout {
    rows [request] [policy audit]
    place audit right-of policy
  }
}
