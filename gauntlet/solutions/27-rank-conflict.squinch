// Approval chain diagram

request   = sys/app-window "Request Service"
policy    = sys/shield-check "Policy Engine"
approver  = sys/user-check "Approver Service"
audit     = sys/database "Audit Log" datastore

request -> policy
policy -> approver
approver -> audit

view main {
  title "Approval Chain"
  layout {
    rows [request] [policy approver audit]
  }
}
