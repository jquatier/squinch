// Approval chain with policy engine and audit log on same row

request  = box "Request Service"
policy   = box "Policy Engine"
approver = box "Approver Service"
audit    = box "Audit Log" datastore

request -> policy
policy -> approver
approver -> audit

view main {
  title "Approval Chain"
  layout {
    rows [request] [policy audit approver]
  }
}
