// Approval chain with policy engine and audit log on same rank

request  = sys/webhook "Request Service"
policy   = sys/shield  "Policy Engine"
approver = sys/server  "Approver Service"
audit    = sys/database "Audit Log" datastore

request -> policy
policy -> approver
approver -> audit

view main {
  layout {
    rows [request] [policy audit]
    place audit right-of policy
  }
}
