req      = sys/server "Request Service"
policy   = sys/cog "Policy Engine"
approver = sys/server "Approver Service"
audit    = sys/database "Audit Log" datastore

req -> policy
policy -> approver
approver -> audit "writes"

view approvals {
  title "Approval Chain"
  include *
  layout { rows [req] [policy audit] [approver] }
}
