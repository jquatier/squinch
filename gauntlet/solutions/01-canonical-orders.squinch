// Lambda-based API with three handlers behind API Gateway
pack aws

gw = aws/api-gateway "API Gateway"

create = aws/lambda "Create Handler"
get    = aws/lambda "Get Handler"
search = aws/lambda "Search Handler"

db    = aws/dynamodb   "Orders Table" datastore
files = aws/s3         "Files Bucket" datastore
idx   = aws/opensearch "Search Index" datastore

sync = aws/lambda "Stream Processor"

gw -> create
gw -> get
gw -> search

create -> db
create -> files
get    -> db
get    -> files
search -> idx

db ~> sync "DynamoDB stream"
sync -> idx

view api {
  title "Lambda-based API"
  layout {
    rows [gw] [create get search] [db files idx sync]
    place sync right-of idx
  }
}
