pack aws

system api "Lambda API" {
  description: "Lambda-based API with search"

  gw = aws/api-gateway "API Gateway"

  create = aws/lambda "Create Handler"
  get    = aws/lambda "Get Handler"
  search = aws/lambda "Search Handler"

  db     = aws/dynamodb  "DynamoDB" datastore
  files  = aws/s3        "S3" datastore
  idx    = aws/opensearch "OpenSearch" datastore

  sync   = aws/lambda "Stream Processor"

  gw -> create, get, search

  create -> db
  create -> files

  get -> db
  get -> files

  search -> idx

  db ~> sync "DynamoDB stream"
  sync -> idx
}

view api {
  layout {
    rows [gw] [create get search] [db files idx]
    place sync right-of db
  }
}
