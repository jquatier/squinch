pack aws

// API layer
gw = aws/api-gateway "API Gateway"

// Lambda handlers
create = aws/lambda "Create Handler"
get    = aws/lambda "Get Handler"
search = aws/lambda "Search Handler"

// Data stores
db     = aws/dynamodb  "Orders Table" datastore
files  = aws/s3        "Files Bucket" datastore
idx    = aws/opensearch "Search Index" datastore

// Stream processor
sync   = aws/lambda "Index Sync" {
  description: "Keeps OpenSearch up to date"
}

// Connections - sync edges
gw -> create
gw -> get
gw -> search

create -> db
create -> files
get    -> db
get    -> files
search -> idx

// Async edge - DynamoDB stream
db ~> sync "DynamoDB stream"
sync -> idx

view main {
  title "Lambda-based API Architecture"
  layout {
    rows [gw] [create get search] [db files sync] [idx]
  }
}
