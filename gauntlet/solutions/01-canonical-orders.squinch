pack aws

// API tier
gw = aws/api-gateway "API Gateway"

// Handler tier
create = aws/lambda "Create Handler"
get    = aws/lambda "Get Handler"
search = aws/lambda "Search Handler"

// Sync tier (stream processor)
sync = aws/lambda "Stream Sync"

// Storage tier
db    = aws/dynamodb  "DynamoDB" datastore
files = aws/s3        "S3 Bucket" datastore
idx   = aws/opensearch "OpenSearch" datastore

// Sync connections
gw -> create
gw -> get
gw -> search

create -> db
create -> files
get -> db
get -> files
search -> idx

// Async stream processing
db ~> sync "DynamoDB stream"
sync -> idx

// Layout
view main {
  title "Lambda-based API Architecture"
  layout {
    rows [gw] [create get search] [db files sync idx]
  }
}
