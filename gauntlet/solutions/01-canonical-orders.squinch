pack aws

system api "Orders API" {
  gw     = aws/api-gateway "API Gateway"
  create = aws/lambda "Create Handler"
  get    = aws/lambda "Get Handler"
  search = aws/lambda "Search Handler"
  sync   = aws/lambda "Index Sync"
  db     = aws/dynamodb "DynamoDB Table" datastore
  files  = aws/s3 "S3 Bucket" datastore
  idx    = aws/opensearch "OpenSearch Index" datastore

  gw -> create, get, search
  create -> db
  create -> files
  get -> db
  search -> idx
  db ~> sync "DynamoDB stream"
  sync -> idx "updates index"
}

view landscape {
  title "Orders API"
  include *
  expand api
}
