pack aws

api = aws/api-gateway "API Gateway"

create = aws/lambda "Create Handler" { subtitle: "Lambda" }
get    = aws/lambda "Get Handler"    { subtitle: "Lambda" }
search = aws/lambda "Search Handler" { subtitle: "Lambda" }

db      = aws/dynamodb   "Orders Table" datastore
files   = aws/s3         "Attachments"  datastore
idx     = aws/opensearch "Search Index" datastore

indexer = aws/lambda "Stream Indexer" { subtitle: "Lambda" }

api -> create, get, search

create -> db    "create order"
create -> files "store attachment"
get    -> db    "read order"
search -> idx   "query"

db      ~> indexer "DynamoDB stream"
indexer -> idx      "index order"

view overview {
  title "Order API"
  include *
  layout {
    rows [api] [create get search] [db indexer idx files]
  }
}
