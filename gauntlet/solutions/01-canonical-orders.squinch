pack aws

system api "Order API" {
  description: "Lambda-based order management"

  gw = aws/api-gateway "API Gateway"

  create = aws/lambda "Create Handler"
  get    = aws/lambda "Get Handler"
  search = aws/lambda "Search Handler"

  db    = aws/dynamodb "Orders Table" datastore
  files = aws/s3 "Attachments" datastore
  idx   = aws/opensearch "Search Index" datastore

  sync = aws/lambda "Index Sync" {
    description: "Stream processor"
  }

  gw -> create
  gw -> get
  gw -> search

  create -> db
  create -> files
  get -> db
  get -> files
  search -> idx

  db ~> sync "DynamoDB stream"
  sync -> idx
}

view api {
  layout {
    rows [gw] [create get search] [db files idx]
    place sync right-of db
  }
}
