pack aws

system api "Order API" {
  description: "Lambda-based API with search"

  // Entry tier
  gw = aws/api-gateway "API Gateway"

  // Handler tier
  create = aws/lambda "Create Handler"
  get = aws/lambda "Get Handler"
  search = aws/lambda "Search Handler"

  // Storage tier
  db = aws/dynamodb "Orders Table" datastore
  files = aws/s3 "Order Files" datastore
  index = aws/opensearch "Search Index" datastore

  // Sync processor
  sync = aws/lambda "Index Sync" {
    description: "Updates OpenSearch from stream"
  }

  // Entry to handlers
  gw -> create
  gw -> get
  gw -> search

  // Handlers to storage
  create -> db
  create -> files
  get -> db
  search -> index

  // Async stream processing
  db ~> sync "DynamoDB stream"
  sync -> index
}

view api {
  layout {
    rows [gw] [create get search] [db files index]
    place sync right-of db
  }
}
