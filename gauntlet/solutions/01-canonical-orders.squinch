pack aws

system orders "Orders API" {
  api    = aws/api-gateway "API Gateway"
  create = aws/lambda "Create Handler"
  get    = aws/lambda "Get Handler"
  search = aws/lambda "Search Handler"
  db     = aws/dynamodb "DynamoDB Table" datastore
  files  = aws/s3 "S3 Bucket" datastore
  idx    = aws/opensearch "OpenSearch Index" datastore
  sync   = aws/lambda "Index Updater" {
    subtitle: "Lambda · async"
  }

  api -> create, get, search
  create -> db
  create -> files
  get -> db
  get -> files
  search -> idx
  db ~> sync "DynamoDB stream"
  sync ~> idx "updates"
}

view orders {
  title "Orders API"
  layout {
    rows [api] [create get search] [db files idx] [sync]
  }
}
