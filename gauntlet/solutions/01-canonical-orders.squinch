pack aws

system orders "Order API" {
  description: "Lambda-based order API"

  api     = aws/api-gateway "API Gateway"
  create  = aws/lambda      "Create Handler"
  get     = aws/lambda      "Get Handler"
  search  = aws/lambda      "Search Handler"
  indexer = aws/lambda      "Index Sync"

  db    = aws/dynamodb  "Orders Table"  datastore
  files = aws/s3        "Files"         datastore
  idx   = aws/opensearch "Search Index" datastore

  api -> create, get, search

  create -> db
  create -> files
  get -> db
  search -> idx

  db ~> indexer "DynamoDB stream"
  indexer ~> idx

  layout {
    rows [api] [create get search] [db files] [indexer] [idx]
  }
}
