// Lambda-based API with DynamoDB stream to OpenSearch
pack aws

system api "Order API" {
  description: "API for order operations"

  // API Gateway entry point
  gw = aws/api-gateway "API Gateway"

  // Lambda handlers
  create = aws/lambda "Create Handler"
  get = aws/lambda "Get Handler"
  search = aws/lambda "Search Handler"

  // Data stores
  db = aws/dynamodb "Orders Table" datastore
  files = aws/s3 "Order Files" datastore
  idx = aws/opensearch "Search Index" datastore

  // Stream processor
  sync = aws/lambda "Index Sync"

  // API Gateway to handlers (sync)
  gw -> create
  gw -> get
  gw -> search

  // Handlers to storage
  create -> db
  create -> files
  get -> db
  search -> idx

  // DynamoDB stream to sync Lambda (async)
  db ~> sync "DynamoDB stream"
  sync -> idx
}

view api {
  layout {
    direction down
    rows [gw] [create get search] [db files idx]
    place sync right-of db
    route db ~> sync from east to west
  }
}
