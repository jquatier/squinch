pack logos

person customer "Customer"

web = logos/react "Web App" {
  subtitle: "React SPA"
}

bff = logos/nodedotjs "BFF" {
  subtitle: "Node.js"
  description: "Backend-for-frontend · API aggregation layer"
}

system identity "Identity & Profile" {
  description: "User authentication and profile management"
  icon: sys/lock
  users = sys/server "Users" { subtitle: "Postgres" }
  auth = sys/server "Auth" { subtitle: "Redis sessions" }
  profile = sys/server "Profile" { subtitle: "Postgres" }

  users_db = sys/database "Users DB" datastore
  auth_cache = sys/database "Session Store" datastore
  profile_db = sys/database "Profile DB" datastore

  users -> users_db
  auth -> auth_cache
  profile -> profile_db
}

system catalog_system "Catalog & Discovery" {
  description: "Product catalog, search and recommendations"
  icon: sys/search
  catalog = sys/server "Catalog" { subtitle: "Postgres" }
  search = sys/server "Search" { subtitle: "OpenSearch" }
  recommendations = sys/server "Recommendations" { subtitle: "Redis" }
  reviews = sys/server "Reviews" { subtitle: "MongoDB" }

  catalog_db = sys/database "Catalog DB" datastore
  search_idx = sys/database "Search Index" datastore
  rec_cache = sys/database "Rec Cache" datastore
  reviews_db = sys/database "Reviews DB" datastore

  catalog -> catalog_db
  search -> search_idx
  recommendations -> rec_cache
  reviews -> reviews_db

  search -> catalog "reads"
  recommendations -> catalog "reads"
  recommendations -> reviews "reads"
}

system commerce "Shopping & Checkout" {
  description: "Cart, pricing, checkout and order placement"
  icon: sys/shopping-cart
  pricing = sys/server "Pricing" { subtitle: "Redis" }
  cart = sys/server "Cart" { subtitle: "Redis" }
  checkout = sys/server "Checkout" { subtitle: "Postgres" }
  orders = sys/server "Orders" { subtitle: "Postgres" }
  payments = sys/server "Payments" { subtitle: "Postgres" }

  pricing_cache = sys/database "Price Cache" datastore
  cart_cache = sys/database "Cart Store" datastore
  checkout_db = sys/database "Checkout DB" datastore
  orders_db = sys/database "Orders DB" datastore
  payments_db = sys/database "Payments DB" datastore

  stripe = box "Stripe" external

  pricing -> pricing_cache
  cart -> cart_cache
  checkout -> checkout_db
  orders -> orders_db
  payments -> payments_db

  checkout -> cart
  checkout -> pricing
  checkout -> payments
  checkout -> orders
  orders -> fulfillment.inventory "reserves"
  payments -> stripe
}

system fulfillment "Fulfillment & Support" {
  description: "Inventory, shipping, notifications and customer support"
  icon: sys/truck
  inventory = sys/server "Inventory" { subtitle: "Postgres" }
  shipping = sys/server "Shipping" { subtitle: "Postgres" }
  notifications = sys/server "Notifications" { subtitle: "SendGrid" }
  support = sys/server "Support" { subtitle: "Postgres" }

  inventory_db = sys/database "Inventory DB" datastore
  shipping_db = sys/database "Shipping DB" datastore
  support_db = sys/database "Support DB" datastore

  sendgrid = box "SendGrid" external
  carrier = box "Carrier API" external

  inventory -> inventory_db
  shipping -> shipping_db
  support -> support_db

  notifications -> sendgrid
  shipping -> carrier
}

bus = logos/kafka "Event Bus" {
  subtitle: "Kafka"
}

customer -> web "browses, shops"
web -> bff

bff -> identity.users
bff -> identity.auth
bff -> identity.profile
bff -> catalog_system.catalog
bff -> catalog_system.search
bff -> catalog_system.recommendations
bff -> catalog_system.reviews
bff -> commerce.pricing
bff -> commerce.cart
bff -> commerce.checkout
bff -> commerce.orders
bff -> fulfillment.support

commerce.orders ~> bus "order events"
commerce.payments ~> bus "payment events"
bus ~> fulfillment.notifications "events"
bus ~> fulfillment.shipping "events"
bus ~> catalog_system.recommendations "events"

view landscape {
  title "E-commerce Platform"
  include *
  layout {
    rows [customer] [web] [bff] [commerce] [bus] [catalog_system fulfillment]
  }
}

view identity {
  title "Identity & Profile Services"
}

view catalog {
  title "Catalog & Discovery Services"
  scope catalog_system
}

view commerce {
  title "Shopping & Checkout Services"
}

view fulfillment {
  title "Fulfillment & Support Services"
}
