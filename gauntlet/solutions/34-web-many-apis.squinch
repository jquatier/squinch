pack aws
pack logos

web = logos/react "Web App" {
  subtitle: "apps/web · React SPA"
}
bff = logos/nodedotjs "BFF" {
  subtitle: "apps/bff · Node"
}
kafka = logos/kafka "Kafka" {
  description: "Order and payment events"
}
stripe = logos/stripe "Stripe" external
carrier = box "Carrier API" external
sendgrid = box "SendGrid" external

system identity "Identity" {
  description: "Accounts, sessions and profiles"
  preview: [users auth profile]
  users = box "Users" { subtitle: "services/users" }
  users_db = logos/postgres "Users DB" datastore
  auth = box "Auth" { subtitle: "services/auth" }
  auth_cache = logos/redis "Session Store" datastore
  profile = box "Profile" { subtitle: "services/profile" }
  profile_db = logos/postgres "Profile DB" datastore
  users -> users_db
  auth -> auth_cache
  profile -> profile_db
}

system catalog "Catalog" {
  description: "Products, search, prices and reviews"
  preview: [catalog search recommendations]
  catalog = box "Catalog" { subtitle: "services/catalog" }
  catalog_db = logos/postgres "Catalog DB" datastore
  search = box "Search" { subtitle: "services/search" }
  search_index = aws/opensearch "Search Index" datastore
  pricing = box "Pricing" { subtitle: "services/pricing" }
  pricing_cache = logos/redis "Pricing Cache" datastore
  reviews = box "Reviews" { subtitle: "services/reviews" }
  reviews_db = logos/mongodb "Reviews DB" datastore
  recommendations = box "Recommendations" { subtitle: "services/recommendations" }
  recs_cache = logos/redis "Recommendations Cache" datastore
  catalog -> catalog_db
  search -> search_index
  pricing -> pricing_cache
  reviews -> reviews_db
  recommendations -> recs_cache
  search -> catalog "reads"
  recommendations -> catalog "reads"
  recommendations -> reviews "reads"
}

system buying "Buying" {
  description: "Cart, checkout, orders and payments"
  preview: [cart checkout orders]
  cart = box "Cart" { subtitle: "services/cart" }
  cart_cache = logos/redis "Cart Store" datastore
  checkout = box "Checkout" { subtitle: "services/checkout" }
  checkout_db = logos/postgres "Checkout DB" datastore
  orders = box "Orders" { subtitle: "services/orders" }
  orders_db = logos/postgres "Orders DB" datastore
  payments = box "Payments" { subtitle: "services/payments" }
  payments_db = logos/postgres "Payments DB" datastore
  cart -> cart_cache
  checkout -> checkout_db
  orders -> orders_db
  payments -> payments_db
  checkout -> cart
  checkout -> payments
  checkout -> orders
}

system fulfilment "Fulfilment" {
  description: "Stock and delivery"
  preview: [inventory shipping]
  inventory = box "Inventory" { subtitle: "services/inventory" }
  inventory_db = logos/postgres "Inventory DB" datastore
  shipping = box "Shipping" { subtitle: "services/shipping" }
  shipping_db = logos/postgres "Shipping DB" datastore
  inventory -> inventory_db
  shipping -> shipping_db
}

system care "Customer Care" {
  description: "Notifications and support"
  preview: [notifications support]
  notifications = box "Notifications" { subtitle: "services/notifications" }
  support = box "Support" { subtitle: "services/support" }
  support_db = logos/postgres "Support DB" datastore
  support -> support_db
}

web -> bff
bff -> identity.users, identity.auth, identity.profile
bff -> catalog.catalog, catalog.search, catalog.pricing, catalog.reviews, catalog.recommendations
bff -> buying.cart, buying.checkout, buying.orders, buying.payments
bff -> fulfilment.shipping, fulfilment.inventory
bff -> care.notifications, care.support

buying.checkout -> catalog.pricing
buying.orders -> fulfilment.inventory
buying.payments -> stripe
fulfilment.shipping -> carrier
care.notifications -> sendgrid

buying.orders ~> kafka "order events"
buying.payments ~> kafka "payment events"
kafka ~> care.notifications, fulfilment.shipping, catalog.recommendations

view landscape {
  title "System Landscape"
  include *
  preview *
  layout {
    rows [web] [bff] [identity catalog buying fulfilment care] [kafka] [stripe carrier sendgrid]
  }
}
view identity { title "Identity" }
view catalog { title "Catalog" }
view buying { title "Buying" }
view fulfilment { title "Fulfilment" }
view care { title "Customer Care" }
