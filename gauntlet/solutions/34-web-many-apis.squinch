// E-commerce platform with React web app, Node BFF, and microservices
pack logos

person customer "Customer"

// Frontend
web = logos/react "Web App" {
  description: "React single-page application"
  subtitle: "React SPA"
}

// Backend-for-frontend
bff = logos/nodedotjs "BFF" {
  description: "Backend-for-frontend orchestration layer"
  subtitle: "Node.js"
}

// Core services
system core_services "Core Services" {
  description: "User identity and authentication"

  users = sys/database "Users" datastore {
    subtitle: "Postgres"
    badge: logos/postgres
  }
  auth = sys/database "Auth" datastore {
    subtitle: "Redis · Sessions"
    badge: logos/redis
  }
  profile = sys/database "Profile" datastore {
    subtitle: "Postgres"
    badge: logos/postgres
  }
}

// Catalog and discovery
system catalog_services "Catalog & Discovery" {
  description: "Product catalog, search, and recommendations"

  catalog = sys/database "Catalog" datastore {
    subtitle: "Postgres"
    badge: logos/postgres
  }
  search = sys/database "Search" datastore {
    subtitle: "OpenSearch"
    badge: logos/elasticsearch
  }
  reviews = sys/database "Reviews" datastore {
    subtitle: "MongoDB"
    badge: logos/mongodb
  }
  recommendations = sys/database "Recommendations" datastore {
    subtitle: "Redis"
    badge: logos/redis
  }
  pricing = sys/database "Pricing" datastore {
    subtitle: "Redis"
    badge: logos/redis
  }
}

// Order processing
system order_services "Order Processing" {
  description: "Cart, checkout, orders, and payments"

  cart = sys/database "Cart" datastore {
    subtitle: "Redis"
    badge: logos/redis
  }
  checkout = sys/database "Checkout" datastore {
    subtitle: "Postgres"
    badge: logos/postgres
  }
  orders = sys/database "Orders" datastore {
    subtitle: "Postgres"
    badge: logos/postgres
  }
  payments = sys/database "Payments" datastore {
    subtitle: "Postgres"
    badge: logos/postgres
  }
  inventory = sys/database "Inventory" datastore {
    subtitle: "Postgres"
    badge: logos/postgres
  }
}

// Fulfillment and support
system fulfillment_services "Fulfillment & Support" {
  description: "Shipping, notifications, and customer support"

  shipping = sys/database "Shipping" datastore {
    subtitle: "Postgres"
    badge: logos/postgres
  }
  notifications = sys/server "Notifications" {
    subtitle: "SendGrid"
  }
  support = sys/database "Support" datastore {
    subtitle: "Postgres"
    badge: logos/postgres
  }
}

// External services
stripe = box "Stripe" external
carrier = box "Carrier API" external
sendgrid = box "SendGrid" external

// Event bus
kafka = logos/kafka "Kafka" {
  description: "Event streaming platform"
}

// Frontend to BFF
customer -> web "uses"
web -> bff "API requests"

// BFF to services
bff -> core_services.users
bff -> core_services.auth
bff -> core_services.profile
bff -> catalog_services.catalog
bff -> catalog_services.search
bff -> catalog_services.reviews
bff -> catalog_services.recommendations
bff -> catalog_services.pricing
bff -> order_services.cart
bff -> order_services.checkout
bff -> order_services.orders
bff -> order_services.payments
bff -> order_services.inventory
bff -> fulfillment_services.shipping
bff -> fulfillment_services.notifications
bff -> fulfillment_services.support

// Service-to-service interactions
catalog_services.search -> catalog_services.catalog "reads"
catalog_services.recommendations -> catalog_services.catalog "reads"
catalog_services.recommendations -> catalog_services.reviews "reads"

order_services.checkout -> order_services.cart "reads cart"
order_services.checkout -> catalog_services.pricing "gets pricing"
order_services.checkout -> order_services.payments "processes payment"
order_services.checkout -> order_services.orders "creates order"

order_services.orders -> order_services.inventory "reserves stock"

// External integrations
order_services.payments -> stripe "processes payment"
fulfillment_services.shipping -> carrier "creates shipment"
fulfillment_services.notifications -> sendgrid "sends emails"

// Event streaming
order_services.orders ~> kafka "order events"
order_services.payments ~> kafka "payment events"
kafka ~> fulfillment_services.notifications "consumes events"
kafka ~> fulfillment_services.shipping "consumes events"
kafka ~> catalog_services.recommendations "consumes events"

view landscape {
  title "E-commerce Platform Architecture"
  include *

  titleblock {
    subtitle: "Microservices Architecture"
  }
}

view full {
  title "E-commerce Platform - Full Detail"
  expand *
}
