pack logos
pack aws

web = logos/react "Web App" {
  subtitle: "apps/web · React SPA"
}
bff = logos/nodedotjs "BFF" {
  subtitle: "apps/bff · Node"
  description: "One HTTP client module per backend service"
}
kafka = logos/apachekafka "Kafka" {
  description: "Events from orders and payments"
}
stripe = logos/stripe "Stripe" external
sendgrid = box "SendGrid" external
carrier = box "Carrier API" external

system identity "Identity" {
  description: "Accounts, sign-in and profiles"
  preview: [users auth profile]
  users = sys/server "Users" { subtitle: "services/users" }
  users_db = logos/postgres "Users DB" datastore
  auth = sys/server "Auth" { subtitle: "services/auth" }
  sessions = logos/redis "Sessions" datastore
  profile = sys/server "Profile" { subtitle: "services/profile" }
  profile_db = logos/postgres "Profile DB" datastore
  users -> users_db
  auth -> sessions
  profile -> profile_db
}

system discovery "Discovery" {
  description: "Catalogue, search, prices, reviews and recommendations"
  preview: [catalog search recs]
  catalog = sys/server "Catalog" { subtitle: "services/catalog" }
  catalog_db = logos/postgres "Catalog DB" datastore
  search = sys/server "Search" { subtitle: "services/search" }
  search_idx = aws/opensearch "Search Index" datastore
  pricing = sys/server "Pricing" { subtitle: "services/pricing" }
  pricing_cache = logos/redis "Pricing Store" datastore
  reviews = sys/server "Reviews" { subtitle: "services/reviews" }
  reviews_db = logos/mongodb "Reviews DB" datastore
  recs = sys/server "Recommendations" { subtitle: "services/recommendations" }
  recs_store = logos/redis "Recommendations Store" datastore
  catalog -> catalog_db
  search -> search_idx
  pricing -> pricing_cache
  reviews -> reviews_db
  recs -> recs_store
  search -> catalog "reads"
  recs -> catalog "reads"
  recs -> reviews "reads"
}

system buying "Buying" {
  description: "Cart, checkout, orders and payments"
  preview: [cart checkout orders]
  cart = sys/server "Cart" { subtitle: "services/cart" }
  cart_store = logos/redis "Cart Store" datastore
  checkout = sys/server "Checkout" { subtitle: "services/checkout" }
  checkout_db = logos/postgres "Checkout DB" datastore
  orders = sys/server "Orders" { subtitle: "services/orders" }
  orders_db = logos/postgres "Orders DB" datastore
  payments = sys/server "Payments" { subtitle: "services/payments" }
  payments_db = logos/postgres "Payments DB" datastore
  cart -> cart_store
  checkout -> checkout_db
  orders -> orders_db
  payments -> payments_db
  checkout -> cart
  checkout -> payments
  checkout -> orders
}

system fulfilment "Fulfilment" {
  description: "Stock and delivery"
  preview: [inventory shipping]
  inventory = sys/server "Inventory" { subtitle: "services/inventory" }
  inventory_db = logos/postgres "Inventory DB" datastore
  shipping = sys/server "Shipping" { subtitle: "services/shipping" }
  shipping_db = logos/postgres "Shipping DB" datastore
  inventory -> inventory_db
  shipping -> shipping_db
}

system care "Customer Care" {
  description: "Notifications and support"
  preview: [notifications support]
  notifications = sys/server "Notifications" { subtitle: "services/notifications" }
  support = sys/server "Support" { subtitle: "services/support" }
  support_db = logos/postgres "Support DB" datastore
  support -> support_db
}

web -> bff
bff -> identity.users, identity.auth, identity.profile
bff -> discovery.catalog, discovery.search, discovery.pricing, discovery.reviews, discovery.recs
bff -> buying.cart, buying.checkout, buying.orders, buying.payments
bff -> fulfilment.inventory, fulfilment.shipping
bff -> care.notifications, care.support

buying.checkout -> discovery.pricing
buying.orders -> fulfilment.inventory
buying.payments -> stripe
fulfilment.shipping -> carrier "carrier API"
care.notifications -> sendgrid

buying.orders ~> kafka "publishes"
buying.payments ~> kafka "publishes"
kafka ~> care.notifications "consumes"
kafka ~> fulfilment.shipping "consumes"
kafka ~> discovery.recs "consumes"

view landscape {
  title "Web Shop Landscape"
  include *
  preview *
  legend auto
}
view identity { title "Identity" }
view discovery { title "Discovery" }
view buying { title "Buying" }
view fulfilment { title "Fulfilment" }
view care { title "Customer Care" }
