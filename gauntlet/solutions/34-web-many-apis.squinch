pack aws
pack logos

web = logos/react "Web App" {
  subtitle: "apps/web · React SPA"
}
bff = logos/nodedotjs "BFF" {
  subtitle: "apps/bff · Node"
  description: "One HTTP client module per service"
}
kafka = logos/apachekafka "Kafka" {
  description: "Order and payment events"
}
stripe = logos/stripe "Stripe" external
sendgrid = sys/mail "SendGrid" external
carrier = sys/truck "Carrier API" external

system identity "Identity" {
  description: "Accounts, sessions and profiles"
  preview: [users auth profile]
  system users "Users" {
    description: "User accounts"
    svc = sys/server "Users Service" { subtitle: "services/users" }
    db = logos/postgresql "Users DB" datastore
    svc -> db
  }
  system auth "Auth" {
    description: "Login and sessions"
    svc = sys/server "Auth Service" { subtitle: "services/auth" }
    sessions = logos/redis "Sessions" datastore
    svc -> sessions
  }
  system profile "Profile" {
    description: "User profiles"
    svc = sys/server "Profile Service" { subtitle: "services/profile" }
    db = logos/postgresql "Profile DB" datastore
    svc -> db
  }
}

system discovery "Catalog & Discovery" {
  description: "Products, search, prices, reviews, recommendations"
  preview: [catalog search recommendations]
  system catalog "Catalog" {
    description: "Product catalogue"
    svc = sys/server "Catalog Service" { subtitle: "services/catalog" }
    db = logos/postgresql "Catalog DB" datastore
    svc -> db
  }
  system search "Search" {
    description: "Product search"
    svc = sys/server "Search Service" { subtitle: "services/search" }
    index = aws/opensearch "Search Index" datastore
    svc -> index
  }
  system pricing "Pricing" {
    description: "Prices"
    svc = sys/server "Pricing Service" { subtitle: "services/pricing" }
    cache = logos/redis "Pricing Redis" datastore
    svc -> cache
  }
  system reviews "Reviews" {
    description: "Product reviews"
    svc = sys/server "Reviews Service" { subtitle: "services/reviews" }
    db = logos/mongodb "Reviews DB" datastore
    svc -> db
  }
  system recommendations "Recommendations" {
    description: "Suggested products"
    svc = sys/server "Recommendations Service" { subtitle: "services/recommendations" }
    cache = logos/redis "Recommendations Redis" datastore
    svc -> cache
  }
  search.svc -> catalog.svc "reads"
  recommendations.svc -> catalog.svc "reads"
  recommendations.svc -> reviews.svc "reads"
}

system buying "Buying" {
  description: "Cart, checkout, orders and payments"
  preview: [cart checkout orders]
  system cart "Cart" {
    description: "Shopping cart"
    svc = sys/server "Cart Service" { subtitle: "services/cart" }
    cache = logos/redis "Cart Redis" datastore
    svc -> cache
  }
  system checkout "Checkout" {
    description: "Checkout flow"
    svc = sys/server "Checkout Service" { subtitle: "services/checkout" }
    db = logos/postgresql "Checkout DB" datastore
    svc -> db
  }
  system orders "Orders" {
    description: "Order lifecycle"
    svc = sys/server "Orders Service" { subtitle: "services/orders" }
    db = logos/postgresql "Orders DB" datastore
    svc -> db
  }
  system payments "Payments" {
    description: "Payment processing"
    svc = sys/server "Payments Service" { subtitle: "services/payments" }
    db = logos/postgresql "Payments DB" datastore
    svc -> db
  }
  checkout.svc -> cart.svc
  checkout.svc -> orders.svc
  checkout.svc -> payments.svc
}

system fulfilment "Fulfilment" {
  description: "Stock and delivery"
  preview: [inventory shipping]
  system inventory "Inventory" {
    description: "Stock levels"
    svc = sys/server "Inventory Service" { subtitle: "services/inventory" }
    db = logos/postgresql "Inventory DB" datastore
    svc -> db
  }
  system shipping "Shipping" {
    description: "Shipments"
    svc = sys/server "Shipping Service" { subtitle: "services/shipping" }
    db = logos/postgresql "Shipping DB" datastore
    svc -> db
  }
}

system engagement "Customer Engagement" {
  description: "Notifications and support"
  preview: [notifications support]
  system notifications "Notifications" {
    description: "Outbound messages"
    svc = sys/server "Notifications Service" { subtitle: "services/notifications" }
  }
  system support "Support" {
    description: "Customer support"
    svc = sys/server "Support Service" { subtitle: "services/support" }
    db = logos/postgresql "Support DB" datastore
    svc -> db
  }
}

web -> bff
bff -> identity.users.svc, identity.auth.svc, identity.profile.svc
bff -> discovery.catalog.svc, discovery.search.svc, discovery.pricing.svc, discovery.reviews.svc, discovery.recommendations.svc
bff -> buying.cart.svc, buying.checkout.svc, buying.orders.svc, buying.payments.svc
bff -> fulfilment.inventory.svc, fulfilment.shipping.svc
bff -> engagement.notifications.svc, engagement.support.svc

buying.checkout.svc -> discovery.pricing.svc
buying.orders.svc -> fulfilment.inventory.svc
buying.payments.svc -> stripe
fulfilment.shipping.svc -> carrier
engagement.notifications.svc -> sendgrid

buying.orders.svc ~> kafka "publishes"
buying.payments.svc ~> kafka "publishes"
kafka ~> engagement.notifications.svc "consumes"
kafka ~> fulfilment.shipping.svc "consumes"
kafka ~> discovery.recommendations.svc "consumes"

view landscape {
  title "Storefront Landscape"
  include *
  preview *
  legend auto
}
view identity {
  title "Identity"
  expand *
}
view discovery {
  title "Catalog & Discovery"
  expand *
}
view buying {
  title "Buying"
  expand *
}
view fulfilment {
  title "Fulfilment"
  expand *
}
view engagement {
  title "Customer Engagement"
  expand *
}
