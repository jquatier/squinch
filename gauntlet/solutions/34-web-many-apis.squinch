pack logos

person customer "Customer"

web = logos/react "Web App"
bff = logos/nodejs "BFF" {
  subtitle: "Backend for Frontend"
}

system user_mgmt "User Management" {
  description: "Authentication and user profiles"
  icon: sys/users

  users = logos/nodejs "Users Service" {
    subtitle: "Node.js"
  }
  users_db = logos/postgres "Users DB" datastore

  auth = logos/nodejs "Auth Service" {
    subtitle: "Node.js"
  }
  auth_cache = logos/redis "Sessions" datastore

  profile = logos/nodejs "Profile Service" {
    subtitle: "Node.js"
  }
  profile_db = logos/postgres "Profiles DB" datastore

  users -> users_db
  auth -> auth_cache
  profile -> profile_db

  layout {
    rows [users auth profile] [users_db auth_cache profile_db]
  }
}

system discovery "Product Discovery" {
  description: "Catalog, search and recommendations"
  icon: sys/search

  catalog = logos/nodejs "Catalog Service" {
    subtitle: "Node.js"
  }
  catalog_db = logos/postgres "Catalog DB" datastore

  search = logos/nodejs "Search Service" {
    subtitle: "Node.js"
  }
  search_idx = logos/elasticsearch "Search Index" datastore

  recommendations = logos/nodejs "Recommendations Service" {
    subtitle: "Node.js"
  }
  rec_cache = logos/redis "Rec Cache" datastore

  reviews = logos/nodejs "Reviews Service" {
    subtitle: "Node.js"
  }
  reviews_db = logos/mongodb "Reviews DB" datastore

  pricing = logos/nodejs "Pricing Service" {
    subtitle: "Node.js"
  }
  pricing_cache = logos/redis "Pricing Cache" datastore

  catalog -> catalog_db
  search -> search_idx
  search -> catalog_db "reads"
  recommendations -> rec_cache
  recommendations -> catalog_db "reads"
  recommendations -> reviews_db "reads"
  reviews -> reviews_db
  pricing -> pricing_cache

  layout {
    rows [catalog] [search reviews recommendations pricing] [catalog_db search_idx reviews_db rec_cache pricing_cache]
  }
}

system order_flow "Order Processing" {
  description: "Cart, checkout, orders and payments"
  icon: sys/cart

  cart = logos/nodejs "Cart Service" {
    subtitle: "Node.js"
  }
  cart_cache = logos/redis "Cart Cache" datastore

  checkout = logos/nodejs "Checkout Service" {
    subtitle: "Node.js"
  }
  checkout_db = logos/postgres "Checkout DB" datastore

  orders = logos/nodejs "Orders Service" {
    subtitle: "Node.js"
  }
  orders_db = logos/postgres "Orders DB" datastore

  payments = logos/nodejs "Payments Service" {
    subtitle: "Node.js"
  }
  payments_db = logos/postgres "Payments DB" datastore

  inventory = logos/nodejs "Inventory Service" {
    subtitle: "Node.js"
  }
  inventory_db = logos/postgres "Inventory DB" datastore

  cart -> cart_cache
  checkout -> checkout_db
  checkout -> cart "reads cart"
  checkout -> discovery.pricing "gets price"
  checkout -> payments "processes payment"
  checkout -> orders "creates order"
  orders -> orders_db
  orders -> inventory "reserves stock"
  payments -> payments_db
  inventory -> inventory_db

  layout {
    rows [cart checkout] [payments orders] [inventory]
  }
}

system fulfillment "Fulfillment & Support" {
  description: "Shipping, notifications and support"
  icon: sys/package

  shipping = logos/nodejs "Shipping Service" {
    subtitle: "Node.js"
  }
  shipping_db = logos/postgres "Shipping DB" datastore

  notifications = logos/nodejs "Notifications Service" {
    subtitle: "Node.js"
  }

  support = logos/nodejs "Support Service" {
    subtitle: "Node.js"
  }
  support_db = logos/postgres "Support DB" datastore

  shipping -> shipping_db
  support -> support_db

  layout {
    rows [shipping notifications support] [shipping_db support_db]
  }
}

bus = logos/kafka "Event Bus" {
  subtitle: "Kafka"
}

stripe = box "Stripe" external {
  badge: logos/stripe
}

carrier = box "Carrier API" external

sendgrid = box "SendGrid" external

customer -> web
web -> bff
bff -> user_mgmt
bff -> discovery
bff -> order_flow
bff -> fulfillment

order_flow.payments -> stripe "processes payment"
fulfillment.shipping -> carrier "tracks shipment"
fulfillment.notifications -> sendgrid "sends email"

order_flow.orders ~> bus "order events"
order_flow.payments ~> bus "payment events"
bus ~> fulfillment.notifications "order/payment events"
bus ~> fulfillment.shipping "order events"
bus ~> discovery.recommendations "order events"

view landscape {
  title "E-commerce Platform Overview"
  include *
  preview user_mgmt, discovery, order_flow, fulfillment

  layout {
    rows [customer] [web] [bff] [user_mgmt order_flow] [discovery fulfillment bus] [stripe carrier sendgrid]
  }
}

view user_mgmt {
  title "User Management"
}

view discovery {
  title "Product Discovery"
}

view order_flow {
  title "Order Processing"
}

view fulfillment {
  title "Fulfillment & Support"
}
