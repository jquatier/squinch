pack aws

// Order event source
order_service = aws/lambda "Order Service"

// Event bus
event_bus = aws/eventbridge "Order Events"

// Email notification path
email_lambda = aws/lambda "Email Notifier"
sns = aws/sns "Notification Topic"

// Analytics path
analytics_lambda = aws/lambda "Analytics Writer"
data_lake = aws/s3 "Data Lake" datastore

// Dead-letter queue
dlq = aws/sqs "Failed Events DLQ"

// Asynchronous event flows
order_service ~> event_bus "order events"
event_bus ~> email_lambda "order.created"
email_lambda ~> sns "send email"
event_bus ~> analytics_lambda "order.created"
analytics_lambda ~> data_lake "store analytics"
event_bus ~> dlq "failed events"
