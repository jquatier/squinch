pack aws

// Event source
bus = aws/eventbridge "EventBridge"

// Email notification path
email_handler = aws/lambda "Email Notifier"
sns = aws/sns "SNS"

// Analytics path
analytics_handler = aws/lambda "Analytics Writer"
datalake = aws/s3 "Data Lake" datastore

// Dead-letter queue for failed events
dlq = aws/sqs "DLQ"

// Asynchronous event flows
bus ~> email_handler "order events"
bus ~> analytics_handler "order events"
email_handler ~> sns "send notification"
analytics_handler ~> datalake "write events"
bus ~> dlq "failed events"
