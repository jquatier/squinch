pack aws

bus      = aws/eventbridge "Order Events" { subtitle: "EventBridge" }
notifier = aws/lambda "Email Notifier" { subtitle: "Lambda" }
email    = aws/sns "Email Topic" { subtitle: "SNS" }
writer   = aws/lambda "Analytics Writer" { subtitle: "Lambda" }
lake     = aws/s3 "Data Lake" datastore { subtitle: "S3" }
dlq      = aws/sqs "Dead-Letter Queue" { subtitle: "SQS" }

bus ~> notifier "order events"
bus ~> writer "order events"
bus ~> dlq "failed events"
notifier ~> email "publishes"
writer ~> lake "writes"

view landscape {
  title "Order Event Flow"
  include *
}
