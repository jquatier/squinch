pack aws

// Event source
bus = aws/eventbridge "Order Events"

// Email notification path
email_handler = aws/lambda "Email Notifier"
email_svc = aws/sns "Email Service"

// Analytics path
analytics_handler = aws/lambda "Analytics Writer"
data_lake = aws/s3 "Data Lake" datastore

// Dead-letter queue
dlq = aws/sqs "Dead Letter Queue"

// Async event flows
bus ~> email_handler
email_handler -> email_svc
bus ~> analytics_handler
analytics_handler -> data_lake
bus ~> dlq "failed events"
