pack aws

order_svc = aws/lambda "Order Service" {
  subtitle: "Emits order events"
}

bus = aws/eventbridge "Event Bus"

system notifier "Email Notifier" {
  fn    = aws/lambda "Notify Handler"
  topic = aws/sns    "Order Emails"

  fn ~> topic "send email"
}

system analytics "Analytics Writer" {
  fn   = aws/lambda "Analytics Handler"
  lake = aws/s3     "Data Lake" datastore

  fn -> lake "write records"
}

dlq = aws/sqs "Dead Letter Queue" datastore

order_svc ~> bus "order events"
bus ~> notifier.fn "order events"
bus ~> analytics.fn "order events"
bus ~> dlq "failed events" { color: amber }

view landscape {
  title "Event-Driven Order Processing"
  include *
  layout {
    rows [order_svc] [bus] [notifier analytics dlq]
  }
}
