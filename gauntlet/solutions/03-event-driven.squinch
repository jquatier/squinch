pack aws

// Event-driven order processing system
bus = aws/eventbridge "EventBridge"

// Email notification path
email_handler = aws/lambda "Email Notifier"
notifications = aws/sns "SNS Topic"

// Analytics path
analytics_handler = aws/lambda "Analytics Writer"
datalake = aws/s3 "S3 Data Lake" datastore

// Error handling
dlq = aws/sqs "Dead Letter Queue"

// Async flows
bus ~> email_handler "order events"
email_handler ~> notifications

bus ~> analytics_handler "order events"
analytics_handler ~> datalake

bus ~> dlq "failed events"

view landscape {
  title "Event-Driven Order Processing"
  include *
  layout {
    rows [bus] [email_handler analytics_handler] [notifications datalake dlq]
  }
}
