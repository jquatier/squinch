pack aws

eventbridge = aws/eventbridge "EventBridge" {
  description: "Order events"
}

email_lambda = aws/lambda "Email Notifier" {
  description: "Sends notifications"
}

sns = aws/sns "SNS" {
  description: "Email delivery"
}

analytics_lambda = aws/lambda "Analytics Writer" {
  description: "Writes to data lake"
}

s3 = aws/s3 "S3 Data Lake" datastore {
  description: "Analytics storage"
}

dlq = aws/sqs "Dead Letter Queue" {
  description: "Failed events"
}

eventbridge ~> email_lambda
eventbridge ~> analytics_lambda
eventbridge ~> dlq
email_lambda ~> sns
analytics_lambda ~> s3
