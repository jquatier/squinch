pack aws

// Event-driven architecture with EventBridge routing to multiple consumers

eventbridge = aws/eventbridge "Order Events"
dlq = aws/sqs "Dead-letter Queue"

// Email notification path
email_handler = aws/lambda "Email Notifier" {
  description: "Processes order events and sends notifications"
}
sns = aws/sns "Email Topic"

// Analytics path
analytics_handler = aws/lambda "Analytics Writer" {
  description: "Writes order events to data lake"
}
lake = aws/s3 "Data Lake" datastore

// Async flows from EventBridge to consumers
eventbridge ~> email_handler
eventbridge ~> analytics_handler

// Email handler publishes to SNS
email_handler ~> sns

// Analytics handler writes to S3
analytics_handler ~> lake

// Failed events to DLQ
email_handler ~> dlq "failures"
analytics_handler ~> dlq "failures"
