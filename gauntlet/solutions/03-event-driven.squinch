pack aws

system order_processing "Order Processing" {
  description: "Event-driven order processing"

  events = aws/eventbridge "EventBridge" {
    description: "Order event bus"
  }

  email_fn = aws/lambda "Email Notifier" {
    description: "Sends order confirmations"
  }

  sns = aws/sns "SNS" {
    description: "Email delivery"
  }

  analytics_fn = aws/lambda "Analytics Writer" {
    description: "Writes to data lake"
  }

  lake = aws/s3 "Data Lake" datastore {
    description: "Analytics storage"
  }

  dlq = aws/sqs "Dead Letter Queue" {
    description: "Failed events"
  }

  events ~> email_fn "order.created"
  email_fn -> sns

  events ~> analytics_fn "order.created"
  analytics_fn -> lake

  events ~> dlq "failed events"
}

view order_processing {
  layout {
    rows [events] [email_fn analytics_fn] [sns lake dlq]
  }
}
