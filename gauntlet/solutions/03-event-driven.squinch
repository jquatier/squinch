pack aws

// Event source
producer = box "Order Service"

// Event bus
bus = aws/eventbridge "Event Bus"

// Consumers
email_fn = aws/lambda "Email Notifier"
email_sns = aws/sns "Email Topic"

analytics_fn = aws/lambda "Analytics Writer"
lake = aws/s3 "Data Lake" datastore

// Dead-letter queue
dlq = aws/sqs "Dead Letter Queue"

// Event flow
producer ~> bus "order events"
bus ~> email_fn
email_fn ~> email_sns
bus ~> analytics_fn
analytics_fn ~> lake
bus ~> dlq "failed events"
