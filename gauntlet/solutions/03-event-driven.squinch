pack aws

// Event source
eventbus = aws/eventbridge "Order Events"

// Consumers
email_fn   = aws/lambda "Email Notifier"
sns        = aws/sns "Email Topic"

analytics_fn = aws/lambda "Analytics Writer"
datalake     = aws/s3 "Data Lake" datastore

// Dead-letter queue for failed events
dlq = aws/sqs "Dead Letter Queue"

// Async flows
eventbus ~> email_fn
email_fn ~> sns

eventbus ~> analytics_fn
analytics_fn ~> datalake

eventbus ~> dlq "failed events"

view main {
  title "Event-Driven Order Processing"
  layout {
    rows [eventbus] [email_fn analytics_fn] [sns datalake dlq]
  }
}
