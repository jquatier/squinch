pack aws

// Event-driven architecture with EventBridge routing to consumers

eventbus = aws/eventbridge "Order Events"
notifier = aws/lambda "Email Notifier"
sns = aws/sns "Email Topic"
analytics = aws/lambda "Analytics Writer"
lake = aws/s3 "Data Lake" datastore
dlq = aws/sqs "Dead Letter Queue"

// Asynchronous event flows
eventbus ~> notifier "order.created"
eventbus ~> analytics "order.created"
notifier -> sns "send email"
analytics -> lake "write events"
eventbus ~> dlq "failed events"
