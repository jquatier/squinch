pack aws

// Event source
eventbus = aws/eventbridge "Order Events"

// Email notification consumer
email_handler = aws/lambda "Email Notifier"
sns = aws/sns "Email Topics"

// Analytics consumer
analytics_handler = aws/lambda "Analytics Writer"
lake = aws/s3 "Data Lake"

// Dead-letter queue for failed events
dlq = aws/sqs "Dead Letter Queue"

// Event flows
eventbus ~> email_handler "order created"
email_handler ~> sns "send email"

eventbus ~> analytics_handler "order created"
analytics_handler ~> lake "write events"

eventbus ~> dlq "failed events"
