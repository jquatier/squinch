// Event-driven architecture with EventBridge routing to multiple consumers
pack aws

// Event source and routing
orders = sys/code "Order Service"
bus = aws/eventbridge "EventBridge"

// Email notification path
email_handler = aws/lambda "Email Notifier"
sns = aws/sns "SNS"

// Analytics path
analytics_handler = aws/lambda "Analytics Writer"
lake = aws/s3 "Data Lake"

// Error handling
dlq = aws/sqs "Dead Letter Queue"

// Event flow - all async
orders ~> bus "order events"
bus ~> email_handler "email events"
bus ~> analytics_handler "analytics events"
email_handler ~> sns "notifications"
analytics_handler ~> lake "store events"
email_handler ~> dlq "failed"
analytics_handler ~> dlq "failed"

view main {
  title "Event-Driven Order Processing"
  layout {
    rows [orders] [bus] [email_handler analytics_handler] [sns lake]
    place dlq right-of lake
    route email_handler ~> dlq from south to west
    route analytics_handler ~> dlq from south to east
  }
}
