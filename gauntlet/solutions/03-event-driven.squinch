pack aws

// Event producer
producer = aws/lambda "Order Service"

// Central event bus
eventbus = aws/eventbridge "Order Events Bus"

// Email notification path
email_handler = aws/lambda "Email Notifier"
sns = aws/sns "Notification Topic"

// Analytics path
analytics_handler = aws/lambda "Analytics Writer"
datalake = aws/s3 "Data Lake" datastore

// Dead-letter queue for failed events
dlq = aws/sqs "Dead Letter Queue"

// Event flow - async from producer to bus
producer ~> eventbus "publishes order events"

// Fan-out from EventBridge to consumers
eventbus ~> email_handler
eventbus ~> analytics_handler

// Processing paths
email_handler ~> sns "sends notification"
analytics_handler ~> datalake "writes events"

// Failed event handling
email_handler ~> dlq "on failure"
analytics_handler ~> dlq "on failure"

view landscape {
  title "Event-Driven Order Processing"
  layout {
    direction down
    rows [producer] [eventbus] [email_handler analytics_handler] [sns datalake]
    place dlq right-of analytics_handler
  }
}
