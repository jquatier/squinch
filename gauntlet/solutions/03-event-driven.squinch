// Event-driven order processing with EventBridge routing to multiple consumers
pack aws

// Event source
eventbridge = aws/eventbridge "EventBridge" {
  description: "Order events"
}

// Email notification path
email_lambda = aws/lambda "Email Notifier" {
  description: "Sends order confirmations"
}
sns = aws/sns "Email Topics"

// Analytics path
analytics_lambda = aws/lambda "Analytics Writer" {
  description: "Writes to data lake"
}
datalake = aws/s3 "Data Lake" datastore

// Dead-letter queue for failed events
dlq = aws/sqs "DLQ" {
  description: "Failed events"
}

// Async flows (dashed arrows)
eventbridge ~> email_lambda "order.created"
eventbridge ~> analytics_lambda "order.created"
email_lambda ~> sns
analytics_lambda ~> datalake
email_lambda ~> dlq "on failure"
analytics_lambda ~> dlq "on failure"
