pack aws

// Event-driven architecture with EventBridge routing to multiple consumers

bus = aws/eventbridge "Order Events"
notifier = aws/lambda "Email Notifier"
email = aws/sns "Email Topic"
analytics = aws/lambda "Analytics Writer"
lake = aws/s3 "Data Lake" datastore
dlq = aws/sqs "Dead Letter Queue"

bus ~> notifier "order created"
bus ~> analytics "order events"
notifier ~> email "send notification"
analytics ~> lake "store events"
notifier ~> dlq "failed"
analytics ~> dlq "failed"

view main {
  title "Event-Driven Order Processing"
  layout {
    rows [bus] [notifier analytics] [email lake dlq]
  }
}
