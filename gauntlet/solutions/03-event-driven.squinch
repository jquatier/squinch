pack aws

// Order events flow through EventBridge to two consumers
eventbus = aws/eventbridge "EventBridge"

// Email notification consumer
email_lambda = aws/lambda "Email Notifier"
sns = aws/sns "SNS Topic"

// Analytics consumer
analytics_lambda = aws/lambda "Analytics Writer"
datalake = aws/s3 "Data Lake" datastore

// Failed events handler
dlq = aws/sqs "Dead-Letter Queue"

// Event flows (async)
eventbus ~> email_lambda "order.created"
email_lambda ~> sns "send notification"

eventbus ~> analytics_lambda "order.created"
analytics_lambda ~> datalake "write events"

eventbus ~> dlq "failed events"
