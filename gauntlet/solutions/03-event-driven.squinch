pack aws

orders    = aws/lambda      "Order Service"
bus       = aws/eventbridge "Event Bus"
notifier  = aws/lambda      "Email Notifier"
sns       = aws/sns         "Order Notifications"
analytics = aws/lambda      "Analytics Writer"
lake      = aws/s3          "Data Lake" datastore
dlq       = aws/sqs         "Dead Letter Queue" datastore

orders ~> bus "order events"
bus ~> notifier, analytics
notifier ~> sns
analytics -> lake
bus ~> dlq "delivery failed"
