pack aws

// Event source
orders = aws/api-gateway "Order API"

// Event bus
bus = aws/eventbridge "Order Events"

// Email notification path
emailHandler = aws/lambda "Email Notifier"
notifications = aws/sns "Email Topic"

// Analytics path
analyticsHandler = aws/lambda "Analytics Writer"
lake = aws/s3 "Data Lake" datastore

// Dead-letter queue for failed events
dlq = aws/sqs "Dead Letter Queue"

// Event flows
orders ~> bus "order events"
bus ~> emailHandler
emailHandler ~> notifications
bus ~> analyticsHandler
analyticsHandler ~> lake
bus ~> dlq "failed events"

view main {
  title "Event-Driven Order Processing"
  layout {
    rows [orders] [bus] [emailHandler analyticsHandler] [notifications lake dlq]
  }
}
