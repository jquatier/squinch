pack aws

bus       = aws/eventbridge "Order Events"
notifier  = aws/lambda "Email Notifier"
topic     = aws/sns "Email Topic"
analytics = aws/lambda "Analytics Writer"
lake      = aws/s3 "Data Lake" datastore
dlq       = aws/sqs "Dead-Letter Queue"

bus ~> notifier "order events"
notifier ~> topic "publishes"
bus ~> analytics "order events"
analytics ~> lake "writes"
bus ~> dlq "failed events"

view landscape {
  title "Order Event Flow"
  include *
}
