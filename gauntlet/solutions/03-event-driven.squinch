pack aws

bus = aws/eventbridge "EventBridge"
dlq = aws/sqs "Dead Letter Queue"

system email_notify "Email Notifier" {
  handler = aws/lambda "Email Handler"
  sns = aws/sns "Email Topic"

  handler ~> sns
}

system analytics "Analytics" {
  writer = aws/lambda "Analytics Writer"
  lake = aws/s3 "Data Lake" datastore

  writer ~> lake
}

bus ~> email_notify.handler "order events"
bus ~> analytics.writer "order events"
bus ~> dlq "failed events"

view default {
  title "Event-Driven Architecture"
  layout {
    rows [bus] [email_notify analytics] [dlq]
  }
}
