pack aws

bus = aws/eventbridge "EventBridge" {
  description: "Order event bus"
}

email_handler = aws/lambda "Email Notifier"
sns = aws/sns "Email Topic"

analytics_handler = aws/lambda "Analytics Writer"
lake = aws/s3 "Data Lake" datastore

dlq = aws/sqs "Dead Letter Queue"

bus ~> email_handler
email_handler ~> sns

bus ~> analytics_handler
analytics_handler ~> lake

bus ~> dlq "failed events"
