// Event-driven architecture with EventBridge routing to multiple consumers
pack aws

// Event source (could be upstream services)
source = box "Order Service" external

// Central event bus
bus = aws/eventbridge "Order Events"

// Email notification path
email_handler = aws/lambda "Email Notifier"
notif = aws/sns "Notifications"

// Analytics path
analytics_handler = aws/lambda "Analytics Writer"
lake = aws/s3 "Data Lake" datastore

// Dead-letter queue for failed events
dlq = aws/sqs "Dead Letter Queue"

// Event flow - all async
source ~> bus "order events"
bus ~> email_handler "order.created"
email_handler ~> notif "send email"
bus ~> analytics_handler "order.*"
analytics_handler ~> lake "store events"

// Failed events
email_handler ~> dlq "failures"
analytics_handler ~> dlq "failures"

view main {
  title "Event-Driven Order Processing"

  layout {
    rows [source] [bus] [email_handler analytics_handler] [notif lake]
    place dlq right-of analytics_handler
  }
}
