pack aws

person customer "Customer"

store   = sys/app-window "Web Storefront"
api     = aws/lambda "Orders API" { subtitle: "Lambda" }
db      = aws/dynamodb "Orders Table" datastore
queue   = aws/sqs "Order Queue"
worker  = sys/cog "Fulfilment Worker"
partner = box "Shipping Partner API" external

customer -> store "places orders"
store -> api
api -> db "writes"
api ~> queue "OrderPlaced"
queue ~> worker "consumes"
worker -> partner "ships via"

view landscape {
  title "Order Processing"
  include *
  about """
    Current state, **before the queue migration**.

    - Order writes are **synchronous**
    - The migration is tracked in `OPS-412`
    - Runbook: [orders runbook](https://runbooks.example.com/orders)
  """
  note right-of db "Encrypted at rest; keeps 18 months of orders"
}
