pack aws
pack logos

svc = aws/lambda "Order Service" {
  subtitle: "Lambda"
}

container pg "Orders DB" {
  icon: logos/postgres
  description: "Postgres · 2 tables"
  orders = sys/table "orders" datastore {
    fields {
      id          uuid         pk
      customer_id uuid
      status      enum(pending, paid, shipped)
      total_cents bigint
      created_at  timestamptz
    }
  }
  order_items = sys/table "order_items" datastore {
    fields {
      order_id   uuid          pk fk ref orders
      sku        text          pk
      quantity   int
      unit_price numeric(10,2)
    }
  }
  order_items -> orders "order_id"
}

carts = aws/dynamodb "Carts" datastore {
  subtitle: "single-table design"
  fields {
    pk         string  pk "CART#<cartId>"
    sk         string  pk "ITEM#<sku>"
    gsi1pk     string  index gsi1 "CUSTOMER#<customerId>"
    qty        number
    expires_at number  ttl
  }
}

topic = logos/kafka "order-events" {
  subtitle: "Kafka topic"
  description: "Keyed by order_id"
  fields {
    order_id          string  pk "message key"
    type              enum(OrderPlaced, OrderPaid)
    payload.total_cents long
    payload.items     array   "line items"
  }
}

analytics = aws/glue "Analytics Job"

svc -> pg.orders "writes"
svc -> pg.order_items "writes"
svc -> carts "reads/writes"
svc ~> topic "publishes orders"
topic ~> analytics "consumes"

view landscape {
  title "Checkout"
  include *
  preview carts, topic
}
view pg { title "Orders DB schema"
  scope pg }
