person shopper "Shopper"
cdn = sys/cdn "CDN"

system checkout "Checkout" {
  description: "Cart to confirmed order"
  api    = sys/webhook "Checkout API"
  svc    = sys/server "Order Service"
  cache  = sys/database "Session Cache" datastore
  events = sys/workflow "Order Events"
  worker = sys/cog "Payment Worker"
  orders = sys/table "Orders" datastore

  api -> svc
  svc -> cache
  svc ~> events
  events ~> worker
  svc -> orders
  worker -> orders

  layout { rows [api] [svc] [cache events] [worker] [orders] }
}

system fulfillment "Fulfillment" {
  description: "Downstream of confirmed orders"
  intake = box "Fulfillment Intake"
}

shopper -> cdn
cdn -> checkout.api
checkout.svc ~> fulfillment "order placed"

view landscape {
  title "Landscape"
  include *
  expand checkout
}

view checkout {
  title "Checkout"
  scope checkout
}
