person shopper "Shopper"
cdn = sys/globe "CDN"

system checkout "Checkout" {
  description: "Cart to paid order"
  api    = sys/app-window "Checkout API"
  svc    = sys/server "Order Service"
  cache  = sys/database "Session Cache" datastore
  queue  = sys/workflow "Order Events"
  worker = sys/cog "Payment Worker"
  orders = sys/table "Orders" datastore

  api -> svc
  svc -> cache
  svc ~> queue
  queue ~> worker
  svc -> orders "writes"
  worker -> orders "writes"

  layout { rows [api] [svc] [cache queue] [worker] [orders] }
}

system fulfillment "Fulfillment" {
  description: "Picks and ships paid orders"
  intake = sys/package-check "Fulfillment Intake"
}

shopper -> cdn
cdn -> checkout.api
checkout.svc -> fulfillment

view landscape {
  title "System Landscape"
  include *
  expand checkout
  layout { rows [shopper] [cdn] [checkout fulfillment] }
}

view checkout {
  title "Checkout"
  scope checkout
}
