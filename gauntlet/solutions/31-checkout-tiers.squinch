person shopper "Shoppers"
cdn = sys/globe "CDN"

system checkout "Checkout" {
  description: "Checkout API, order handling and payment"
  api    = sys/server "Checkout API"
  svc    = sys/server "Order Service"
  cache  = sys/database "Session Cache" datastore
  queue  = sys/workflow "Order Events"
  worker = sys/cog "Payment Worker"
  orders = sys/table "Orders" datastore

  api -> svc
  svc -> cache
  svc ~> queue
  queue ~> worker
  svc -> orders "writes"
  worker -> orders "writes"
  layout { rows [api] [svc] [cache queue] [worker] [orders] }
}

system fulfillment "Fulfillment" {
  description: "Downstream of Checkout"
  core = sys/package-check "Fulfillment Service"
}

shopper -> cdn
cdn -> checkout.api
checkout.svc -> fulfillment

view landscape {
  title "Checkout landscape"
  include *
  expand checkout
  layout { rows [shopper] [cdn] [checkout fulfillment] }
}
view checkout {
  title "Checkout"
  scope checkout
}
