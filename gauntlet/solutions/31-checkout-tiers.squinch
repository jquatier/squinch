person shopper "Shopper"
cdn = sys/globe "CDN"
fulfillment = box "Fulfillment" external

system checkout "Checkout" {
  description: "Order intake and payment"
  api     = sys/api "Checkout API"
  service = sys/server "Order Service"
  cache   = sys/database "Session Cache" datastore
  events  = sys/stream "Order Events" 
  worker  = sys/worker "Payment Worker"
  orders  = sys/table "Orders" datastore

  api -> service
  service -> cache
  service ~> events "order placed"
  events ~> worker
  service -> orders "writes"
  worker -> orders "writes"

  layout { rows [api] [service] [cache events] [worker] [orders] }
}

shopper -> cdn
cdn -> checkout.api
checkout.service -> fulfillment

view landscape {
  title "Checkout Landscape"
  include *
  expand checkout
}

view checkout {
  title "Checkout"
  scope checkout
}
