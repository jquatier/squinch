pack aws

person shopper "Shopper"
cdn = aws/cloudfront "CDN"
fulfillment = box "Fulfillment"

system checkout "Checkout" {
  description: "Checkout and order placement"

  api    = aws/api-gateway  "Checkout API"
  svc    = aws/lambda       "Order Service"
  cache  = aws/elasticache  "Session Cache" datastore
  queue  = aws/sqs          "Order Events"
  worker = aws/lambda       "Payment Worker"
  db     = aws/dynamodb     "Orders" datastore

  api -> svc
  svc -> cache
  svc ~> queue
  queue ~> worker
  svc -> db "writes order"
  worker -> db "writes payment"

  layout {
    rows [api] [svc] [cache queue] [worker] [db]
  }
}

shopper -> cdn "browses"
cdn -> checkout.api "requests"
checkout.worker -> fulfillment "triggers fulfillment"

view landscape {
  title "System Landscape"
  include *
  expand checkout
}

view checkout {
  title "Checkout"
  scope checkout
}
