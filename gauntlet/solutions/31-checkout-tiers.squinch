pack aws

person customer "Shopper"

cdn = aws/cloudfront "CDN"

system checkout "Checkout" {
  api    = aws/api-gateway  "Checkout API"
  order  = aws/lambda       "Order Service"
  cache  = aws/elasticache  "Session Cache" datastore
  events = aws/sqs          "Order Events"
  worker = aws/lambda       "Payment Worker"
  db     = aws/dynamodb     "Orders Table" datastore

  api -> order
  order -> cache
  order ~> events "publishes"
  events ~> worker
  order -> db
  worker -> db

  layout { rows [api] [order] [cache events] [worker] [db] }
}

fulfillment = box "Fulfillment"

customer -> cdn "browses"
cdn -> checkout.api "requests"
checkout.order -> fulfillment "hands off order"

view landscape {
  title "System Landscape"
  include *
  expand checkout
  layout { rows [cdn] [checkout fulfillment] }
}

view checkout {
  title "Checkout"
}
