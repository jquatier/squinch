person shopper "Shopper"
cdn = sys/globe "CDN"

system checkout "Checkout" {
  description: "Checkout API through to the Orders table"
  api    = sys/app-window "Checkout API"
  svc    = sys/server "Order Service"
  cache  = sys/database "Session Cache" datastore
  events = sys/workflow "Order Events"
  worker = sys/cog "Payment Worker"
  orders = sys/table "Orders" datastore

  api -> svc
  svc -> cache
  svc ~> events
  events ~> worker
  svc -> orders "writes"
  worker -> orders "writes"

  layout { rows [api] [svc] [cache events] [worker] [orders] }
}

fulfillment = box "Fulfillment"

shopper -> cdn
cdn -> checkout.api
checkout.svc -> fulfillment

view landscape {
  title "Checkout landscape"
  include *
  expand checkout
}

view checkout {
  title "Checkout"
  scope checkout
}
