pack aws

person shopper "Shopper"
cdn = aws/cloudfront "CDN"

system checkout "Checkout" {
  description: "Cart to confirmed order"

  api     = aws/api-gateway    "Checkout API"
  service = aws/lambda         "Order Service"
  cache   = aws/elasticache    "Session Cache" datastore
  queue   = aws/sqs            "Order Events"
  worker  = aws/lambda         "Payment Worker"
  db      = aws/dynamodb       "Orders" datastore

  api -> service
  service -> cache
  service ~> queue
  queue ~> worker
  service -> db
  worker -> db

  layout {
    rows [api] [service] [cache queue] [worker] [db]
  }
}

fulfillment = box "Fulfillment" {
  description: "Pick, pack, dispatch"
}

shopper -> cdn
cdn -> checkout.api
checkout.queue ~> fulfillment

view landscape {
  title "System Landscape"
  include *
  expand checkout
}

view checkout {
  title "Checkout Service"
  scope checkout
}
