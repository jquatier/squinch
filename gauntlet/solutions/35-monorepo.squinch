pack aws
pack logos

// Actors
person customer "Customer"
person staff "Staff"

// Entry points
gateway = logos/kong "API Gateway"

// Frontend applications
system apps "Client Applications" {
  description: "Customer and staff-facing applications"
  storefront = logos/nextjs "Storefront" { subtitle: "Next.js" }
  admin = logos/react "Admin Portal" { subtitle: "React" }
  mobile = logos/react "Mobile App" { subtitle: "React Native" }
}

// Backend services
system identity "Identity" {
  description: "Authentication and authorization"
  icon: sys/user
  accounts = sys/server "Accounts API"
  sessions = sys/server "Sessions API"
  mfa = sys/server "MFA Worker"
  db = logos/postgres "Identity DB" datastore
  cache = logos/redis "Sessions Cache" datastore

  accounts -> db
  sessions -> cache
  mfa -> db
}

system catalog "Catalog" {
  description: "Product catalog and search"
  icon: sys/catalog
  products = sys/server "Products API"
  media = sys/server "Media API"
  search = sys/server "Search API"
  indexer = sys/server "Indexer Worker"
  files = aws/s3 "Media Storage" datastore
  searchdb = logos/elasticsearch "Search Index" datastore

  products ~> indexer
  media -> files
  search -> searchdb
  indexer -> searchdb
}

system commerce "Commerce" {
  description: "Shopping cart, checkout and orders"
  icon: sys/cart
  cart = sys/server "Cart API"
  checkout = sys/server "Checkout API"
  orders = sys/server "Orders API"
  payments = sys/server "Payments API"
  tax = sys/server "Tax API"
  cartcache = logos/redis "Cart Cache" datastore
  ordersdb = logos/postgres "Orders DB" datastore
  paymentsdb = logos/postgres "Payments DB" datastore

  cart -> cartcache
  checkout -> cart
  checkout -> tax
  checkout -> payments
  checkout -> orders
  orders -> ordersdb
  orders ~> kafka
  payments -> paymentsdb
  payments -> stripe
  payments ~> kafka
  tax -> avalara
}

system fulfilment "Fulfilment" {
  description: "Warehouse, shipping and returns"
  icon: sys/package
  warehouse = sys/server "Warehouse API"
  shipping = sys/server "Shipping API"
  returns = sys/server "Returns API"
  labels = sys/server "Label Worker"
  warehousedb = logos/postgres "Warehouse DB" datastore
  returnsdb = logos/postgres "Returns DB" datastore

  warehouse -> warehousedb
  shipping -> carriers
  returns -> returnsdb
  returns ~> kafka
  labels -> shipping
}

system engagement "Engagement" {
  description: "Customer communications"
  icon: sys/bell
  email = sys/server "Email Worker"
  push = sys/server "Push Worker"
  campaigns = sys/server "Campaigns API"
  campaignsdb = logos/postgres "Campaigns DB" datastore

  email -> sendgrid
  push -> firebase
  campaigns -> campaignsdb
}

system analytics "Analytics" {
  description: "Data warehouse and analytics"
  icon: sys/chart-bar
  collector = sys/server "Events Collector"
  warehouse = logos/snowflake "Data Warehouse" datastore
  dbt = sys/server "DBT Job" { badge: logos/python }
  dashboards = sys/chart-bar "Metabase Dashboards"

  collector -> warehouse
  dbt -> warehouse
  dashboards -> warehouse
}

// External services
stripe = box "Stripe" external
avalara = box "Avalara" external
carriers = box "Carrier APIs" external
sendgrid = box "SendGrid" external
firebase = box "Firebase" external

// Central message bus
kafka = logos/kafka "Kafka Cluster"

// Kafka consumers
kafka ~> catalog.indexer "product events"
kafka ~> fulfilment.labels "order events"
kafka ~> engagement.email "notification events"
kafka ~> engagement.push "notification events"
kafka ~> analytics.collector "all events"

// Kafka producers - accounts
identity.accounts ~> kafka "account events"

// Gateway to services
gateway -> identity.sessions "auth check"
gateway -> apps.storefront
gateway -> apps.admin
gateway -> apps.mobile

// Client connections
customer -> apps.storefront
customer -> apps.mobile
staff -> apps.admin

// API calls through gateway
apps.storefront -> gateway
apps.admin -> gateway
apps.mobile -> gateway

// Cross-service calls
commerce.orders -> fulfilment.warehouse

view landscape {
  title "Monorepo Architecture"
  include *
  preview apps, identity, catalog, commerce, fulfilment, engagement, analytics
}

view commerce_detail {
  title "Commerce Services Detail"
  expand commerce
  layout {
    rows [gateway] [commerce.checkout] [commerce.cart commerce.tax commerce.orders] [commerce.payments] [commerce.cartcache commerce.ordersdb commerce.paymentsdb] [kafka stripe avalara]
  }
}
