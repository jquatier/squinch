pack aws
pack logos

person customer "Customer"
person staff "Staff"

storefront = logos/nextjs "Storefront" { subtitle: "Next.js" }
admin      = logos/react "Admin" { subtitle: "React" }
mobile     = logos/react "Mobile App" { subtitle: "React Native" }
gateway    = logos/kong "API Gateway" { subtitle: "Kong" }
kafka      = logos/kafka "Kafka" { subtitle: "Event cluster" }

stripe    = logos/stripe "Stripe" external
avalara   = box "Avalara" external
carriers  = box "Carrier APIs" external
sendgrid  = box "SendGrid" external
firebase  = box "Firebase" external

system identity "Identity" {
  description: "Accounts, sessions and MFA"
  preview: [accounts sessions mfa]
  accounts = sys/users "accounts-api" { description: "User accounts" }
  sessions = sys/key-round "sessions-api" { description: "Session checks" }
  mfa      = sys/shield-check "mfa-worker" { description: "Multi-factor worker" }
  pg    = logos/postgresql "Postgres" datastore
  redis = logos/redis "Redis" datastore
}

system catalog "Catalog" {
  description: "Products, media and search"
  preview: [products media search]
  products = sys/package-check "products-api" { description: "Product data" }
  media    = aws/s3 "media-api" { subtitle: "S3" }
  search   = logos/elasticsearch "search-api" { subtitle: "Elasticsearch" }
  indexer  = sys/cog "indexer" { subtitle: "worker" }
  indexer -> search "updates index"
  indexer -> products "reads"
}

system commerce "Commerce" {
  description: "Cart, checkout, orders and payments"
  preview: [checkout orders payments]
  cart     = sys/shopping-cart "cart-api"
  checkout = sys/credit-card "checkout-api"
  orders   = sys/receipt-text "orders-api"
  payments = sys/wallet "payments-api"
  tax      = sys/receipt-text "tax-api"
  cartdb   = logos/redis "Redis" datastore
  ordersdb = logos/postgresql "Postgres" datastore
  paydb    = logos/postgresql "Postgres" datastore
  checkout -> cart, tax, payments, orders
  cart -> cartdb
  orders -> ordersdb
  payments -> paydb
}

system fulfilment "Fulfilment" {
  description: "Warehouse, shipping and returns"
  preview: [warehouse shipping returns]
  warehouse = sys/warehouse "warehouse-api"
  shipping  = sys/truck "shipping-api"
  returns   = sys/package-check "returns-api"
  label     = sys/barcode "label-worker" { subtitle: "worker" }
  whdb      = logos/postgresql "Postgres" datastore
  retdb     = logos/postgresql "Postgres" datastore
  warehouse -> whdb
  returns -> retdb
}

system engagement "Engagement" {
  description: "Email, push and campaigns"
  preview: [email push campaigns]
  email     = sys/webhook "email-worker" { subtitle: "worker" }
  push      = sys/smartphone "push-worker" { subtitle: "worker" }
  campaigns = sys/radio-tower "campaigns-api"
  campdb    = logos/postgresql "Postgres" datastore
  campaigns -> campdb
}

system analytics "Analytics" {
  description: "Event collection, warehouse and dashboards"
  preview: [collector warehouse metabase]
  collector = sys/activity "events-collector"
  warehouse = logos/snowflake "Snowflake" datastore
  dbt       = sys/clock "dbt job" { subtitle: "nightly" }
  metabase  = sys/chart-line "Metabase" { subtitle: "dashboards" }
  collector -> warehouse
  dbt -> warehouse
  metabase -> warehouse
}

customer -> storefront, mobile
staff -> admin
staff -> analytics.metabase "views dashboards"
storefront -> gateway
admin -> gateway
mobile -> gateway
gateway -> identity.sessions "checks every request"

commerce.orders -> fulfilment.warehouse
commerce.payments -> stripe
commerce.tax -> avalara
fulfilment.shipping -> carriers
engagement.email -> sendgrid
engagement.push -> firebase

identity.accounts ~> kafka "publishes"
commerce.orders ~> kafka "publishes"
commerce.payments ~> kafka "publishes"
fulfilment.returns ~> kafka "publishes"
kafka ~> catalog.indexer "consumes"
kafka ~> fulfilment.label "consumes"
kafka ~> engagement.email "consumes"
kafka ~> engagement.push "consumes"
kafka ~> analytics.collector "consumes"

view landscape {
  title "Monorepo landscape"
  include *
  preview *
}
view identity { title "Identity" }
view catalog { title "Catalog" }
view commerce { title "Commerce" }
view fulfilment { title "Fulfilment" }
view engagement { title "Engagement" }
view analytics { title "Analytics" }
