// Monorepo e-commerce platform architecture

pack aws
pack logos

// Actors
person customer "Customer"
person staff "Staff"

// Gateway
gw = box "Kong Gateway" { subtitle: "API Gateway" }

// Applications (top-level for landscape visibility)
storefront = box "Storefront" { subtitle: "Next.js" }
admin = box "Admin Portal" { subtitle: "React" }
mobile = box "Mobile App" { subtitle: "React Native" }

// Kafka event bus
kafka = logos/kafka "Kafka Cluster" { subtitle: "Event Bus" }

// External services
stripe = box "Stripe" external
avalara = box "Avalara" external
carriers = box "Carrier APIs" external
sendgrid = box "SendGrid" external
firebase = box "Firebase" external

// Identity service
system identity "Identity" {
  description: "Authentication and access control"
  icon: sys/lock

  accounts = sys/server "Accounts API"
  sessions = sys/server "Sessions API"
  mfa = sys/server "MFA Worker"
  db = logos/postgres "Identity DB" datastore
  cache = logos/redis "Sessions Cache" datastore

  accounts -> db
  sessions -> cache
  sessions -> db
  mfa -> db
  accounts ~> kafka
}

// Catalog service
system catalog "Catalog" {
  description: "Product catalog and search"
  icon: sys/archive

  products = sys/server "Products API"
  media = sys/server "Media API"
  search = sys/server "Search API"
  indexer = sys/server "Indexer Worker"
  s3 = aws/s3 "Media Storage" datastore
  searchdb = logos/elasticsearch "Search Index" datastore

  products ~> kafka
  media -> s3
  search -> searchdb
  indexer -> products
  indexer -> searchdb
}

// Commerce service
system commerce "Commerce" {
  description: "Cart, checkout, orders and payments"
  icon: sys/code

  cart = sys/server "Cart API"
  checkout = sys/server "Checkout API"
  orders = sys/server "Orders API"
  payments = sys/server "Payments API"
  tax = sys/server "Tax API"
  cartcache = logos/redis "Cart Cache" datastore
  ordersdb = logos/postgres "Orders DB" datastore
  paymentsdb = logos/postgres "Payments DB" datastore

  cart -> cartcache
  checkout -> cart
  checkout -> tax
  checkout -> payments
  checkout -> orders
  orders -> ordersdb
  payments -> paymentsdb
  orders ~> kafka
  payments ~> kafka

  layout { rows [checkout] [cart tax payments orders] [cartcache paymentsdb ordersdb] }
}

// Fulfilment service
system fulfilment "Fulfilment" {
  description: "Warehouse, shipping and returns"
  icon: sys/warehouse

  warehouse = sys/server "Warehouse API"
  shipping = sys/server "Shipping API"
  returns = sys/server "Returns API"
  labelworker = sys/server "Label Worker"
  warehousedb = logos/postgres "Warehouse DB" datastore
  returnsdb = logos/postgres "Returns DB" datastore

  warehouse -> warehousedb
  shipping -> warehouse
  returns -> returnsdb
  returns ~> kafka
  labelworker -> shipping
}

// Engagement service
system engagement "Engagement" {
  description: "Customer communications"
  icon: sys/activity

  emailworker = sys/server "Email Worker"
  pushworker = sys/server "Push Worker"
  campaigns = sys/server "Campaigns API"
  campaignsdb = logos/postgres "Campaigns DB" datastore

  emailworker -> sendgrid
  pushworker -> firebase
  campaigns -> campaignsdb

  layout { rows [campaigns] [emailworker pushworker] [campaignsdb] }
}

// Analytics service
system analytics "Analytics" {
  description: "Data warehouse and reporting"
  icon: sys/chart-line

  collector = sys/server "Events Collector"
  warehouse = sys/database "Data Warehouse" datastore { badge: logos/snowflake, subtitle: "Snowflake" }
  dbt = sys/workflow "dbt Transform" { subtitle: "Nightly job" }
  metabase = box "Metabase" { subtitle: "Dashboards" }

  collector -> warehouse
  dbt -> warehouse
  metabase -> warehouse

  layout { rows [collector] [warehouse dbt metabase] }
}

// Application connections
customer -> storefront
customer -> mobile
staff -> admin
storefront -> gw
admin -> gw
mobile -> gw

// Gateway to services
gw -> identity.sessions "auth check"
gw -> identity.accounts
gw -> catalog.products
gw -> catalog.media
gw -> catalog.search
gw -> commerce.cart
gw -> commerce.checkout
gw -> fulfilment.warehouse
gw -> fulfilment.shipping
gw -> fulfilment.returns
gw -> engagement.campaigns

// Service interactions
commerce.orders -> fulfilment.warehouse
commerce.tax -> avalara
commerce.payments -> stripe
fulfilment.shipping -> carriers

// Kafka publishers
identity.accounts -> kafka "account events"
catalog.products -> kafka "product events"
commerce.orders -> kafka "order events"
commerce.payments -> kafka "payment events"
fulfilment.returns -> kafka "return events"

// Kafka consumers
kafka ~> catalog.indexer "product events"
kafka ~> fulfilment.labelworker "order events"
kafka ~> engagement.emailworker "order/account events"
kafka ~> engagement.pushworker "order events"
kafka ~> analytics.collector "all events"

// Views
view landscape {
  title "Monorepo System Landscape"
  include *
  layout {
    rows [customer staff] [storefront admin mobile] [gw] [identity commerce] [catalog fulfilment kafka] [engagement analytics] [stripe avalara carriers sendgrid firebase]
  }
}

view commerce_flow {
  title "Commerce Flow"
  scope commerce
  layout {
    rows [checkout] [cart tax payments orders] [cartcache paymentsdb ordersdb]
  }
}

view event_driven {
  title "Event-Driven Architecture"
  include identity.accounts, catalog.products, catalog.indexer, commerce.orders, commerce.payments
  include fulfilment.returns, fulfilment.labelworker, engagement.emailworker, engagement.pushworker
  include analytics.collector
  layout {
    rows [identity.accounts commerce.orders commerce.payments fulfilment.returns] [kafka] [catalog.indexer fulfilment.labelworker engagement.emailworker engagement.pushworker analytics.collector]
  }
}
