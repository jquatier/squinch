// Monorepo system architecture
pack aws
pack logos

// Actors
person customers "Customers"
person staff "Staff"

// Gateway
gateway = box "Kong Gateway" {
  subtitle: "API Gateway"
}

// Applications
system apps "Applications" {
  description: "Customer and staff interfaces"
  icon: sys/app-window
  glyph: sys/code

  storefront = box "Storefront" {
    subtitle: "Next.js"
    tags: #customer-facing
  }
  mobile = box "Mobile App" {
    subtitle: "React Native"
    tags: #customer-facing
  }
  admin = box "Admin Portal" {
    subtitle: "React"
    tags: #staff-facing
  }
}

// Identity services
system identity "Identity" {
  description: "Authentication and authorization"
  icon: sys/lock
  domain: "identity"

  accounts_api = box "Accounts API"
  sessions_api = box "Sessions API"
  mfa_worker = box "MFA Worker"
  identity_db = logos/postgres "Accounts DB" datastore
  identity_cache = logos/redis "Sessions Cache" datastore

  accounts_api -> identity_db
  sessions_api -> identity_cache
  accounts_api ~> mfa_worker

  layout {
    rows [accounts_api sessions_api] [mfa_worker] [identity_db identity_cache]
  }
}

// Catalog services
system catalog "Catalog" {
  description: "Product catalog and search"
  icon: sys/search
  domain: "catalog"

  products_api = box "Products API"
  media_api = box "Media API"
  search_api = box "Search API"
  indexer = box "Search Indexer"
  media_store = aws/s3 "Media Storage" datastore
  search_index = logos/elasticsearch "Search Index" datastore

  media_api -> media_store
  search_api -> search_index
  products_api ~> indexer "product updates"
  indexer -> search_index "updates index"

  layout {
    rows [products_api media_api] [search_api] [indexer] [media_store search_index]
  }
}

// Commerce services
system commerce "Commerce" {
  description: "Cart, checkout, orders, payments"
  icon: sys/code
  domain: "commerce"

  cart_api = box "Cart API"
  checkout_api = box "Checkout API"
  orders_api = box "Orders API"
  payments_api = box "Payments API"
  tax_api = box "Tax API"
  cart_cache = logos/redis "Cart Cache" datastore
  orders_db = logos/postgres "Orders DB" datastore
  payments_db = logos/postgres "Payments DB" datastore
  stripe = box "Stripe" external
  avalara = box "Avalara" external

  cart_api -> cart_cache
  checkout_api -> cart_api
  checkout_api -> tax_api
  checkout_api -> payments_api
  checkout_api -> orders_api
  orders_api -> orders_db
  payments_api -> payments_db
  payments_api -> stripe
  tax_api -> avalara

  layout {
    rows [checkout_api] [cart_api tax_api payments_api orders_api] [avalara stripe cart_cache orders_db payments_db]
  }
}

// Fulfilment services
system fulfilment "Fulfilment" {
  description: "Warehouse, shipping, returns"
  icon: sys/warehouse
  domain: "fulfilment"

  warehouse_api = box "Warehouse API"
  shipping_api = box "Shipping API"
  returns_api = box "Returns API"
  label_worker = box "Label Worker"
  warehouse_db = logos/postgres "Warehouse DB" datastore
  returns_db = logos/postgres "Returns DB" datastore
  carriers = box "Carrier APIs" external

  warehouse_api -> warehouse_db
  returns_api -> returns_db
  shipping_api -> carriers
  label_worker -> shipping_api

  layout {
    rows [warehouse_api returns_api] [label_worker] [shipping_api] [warehouse_db returns_db carriers]
  }
}

// Engagement services
system engagement "Engagement" {
  description: "Email, push notifications, campaigns"
  icon: sys/activity
  domain: "engagement"

  email_worker = box "Email Worker"
  push_worker = box "Push Worker"
  campaigns_api = box "Campaigns API"
  campaigns_db = logos/postgres "Campaigns DB" datastore
  sendgrid = box "SendGrid" external
  firebase = box "Firebase" external

  email_worker -> sendgrid
  push_worker -> firebase
  campaigns_api -> campaigns_db

  layout {
    rows [campaigns_api] [email_worker push_worker] [sendgrid firebase campaigns_db]
  }
}

// Analytics services
system analytics "Analytics" {
  description: "Events, data warehouse, dashboards"
  icon: sys/chart-line
  domain: "analytics"

  events_collector = box "Events Collector"
  warehouse = sys/database "Data Warehouse" datastore {
    badge: logos/snowflake
    subtitle: "Snowflake"
  }
  dbt_job = box "dbt Job" {
    subtitle: "nightly"
  }
  dashboards = box "Dashboards" {
    subtitle: "Metabase"
  }

  events_collector -> warehouse
  warehouse -> dashboards
  dbt_job -> warehouse

  layout {
    rows [events_collector] [dbt_job] [warehouse] [dashboards]
  }
}

// Kafka event bus
kafka = logos/kafka "Event Bus" {
  subtitle: "Kafka cluster"
}

// Application connections
customers -> apps.storefront
customers -> apps.mobile
staff -> apps.admin

apps.storefront -> gateway
apps.mobile -> gateway
apps.admin -> gateway

// Gateway to services
gateway -> identity.sessions_api "auth check"
gateway -> catalog.products_api
gateway -> catalog.media_api
gateway -> catalog.search_api
gateway -> commerce.cart_api
gateway -> commerce.checkout_api
gateway -> commerce.orders_api
gateway -> fulfilment.warehouse_api
gateway -> fulfilment.returns_api
gateway -> engagement.campaigns_api

// Service to service calls
commerce.orders_api -> fulfilment.warehouse_api

// Event publishers
identity.accounts_api ~> kafka "account events"
commerce.orders_api ~> kafka "order events"
commerce.payments_api ~> kafka "payment events"
fulfilment.returns_api ~> kafka "return events"

// Event consumers
kafka ~> catalog.indexer "product events"
kafka ~> fulfilment.label_worker "order events"
kafka ~> engagement.email_worker "notification events"
kafka ~> engagement.push_worker "notification events"
kafka ~> analytics.events_collector "all events"

// Views
view landscape {
  title "E-commerce Platform Landscape"
  include *
  preview *

  titleblock {
    subtitle: "Monorepo architecture"
    owner: platform-team
  }

  layout {
    rows [customers staff] [apps] [gateway] [identity commerce] [kafka catalog fulfilment engagement analytics]
  }
}

view commerce_detail {
  title "Commerce Domain Detail"
  scope commerce

  layout {
    rows [checkout_api] [cart_api tax_api payments_api orders_api] [avalara stripe cart_cache orders_db payments_db]
  }
}

view full {
  title "Full Detail"
  expand *

  layout {
    rows [customers staff] [apps] [gateway] [identity commerce] [kafka catalog fulfilment engagement analytics]
  }
}
