pack logos

person customer "Customers"
person staff "Staff"

system apps "Apps" {
  description: "Customer and staff front ends"
  preview: [storefront admin mobile]
  storefront = logos/nextjs "Storefront" { subtitle: "Next.js · customers" }
  admin      = logos/react  "Admin"      { subtitle: "React · staff" }
  mobile     = logos/react  "Mobile"     { subtitle: "React Native" }
}

gateway = logos/kong "Gateway" { subtitle: "Kong" }
kafka   = logos/kafka "Kafka Cluster" { subtitle: "event backbone" }

system identity "Identity" {
  description: "Accounts, sessions and MFA"
  preview: [accounts sessions mfa]
  accounts = sys/server "accounts-api"
  sessions = sys/server "sessions-api"
  mfa      = sys/cog    "mfa-worker"
  pg       = logos/postgres "Postgres" datastore
  redis    = logos/redis    "Redis" datastore
  accounts -> pg
  sessions -> redis
  layout { rows [accounts sessions mfa] [pg redis] }
}

system catalog "Catalog" {
  description: "Products, media and search"
  preview: [products media search]
  products = sys/server "products-api"
  media    = sys/server "media-api"
  search   = sys/server "search-api"
  indexer  = sys/cog    "indexer"
  bucket   = aws/s3 "Media Bucket" datastore
  es       = logos/elasticsearch "Elasticsearch" datastore
  media -> bucket
  search -> es
  indexer -> es "keeps in step"
}

system commerce "Commerce" {
  description: "Cart, checkout, orders and payments"
  preview: [cart checkout orders]
  cart     = sys/server "cart-api"
  checkout = sys/server "checkout-api"
  orders   = sys/server "orders-api"
  payments = sys/server "payments-api"
  tax      = sys/server "tax-api"
  cartdb   = logos/redis "Cart Redis" datastore
  ordersdb = logos/postgres "Orders Postgres" datastore
  paydb    = logos/postgres "Payments Postgres" datastore
  cart -> cartdb
  orders -> ordersdb
  payments -> paydb
  checkout -> cart, tax, payments, orders
}

system fulfilment "Fulfilment" {
  description: "Warehouse, shipping and returns"
  preview: [warehouse shipping returns]
  warehouse = sys/server "warehouse-api"
  shipping  = sys/server "shipping-api"
  returns   = sys/server "returns-api"
  label     = sys/cog    "label-worker"
  whdb      = logos/postgres "Warehouse Postgres" datastore
  retdb     = logos/postgres "Returns Postgres" datastore
  warehouse -> whdb
  returns -> retdb
}

system engagement "Engagement" {
  description: "Email, push and campaigns"
  preview: [email push campaigns]
  email     = sys/cog    "email-worker"
  push      = sys/cog    "push-worker"
  campaigns = sys/server "campaigns-api"
  campdb    = logos/postgres "Campaigns Postgres" datastore
  campaigns -> campdb
}

system analytics "Analytics" {
  description: "Event collection, warehouse and dashboards"
  preview: [collector warehouse metabase]
  collector = sys/server "events-collector"
  warehouse = logos/snowflake "Snowflake Warehouse" datastore
  dbt       = sys/workflow "dbt job" { subtitle: "nightly" }
  metabase  = sys/chart-line "Metabase" { subtitle: "dashboards" }
  dbt -> warehouse "transforms"
  metabase -> warehouse "queries"
}

stripe   = box "Stripe" external
avalara  = box "Avalara" external
carriers = box "Carrier APIs" external
sendgrid = box "SendGrid" external
firebase = box "Firebase" external

customer -> apps.storefront, apps.mobile
staff -> apps.admin, analytics.metabase
apps.storefront -> gateway
apps.admin -> gateway
apps.mobile -> gateway
gateway -> identity.sessions "checks every request"

commerce.orders -> fulfilment.warehouse
commerce.payments -> stripe
commerce.tax -> avalara
fulfilment.shipping -> carriers
engagement.email -> sendgrid
engagement.push -> firebase

identity.accounts ~> kafka "publishes"
commerce.orders ~> kafka "publishes"
commerce.payments ~> kafka "publishes"
fulfilment.returns ~> kafka "publishes"
kafka ~> catalog.indexer, fulfilment.label, engagement.email, engagement.push, analytics.collector "consumes"

view landscape {
  title "System Landscape"
  include *
  preview *
}
view identity { scope identity }
view catalog { scope catalog }
view commerce { scope commerce }
view fulfilment { scope fulfilment }
view engagement { scope engagement }
view analytics { scope analytics }
view apps { scope apps }
