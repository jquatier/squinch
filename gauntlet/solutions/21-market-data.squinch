// Market data flow architecture

exchange = box "Exchange" external

feed = sys/radio-tower "Feed Handler" {
  description: "Ingests price stream"
}

pricing = sys/gauge "Pricing Engine" {
  description: "Real-time pricing"
}

ui = sys/monitor "Trading UI" {
  description: "Trader interface"
}

batch = sys/clock "Overnight Batch" {
  description: "Nightly reconciliation"
}

clearing = box "Clearing House" external

risk = sys/shield "Risk Service" {
  description: "System health monitoring"
}

// Continuous streams (async)
exchange ~> feed "price stream" { animate: packets }
feed ~> pricing "ticks" { animate: packets }
pricing ~> ui "pricing updates" { animate: packets }

// Nightly batch job
batch -> clearing "reconcile fills"

// Health polling (sync, periodic)
risk -> pricing "health check" { animate: pulse }
