exchange = box "Exchange" external
feed     = sys/server "Feed Handler" { subtitle: "ingests and normalises" }
pricing  = sys/cpu "Pricing Engine"
ui       = sys/app-window "Trading UI"
risk     = sys/shield "Risk Service"
batch    = sys/clock "Overnight Batch" { subtitle: "fills reconciliation" }
clearing = box "Clearing House" external

exchange ~> feed "price stream" { tags: #continuous }
feed ~> pricing "ticks" { tags: #continuous }
pricing ~> ui "subscription" { tags: #continuous }
batch -> clearing "nightly reconcile" { tags: #nightly; style: dotted }
risk -> pricing "health poll, every few s" { tags: #poll; animate: pulse }

view landscape {
  title "Market Data Path"
  include *
  color #continuous blue
  color #nightly amber
  color #poll violet
  legend {
    #continuous "Continuous stream"
    #nightly "Nightly batch job"
    #poll "Periodic poll"
  }
  layout { rows [exchange batch] [feed clearing] [pricing] [ui risk] }
}
