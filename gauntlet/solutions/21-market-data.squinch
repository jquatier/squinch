exchange = box "Exchange" external
clearing = box "Clearing House" external

feed    = sys/radio-tower "Feed Handler" { subtitle: "ingest · normalise" }
pricing = sys/gauge "Pricing Engine"
ui      = sys/monitor "Trading UI"
risk    = sys/shield-check "Risk Service"
recon   = sys/clock "Fills Reconciliation" { subtitle: "overnight batch" }

exchange ~> feed "price stream" { tags: #continuous }
feed ~> pricing "ticks" { tags: #continuous }
pricing ~> ui "tick subscription" { tags: #continuous }
recon -> clearing "reconcile day's fills" { tags: #nightly, style: dotted }
risk -> pricing "health poll, every few secs" { tags: #poll, animate: pulse }

view landscape {
  title "Market Data Path"
  include *
  color #continuous blue
  color #nightly amber
  color #poll violet
  legend {
    #continuous "Continuous stream"
    #nightly "Nightly batch"
    #poll "Periodic poll"
  }
  layout {
    rows [exchange recon] [feed clearing] [pricing] [ui risk]
  }
}
