// Market data path diagram

exchange = sys/network "Exchange"
feed_handler = sys/server "Feed Handler"
pricing_engine = sys/server "Pricing Engine"
trading_ui = sys/app-window "Trading UI"
batch_recon = sys/clock "Overnight Batch"
clearing_house = sys/building-2 "Clearing House"
risk_service = sys/shield "Risk Service"

// Continuous data flow
exchange ~> feed_handler "price stream" { animate: packets }
feed_handler ~> pricing_engine "ticks" { animate: fast }
pricing_engine ~> trading_ui "price updates" { animate: fast }

// Nightly batch job
clearing_house -> batch_recon "fills data"
batch_recon -> pricing_engine "reconcile" { style: dotted }

// Health polling
risk_service -> pricing_engine "health check" { animate: pulse }

view main {
  title "Market Data Flow"
  layout {
    rows [exchange] [feed_handler] [pricing_engine batch_recon risk_service] [trading_ui]
  }
}
