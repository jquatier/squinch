// Market data processing system

exchange = box "Exchange" external
clearing = box "Clearing House" external

system market "Market Data" {
  description: "Real-time price ingestion and distribution"

  feed     = sys/antenna "Feed Handler"
  norm     = sys/cog "Normaliser"
  pricing  = sys/gauge "Pricing Engine"
  batch    = sys/clock "Reconciliation Batch"

  feed -> norm "stream" { animate: packets }
  norm ~> pricing "ticks" { animate: packets }
  batch -> clearing "reconcile fills (nightly)"

  layout {
    rows [feed] [norm] [pricing batch]
  }
}

ui   = sys/monitor "Trading UI"
risk = sys/shield "Risk Service"

exchange ~> market.feed "price stream" { animate: packets }
market.pricing ~> ui "subscribe" { animate: packets }
risk -> market.pricing "health poll (every few seconds)" { animate: pulse }

view landscape {
  title "Market Data Flow"
  expand market
  layout {
    rows [exchange] [market risk] [ui]
  }
}
