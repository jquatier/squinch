// Market data flow architecture

exchange = sys/radio-tower "Exchange" external
clearing = sys/building-2 "Clearing House" external

feed = sys/code "Feed Handler" {
  description: "Normalises price stream"
}

pricing = sys/server "Pricing Engine" {
  description: "Live price data"
}

ui = sys/app-window "Trading UI"

risk = sys/shield-check "Risk Service" {
  description: "Health monitoring"
}

batch = sys/clock "Overnight Batch" {
  description: "Reconciliation job"
}

// Continuous price stream
exchange ~> feed "price stream" { animate: packets }
feed ~> pricing "ticks" { animate: packets }
pricing ~> ui "price feed" { animate: packets }

// Health polling
risk -> pricing "health check" { animate: pulse }

// Nightly reconciliation
batch ~> clearing "reconcile fills" { animate: slow }

view landscape {
  title "Market Data Flow"
  layout {
    rows [exchange] [feed] [pricing risk] [ui batch clearing]
    place risk right-of pricing
    place clearing right-of batch
  }
}
