exchange = box "Exchange" external { subtitle: "price stream source" }
feed     = sys/radio-tower "Feed Handler" { subtitle: "ingest + normalise" }
pricing  = sys/gauge "Pricing Engine"
ui       = sys/app-window "Trading UI"
risk     = sys/shield-check "Risk Service"
batch    = sys/clock "Reconciliation Batch" { subtitle: "overnight" }
clearing = box "Clearing House" external

exchange ~> feed "price stream" { tags: #continuous; animate: packets }
feed ~> pricing "ticks" { tags: #continuous; animate: packets }
pricing ~> ui "tick subscription" { tags: #continuous; animate: packets }
batch -> clearing "nightly: reconcile fills" { tags: #nightly; style: dotted }
risk -> pricing "poll every few seconds: health" { tags: #poll; animate: pulse }

view landscape {
  title "Market Data Path"
  include *
  color #continuous blue
  color #nightly amber
  color #poll violet
  legend auto
  layout { rows [exchange batch] [feed clearing] [pricing risk] [ui] }
}
