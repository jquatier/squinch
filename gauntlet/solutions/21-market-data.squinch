pack aws
pack logos

// Actors
trader = person "Trader"

// External systems
exchange = box "Exchange" external
clearing = box "Clearing House" external

// Core components
feed_handler = aws/kinesis "Feed Handler" {
  description: "Ingests price stream"
}

normalizer = aws/lambda "Normalizer" {
  description: "Standardizes ticks"
}

pricing_engine = sys/server "Pricing Engine" {
  description: "Real-time pricing"
}

trading_ui = sys/app-window "Trading UI" {
  description: "Trader interface"
}

risk_service = sys/shield "Risk Service" {
  description: "Health monitoring"
}

batch = aws/batch "Reconciliation Job" {
  description: "Overnight fill reconciliation"
}

// Continuous price stream path
exchange ~> feed_handler "price stream" { animate: packets }
feed_handler ~> normalizer "raw ticks" { animate: fast }
normalizer ~> pricing_engine "normalized ticks" { animate: fast }
pricing_engine ~> trading_ui "price updates" { animate: packets }

// Trader interaction
trader -> trading_ui "views prices"

// Nightly batch reconciliation
batch -> clearing "fetch fills" { animate: comet }

// Risk service polling
risk_service -> pricing_engine "health check" { animate: pulse }

view landscape {
  title "Market Data Pipeline"
  layout {
    direction down
    rows [exchange] [feed_handler, normalizer] [pricing_engine, risk_service] [trading_ui, batch] [clearing]
    place risk_service right-of pricing_engine
    place batch right-of trading_ui
  }
  titleblock {
    version: "2026-08"
  }
}
