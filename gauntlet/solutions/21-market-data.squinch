exchange = box "Exchange" external
clearing = box "Clearing House" external

feed    = sys/radio-tower "Feed Handler" { subtitle: "ingest + normalise" }
pricing = sys/cpu "Pricing Engine"
ui      = sys/app-window "Trading UI"
risk    = sys/shield-check "Risk Service"
recon   = sys/clock "Reconciliation Batch" { subtitle: "nightly" }

exchange ~> feed "price stream" { color: blue, animate: packets, tags: #continuous }
feed ~> pricing "ticks" { color: blue, animate: packets, tags: #continuous }
pricing ~> ui "tick subscription" { color: blue, animate: packets, tags: #continuous }
risk -> pricing "health poll, every few seconds" { color: violet, animate: pulse, tags: #poll }
recon -> clearing "reconcile day's fills, overnight" { color: amber, style: dotted, tags: #nightly }

view landscape {
  title "Market Data Path"
  include *
  color #continuous blue
  color #poll violet
  color #nightly amber
  legend auto
  layout {
    rows [exchange recon] [feed clearing] [pricing] [ui risk]
  }
}
