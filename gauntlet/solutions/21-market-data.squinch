// Market data processing pipeline
pack aws

// External systems
exchange      = box "Exchange" external
clearing      = box "Clearing House" external

// Core components
feed_handler  = aws/lambda "Feed Handler" {
  subtitle: "Lambda · Node 20"
  description: "Ingests continuous price stream"
}
pricing       = aws/lambda "Pricing Engine" {
  subtitle: "Lambda · Python"
  description: "Normalises ticks and serves prices"
}
ui            = sys/app-window "Trading UI" {
  description: "Real-time price display"
}
reconcile     = aws/batch "Reconciliation Job" {
  subtitle: "Batch · Nightly"
  description: "Validates fills against clearing house"
}
risk          = aws/lambda "Risk Service" {
  subtitle: "Lambda · Java"
  description: "Health monitoring"
}

// Connections
exchange      ~> feed_handler "price stream" { animate: packets }
feed_handler  ~> pricing "normalised ticks" { animate: fast }
pricing       ~> ui "subscription"
clearing      -> reconcile "daily fills" { color: amber }
risk          -> pricing "health poll" { animate: pulse, style: dotted }

view main {
  title "Market Data Pipeline"
  layout {
    rows [exchange] [feed_handler] [pricing risk] [ui]
    place reconcile right-of ui
  }
  titleblock {
    subtitle: "Data flow architecture"
  }
}
