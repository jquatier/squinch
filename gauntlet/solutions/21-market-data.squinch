// Market data system

exchange = box "Exchange" external

system market "Market Data Platform" {
  feed    = sys/webhook    "Feed Handler"
  norm    = sys/workflow   "Normalizer"
  pricing = sys/server     "Pricing Engine"

  feed ~> norm "price stream" { animate: packets }
  norm ~> pricing "ticks" { animate: packets }
}

ui = sys/app-window "Trading UI"

clearing = box "Clearing House" external
batch = sys/cron "Overnight Batch"

risk = sys/shield "Risk Service"

// Continuous data flow
exchange ~> market.feed "price stream" { animate: packets }
market.pricing ~> ui "subscribe" { animate: packets }

// Nightly reconciliation
batch -> clearing "reconcile fills" { color: amber }

// Periodic health polling
risk -> market.pricing "health poll" { animate: pulse, color: teal }

view landscape {
  title "Market Data Flow"
  layout {
    rows [exchange] [market risk] [batch ui] [clearing]
    place risk right-of market
    place batch left-of ui
  }
}
