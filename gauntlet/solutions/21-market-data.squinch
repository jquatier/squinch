// Market data flow diagram
pack aws

// External systems
exchange = box "Exchange" external
clearing = box "Clearing House" external

// Core components
feed = aws/kinesis "Feed Handler" {
  description: "Ingests and normalises price stream"
}

pricing = aws/lambda "Pricing Engine" {
  description: "Processes ticks and serves prices"
}

ui = sys/app-window "Trading UI" {
  description: "Real-time price display"
}

risk = aws/lambda "Risk Service" {
  description: "Market risk monitoring"
}

batch = aws/batch "Reconciliation Job" {
  description: "Nightly fill reconciliation"
  subtitle: "Runs overnight"
}

// Continuous data flow
exchange ~> feed "price stream" { animate: packets }
feed ~> pricing "ticks" { animate: fast }
pricing ~> ui "subscribe" { animate: slow }

// Polling for health
risk -> pricing "health check" { animate: pulse }

// Nightly batch job
batch -> clearing "reconcile fills" { color: amber }

view market-data {
  title "Market Data Flow"
  layout {
    rows [exchange] [feed] [pricing risk] [ui] [batch clearing]
    place risk right-of pricing
    place clearing right-of batch
  }
  legend auto
}
