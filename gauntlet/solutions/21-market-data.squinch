pack aws
pack logos

person trader "Trader"

system market "Market Data Platform" {
  description: "Real-time pricing and reconciliation"

  exchange = box "Exchange" external {
    subtitle: "Live price feed"
  }

  feed = aws/lambda "Feed Handler" {
    description: "Ingests and normalises price stream"
    subtitle: "Node 20"
  }

  pricing = aws/lambda "Pricing Engine" {
    description: "Processes ticks and serves prices"
    subtitle: "Node 20"
  }

  ui = sys/app-window "Trading UI" {
    description: "Real-time price display"
  }

  risk = aws/lambda "Risk Service" {
    description: "Health monitoring"
    subtitle: "Node 20"
  }

  clearing = box "Clearing House" external {
    subtitle: "Daily settlement"
  }

  batch = aws/batch "Overnight Reconciliation" {
    description: "Reconciles fills against clearing house"
    subtitle: "Cron · 02:00 UTC"
  }

  fills = aws/dynamodb "Fills" datastore

  exchange ~> feed "price stream" { animate: packets }
  feed ~> pricing "ticks" { animate: fast }
  pricing ~> ui "live prices" { animate: slow }
  risk -> pricing "healthcheck" { animate: pulse, style: dotted }
  clearing ~> batch "settlements" { animate: false }
  batch -> fills "reconcile"

  layout {
    rows [exchange] [feed] [pricing] [ui] [batch] [fills]
  }
}

trader -> market.ui "monitors prices"
market.clearing -> market.batch

view landscape {
  title "Market Data Architecture"
  expand market
  titleblock {
    subtitle: "Trading infrastructure"
  }
}
