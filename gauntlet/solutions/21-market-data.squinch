// Market data ingestion and distribution system
pack logos

// External actors and systems
exchange = box "Exchange" external
clearing  = box "Clearing House" external

// Core price feed pipeline
feed     = sys/network "Feed Handler"
pricing  = sys/database "Pricing Engine" datastore
ui       = sys/app-window "Trading UI"

// Supporting services
batch    = sys/clock "Batch Reconciliation"
risk     = sys/shield "Risk Service"

// Continuous price stream ingestion (exchange -> feed handler -> pricing engine)
exchange ~> feed "price stream" { animate: packets }
feed ~> pricing "normalized ticks" { animate: packets }

// UI subscription to pricing engine (continuous)
pricing ~> ui "price updates" { animate: fast }

// Overnight batch reconciliation (batch job)
batch -> clearing "nightly fills" { animate: pulse }

// Risk service polling for health (periodic check)
risk -> pricing "health poll" { animate: comet }

view landscape {
  title "Market Data System"
  layout {
    rows [exchange] [feed] [pricing risk] [ui] [batch clearing]
    place risk right-of pricing
    place clearing right-of batch
  }
  titleblock {
    version: "2026-08"
  }
}
