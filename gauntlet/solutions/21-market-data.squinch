// Market data processing system

exchange = box "Exchange" external
clearinghouse = box "Clearing House" external

system market "Market Data System" {
  feedhandler = sys/router "Feed Handler" {
    description: "Ingests price stream"
  }

  pricing = sys/cpu "Pricing Engine" {
    description: "Price processing"
  }

  ui = sys/app-window "Trading UI" {
    description: "Trading interface"
  }

  batch = sys/clock "Overnight Batch" {
    description: "Daily reconciliation"
  }

  risk = sys/shield "Risk Service" {
    description: "Health monitoring"
  }

  // Continuous price stream
  exchange ~> feedhandler "price stream" { animate: packets }
  feedhandler ~> pricing "normalized ticks" { animate: fast }
  pricing ~> ui "price updates" { animate: fast }

  // Nightly batch job
  batch ~> clearinghouse "reconcile fills" { animate: slow }

  // Health polling
  risk -> pricing "health check" { animate: pulse }
}

view landscape {
  title "Market Data Flow"
  layout {
    rows [exchange] [market.feedhandler market.pricing] [market.ui market.batch market.risk] [clearinghouse]
    place market.batch right-of market.ui
    place market.risk right-of market.batch
  }
}
