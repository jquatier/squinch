// Market data processing pipeline
pack logos

// External systems
exchange = box "Exchange" external
clearing = box "Clearing House" external

// Core components
feed = sys/antenna "Feed Handler" {
  description: "Ingests price stream"
}
pricing = sys/gauge "Pricing Engine" {
  description: "Real-time prices"
}
ui = sys/app-window "Trading UI"
batch = sys/clock "Overnight Reconciliation" {
  description: "Nightly fills reconciliation"
}
risk = sys/shield "Risk Service" {
  description: "Health monitoring"
}

// Continuous data flows
exchange ~> feed "price stream" { animate: packets }
feed ~> pricing "ticks" { animate: packets }
pricing ~> ui "price updates" { animate: packets }

// Nightly batch job
clearing -> batch "fills"
batch -> pricing "reconciliation"

// Health polling
risk -> pricing "health check" { animate: pulse }

view landscape {
  title "Market Data Pipeline"
  layout {
    rows [exchange clearing] [feed] [pricing batch risk] [ui]
    place batch right-of pricing
    place risk right-of batch
  }
}
