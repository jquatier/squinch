exchange = sys/building-2 "Exchange" external
clearing = sys/building-2 "Clearing House" external

system md "Market Data Path" {
  feed    = sys/radio-tower "Feed Handler" { subtitle: "ingest + normalise" }
  pricing = sys/cpu "Pricing Engine"
  ui      = sys/monitor "Trading UI"
  risk    = sys/shield-check "Risk Service"
  batch   = sys/clock "Reconciliation Batch" { subtitle: "nightly" }

  feed ~> pricing "ticks" { tags: #continuous }
  pricing ~> ui "subscription" { tags: #continuous }
  risk -> pricing "health poll" { tags: #poll  style: dotted  animate: pulse }
  layout { rows [feed] [pricing] [ui risk] [batch] }
}

exchange ~> md.feed "price stream" { tags: #continuous }
md.batch ~> clearing "fills reconciliation" { tags: #nightly  animate: slow }

view landscape {
  title "Market Data Path"
  include *
  expand md
  color #continuous blue
  color #nightly amber
  color #poll violet
  legend {
    #continuous "Continuous stream"
    #nightly    "Nightly batch"
    #poll       "Health poll"
  }
  about """
  - **Continuous**: live stream, ticks and subscription
  - **Nightly**: overnight fills reconciliation
  - **Poll**: risk checks pricing health every few seconds
  """
}
