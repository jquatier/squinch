// Market data flow architecture

exchange = sys/radio-tower "Exchange" external
clearing = sys/building-2 "Clearing House" external

feed_handler = sys/webhook "Feed Handler"
normaliser = sys/cog "Normaliser"
pricing_engine = sys/cpu "Pricing Engine"
trading_ui = sys/app-window "Trading UI"
batch_recon = sys/clock "Nightly Reconciliation" {
  description: "Batch job"
}
risk_service = sys/shield-check "Risk Service"

// Continuous price stream
exchange ~> feed_handler "price stream" { animate: packets }
feed_handler ~> normaliser "raw ticks"
normaliser ~> pricing_engine "normalised ticks"
pricing_engine ~> trading_ui "price updates" { animate: packets }

// Nightly batch reconciliation
batch_recon -> clearing "reconcile fills" { color: amber }

// Health poll
risk_service -> pricing_engine "health check" { animate: pulse }

view landscape {
  title "Market Data Architecture"
  layout {
    rows [exchange] [feed_handler] [normaliser] [pricing_engine trading_ui risk_service]
    place batch_recon left-of pricing_engine
    place clearing left-of batch_recon
  }
}
