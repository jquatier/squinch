exchange = sys/globe       "Exchange" external
feed     = sys/route       "Feed Handler"
pricing  = sys/cog         "Pricing Engine"
ui       = sys/app-window  "Trading UI"
risk     = sys/activity    "Risk Service"
recon    = sys/repeat      "Overnight Reconciliation"
clearing = sys/building-2  "Clearing House" external

exchange ~> feed    "price stream"    { tags: #continuous }
feed     ~> pricing "normalized ticks" { tags: #continuous }
pricing  ~> ui       "price updates"  { tags: #continuous }
risk     -> pricing "health check"    { tags: #poll, animate: pulse }
recon    ~> clearing "reconciles fills" { tags: #nightly, animate: slow }

view landscape {
  title "Market Data Path"
  include *
  color #continuous teal
  color #poll violet
  color #nightly amber
  legend auto

  layout {
    rows [exchange] [feed] [pricing risk] [ui]
  }
}
