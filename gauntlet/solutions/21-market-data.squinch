exchange = sys/building-2 "Exchange" external
feed     = sys/activity "Feed Handler" { subtitle: "ingest · normalise" }
pricing  = sys/cpu "Pricing Engine"
ui       = sys/app-window "Trading UI"
risk     = sys/shield-check "Risk Service"
recon    = sys/clock "Reconciliation Batch" { subtitle: "overnight" }
clearing = sys/building-2 "Clearing House" external

exchange ~> feed "price stream" { color: teal, animate: packets, tags: #continuous }
feed ~> pricing "normalised ticks" { color: teal, animate: packets, tags: #continuous }
pricing ~> ui "tick subscription" { color: teal, animate: packets, tags: #continuous }
risk -> pricing "health poll, every few seconds" { color: violet, style: dotted, animate: pulse }
recon -> clearing "nightly fills reconciliation" { color: amber }

view landscape {
  title "Market Data Path"
  include *
  legend auto
  note bottom-right "Teal: continuous stream · Violet dotted: periodic poll · Amber solid: nightly batch"
}
