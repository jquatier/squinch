pack aws

system payments "Payments Platform" {
  api       = aws/lambda   "Payments API"  { tags: #pci }
  tokenizer = aws/lambda   "Tokenizer"     { tags: #pci }
  vault     = aws/dynamodb "Card Vault"    datastore { tags: #pci }
  analytics = aws/lambda   "Analytics"
  warehouse = aws/redshift "Warehouse"     datastore

  api -> tokenizer
  tokenizer -> vault
  api ~> analytics
  analytics -> warehouse
}

view landscape {
  title "Payments Platform"
  expand payments
  color #pci red
  legend { #pci "In PCI scope"  -> "Request"  ~> "Event" }
}

view audit {
  title "PCI Audit View"
  scope payments
  only #pci
  color #pci red
  legend { #pci "In PCI scope"  -> "Request" }
}
