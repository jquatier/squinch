pack aws

system payments "Payment Platform" {
  description: "Payment processing and analytics"
  icon: aws/lambda

  api        = aws/lambda     "API Handler" #pci
  tokenizer  = aws/lambda     "Tokenizer" #pci
  vault      = aws/dynamodb   "Card Vault" datastore #pci
  analytics  = aws/lambda     "Analytics"
  warehouse  = aws/redshift   "Warehouse" datastore

  api -> tokenizer
  tokenizer -> vault
  api ~> analytics
  analytics -> warehouse

  layout {
    rows [api] [tokenizer] [vault analytics] [warehouse]
  }
}

view full {
  title "Payment Platform - Full View"
  scope payments
}

view auditor {
  title "Payment Platform - PCI Scope"
  scope payments
  only #pci
  highlight #pci
}
