pack aws

api       = aws/lambda   "Payments API"  { tags: #pci }
tokenizer = aws/lambda   "Tokenizer"     { tags: #pci }
vault     = aws/dynamodb "Card Vault"    datastore { tags: #pci }
analytics = aws/lambda   "Analytics"
warehouse = aws/redshift "Warehouse"     datastore

api -> tokenizer "card data"
tokenizer -> vault "stores"
api ~> analytics "payment events"
analytics -> warehouse "loads"

view full {
  title "Payments Platform"
  include *
  color #pci red
  legend auto
}

view auditor {
  title "PCI Scope"
  include *
  only #pci
  context off
  about "Only the components tagged `#pci`."
}
