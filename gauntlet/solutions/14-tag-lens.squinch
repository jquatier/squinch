// Payments platform diagram
pack aws

system payments "Payments Platform" {
  description: "Payment processing and analytics"

  api = aws/lambda "API Handler" {
    description: "Payment API endpoint"
    tags: #pci
  }

  tokenizer = aws/lambda "Tokenizer" {
    description: "Card tokenization service"
    tags: #pci
  }

  vault = aws/dynamodb "Card Vault" datastore {
    description: "Encrypted card data"
    tags: #pci
  }

  analytics = aws/lambda "Analytics" {
    description: "Payment analytics processor"
  }

  warehouse = aws/redshift "Data Warehouse" datastore {
    description: "Analytics storage"
  }

  api -> tokenizer
  tokenizer -> vault
  api ~> analytics
  analytics -> warehouse
}

view full {
  title "Full Platform View"
  scope payments
}

view auditor {
  title "PCI Compliance Scope"
  scope payments
  only #pci
}
