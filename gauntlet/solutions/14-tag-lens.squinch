pack aws

// Payments platform with PCI scope tagging
api = aws/lambda "API Handler" #pci {
  description: "Payment request validation and routing"
  subtitle: "Lambda · Node 20"
}

tokenizer = aws/lambda "Tokenizer" #pci {
  description: "Card tokenization service"
  subtitle: "Lambda · Node 20"
}

vault = aws/dynamodb "Card Vault" datastore #pci {
  description: "Encrypted card tokens"
}

analytics = aws/lambda "Analytics" {
  description: "Transaction analytics processor"
  subtitle: "Lambda · Python 3.11"
}

warehouse = aws/redshift "Analytics Warehouse" datastore {
  description: "Transaction data warehouse"
}

// Connections
api -> tokenizer
tokenizer -> vault
tokenizer ~> analytics "transaction events"
analytics -> warehouse

view full {
  title "Payment Platform - Full View"
  include *
  layout {
    rows [api] [tokenizer] [vault analytics] [warehouse]
  }
}

view pci {
  title "Payment Platform - PCI Audit Scope"
  include *
  only #pci
  layout {
    rows [api] [tokenizer] [vault]
  }
}
