// Payments platform with PCI scope tagging
pack aws

system payments "Payments Platform" {
  description: "Payment processing and analytics"
  tags: #payments

  api = aws/lambda "API Handler" {
    description: "Payment request entry point"
    tags: #pci
  }

  tokenizer = aws/lambda "Tokenizer" {
    description: "Card tokenization service"
    tags: #pci
  }

  vault = aws/dynamodb "Card Vault" datastore {
    description: "Encrypted card data storage"
    tags: #pci
  }

  analytics = aws/lambda "Analytics" {
    description: "Payment analytics processor"
  }

  warehouse = aws/redshift "Data Warehouse" datastore {
    description: "Analytics data store"
  }

  api -> tokenizer
  tokenizer -> vault
  api ~> analytics
  analytics -> warehouse
}

view full {
  title "Full Payments Platform"
  scope payments
  layout {
    rows [api] [tokenizer analytics] [vault warehouse]
  }
}

view auditor {
  title "PCI Scope - Auditor View"
  scope payments
  only #pci
  layout {
    rows [api] [tokenizer] [vault]
  }
}
