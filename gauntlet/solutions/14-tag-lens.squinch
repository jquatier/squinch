pack aws

// Payments platform with PCI compliance scope
system payments "Payments Platform" {
  description: "Card payment processing and analytics"
  glyph: sys/lock

  api = aws/lambda "API Handler" {
    description: "Processes payment requests"
    tags: #pci
  }

  tokenizer = aws/lambda "Tokenizer" {
    description: "Tokenizes card data"
    tags: #pci
  }

  vault = aws/dynamodb "Card Vault" datastore {
    description: "Encrypted card storage"
    tags: #pci
  }

  analytics = aws/lambda "Analytics" {
    description: "Processes transaction data"
  }

  warehouse = aws/redshift "Data Warehouse" datastore {
    description: "Transaction analytics"
  }

  // connections
  api -> tokenizer "tokenize card"
  tokenizer -> vault "store token"
  api -> analytics "send transaction"
  analytics -> warehouse "load data"
}

view full {
  title "Payments Platform - Full Architecture"
  scope payments
  show descriptions
}

view auditor {
  title "PCI Compliance Scope"
  scope payments
  only #pci
  show descriptions
  highlight #pci
  titleblock {
    version: "2026-07"
    owner: security-team
  }
}
