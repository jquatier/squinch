// Payments platform with PCI scope tagging
pack aws

system payments "Payments Platform" {
  description: "Payment processing and analytics"
  tags: #core

  api = aws/lambda "API Handler" {
    description: "Payment request handler"
    tags: #pci
  }

  tokenizer = aws/lambda "Tokenizer" {
    description: "Card tokenization"
    tags: #pci
  }

  vault = aws/dynamodb "Card Vault" datastore {
    description: "Secure card storage"
    tags: #pci
  }

  analytics = aws/lambda "Analytics" {
    description: "Payment analytics"
  }

  warehouse = aws/redshift "Data Warehouse" datastore {
    description: "Analytics warehouse"
  }

  api -> tokenizer
  tokenizer -> vault
  api -> analytics
  analytics -> warehouse
}

view full {
  title "Full Payment Platform"
  scope payments
  show descriptions
}

view auditor {
  title "PCI Scope - Auditor View"
  scope payments
  only #pci
  show descriptions
}
