// Payments platform with PCI scope tagging
pack aws

system payments "Payments Platform" {
  description: "Payment processing and analytics"
  tags: #core

  api = aws/lambda "API Handler" {
    description: "Receives payment requests"
    tags: #pci
  }

  tokenizer = aws/lambda "Tokenizer" {
    description: "Tokenizes card data"
    tags: #pci
  }

  vault = aws/dynamodb "Card Vault" datastore {
    description: "Stores tokenized cards"
    tags: #pci
  }

  analytics = aws/lambda "Analytics" {
    description: "Processes payment events"
  }

  warehouse = aws/redshift "Data Warehouse" datastore {
    description: "Analytics storage"
  }

  api -> tokenizer
  tokenizer -> vault
  api ~> analytics
  analytics -> warehouse
}

view full {
  title "Payments Platform - Full Architecture"
  scope payments
  show descriptions
}

view auditor {
  title "Payments Platform - PCI Scope"
  scope payments
  only #pci
  show descriptions
}
