// Payments platform with PCI scope tagging
pack aws

system payments "Payments Platform" {
  description: "Payment processing and tokenization"

  api = aws/lambda "API Handler" {
    description: "Payment request handler"
    subtitle: "Lambda · Node 20"
    tags: #pci
  }

  tokenizer = aws/lambda "Tokenizer" {
    description: "Card tokenization service"
    subtitle: "Lambda · Python 3.12"
    tags: #pci
  }

  vault = aws/dynamodb "Card Vault" datastore {
    description: "Encrypted card token storage"
    tags: #pci
  }

  analytics = aws/lambda "Analytics" {
    description: "Payment analytics processor"
    subtitle: "Lambda · Python 3.12"
  }

  warehouse = aws/redshift "Data Warehouse" datastore {
    description: "Analytics and reporting"
  }

  api -> tokenizer "tokenize card"
  tokenizer -> vault "store token"
  api -> analytics "payment event"
  analytics -> warehouse "aggregate metrics"
}

view full {
  title "Payments Platform — Full Architecture"
  scope payments
}

view audit {
  title "Payments Platform — PCI Audit Scope"
  scope payments
  only #pci
  highlight #pci
}
