pack aws

// Payments platform with PCI scope tagging
api        = aws/lambda "API Handler" { tags: #pci }
tokenizer  = aws/lambda "Card Tokenizer" { tags: #pci }
vault      = aws/dynamodb "Card Vault" datastore { tags: #pci }
analytics  = aws/lambda "Analytics"
warehouse  = aws/redshift "Data Warehouse" datastore

// Payment flow
api -> tokenizer
tokenizer -> vault
api -> analytics
analytics -> warehouse

view full {
  title "Payments Platform - Full View"
  include *
}

view auditor {
  title "Payments Platform - PCI Scope Only"
  include *
  only #pci
}
