// Payments platform architecture
pack aws

system payments "Payments Platform" {
  description: "Payment processing and analytics"
  glyph: sys/lock

  api = aws/lambda "API Handler" {
    description: "Payment API endpoint"
    tags: #pci
  }

  tokenizer = aws/lambda "Tokenizer" {
    description: "Card tokenization service"
    tags: #pci
  }

  vault = aws/dynamodb "Card Vault" datastore {
    description: "Encrypted card tokens"
    tags: #pci
  }

  analytics = aws/lambda "Analytics" {
    description: "Transaction analytics"
  }

  warehouse = aws/redshift "Data Warehouse" datastore {
    description: "Analytics data store"
  }

  api -> tokenizer "tokenize card"
  tokenizer -> vault "store token"
  api -> analytics "log transaction"
  analytics -> warehouse "aggregate data"
}

view full {
  title "Payments Platform - Full View"
  scope payments
  show descriptions
}

view auditor {
  title "Payments Platform - PCI Scope"
  scope payments
  only #pci
  show descriptions
}
