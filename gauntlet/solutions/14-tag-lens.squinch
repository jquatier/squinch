pack aws

system payments "Payment Platform" {
  description: "Payment processing and analytics"

  api = aws/lambda "API Handler" #pci {
    subtitle: "Lambda · Node 20"
    description: "Receives and validates payment requests"
  }

  tokenizer = aws/lambda "Tokenizer" #pci {
    subtitle: "Lambda · Node 20"
    description: "Tokenizes sensitive card data"
  }

  vault = aws/dynamodb "Card Vault" datastore #pci {
    subtitle: "DynamoDB"
    description: "Encrypted storage for tokenized card data"
  }

  analytics = aws/lambda "Analytics Processor" {
    subtitle: "Lambda · Python 3.11"
    description: "Processes transaction metrics"
  }

  warehouse = aws/redshift "Analytics Warehouse" datastore {
    subtitle: "Redshift"
    description: "Transaction analytics and reporting"
  }

  // Payment flow
  api -> tokenizer "validate payment"
  tokenizer -> vault "store token"
  tokenizer ~> analytics "transaction event"
  analytics -> warehouse "load metrics"
}

view full {
  title "Payment Platform - Full Architecture"
  scope payments
  layout {
    rows [api] [tokenizer] [vault analytics] [warehouse]
  }
}

view auditor {
  title "Payment Platform - PCI Compliance Scope"
  scope payments
  only #pci
  highlight #pci
}
