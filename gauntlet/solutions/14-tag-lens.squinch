// Payments platform with PCI scope tagging
pack aws

// Components
api = aws/lambda "Payment API" {
  subtitle: "Lambda · Node 20"
  tags: #pci
}

tokenizer = aws/lambda "Card Tokenizer" {
  subtitle: "Lambda · Node 20"
  tags: #pci
}

vault = aws/dynamodb "Card Vault" datastore {
  subtitle: "Encrypted card data"
  tags: #pci
}

analytics = aws/lambda "Analytics Processor" {
  subtitle: "Lambda · Python 3.11"
}

warehouse = aws/redshift "Analytics Warehouse" datastore {
  subtitle: "Redshift"
  description: "Payment analytics aggregations"
}

// Connections
api -> tokenizer "tokenize card"
tokenizer -> vault "store token"
api -> analytics "payment event"
analytics -> warehouse "aggregated metrics"

// Views
view full {
  title "Payments Platform — Full System"
  include *
  layout {
    rows [api] [tokenizer] [vault analytics] [warehouse]
  }
}

view audit {
  title "Payments Platform — PCI Audit Scope"
  only #pci
  highlight #pci
}
