pack aws

system payments "Payments Platform" {
  description: "Card payment processing and analytics"

  api = aws/lambda "API Handler" #pci
  tokenizer = aws/lambda "Tokenizer" #pci
  vault = aws/dynamodb "Card Vault" datastore #pci
  analytics = aws/lambda "Analytics"
  warehouse = aws/redshift "Data Warehouse" datastore

  api -> tokenizer
  tokenizer -> vault
  vault ~> analytics
  analytics -> warehouse
}

view full {
  title "Payments Platform - Full View"
  scope payments
}

view auditor {
  title "Payments Platform - PCI Auditor View"
  scope payments
  only #pci
}
