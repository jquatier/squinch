pack aws

person customer "Customer"

system payments "Payments Platform" {
  api       = aws/lambda   "API"                 { tags: #pci }
  tokenizer = aws/lambda   "Tokenizer"            { tags: #pci }
  vault     = aws/dynamodb "Card Vault" datastore { tags: #pci }
  analytics = aws/lambda   "Analytics"
  warehouse = aws/redshift "Analytics Warehouse" datastore

  api -> tokenizer "tokenize card"
  tokenizer -> vault "store token"
  vault ~> analytics "token stream"
  analytics -> warehouse "load"
}

customer -> payments.api "pay"

view landscape {
  title "Payments Platform"
  include *
}

view full {
  title "Full Picture"
  expand *
}

view auditor {
  title "PCI Audit View"
  scope payments
  only #pci
}
