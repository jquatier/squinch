// Payments Platform Architecture
pack aws

system payments "Payments Platform" {
  description: "Card payment processing and analytics"
  glyph: sys/lock

  api       = aws/lambda    "API Handler" {
    tags: #pci
    description: "Payment API entry point"
  }
  tokenizer = aws/lambda    "Tokenizer" {
    tags: #pci
    description: "Card tokenization service"
  }
  vault     = aws/dynamodb  "Card Vault" datastore {
    tags: #pci
    description: "Encrypted card data"
  }
  analytics = aws/lambda    "Analytics" {
    description: "Payment analytics processor"
  }
  warehouse = aws/redshift  "Data Warehouse" datastore {
    description: "Analytics storage"
  }

  api -> tokenizer "tokenize card"
  tokenizer -> vault "store token"
  api -> analytics "send metadata"
  analytics -> warehouse "store analytics"
}

view full {
  title "Payments Platform - Full Architecture"
  scope payments
  show descriptions

  layout {
    rows [api] [tokenizer analytics] [vault warehouse]
  }
}

view auditor {
  title "Payments Platform - PCI Scope"
  scope payments
  exclude analytics
  exclude warehouse
  show descriptions

  layout {
    rows [api] [tokenizer] [vault]
  }
}
