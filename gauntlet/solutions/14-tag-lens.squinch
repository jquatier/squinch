pack aws

system payments "Payments Platform" {
  description: "Payment processing and analytics"

  api = aws/lambda "API Handler" {
    description: "Processes payment requests"
    tags: #pci
  }

  tokenizer = aws/lambda "Tokenizer" {
    description: "Tokenizes card data"
    tags: #pci
  }

  vault = aws/dynamodb "Card Vault" datastore {
    description: "Stores tokenized card data"
    tags: #pci
  }

  analytics = aws/lambda "Analytics Handler" {
    description: "Processes analytics events"
  }

  warehouse = aws/redshift "Data Warehouse" datastore {
    description: "Analytics data store"
  }

  api -> tokenizer "tokenize card"
  tokenizer -> vault "store token"
  api ~> analytics "payment event"
  analytics -> warehouse "store analytics"
}

view full {
  title "Payments Platform — Full Detail"
  scope payments
}

view auditor {
  title "Payments Platform — PCI Scope"
  scope payments
  only #pci
  highlight #pci
}
