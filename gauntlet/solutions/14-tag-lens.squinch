pack aws

system payments "Payments Platform" {
  description: "Card payment processing"

  api        = aws/lambda     "API Handler" #pci
  tokenizer  = aws/lambda     "Tokenizer" #pci
  vault      = aws/dynamodb   "Card Vault" datastore #pci
  analytics  = aws/lambda     "Analytics"
  warehouse  = aws/redshift   "Warehouse" datastore

  api -> tokenizer "tokenize card"
  tokenizer -> vault "store token"
  tokenizer -> analytics "payment event"
  analytics -> warehouse "load metrics"
}

view full {
  title "Full System"
  scope payments
}

view auditor {
  title "PCI Scope"
  scope payments
  only #pci
}
