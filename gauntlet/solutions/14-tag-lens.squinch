pack aws

api       = aws/lambda   "Payments API" { tags: #pci }
tokenizer = aws/lambda   "Tokenizer"    { tags: #pci }
vault     = aws/dynamodb "Card Vault"   datastore { tags: #pci }
analytics = aws/lambda   "Analytics"
warehouse = aws/redshift "Warehouse"    datastore

api -> tokenizer
tokenizer -> vault
api -> analytics
analytics -> warehouse

view full {
  title "Payments Platform"
  include *
  color #pci red
  legend auto
}

view auditor {
  title "PCI Scope"
  include *
  only #pci
  color #pci red
  legend auto
}
