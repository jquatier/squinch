pack aws

system payments "Payments Platform" {
  api       = aws/lambda   "API" { tags: #pci }
  tokenizer = aws/lambda   "Tokenizer" { tags: #pci }
  vault     = aws/dynamodb "Card Vault" datastore { tags: #pci }
  analytics = aws/lambda   "Analytics"
  warehouse = aws/redshift "Warehouse" datastore

  api -> tokenizer
  tokenizer -> vault
  analytics -> warehouse
}

view landscape {
  title "Full picture"
  scope payments
  color #pci red
  legend auto
}

view pci_audit {
  title "PCI scope (auditor)"
  scope payments
  only #pci
  legend auto
}
