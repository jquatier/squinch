pack aws

system payments "Payment Platform" {
  description: "Payment processing and analytics"

  api = aws/lambda "API Handler" {
    description: "Payment API entry point"
    tags: #pci
  }

  tokenizer = aws/lambda "Tokenizer" {
    description: "Card tokenization service"
    tags: #pci
  }

  vault = aws/dynamodb "Card Vault" datastore {
    description: "Encrypted card data"
    tags: #pci
  }

  analytics = aws/lambda "Analytics" {
    description: "Payment analytics processor"
  }

  warehouse = aws/redshift "Data Warehouse" datastore {
    description: "Analytics and reporting"
  }

  api -> tokenizer
  tokenizer -> vault
  api -> analytics
  analytics -> warehouse
}

view full {
  title "Payment Platform - Full Architecture"
  scope payments
  show descriptions
}

view auditor {
  title "Payment Platform - PCI Scope"
  scope payments
  only #pci
  show descriptions
}
