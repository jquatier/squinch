pack aws

system payments "Payments Platform" {
  description: "Payment processing and analytics"
  glyph: sys/lock

  api = aws/lambda "API Handler" #pci {
    description: "Process payment requests"
  }

  tokenizer = aws/lambda "Tokenizer" #pci {
    description: "Card tokenization service"
  }

  vault = aws/dynamodb "Card Vault" datastore #pci {
    description: "Encrypted card data"
  }

  analytics = aws/lambda "Analytics" {
    description: "Process payment metrics"
  }

  warehouse = aws/redshift "Data Warehouse" datastore {
    description: "Analytics data store"
  }

  api -> tokenizer
  tokenizer -> vault
  api -> analytics
  analytics -> warehouse
}

view full {
  title "Payments Platform - Full Architecture"
  scope payments
  show descriptions
}

view auditor {
  title "Payments Platform - PCI Scope"
  scope payments
  only #pci
  show descriptions
}
