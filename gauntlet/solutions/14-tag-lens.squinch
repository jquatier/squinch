pack aws

api       = aws/lambda   "API Lambda"       { tags: #pci }
tokenizer = aws/lambda   "Tokenizer Lambda"  { tags: #pci }
vault     = aws/dynamodb "Card Vault"        datastore { tags: #pci }
analytics = aws/lambda   "Analytics Lambda"
wh        = aws/redshift "Redshift Warehouse" datastore

api -> tokenizer
tokenizer -> vault
vault     ~> analytics "stream"
analytics ~> wh "load"

view full {
  title "Payments Platform"
  include *
}

view audit {
  title "Auditor View — PCI Scope"
  include *
  only #pci
}
