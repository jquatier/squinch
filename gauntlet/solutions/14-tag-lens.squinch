pack aws

system payments "Payments Platform" {
  description: "Payment processing and analytics"

  api = aws/api-gateway "Payment API" #pci
  tokenizer = aws/lambda "Tokenizer" #pci {
    description: "Tokenizes card data"
  }
  vault = aws/dynamodb "Card Vault" datastore #pci {
    description: "Stores tokenized card data"
  }
  analytics = aws/lambda "Analytics Processor"
  warehouse = aws/redshift "Analytics Warehouse" datastore {
    description: "Payment analytics and reporting"
  }

  api -> tokenizer
  tokenizer -> vault
  api -> analytics
  analytics -> warehouse

  layout {
    rows [api] [tokenizer analytics] [vault warehouse]
  }
}

view full {
  title "Full Platform View"
  scope payments
}

view auditor {
  title "PCI Compliance Scope"
  scope payments
  only #pci
  color #pci red
  legend auto
}
