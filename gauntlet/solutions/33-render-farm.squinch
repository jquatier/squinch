pack aws

dispatcher = aws/ec2 "Dispatcher" {
  subtitle: "Frame distributor"
}

worker1  = aws/ec2 "Worker 1"  { subtitle: "Render node" }
worker2  = aws/ec2 "Worker 2"  { subtitle: "Render node" }
worker3  = aws/ec2 "Worker 3"  { subtitle: "Render node" }
worker4  = aws/ec2 "Worker 4"  { subtitle: "Render node" }
worker5  = aws/ec2 "Worker 5"  { subtitle: "Render node" }
worker6  = aws/ec2 "Worker 6"  { subtitle: "Render node" }
worker7  = aws/ec2 "Worker 7"  { subtitle: "Render node" }
worker8  = aws/ec2 "Worker 8"  { subtitle: "Render node" }
worker9  = aws/ec2 "Worker 9"  { subtitle: "Render node" }
worker10 = aws/ec2 "Worker 10" { subtitle: "Render node" }
worker11 = aws/ec2 "Worker 11" { subtitle: "Render node" }
worker12 = aws/ec2 "Worker 12" { subtitle: "Render node" }

dispatcher -> worker1
dispatcher -> worker2
dispatcher -> worker3
dispatcher -> worker4
dispatcher -> worker5
dispatcher -> worker6
dispatcher -> worker7
dispatcher -> worker8
dispatcher -> worker9
dispatcher -> worker10
dispatcher -> worker11
dispatcher -> worker12

view main {
  title "Render Farm"
  layout {
    wrap 4
  }
}
