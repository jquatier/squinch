pack aws

dispatcher = aws/ec2 "Dispatcher" {
  description: "Distributes frames to render workers"
}

worker1  = aws/ec2 "Worker 1"
worker2  = aws/ec2 "Worker 2"
worker3  = aws/ec2 "Worker 3"
worker4  = aws/ec2 "Worker 4"
worker5  = aws/ec2 "Worker 5"
worker6  = aws/ec2 "Worker 6"
worker7  = aws/ec2 "Worker 7"
worker8  = aws/ec2 "Worker 8"
worker9  = aws/ec2 "Worker 9"
worker10 = aws/ec2 "Worker 10"
worker11 = aws/ec2 "Worker 11"
worker12 = aws/ec2 "Worker 12"

dispatcher -> worker1, worker2, worker3, worker4, worker5, worker6, worker7, worker8, worker9, worker10, worker11, worker12

view main {
  title "Render Farm"
  include *
  layout {
    wrap 4
  }
}
