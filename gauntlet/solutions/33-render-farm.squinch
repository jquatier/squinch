pack aws

disp = sys/server "Dispatcher" {
  description: "Hands frames out to the workers"
}

w1  = aws/ec2 "Worker 1"
w2  = aws/ec2 "Worker 2"
w3  = aws/ec2 "Worker 3"
w4  = aws/ec2 "Worker 4"
w5  = aws/ec2 "Worker 5"
w6  = aws/ec2 "Worker 6"
w7  = aws/ec2 "Worker 7"
w8  = aws/ec2 "Worker 8"
w9  = aws/ec2 "Worker 9"
w10 = aws/ec2 "Worker 10"
w11 = aws/ec2 "Worker 11"
w12 = aws/ec2 "Worker 12"

disp -> w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11, w12

view landscape {
  title "Render Farm"
  include *
  layout { wrap 4 }
}
