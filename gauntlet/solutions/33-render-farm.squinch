pack aws

dispatcher = aws/ec2 "Dispatcher"

w1  = aws/ec2 "Render Worker 1"
w2  = aws/ec2 "Render Worker 2"
w3  = aws/ec2 "Render Worker 3"
w4  = aws/ec2 "Render Worker 4"
w5  = aws/ec2 "Render Worker 5"
w6  = aws/ec2 "Render Worker 6"
w7  = aws/ec2 "Render Worker 7"
w8  = aws/ec2 "Render Worker 8"
w9  = aws/ec2 "Render Worker 9"
w10 = aws/ec2 "Render Worker 10"
w11 = aws/ec2 "Render Worker 11"
w12 = aws/ec2 "Render Worker 12"

dispatcher -> w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11, w12

view landscape {
  title "Render Farm"
  include *
  layout {
    wrap 5
  }
}
