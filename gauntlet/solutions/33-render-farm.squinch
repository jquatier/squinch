pack aws

disp = sys/workflow "Dispatcher" { description: "Hands out frames" }
w01 = aws/ec2 "Worker 01"
w02 = aws/ec2 "Worker 02"
w03 = aws/ec2 "Worker 03"
w04 = aws/ec2 "Worker 04"
w05 = aws/ec2 "Worker 05"
w06 = aws/ec2 "Worker 06"
w07 = aws/ec2 "Worker 07"
w08 = aws/ec2 "Worker 08"
w09 = aws/ec2 "Worker 09"
w10 = aws/ec2 "Worker 10"
w11 = aws/ec2 "Worker 11"
w12 = aws/ec2 "Worker 12"

disp -> w01, w02, w03, w04, w05, w06, w07, w08, w09, w10, w11, w12 "frames"

view landscape {
  title "Render Farm"
  include *
  layout { wrap 4 }
}
