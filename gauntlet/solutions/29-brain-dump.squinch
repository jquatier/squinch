pack aws
pack logos

person customer "Customer"
person data_team "Data Team"

mobile  = sys/smartphone "Mobile App"
website = sys/globe "Website"
gw      = sys/webhook "Gateway"
account = sys/server "Account Service"
billing = sys/server "Billing Service"
stripe  = logos/stripe "Stripe" external
pg      = logos/postgres "Main Postgres" datastore
billdb  = logos/postgres "Billing Database" datastore
export  = aws/s3 "Nightly Export" { subtitle: "S3" }

customer -> mobile
customer -> website
mobile -> gw
website -> gw
gw -> account
gw -> billing
billing -> stripe
account -> pg "writes"
billing -> billdb
pg ~> export "nightly"
export ~> data_team

view landscape {
  title "System Landscape"
  include *
}
