pack aws
pack logos

person customer "Customer"
mobile = sys/smartphone "Mobile App"
web = sys/app-window "Website"
gw = aws/api-gateway "API Gateway"

system account "Account Service" {
  api = sys/code "Account API"
  db = logos/postgres "Account DB" datastore

  api -> db
}

system billing "Billing Service" {
  api = sys/code "Billing API"
  db = logos/postgres "Billing DB" datastore

  api -> db
}

stripe = box "Stripe" external
export = aws/s3 "Data Export" datastore
datateam = person "Data Team"

customer -> mobile
customer -> web
mobile -> gw
web -> gw
gw -> account.api
gw -> billing.api
billing.api -> stripe
account.db ~> export "nightly export"
export -> datateam

view landscape {
  title "System Overview"
  include *
  layout {
    rows [customer] [mobile web] [gw] [account billing] [stripe export datateam]
  }
}
