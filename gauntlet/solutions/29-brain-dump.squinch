pack aws
pack logos

person customer "Customer"

gw = aws/api-gateway "API Gateway"

system account "Account Service" {
  svc = aws/lambda "Account Handler"
  db = aws/rds "Postgres" datastore {
    subtitle: "Main database"
  }
  svc -> db
}

system billing "Billing Service" {
  svc = aws/lambda "Billing Handler"
  db = aws/rds "Postgres" datastore {
    subtitle: "Billing database"
  }
  stripe = box "Stripe" external {
    badge: logos/stripe
  }
  svc -> db
  svc -> stripe
}

export = aws/s3 "Data Export" datastore {
  subtitle: "Nightly export"
}

person data_team "Data Team"

customer -> gw "mobile app / website"
gw -> account.svc
gw -> billing.svc
account.db ~> export "nightly export"
export -> data_team

view landscape {
  title "System Overview"
  include *
}
