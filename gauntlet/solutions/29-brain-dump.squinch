person customer "Customer"
person data_team "Data Team"

mobile  = sys/smartphone "Mobile App"
website = sys/globe "Website"
gw      = sys/network "Gateway"
account = sys/server "Account Service"
billing = sys/server "Billing Service"
pg      = logos/postgres "Main Postgres" datastore
billdb  = sys/database "Billing Database" datastore
stripe  = logos/stripe "Stripe" external
export  = aws/s3 "Nightly Export"

customer -> mobile
customer -> website
mobile -> gw
website -> gw
gw -> account
gw -> billing
account -> pg "writes"
billing -> billdb
billing -> stripe
pg ~> export "nightly"
export ~> data_team

view landscape {
  title "System Landscape"
  include *
}
