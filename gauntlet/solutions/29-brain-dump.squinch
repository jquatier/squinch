pack aws
pack logos

person customer "Customer"

mobile = box "Mobile App"
web = box "Website"
gw = aws/api-gateway "API Gateway"

system account "Account Service" {
  api = aws/lambda "Account API"
  db = sys/database "Account DB" datastore {
    badge: logos/postgres
    subtitle: "Postgres"
  }
  exporter = aws/lambda "Data Exporter"
  bucket = aws/s3 "Export Bucket" datastore

  api -> db "writes"
  db -> exporter "nightly"
  exporter -> bucket
}

system billing "Billing Service" {
  api = aws/lambda "Billing API"
  db = sys/database "Billing DB" datastore {
    badge: logos/postgres
    subtitle: "Postgres"
  }

  api -> db
}

stripe = box "Stripe" external

customer -> mobile
customer -> web
mobile -> gw
web -> gw
gw -> account.api
gw -> billing.api
billing.api -> stripe

view landscape {
  title "System Architecture"
  include *
}
