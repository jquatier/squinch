person customer "Customer"
person data_team "Data Team"

mobile  = sys/smartphone "Mobile App"
web     = sys/globe "Website"
gateway = sys/api "Gateway"
account = sys/server "Account Service"
billing = sys/server "Billing Service"
pg      = logos/postgres "Main Postgres" datastore
billdb  = sys/database "Billing Database" datastore
stripe  = logos/stripe "Stripe" external
export  = aws/s3 "Nightly Export" datastore

customer -> mobile
customer -> web
mobile -> gateway
web -> gateway
gateway -> account
gateway -> billing
account -> pg "writes"
billing -> billdb
billing -> stripe
pg ~> export "nightly export"
export -> data_team

view landscape {
  title "Platform Overview"
  include *
}
