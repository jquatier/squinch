// Customer-facing platform with account and billing services
pack logos

person customer "Customer"

gateway = box "API Gateway"
mobile  = box "Mobile App"
web     = box "Website"

system account "Account Service" {
  api = box "API"
  db  = logos/postgres "Account DB" datastore

  api -> db
}

system billing "Billing Service" {
  api    = box "API"
  db     = logos/postgres "Billing DB" datastore
  stripe = box "Stripe" external

  api -> db
  api -> stripe
}

export = logos/postgres "Export Job"
s3     = box "S3 Bucket" datastore

// Customer flows
customer -> mobile
customer -> web
mobile   -> gateway
web      -> gateway

// Gateway to services
gateway -> account.api
gateway -> billing.api

// Nightly export
account.db ~> export "nightly"
export ~> s3
