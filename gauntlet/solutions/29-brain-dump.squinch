pack aws
pack logos

person customer "Customer"

mobile = sys/smartphone "Mobile App"
web = sys/app-window "Website"
gw = aws/api-gateway "API Gateway"

account = aws/lambda "Account Service"
billing = aws/lambda "Billing Service"

account_db = aws/rds "Account DB" datastore {
  subtitle: "Postgres"
}
billing_db = aws/rds "Billing DB" datastore {
  subtitle: "Postgres"
}

export = aws/s3 "Data Export" datastore {
  subtitle: "Nightly export"
}

stripe = box "Stripe" external

customer -> mobile
customer -> web
mobile -> gw
web -> gw
gw -> account
gw -> billing
account -> account_db
billing -> billing_db
billing -> stripe
account_db ~> export "nightly export"

view landscape {
  title "System Architecture"
  include *
}
