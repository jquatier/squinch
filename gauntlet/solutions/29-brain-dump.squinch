pack aws
pack logos

// actors
customer = person "Customer"

// entry points
mobile = sys/smartphone "Mobile App"
website = sys/app-window "Website"

// gateway
gw = aws/api-gateway "API Gateway"

// services
account = aws/lambda "Account Service"
billing = aws/lambda "Billing Service"

// external
stripe = box "Stripe" external

// datastores
account_db = logos/postgres "Account DB" datastore
billing_db = logos/postgres "Billing DB" datastore
export = aws/s3 "Data Export" datastore

// connections
customer -> mobile
customer -> website
mobile -> gw
website -> gw
gw -> account
gw -> billing
account -> account_db "writes"
billing -> billing_db "reads/writes"
billing -> stripe "payment processing"
account_db ~> export "nightly export"

view landscape {
  title "System Overview"
  layout {
    rows [mobile website] [gw] [account billing] [account_db billing_db stripe] [export]
  }
}
