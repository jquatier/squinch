pack aws
pack logos

person customer "Customer"
person data_team "Data Team"

system platform "Platform" {
  gw = aws/api-gateway "API Gateway"

  account = aws/lambda "Account Service" {
    description: "Customer account management"
  }

  billing = aws/lambda "Billing Service" {
    description: "Payment processing and billing"
  }

  account_db = aws/rds "Account DB" datastore {
    subtitle: "Postgres"
  }

  billing_db = aws/rds "Billing DB" datastore {
    subtitle: "Postgres"
  }

  export = aws/s3 "Data Export" {
    description: "Nightly export bucket"
  }

  gw -> account
  gw -> billing
  account -> account_db
  account ~> export "nightly export"
  billing -> billing_db
}

stripe = logos/stripe "Stripe" external

customer -> platform.gw "mobile app / website"
platform.billing -> stripe
platform.export ~> data_team "export access"

view landscape {
  title "System Landscape"
  include *
}
