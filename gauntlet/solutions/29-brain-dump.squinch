pack aws
pack logos

// Actors
customer = person "Customer"

// Entry points
mobile = sys/smartphone "Mobile App"
web = sys/app-window "Website"

// Infrastructure
gw = aws/api-gateway "API Gateway"

// Services
system account "Account Service" {
  svc = sys/code "Account API"
  db = sys/database "Account DB" datastore {
    subtitle: "Postgres"
  }
  export = aws/lambda "Nightly Export"

  svc -> db
  db ~> export "nightly batch"
}

system billing "Billing Service" {
  svc = sys/code "Billing API"
  db = sys/database "Billing DB" datastore {
    subtitle: "Postgres"
  }

  svc -> db
}

// External services
stripe = box "Stripe" external
s3 = aws/s3 "Data Export Bucket" datastore

// Connections
customer -> mobile
customer -> web
mobile -> gw
web -> gw
gw -> account.svc
gw -> billing.svc
billing.svc -> stripe
account.export ~> s3

view landscape {
  title "System Overview"
  layout {
    rows [customer] [mobile web] [gw] [account billing] [stripe s3]
  }
}
