person customer "Customer"
person data_team "Data Team"

mobile  = sys/smartphone "Mobile App"
website = sys/globe "Website"
gw      = sys/router "Gateway"
account = sys/server "Account Service"
billing = sys/server "Billing Service"
main_db = logos/postgres "Main Postgres" datastore
bill_db = logos/postgres "Billing Database" datastore
stripe  = logos/stripe "Stripe" external
export  = aws/s3 "Nightly Export" datastore

customer -> mobile
customer -> website
mobile -> gw
website -> gw
gw -> account
gw -> billing
account -> main_db "writes"
billing -> bill_db
billing -> stripe
main_db ~> export "nightly export"
export ~> data_team

view landscape {
  title "Platform Overview"
  include *
}
