pack aws
pack logos

person customer "Customer"

mobile = sys/smartphone "Mobile App"
web = sys/app-window "Website"
gw = aws/api-gateway "API Gateway"

system account "Account Service" {
  api = aws/lambda "Account API"
  db = sys/database "Main DB" datastore {
    badge: logos/postgres
    subtitle: "PostgreSQL"
  }
  export = aws/lambda "Nightly Export"
  s3 = aws/s3 "Data Export" datastore

  api -> db
  db ~> export "nightly job"
  export -> s3
}

system billing "Billing Service" {
  api = aws/lambda "Billing API"
  db = sys/database "Billing DB" datastore {
    badge: logos/postgres
    subtitle: "PostgreSQL"
  }
  stripe = box "Stripe" external

  api -> db
  api -> stripe "payments"
}

customer -> mobile
customer -> web
mobile -> gw
web -> gw
gw -> account.api
gw -> billing.api

view landscape {
  title "System Landscape"
}
