pack aws
pack logos

// Actors
person customer "Customer"

// Frontend
mobile = sys/smartphone "Mobile App"
web = sys/app-window "Website"

// Backend
gw = aws/api-gateway "API Gateway"
account = aws/lambda "Account Service"
billing = aws/lambda "Billing Service"

// Databases
account_db = logos/postgres "Main Database" datastore
billing_db = logos/postgres "Billing Database" datastore

// External integrations
stripe = box "Stripe" external
s3 = aws/s3 "Data Export" datastore

// Data team
person data_team "Data Team"

// Edges - customer interactions
customer -> mobile
customer -> web

// Frontend to gateway
mobile -> gw
web -> gw

// Gateway to services
gw -> account
gw -> billing

// Service to database
account -> account_db
billing -> billing_db

// Billing to Stripe
billing -> stripe "payment processing"

// Nightly export
account ~> s3 "nightly export"
data_team -> s3
