pack aws
pack logos

person customer "Customer"

mobile = box "Mobile App"
web = box "Website"
gw = aws/api-gateway "API Gateway"

system account "Account Service" {
  api = aws/lambda "Account API"
  db = sys/database "Main Postgres" datastore { badge: logos/postgres }

  api -> db
}

system billing "Billing Service" {
  api = aws/lambda "Billing API"
  db = sys/database "Billing DB" datastore { badge: logos/postgres }
  stripe = box "Stripe" external { badge: logos/stripe }

  api -> db
  api -> stripe
}

export = aws/lambda "Nightly Export"
data_lake = aws/s3 "Data Lake"

customer -> mobile "uses"
customer -> web "uses"
mobile -> gw
web -> gw
gw -> account.api
gw -> billing.api
account.db ~> export "nightly"
export -> data_lake

view landscape {
  title "System Overview"
  include *
  layout {
    rows [customer] [mobile web] [gw] [account billing] [export] [data_lake]
  }
}
