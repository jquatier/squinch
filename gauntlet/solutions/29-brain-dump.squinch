pack aws

person customer "Customer"
person data_team "Data Team"

mobile = sys/smartphone "Mobile App"
web    = sys/browser    "Website"
stripe = logos/stripe   "Stripe" external

system platform "Platform" {
  gw         = aws/api-gateway "Gateway"
  account    = sys/server      "Account Service"
  billing    = sys/server      "Billing Service"
  db         = logos/postgres  "Postgres" datastore
  billing_db = sys/database    "Billing DB" datastore
  export     = aws/s3          "Data Export" datastore

  gw -> account
  gw -> billing
  account -> db
  account ~> export "nightly export"
  billing -> billing_db

  layout { rows [gw] [account billing] [db billing_db export] }
}

customer -> mobile "uses"
customer -> web "uses"
mobile -> platform.gw
web -> platform.gw
platform.billing -> stripe "charge"
platform.export -> data_team "reads"

view landscape {
  title "Platform Overview"
  include *
}
