pack logos

// Customers
person customer "Customer"

// Entry points
mobile = sys/smartphone "Mobile App"
website = sys/app-window "Website"
gw = sys/network "Gateway"

// Services
account = sys/code "Account Service" #core
billing = sys/code "Billing Service" #core

// External systems
stripe = box "Stripe" external

// Data stores
account_db = logos/postgres "Account DB" datastore
billing_db = logos/postgres "Billing DB" datastore
export = aws/s3 "Data Export" datastore

// Connections
customer -> mobile
customer -> website
mobile -> gw
website -> gw
gw -> account
gw -> billing

account -> account_db
billing -> billing_db
billing -> stripe

account ~> export "nightly export"
