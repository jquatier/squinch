pack aws
pack logos

person customer "Customer"

mobile  = sys/smartphone "Mobile App"
website = sys/monitor     "Website"
gw      = aws/api-gateway "Gateway"

account = sys/server   "Account Service"
billing = sys/server   "Billing Service"

account_db = logos/postgres "Main Postgres" datastore
billing_db = logos/postgres "Billing DB" datastore

stripe = box "Stripe" external
export = aws/s3 "Data Export" datastore

customer -> mobile
customer -> website

mobile  -> gw
website -> gw

gw -> account
gw -> billing

account -> account_db
billing -> billing_db

billing -> stripe

account ~> export "nightly export"
