pack aws
pack logos

// Customers
person mobile_user "Mobile Customer"
person web_user "Web Customer"

// Gateway
gw = aws/api-gateway "API Gateway"

// Services
account = aws/lambda "Account Service"
billing = aws/lambda "Billing Service"

// Datastores
account_db = logos/postgres "Main Postgres" datastore
billing_db = logos/postgres "Billing DB" datastore
export_bucket = aws/s3 "Data Export" datastore

// External
stripe = box "Stripe" external

// Connections
mobile_user -> gw
web_user -> gw

gw -> account
gw -> billing

account -> account_db "write"
billing -> billing_db

billing -> stripe "payment processing"

account_db ~> export_bucket "nightly export"

view landscape {
  title "System Overview"
  include *
}
