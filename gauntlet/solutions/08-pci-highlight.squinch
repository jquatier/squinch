pack aws

system payments "Payments Service" {
  description: "Payment processing and settlement"

  api = aws/lambda "API Handler"
  tokenizer = aws/lambda "Tokenizer" #pci
  vault = aws/dynamodb "Card Vault" datastore #pci
  queue = aws/sqs "Settlement Queue"
  worker = aws/lambda "Settlement Worker" #pci

  api -> tokenizer
  tokenizer -> vault
  api ~> queue
  queue ~> worker
  worker -> vault
}

view payments {
  title "Payments Service - PCI Scope"
  highlight #pci
  note top-right "Card tokens stored in Card Vault DynamoDB table" { style: warning }
}
