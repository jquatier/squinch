pack aws

system payments "Payments Service" {
  description: "Card payment processing"
  glyph: sys/lock

  api = aws/lambda "API Handler" {
    tags: #pci
  }
  tokenizer = aws/lambda "Tokenizer" {
    description: "Tokenizes card data"
    tags: #pci
  }
  vault = aws/dynamodb "Card Vault" datastore {
    description: "Encrypted card tokens"
    tags: #pci
  }
  queue = aws/sqs "Settlement Queue"
  worker = aws/lambda "Settlement Worker"

  api -> tokenizer
  tokenizer -> vault
  tokenizer ~> queue
  queue ~> worker
}

view payments {
  scope payments
  highlight #pci
  note right-of vault "Tokens stored encrypted at rest" { style: warning }
  show descriptions
}
