pack aws

system payments "Payments Service" {
  description: "Card payment processing and settlement"
  icon: aws/lambda

  api = aws/api-gateway "Payment API"
  tokenizer = aws/lambda "Tokenizer" {
    description: "Tokenizes card data"
    subtitle: "Lambda · Node 20"
    tags: #pci
  }
  vault = aws/dynamodb "Card Vault" datastore {
    description: "Encrypted card tokens"
    tags: #pci
  }
  queue = aws/sqs "Settlement Queue" {
    description: "Pending settlements"
    tags: #pci
  }
  worker = aws/lambda "Settlement Worker" {
    description: "Processes settlements"
    subtitle: "Lambda · Node 20"
    tags: #pci
  }

  api -> tokenizer "tokenize card"
  tokenizer -> vault "store token"
  tokenizer ~> queue "queue settlement"
  queue ~> worker "drain"

  layout {
    rows [api] [tokenizer] [vault queue] [worker]
  }
}

view payments {
  title "Payments Service"
  highlight #pci
  note right-of vault "Card tokens stored encrypted; see security-compliance.md" {
    style: warning
  }
}
