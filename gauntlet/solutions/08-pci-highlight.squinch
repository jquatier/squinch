pack aws

system payments "Payments Service" {
  api   = aws/lambda "Payments API" { tags: #pci }
  token = aws/lambda "Tokenizer" { tags: #pci }
  vault = aws/dynamodb "Card Vault" datastore { tags: #pci }
  queue = aws/sqs "Settlement Queue"
  worker = aws/lambda "Settlement Worker"

  api -> token
  token -> vault
  api ~> queue
  queue ~> worker
}

view payments {
  title "Payments Service"
}

view pci {
  title "PCI surface"
  scope payments
  highlight #pci
  note right-of vault "Tokens are stored in the Card Vault (DynamoDB)"
}
