pack aws

system payments "Payment Service" {
  description: "Payment processing and settlement"
  tags: #core

  api = aws/lambda "API Handler" {
    tags: #pci
  }
  tokenizer = aws/lambda "Tokenizer" {
    description: "Tokenizes card data"
    tags: #pci
  }
  vault = aws/dynamodb "Card Vault" datastore {
    description: "Stores tokenized cards"
    tags: #pci
  }
  queue = aws/sqs "Settlement Queue"
  worker = aws/lambda "Settlement Worker"

  api -> tokenizer
  tokenizer -> vault
  api ~> queue
  queue ~> worker
}

view payments {
  scope payments
  highlight #pci
  note top-right "Card tokens are stored in the DynamoDB vault after tokenization" { style: warning }
  show descriptions
  legend auto
}
