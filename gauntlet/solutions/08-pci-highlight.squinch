pack aws

system payments "Payment Service" {
  description: "Card payment processing and settlement"
  icon: aws/lambda

  api = aws/lambda "API Handler" {
    description: "Receives payment requests"
  }

  tokenizer = aws/lambda "Tokenizer" {
    description: "Tokenizes card data"
    tags: #pci
  }

  vault = aws/dynamodb "Card Vault" datastore {
    description: "Encrypted card tokens"
    tags: #pci
  }

  queue = aws/sqs "Settlement Queue" {
    description: "Pending settlements"
  }

  worker = aws/lambda "Settlement Worker" {
    description: "Processes settlements"
    tags: #pci
  }

  api -> tokenizer "card data"
  tokenizer -> vault "store token"
  tokenizer ~> queue "settlement request"
  queue ~> worker "drain"
  worker -> vault "retrieve token"
}

view payments {
  title "Payment Service Architecture"
  highlight #pci
  note right-of vault "Card tokens encrypted at rest; PCI DSS scope" {
    style: warning
  }
  legend auto
}
