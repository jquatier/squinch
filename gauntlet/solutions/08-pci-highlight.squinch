pack aws

system payments "Payments Service" {
  description: "Payment processing and settlement"
  glyph: sys/lock

  api = aws/lambda "API Handler"
  tokenizer = aws/lambda "Tokenizer" {
    description: "Tokenizes card data"
    tags: #pci
  }
  vault = aws/dynamodb "Card Vault" datastore {
    description: "Stores tokenized cards"
    tags: #pci
  }
  queue = aws/sqs "Settlement Queue"
  worker = aws/lambda "Settlement Worker"

  api -> tokenizer
  tokenizer -> vault
  tokenizer ~> queue "enqueue settlement"
  queue ~> worker
}

view payments {
  title "Payments Service - PCI Scope"
  highlight #pci
  note top-right "Tokens are stored in the Card Vault; raw card data never persists" { style: warning }
  show descriptions
  legend auto
  titleblock {
    version: "2026-07"
    owner: team-payments
  }
}
