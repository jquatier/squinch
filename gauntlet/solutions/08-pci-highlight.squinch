pack aws

system payments "Payments" {
  api    = aws/lambda   "Payments API" { tags: #pci }
  tok    = aws/lambda   "Tokenizer" { tags: #pci }
  vault  = aws/dynamodb "Card Vault" {
    description: "Tokens only; PAN never stored"
    tags: #pci
  }
  queue  = aws/sqs    "Settlement Queue"
  worker = aws/lambda "Settlement Worker"

  api -> tok "tokenize card"
  tok -> vault "store token"
  api ~> queue "enqueue settlement"
  queue ~> worker
  worker -> vault "mark settled"
}

view payments {
  layout {
    rows [api] [tok queue] [vault worker]
  }
}

view payments-pci {
  scope payments
  title "PCI Surface"
  highlight #pci
  show descriptions
  note right-of vault "Tokens live here; issuer keys are in KMS"
}
