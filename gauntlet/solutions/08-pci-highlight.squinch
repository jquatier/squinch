pack aws

system payments "Payments Service" {
  description: "Payment processing and settlement"

  api = aws/lambda "API Handler"
  tokenizer = aws/lambda "Tokenizer" {
    tags: #pci
  }
  vault = aws/dynamodb "Card Vault" datastore {
    tags: #pci
  }
  queue = aws/sqs "Settlement Queue"
  worker = aws/lambda "Settlement Worker"

  api -> tokenizer {
    tags: #pci
  }
  tokenizer -> vault {
    tags: #pci
  }
  api ~> queue
  queue ~> worker
}

view payments {
  highlight #pci
  note top-right "Tokens are stored encrypted in the Card Vault DynamoDB table"
}
