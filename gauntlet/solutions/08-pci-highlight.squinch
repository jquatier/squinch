pack aws

system payments "Payment Service" {
  description: "Card payment processing"

  api = aws/lambda "API Handler" #pci
  tokenizer = aws/lambda "Card Tokenizer" #pci
  vault = aws/dynamodb "Card Vault" datastore #pci
  queue = aws/sqs "Settlement Queue"
  settlement = aws/lambda "Settlement Worker"

  api -> tokenizer
  tokenizer -> vault
  api ~> queue "payment events"
  queue ~> settlement
}

view payments {
  title "Payment Service Architecture"
}

view pci_surface {
  title "PCI Compliance Surface"
  scope payments
  highlight #pci
  note top-right "Card tokens are stored encrypted in the vault" { style: warning }
}
