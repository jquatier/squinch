pack aws

system payments "Payments Service" {
  description: "Card processing and settlement"
  glyph: sys/lock

  api = aws/lambda "API Handler" #pci
  tokenizer = aws/lambda "Tokenizer" #pci
  vault = aws/dynamodb "Card Vault" datastore #pci
  queue = aws/sqs "Settlement Queue"
  worker = aws/lambda "Settlement Worker"

  api -> tokenizer
  tokenizer -> vault
  tokenizer ~> queue
  queue ~> worker
}

view payments {
  highlight #pci
  note right-of vault "Tokens stored here; card data encrypted at rest" { style: warning }
  titleblock {
    version: "2026-08"
    owner: team-payments
  }
}
