pack aws

system payments "Payment Service" {
  description: "PCI-compliant payment processing"

  api = aws/lambda "Payment API" {
    description: "Accepts payment requests"
  }

  tokenizer = aws/lambda "Card Tokenizer" #pci {
    description: "Tokenizes card data"
    subtitle: "Lambda · Node 20"
  }

  vault = aws/dynamodb "Card Vault" datastore #pci {
    description: "Encrypted token storage"
  }

  queue = aws/sqs "Settlement Queue" #pci {
    description: "Async settlement processing"
  }

  worker = aws/lambda "Settlement Worker" #pci {
    description: "Processes settlements"
    subtitle: "Lambda · Python 3.12"
  }

  api -> tokenizer "tokenize card"
  tokenizer -> vault "store token"
  tokenizer ~> queue "settlement event"
  queue ~> worker "process"
}

view payments {
  title "Payment Service Architecture"
  highlight #pci
  note right-of vault "Tokens stored encrypted at rest; keys in KMS" {
    style: warning
  }
  legend auto
}
