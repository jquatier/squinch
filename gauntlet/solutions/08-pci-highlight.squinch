pack aws

system payments "Payment Service" {
  description: "Card payment processing"
  glyph: sys/lock

  api = aws/lambda "API Handler" {
    description: "Payment API endpoint"
    tags: #pci
  }

  tokenizer = aws/lambda "Tokenizer" {
    description: "Card tokenization"
    tags: #pci
  }

  vault = aws/dynamodb "Card Vault" datastore {
    description: "Encrypted card tokens"
    tags: #pci
  }

  queue = aws/sqs "Settlement Queue" {
    description: "Payment settlement events"
  }

  worker = aws/lambda "Settlement Worker" {
    description: "Process settlements"
  }

  api -> tokenizer "tokenize card"
  tokenizer -> vault "store token"
  api ~> queue "settlement event"
  queue ~> worker
}

view payments {
  scope payments
  highlight #pci
  note top-right "Tokens are stored encrypted in the Card Vault DynamoDB table" { style: warning }
  show descriptions
}
