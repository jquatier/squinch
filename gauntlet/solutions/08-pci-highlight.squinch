pack aws

person customer "Customer"

system payments "Payments Service" {
  api       = aws/lambda   "API" {
    subtitle: "Lambda"
    tags: #pci
  }
  tokenizer = aws/lambda   "Tokenizer" {
    subtitle: "Lambda"
    tags: #pci
  }
  vault     = aws/dynamodb "Card Vault" datastore {
    tags: #pci
  }
  queue     = aws/sqs      "Settlement Queue"
  worker    = aws/lambda   "Settlement Worker" {
    subtitle: "Lambda"
  }

  api -> tokenizer
  tokenizer -> vault
  api ~> queue "settlement event"
  queue ~> worker
}

customer -> payments.api "submits payment"

view pci {
  title "PCI Surface"
  scope payments
  highlight #pci
  note right-of vault "Tokens stored here — raw card data never leaves the API and Tokenizer"
  legend auto
}
