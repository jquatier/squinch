pack aws

system payments "Payment Service" {
  description: "Card payment processing"
  tags: #core

  api = aws/lambda "API Handler"
  tokenizer = aws/lambda "Tokenizer" {
    description: "Tokenizes card data"
    tags: #pci
  }
  vault = aws/dynamodb "Card Vault" datastore {
    description: "Encrypted token storage"
    tags: #pci
  }
  queue = aws/sqs "Settlement Queue" {
    tags: #pci
  }
  worker = aws/lambda "Settlement Worker" {
    description: "Processes settlements"
    tags: #pci
  }

  api -> tokenizer
  tokenizer -> vault
  tokenizer ~> queue
  queue ~> worker
}

view payments {
  scope payments
  highlight #pci
  note top-right "Tokens stored in Card Vault (DynamoDB)" { style: warning }
}
