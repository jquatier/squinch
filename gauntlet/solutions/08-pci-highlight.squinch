pack aws

system payments "Payment Service" {
  description: "Card processing, tokenization, and settlement"

  api       = aws/lambda    "Payment API" #pci {
    subtitle: "Lambda · Node 20"
    description: "Receives payment requests with card data"
  }

  tokenizer = aws/lambda    "Tokenizer" #pci {
    subtitle: "Lambda · Node 20"
    description: "Tokenizes card data"
  }

  vault     = aws/dynamodb  "Card Vault" datastore #pci {
    subtitle: "DynamoDB"
    description: "Encrypted token-to-card mapping"
  }

  queue     = aws/sqs       "Settlement Queue" {
    subtitle: "SQS FIFO"
    description: "Settlement requests with tokens"
  }

  worker    = aws/lambda    "Settlement Worker" {
    subtitle: "Lambda · Node 20"
    description: "Processes settlements"
  }

  api       -> tokenizer "card data"
  tokenizer -> vault     "store token"
  tokenizer ~> queue     "settlement request"
  queue     ~> worker
}

view payments {
  title "Payment Service"
}

view pci_surface {
  title "PCI Compliance Surface"
  scope payments
  highlight #pci
  note right-of vault "Tokens stored encrypted at rest; card data never persisted in plain text" {
    style: warning
  }
}
