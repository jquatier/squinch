// Payments service with PCI compliance highlighting
pack aws

system payments "Payments Service" {
  description: "Card processing and settlement"
  glyph: sys/lock
  tags: #core

  api = aws/lambda "API Handler" {
    description: "Payment requests"
  }

  tokenizer = aws/lambda "Tokenizer" {
    description: "Tokenizes card data"
    tags: #pci
  }

  vault = aws/dynamodb "Card Vault" datastore {
    description: "Encrypted tokens"
    tags: #pci
  }

  queue = aws/sqs "Settlement Queue" {
    tags: #pci
  }

  worker = aws/lambda "Settlement Worker" {
    description: "Processes settlements"
    tags: #pci
  }

  api -> tokenizer
  tokenizer -> vault { tags: #pci }
  tokenizer ~> queue { tags: #pci }
  queue ~> worker { tags: #pci }
}

view payments {
  scope payments
  highlight #pci
  note right-of vault "Tokens stored encrypted at rest"
  show descriptions
}
