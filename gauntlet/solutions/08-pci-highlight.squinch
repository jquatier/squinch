pack aws

system payments "Payments Service" {
  api       = aws/lambda   "Payments API" #pci
  tokenizer = aws/lambda   "Tokenizer" #pci
  vault     = aws/dynamodb "Card Vault" datastore #pci
  queue     = aws/sqs      "Settlement Queue"
  worker    = aws/lambda   "Settlement Worker"

  api -> tokenizer
  tokenizer -> vault "stores tokens"
  api ~> queue
  queue ~> worker "drains"
}

view landscape {
  title "Payments Service"
  include *
}

view pci {
  title "PCI surface"
  scope payments
  highlight #pci
  note right-of vault "Tokens are stored in the Card Vault (DynamoDB)"
  legend auto
}
