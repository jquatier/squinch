pack aws

system payments "Payment Service" {
  description: "Payment processing and tokenization"
  glyph: sys/lock

  api = aws/lambda "API Handler"
  tokenizer = aws/lambda "Card Tokenizer" {
    description: "Tokenizes card data"
    tags: #pci
  }
  vault = aws/dynamodb "Card Vault" datastore {
    description: "Stores tokenized cards"
    tags: #pci
  }
  queue = aws/sqs "Settlement Queue"
  settlement = aws/lambda "Settlement Worker" {
    tags: #pci
  }

  api -> tokenizer
  tokenizer -> vault
  api ~> queue
  queue ~> settlement
}

view payments {
  highlight #pci
  note top-right "Card tokens are stored in the Card Vault (DynamoDB)" { style: warning }
}
