pack aws

system payments "Payments Service" {
  description: "Payment processing and card tokenization"
  tags: #core

  api = aws/lambda "API Handler"
  tokenizer = aws/lambda "Tokenizer" {
    description: "Tokenizes card data"
    tags: #pci
  }
  vault = aws/dynamodb "Card Vault" datastore {
    description: "Encrypted card tokens"
    tags: #pci
  }
  queue = aws/sqs "Settlement Queue"
  worker = aws/lambda "Settlement Worker"

  api -> tokenizer {
    tags: #pci
  }
  tokenizer -> vault {
    tags: #pci
  }
  api ~> queue
  queue ~> worker
}

view payments {
  scope payments
  highlight #pci
  note top-right "Card tokens stored in encrypted DynamoDB vault" { style: warning }
}
