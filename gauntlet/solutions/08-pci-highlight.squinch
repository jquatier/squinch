pack aws

system payments "Payments Service" {
  description: "Payment processing with card tokenization"

  api = aws/lambda "API Handler" {
    subtitle: "Lambda · Node 20"
    description: "Processes payment requests"
  }

  tokenizer = aws/lambda "Tokenizer" {
    subtitle: "Lambda · Node 20"
    description: "Tokenizes card data"
    tags: #pci
  }

  vault = aws/dynamodb "Card Vault" datastore {
    description: "Stores tokenized card data"
    tags: #pci
  }

  queue = aws/sqs "Settlement Queue" {
    description: "Settlement events"
    tags: #pci
  }

  worker = aws/lambda "Settlement Worker" {
    subtitle: "Lambda · Node 20"
    description: "Processes settlements"
    tags: #pci
  }

  api -> tokenizer "tokenize card"
  tokenizer -> vault "store token" { tags: #pci }
  tokenizer ~> queue "settlement event"
  queue ~> worker
}

view payments {
  title "Payments Service"
  highlight #pci
  note top-right "PCI Scope: Tokenizer, vault, queue, and settlement worker. Tokens are stored in the DynamoDB vault table." { style: warning }
  legend auto
}
