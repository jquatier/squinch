pack aws

system payments "Payments Service" {
  api       = aws/lambda   "Payments API"   { tags: #pci }
  tokenizer = aws/lambda   "Tokenizer"      { tags: #pci }
  vault     = aws/dynamodb "Card Vault"     datastore #pci
  queue     = aws/sqs      "Settlement Queue"
  worker    = aws/lambda   "Settlement Worker"

  api -> tokenizer "card details"
  tokenizer -> vault "stores card data"
  api ~> queue "settlement request"
  queue ~> worker
}

view payments {
  title "Payments Service"
}

view pci {
  title "PCI Surface"
  scope payments
  highlight #pci
  note right-of payments.vault "Tokens are stored in the Card Vault (DynamoDB)"
}
