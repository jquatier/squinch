pack aws

system payments "Payments Service" {
  description: "Card intake, tokenization and settlement"

  api   = aws/lambda   "Payments API" {
    subtitle: "Lambda"
    tags: #pci
  }
  tok   = aws/lambda   "Tokenizer" {
    subtitle: "Lambda"
    tags: #pci
  }
  vault = aws/dynamodb "Card Vault" datastore {
    subtitle: "DynamoDB"
    tags: #pci
  }
  queue  = aws/sqs     "Settlement Queue"
  worker = aws/lambda  "Settlement Worker" {
    subtitle: "Queue consumer"
  }

  api -> tok "card data"
  tok -> vault "stores token"
  api ~> queue "settlement request"
  queue ~> worker "drains"
}

view landscape {
  title "Payments Service"
  include *
  expand payments
}

view pci {
  title "PCI surface"
  scope payments
  highlight #pci
  note right-of vault "Tokens are stored in the Card Vault (DynamoDB)"
  legend {
    ->  "Request"
    ~>  "Event"
  }
}
