pack aws

system payments "Payment Service" {
  description: "Processes payments and tokenizes card data"

  api = aws/lambda "API Handler" #pci
  tokenizer = aws/lambda "Tokenizer" #pci
  vault = aws/dynamodb "Card Vault" datastore #pci
  queue = aws/sqs "Settlement Queue"
  worker = aws/lambda "Settlement Worker"

  api -> tokenizer "tokenize card"
  tokenizer -> vault "store token"
  api ~> queue "enqueue settlement"
  queue ~> worker "process settlement"
}

view payments {
  highlight #pci
  note right-of vault "Tokens stored encrypted in DynamoDB" { style: warning }
}
