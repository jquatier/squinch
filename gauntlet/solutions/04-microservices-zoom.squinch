pack aws

// API Gateway
gw = aws/api-gateway "API Gateway"

// Catalog Service
system catalog "Catalog Service" {
  description: "Product catalog and inventory management"
  icon: aws/lambda

  api = aws/lambda "Catalog API"
  db = aws/dynamodb "Catalog DB" datastore

  api -> db
}

// Checkout Service
system checkout "Checkout Service" {
  description: "Order processing and cart management"
  icon: aws/lambda

  api = aws/lambda "Checkout API"
  db = aws/dynamodb "Checkout DB" datastore

  api -> db
}

// Identity Service
system identity "Identity Service" {
  description: "User authentication and authorization"
  icon: aws/lambda

  api = aws/lambda "Identity API"
  db = aws/dynamodb "Identity DB" datastore

  api -> db
}

// Connections from gateway to services
gw -> catalog.api
gw -> checkout.api
gw -> identity.api

// Views
view landscape {
  title "Microservices Landscape"
  include *
}

view checkout {
  title "Checkout Service Detail"
}
