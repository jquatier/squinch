pack aws

// API Gateway entry point
gw = aws/api-gateway "API Gateway"

// Catalog Service
system catalog "Catalog Service" {
  description: "Product catalog and inventory"
  glyph: sys/database

  api = aws/lambda "Catalog API"
  db = aws/dynamodb "Catalog DB" datastore

  api -> db
}

// Checkout Service
system checkout "Checkout Service" {
  description: "Order processing and payment"
  glyph: sys/code

  api = aws/lambda "Checkout API"
  db = aws/dynamodb "Checkout DB" datastore

  api -> db
}

// Identity Service
system identity "Identity Service" {
  description: "Authentication and authorization"
  glyph: sys/lock

  api = aws/lambda "Identity API"
  db = aws/dynamodb "Identity DB" datastore

  api -> db
}

// Gateway routes to each service
gw -> catalog.api
gw -> checkout.api
gw -> identity.api

// Landscape view showing all services
view landscape {
  title "Microservices Architecture"
  include *
}

// Zoomed view of checkout service
view checkout {
  scope checkout
}
