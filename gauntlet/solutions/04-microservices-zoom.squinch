pack aws

gw = aws/api-gateway "API Gateway"

system catalog "Catalog Service" {
  description: "Product listings and search"
  api = aws/lambda   "Catalog API" { subtitle: "Lambda" }
  db  = aws/dynamodb "Catalog Table" datastore
  api -> db
}

system checkout "Checkout Service" {
  description: "Cart and order placement"
  api = aws/lambda   "Checkout API" { subtitle: "Lambda" }
  db  = aws/dynamodb "Orders Table" datastore
  api -> db
}

system identity "Identity Service" {
  description: "Auth and user accounts"
  api = aws/lambda   "Identity API" { subtitle: "Lambda" }
  db  = aws/dynamodb "Users Table" datastore
  api -> db
}

gw -> catalog.api
gw -> checkout.api
gw -> identity.api

view landscape {
  title "System Landscape"
  include *
}

view checkout {
  title "Checkout Service"
  scope checkout
}
