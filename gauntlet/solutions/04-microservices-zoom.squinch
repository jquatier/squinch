pack aws

gw = aws/api-gateway "API Gateway"

system catalog "Catalog" {
  description: "Product browsing and search"
  glyph: sys/search
  api = aws/lambda   "Catalog API"
  db  = aws/dynamodb "Products"
  api -> db
}

system checkout "Checkout" {
  description: "Carts, orders, payment hand-off"
  glyph: sys/api
  api = aws/lambda "Checkout API"
  db  = aws/aurora "Orders"
  api -> db
}

system identity "Identity" {
  description: "Sign-in and profiles"
  glyph: sys/auth
  api = aws/lambda   "Identity API"
  db  = aws/dynamodb "Accounts"
  api -> db
}

gw -> catalog.api  "browse"
gw -> checkout.api "checkout"
gw -> identity.api "auth"
checkout.api -> identity.api "verify session"

view landscape {
  title "Services Landscape"
  include *
}

view checkout {
  title "Checkout Service"
}
