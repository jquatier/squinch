pack aws

person user "User"
gw = aws/api-gateway "API Gateway"

system catalog "Catalog Service" {
  description: "Product browsing and search"
  glyph: sys/database

  api = aws/lambda "Catalog API"
  db = aws/dynamodb "Product Database" datastore

  api -> db
}

system checkout "Checkout Service" {
  description: "Cart and order processing"
  glyph: sys/workflow

  api = aws/lambda "Checkout API"
  db = aws/dynamodb "Orders Database" datastore

  api -> db
}

system identity "Identity Service" {
  description: "Authentication and authorization"
  glyph: sys/shield

  api = aws/lambda "Identity API"
  db = aws/dynamodb "Users Database" datastore

  api -> db
}

user -> gw
gw -> catalog.api
gw -> checkout.api
gw -> identity.api

view landscape {
  title "Microservices Landscape"
  include *
  show descriptions
}

view checkout {
  scope checkout
  show descriptions
}
