pack aws

person customer "Customer"

gw = aws/api-gateway "API Gateway"

system catalog "Catalog Service" {
  description: "Product browsing and search"
  glyph: sys/database

  api = aws/lambda "Catalog API"
  db = aws/dynamodb "Catalog DB" datastore

  api -> db
}

system checkout "Checkout Service" {
  description: "Shopping cart and orders"
  glyph: sys/code

  api = aws/lambda "Checkout API"
  db = aws/dynamodb "Orders DB" datastore

  api -> db
}

system identity "Identity Service" {
  description: "Authentication and user profiles"
  glyph: sys/lock

  api = aws/lambda "Identity API"
  db = aws/dynamodb "Users DB" datastore

  api -> db
}

customer -> gw "browse and order"
gw -> catalog.api
gw -> checkout.api
gw -> identity.api

view landscape {
  title "System Landscape"
  include *
}

view checkout {
  scope checkout
  show descriptions
}
