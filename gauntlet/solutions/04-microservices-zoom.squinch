pack aws

// API Gateway
gw = aws/api-gateway "API Gateway"

// Catalog service
system catalog "Catalog Service" {
  description: "Product catalog and inventory"
  glyph: sys/database

  api = aws/lambda "Catalog API"
  db = aws/dynamodb "Catalog DB" datastore

  api -> db
}

// Checkout service
system checkout "Checkout Service" {
  description: "Shopping cart and order processing"
  glyph: sys/code

  api = aws/lambda "Checkout API"
  db = aws/dynamodb "Checkout DB" datastore

  api -> db
}

// Identity service
system identity "Identity Service" {
  description: "User authentication and authorization"
  glyph: sys/lock

  api = aws/lambda "Identity API"
  db = aws/dynamodb "Identity DB" datastore

  api -> db
}

// Connections from gateway to services
gw -> catalog.api
gw -> checkout.api
gw -> identity.api

// Landscape view
view landscape {
  title "Microservices Landscape"
  include *
  show descriptions
}

// Zoomed view of checkout service
view checkout {
  scope checkout
  show descriptions
}
