pack aws

gw = aws/api-gateway "API Gateway"

system catalog "Catalog Service" {
  description: "Product listings and search"
  api = aws/lambda "Catalog API"
  db = aws/dynamodb "Products" datastore

  api -> db
}

system checkout "Checkout Service" {
  description: "Shopping cart and order processing"
  api = aws/lambda "Checkout API"
  db = aws/dynamodb "Orders" datastore

  api -> db
}

system identity "Identity Service" {
  description: "User authentication and authorization"
  api = aws/lambda "Identity API"
  db = aws/dynamodb "Users" datastore

  api -> db
}

gw -> catalog.api
gw -> checkout.api
gw -> identity.api

view landscape {
  title "Microservices Landscape"
  include *
}

view checkout {
  title "Checkout Service Detail"
}
