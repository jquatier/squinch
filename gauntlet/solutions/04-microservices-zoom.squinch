pack aws

// API Gateway
gw = aws/api-gateway "API Gateway"

// Catalog Service
system catalog "Catalog Service" {
  description: "Product search and browsing"
  glyph: sys/database

  api = aws/lambda "Catalog API"
  db = aws/dynamodb "Catalog DB" datastore

  api -> db
}

// Checkout Service
system checkout "Checkout Service" {
  description: "Shopping cart and order processing"
  glyph: sys/code

  api = aws/lambda "Checkout API"
  db = aws/dynamodb "Orders DB" datastore

  api -> db
}

// Identity Service
system identity "Identity Service" {
  description: "Authentication and user management"
  glyph: sys/shield

  api = aws/lambda "Identity API"
  db = aws/dynamodb "Users DB" datastore

  api -> db
}

// Gateway routes to all services
gw -> catalog.api
gw -> checkout.api
gw -> identity.api

// Landscape view
view landscape {
  title "Microservices Landscape"
  include *
}

// Checkout service zoomed view
view checkout {
  scope checkout
  title "Checkout Service Detail"
}
