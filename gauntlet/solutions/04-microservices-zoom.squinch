pack aws

// API Gateway
gateway = aws/api-gateway "API Gateway"

// Catalog Service
system catalog "Catalog Service" {
  description: "Product search and browsing"
  glyph: sys/database

  api = aws/lambda "Catalog API"
  db = aws/dynamodb "Catalog DB" datastore

  api -> db
}

// Checkout Service
system checkout "Checkout Service" {
  description: "Order processing and payment"
  glyph: sys/code

  api = aws/lambda "Checkout API"
  db = aws/dynamodb "Orders DB" datastore

  api -> db
}

// Identity Service
system identity "Identity Service" {
  description: "Authentication and authorization"
  glyph: sys/shield

  api = aws/lambda "Identity API"
  db = aws/dynamodb "Users DB" datastore

  api -> db
}

// Gateway connections to services
gateway -> catalog.api
gateway -> checkout.api
gateway -> identity.api

// Landscape view showing all systems
view landscape {
  title "System Landscape"
  include *
}

// Zoomed view of checkout service
view checkout {
  scope checkout
  show descriptions
}
