pack aws

person customer "Customer"
gw = aws/api-gateway "API Gateway"

system catalog "Catalog Service" {
  description: "Product browsing and search"
  glyph: sys/search

  api = aws/lambda "Catalog API"
  db = aws/dynamodb "Product Catalog" datastore

  api -> db
}

system checkout "Checkout Service" {
  description: "Shopping cart and orders"
  glyph: sys/package

  api = aws/lambda "Checkout API"
  db = aws/dynamodb "Orders" datastore

  api -> db
}

system identity "Identity Service" {
  description: "Authentication and users"
  glyph: sys/user

  api = aws/lambda "Identity API"
  db = aws/dynamodb "Users" datastore

  api -> db
}

customer -> gw "browse and purchase"
gw -> catalog.api
gw -> checkout.api
gw -> identity.api

view landscape {
  title "System Landscape"
  include *
}

view checkout {
  scope checkout
  expand checkout
}
