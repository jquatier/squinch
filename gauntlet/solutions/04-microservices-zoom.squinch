pack aws

// API Gateway
gw = aws/api-gateway "API Gateway"

// Catalog Service
system catalog "Catalog Service" {
  description: "Product listings and search"
  glyph: sys/database

  api = aws/lambda "Catalog API"
  db = aws/dynamodb "Catalog DB" datastore

  api -> db
}

// Checkout Service
system checkout "Checkout Service" {
  description: "Cart and order processing"
  glyph: sys/workflow

  api = aws/lambda "Checkout API"
  db = aws/dynamodb "Orders DB" datastore

  api -> db
}

// Identity Service
system identity "Identity Service" {
  description: "Authentication and user management"
  glyph: sys/shield

  api = aws/lambda "Identity API"
  db = aws/dynamodb "Users DB" datastore

  api -> db
}

// Gateway connections to services
gw -> catalog.api
gw -> checkout.api
gw -> identity.api

// Landscape view
view landscape {
  title "Microservices Landscape"
  include *
}

// Zoomed view of checkout service
view checkout {
  scope checkout
  show descriptions
}
