pack aws

gw = aws/api-gateway "API Gateway"

system catalog "Catalog" {
  description: "Product listings and search"
  api = aws/lambda "Catalog API"
  db  = sys/database "Catalog DB" datastore
  api -> db
}

system checkout "Checkout" {
  description: "Carts, payment and order placement"
  api = aws/lambda "Checkout API"
  db  = sys/database "Checkout DB" datastore
  api -> db
}

system identity "Identity" {
  description: "Accounts, sign-in and sessions"
  api = aws/lambda "Identity API"
  db  = sys/database "Identity DB" datastore
  api -> db
}

gw -> catalog.api
gw -> checkout.api
gw -> identity.api

view landscape {
  title "Microservices Landscape"
  include *
}

view checkout {
  title "Checkout Service"
  scope checkout
}
