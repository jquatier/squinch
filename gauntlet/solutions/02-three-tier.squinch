pack aws

person user "User"

alb   = aws/elastic-load-balancing "Application Load Balancer"
app   = aws/fargate "Web Service" { subtitle: "ECS · Fargate" }
db    = aws/aurora "Aurora Database" datastore
cache = aws/elasticache "Cache" datastore

user -> alb
alb -> app
app -> db
app -> cache

view landscape {
  title "Three-Tier Web App"
  include *
}
