pack aws

person user "User"

alb   = aws/elastic-load-balancing "Application Load Balancer"
app   = aws/ecs                    "ECS (Fargate)" {
  description: "Application service"
}
cache = aws/elasticache            "ElastiCache" datastore
db    = aws/aurora                 "Aurora Database" datastore

user -> alb "requests"
alb -> app
app -> cache "read/write"
app -> db "read/write"
