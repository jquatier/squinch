pack aws

person user "User"

alb   = aws/elastic-load-balancing "Application Load Balancer"
app   = aws/ecs                    "Web Service" { subtitle: "ECS Fargate" }
cache = aws/elasticache            "Cache" datastore { subtitle: "Redis" }
db    = aws/aurora                 "Database" datastore { subtitle: "Aurora" }

user -> alb "HTTPS"
alb  -> app
app  -> cache
app  -> db
