pack aws

person user "User"

alb   = aws/elastic-load-balancing "Application Load Balancer"
app   = aws/ecs                    "Web Application" {
  subtitle: "ECS · Fargate"
}
cache = aws/elasticache            "Session Cache" datastore
db    = aws/aurora                 "Database" datastore

user -> alb "requests"
alb  -> app
app  -> cache "read/write sessions"
app  -> db    "read/write data"
