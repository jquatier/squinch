pack aws

person user "User"

system app "Three-Tier Web App" {
  alb   = aws/elastic-load-balancing "Load Balancer"
  svc   = aws/fargate               "App Service" {
    subtitle: "ECS on Fargate"
  }
  db    = aws/aurora     "Database" datastore
  cache = aws/elasticache "Cache" datastore

  alb -> svc
  svc -> db
  svc -> cache
}

user -> app.alb "requests"
