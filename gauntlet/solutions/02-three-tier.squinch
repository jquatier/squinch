pack aws

person user "User"

system app "Three-Tier Web App" {
  description: "Classic three-tier web app"

  alb    = aws/elb          "Application Load Balancer"
  svc    = aws/fargate      "ECS Service" {
    subtitle: "ECS · Fargate"
  }
  db     = aws/aurora       "Orders DB" datastore
  cache  = aws/elasticache  "Session Cache" datastore

  alb -> svc
  svc -> db
  svc -> cache
}

user -> app.alb "browses"
