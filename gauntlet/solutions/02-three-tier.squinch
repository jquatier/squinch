pack aws

person user "User"

alb   = aws/elastic-load-balancing "Application Load Balancer"
app   = aws/fargate "Web Application"
cache = aws/elasticache "Cache"
db    = aws/aurora "Database" datastore

user -> alb
alb -> app
app -> cache
app -> db

view default {
  layout {
    rows [user] [alb] [app cache] [db]
    place cache right-of app
  }
}
