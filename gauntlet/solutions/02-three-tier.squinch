// Classic three-tier web application architecture
pack aws

person user "User"

alb = aws/elastic-load-balancing "Application Load Balancer"
app = aws/fargate "ECS Service" {
  description: "Fargate containers"
}
cache = aws/elasticache "ElastiCache" {
  description: "Session and query cache"
  tags: #datastore
}
db = aws/aurora "Aurora DB" {
  description: "Primary data store"
  tags: #datastore
}

// Request flow
user -> alb "HTTPS"
alb -> app "HTTP"
app -> cache "read/write"
app -> db "queries"

view default {
  layout {
    rows [user] [alb] [app] [cache db]
  }
}
