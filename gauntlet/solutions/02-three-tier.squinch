pack aws

person user "User"

alb   = aws/elastic-load-balancing "Application Load Balancer"
app   = aws/fargate                "Web Service" {
  description: "ECS on Fargate"
}
cache = aws/elasticache            "Session Cache" datastore
db    = aws/aurora                 "Database" datastore

user -> alb "requests"
alb -> app
app -> cache "session data"
app -> db "queries"

view landscape {
  layout {
    rows [user] [alb] [app] [cache db]
  }
}
