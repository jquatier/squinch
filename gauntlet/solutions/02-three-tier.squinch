// Three-tier web application architecture
pack aws

person user "User"

alb = aws/elastic-load-balancing "Application Load Balancer"
app = aws/fargate "ECS Service" {
  description: "Application tier"
}
cache = aws/elasticache "ElastiCache" datastore {
  description: "Redis cache"
}
db = aws/aurora "Aurora Database" datastore {
  description: "Primary data store"
}

user -> alb "HTTPS requests"
alb -> app "forwards traffic"
app -> cache "cache lookup"
app -> db "data queries"
