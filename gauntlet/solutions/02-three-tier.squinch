pack aws

person user "User"

system app "Web Application" {
  lb    = aws/elb         "Application Load Balancer"
  web   = aws/fargate     "Web Service (ECS)"
  db    = aws/aurora      "Aurora"
  cache = aws/elasticache "Session Cache"

  lb -> web
  web -> db "reads/writes"
  web -> cache "hot data"
}

user -> app.lb "HTTPS"

view app {
  layout {
    rows [lb] [web] [db cache]
  }
}
