pack aws

person user "User"

alb   = aws/elastic-load-balancing "Application Load Balancer"
app   = aws/ecs                    "Web App" { subtitle: "ECS · Fargate" }
cache = aws/elasticache            "Cache" datastore { subtitle: "ElastiCache" }
db    = aws/aurora                 "Database" datastore { subtitle: "Aurora" }

user -> alb  "HTTPS"
alb  -> app
app  -> cache "read/write"
app  -> db    "read/write"
