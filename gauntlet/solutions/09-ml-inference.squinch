pack aws

person client "Client App"

system ml_inference "ML Inference System" {
  tags: #inference

  api = aws/api-gateway "API Gateway"
  lambda = aws/lambda "Inference Handler" {
    description: "Queries model endpoint"
  }
  endpoint = aws/sagemaker "SageMaker Endpoint" {
    description: "Realtime predictions"
  }
  features = aws/dynamodb "Feature Store" datastore {
    description: "Feature data"
  }

  api -> lambda
  lambda -> endpoint
  lambda -> features "fetch features"
}

system training "Model Training" {
  tags: #batch

  batch = aws/lambda "Batch Job" {
    description: "Nightly retraining"
  }
  data = aws/s3 "Training Data" datastore

  batch -> data "read training data"
  batch ~> ml_inference.endpoint "retrain model"
}

client -> ml_inference.api "inference request"

view landscape {
  title "ML Inference System"
  include *
}

view ml_inference {
  title "Realtime Inference Flow"
  scope ml_inference
  expand training
}
