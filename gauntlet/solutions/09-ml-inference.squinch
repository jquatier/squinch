pack aws

person client "Client App"

api       = aws/api-gateway "API Gateway"
inference = aws/lambda      "Inference Service" {
  subtitle: "Lambda · Python"
}
endpoint  = aws/sagemaker   "ML Endpoint" {
  subtitle: "SageMaker"
}
features  = aws/dynamodb    "Feature Store" datastore

training  = aws/batch       "Training Job" {
  subtitle: "Nightly batch"
}
data      = aws/s3          "Training Data" datastore

client -> api "inference request"
api -> inference
inference -> endpoint "predict"
inference -> features "fetch features"
training ~> endpoint "update model"
training -> data "read training data"
