pack aws

person client "Client App"

system inference "ML Inference Service" {
  glyph: aws/sagemaker
  description: "Realtime model serving"

  gw = aws/api-gateway "API Gateway"
  handler = aws/lambda "Inference Handler" {
    description: "Queries model endpoint"
  }
  model = aws/sagemaker "SageMaker Endpoint" {
    description: "Deployed ML model"
  }
  features = aws/dynamodb "Feature Store" datastore {
    description: "Feature data"
  }

  gw -> handler
  handler -> features "fetch features"
  handler -> model "predict"
}

system training "Model Training" {
  glyph: aws/batch
  description: "Nightly model retraining"

  job = aws/batch "Training Job" {
    description: "Batch retraining"
  }
  data = aws/s3 "Training Data" datastore

  job -> data "read training data"
}

client -> inference.gw "prediction request"
training.job ~> inference.model "deploy retrained model"
