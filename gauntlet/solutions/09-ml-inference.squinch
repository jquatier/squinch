pack aws

clients  = sys/smartphone "Client Apps"
api      = aws/api-gateway "API Gateway"
fn       = aws/lambda "Front-end Lambda"
endpoint = aws/sagemaker "SageMaker Endpoint" { subtitle: "Model hosting" }
features = aws/dynamodb "Feature Store" datastore
batch    = sys/clock "Nightly Batch Job" { subtitle: "Retraining" }
training = aws/s3 "Training Data" datastore

clients -> api "requests"
api -> fn
fn -> endpoint "predict"
fn -> features "fetch features"
batch -> training "reads"
batch ~> endpoint "retrains model"

view landscape {
  title "Realtime ML Inference"
  include *
}
