pack aws

person client "Client App"

system ml_inference "ML Inference Service" {
  description: "Realtime model inference with feature lookup"
  glyph: aws/sagemaker

  api = aws/api-gateway "API Gateway"
  lambda = aws/lambda "Inference Handler"
  endpoint = aws/sagemaker "SageMaker Endpoint"
  features = aws/dynamodb "Feature Store" datastore

  api -> lambda
  lambda -> features "get features"
  lambda -> endpoint "predict"
}

system training "Model Training Pipeline" {
  description: "Nightly batch model retraining"
  glyph: sys/workflow

  job = aws/batch "Training Job"
  data = aws/s3 "Training Data" datastore

  job -> data "read training data"
}

client -> ml_inference.api "inference request"
training.job ~> ml_inference.endpoint "retrain model"
