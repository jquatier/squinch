pack aws

person client "Client App"

system inference "ML Inference System" {
  glyph: aws/sagemaker
  description: "Realtime ML predictions"

  api = aws/api-gateway "API Gateway"
  fn = aws/lambda "Inference Handler"
  features = aws/dynamodb "Feature Store" datastore
  model = aws/sagemaker "Model Endpoint"

  api -> fn "inference request"
  fn -> features "fetch features"
  fn -> model "predict"
}

system training "Model Training" {
  glyph: aws/batch
  description: "Nightly model retraining"

  job = aws/batch "Training Job"
  data = aws/s3 "Training Data" datastore

  job -> data "read training data"
  job ~> inference.model "update model"
}

client -> inference.api "request prediction"

view landscape {
  title "ML Inference Architecture"
  include *
  layout {
    rows [client] [training] [inference]
  }
}

view inference {
  scope inference
  layout {
    rows [api] [fn] [features model]
    place model right-of features
  }
}
