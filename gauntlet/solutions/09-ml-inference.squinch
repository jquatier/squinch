pack aws

person client "Client Apps"

system inference "ML Inference" {
  tags: #realtime

  gw = aws/api-gateway "API Gateway"
  handler = aws/lambda "Inference Handler"
  model = aws/sagemaker "SageMaker Endpoint"
  features = aws/dynamodb "Feature Store" datastore

  gw -> handler "inference request"
  handler -> features "fetch features"
  handler -> model "predict"
}

system training "Model Training" {
  tags: #batch

  job = aws/batch "Nightly Job"
  data = aws/s3 "Training Data" datastore

  job -> data "load training data"
  job ~> inference.model "retrain model"
}

client -> inference.gw "call API"

view landscape {
  title "ML Inference System"
  include *
}

view inference {
  scope inference
  layout {
    rows [gw] [handler] [features model]
    place model right-of features
  }
}
