pack aws

person client "Client App"

system inference "ML Inference" {
  description: "Realtime model serving"

  api = aws/api-gateway "API Gateway"
  lambda = aws/lambda "Inference Handler"
  model = aws/sagemaker "SageMaker Endpoint"
  features = aws/dynamodb "Feature Store" datastore

  api -> lambda
  lambda -> model "predict"
  lambda -> features "get features"
}

system training "Model Training" {
  description: "Nightly batch retraining"

  job = aws/batch "Training Job"
  data = aws/s3 "Training Data" datastore

  job -> data "read training data"
  job ~> inference.model "update model"
}

client -> inference.api "API request"

view landscape {
  title "ML Inference System"
  include *
  layout {
    rows [client] [inference training]
  }
}
