pack aws

person client "Client App"

system inference "ML Inference Service" {
  description: "Real-time prediction API"

  gw = aws/api-gateway "API Gateway"
  handler = aws/lambda "Inference Handler"
  model = aws/sagemaker "SageMaker Endpoint"
  features = aws/dynamodb "Feature Store" datastore

  gw -> handler
  handler -> features
  handler -> model
}

system training "Model Training" {
  description: "Nightly batch retraining"

  job = aws/batch "Batch Job"
  data = aws/s3 "Training Data" datastore

  job -> data
}

client -> inference.gw "prediction request"
training.job ~> inference.model "retrain model"
