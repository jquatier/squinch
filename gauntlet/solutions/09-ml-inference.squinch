pack aws

clients = sys/mobile "Client Apps"

system inference "Realtime Inference" {
  api      = aws/api-gateway "Inference API"
  fn       = aws/lambda      "Feature Assembler"
  endpoint = aws/sagemaker   "Model Endpoint"
  features = aws/dynamodb    "Feature Store"

  api -> fn
  fn -> features "fetch features"
  fn -> endpoint "invoke"
}

system training "Nightly Training" {
  data    = aws/s3     "Training Data"
  retrain = aws/batch  "Retrain Job"

  retrain -> data "reads"
}

clients -> inference.api "predict"
training.retrain ~> inference.endpoint "deploys new model"

view inference {
  layout {
    rows [api] [fn] [features endpoint]
  }
}

view landscape {
  include *
}
