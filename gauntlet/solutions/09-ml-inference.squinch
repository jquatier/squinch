pack aws

person client "Client App"

system ml_inference "ML Inference Service" {
  description: "Real-time ML predictions with feature store"
  glyph: aws/sagemaker

  gw     = aws/api-gateway "API Gateway"
  lambda = aws/lambda      "Inference Handler"
  model  = aws/sagemaker   "Model Endpoint"
  store  = aws/dynamodb    "Feature Store" datastore

  gw -> lambda "predict"
  lambda -> model "inference"
  lambda -> store "get features"
}

batch    = aws/batch "Nightly Retrain Job"
training = aws/s3    "Training Data" datastore

client -> ml_inference.gw "prediction request"
batch -> training "read training data"
batch ~> ml_inference.model "update model"
