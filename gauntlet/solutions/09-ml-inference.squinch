pack aws

person client "Client Apps"

gw = aws/api-gateway "API Gateway"
infer = aws/lambda "Inference Handler"
features = aws/dynamodb "Feature Store" datastore
model = aws/sagemaker "ML Endpoint"

training_data = aws/s3 "Training Data" datastore
batch = aws/batch "Nightly Trainer"

client -> gw "requests"
gw -> infer
infer -> features "fetch features"
infer -> model "predict"

batch ~> model "retrain"
training_data ~> batch "training data"
