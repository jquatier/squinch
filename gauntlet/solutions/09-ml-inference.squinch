pack aws

clients = sys/app-window "Client Apps" external

system inference "Realtime ML Inference" {
  description: "Online serving and nightly retraining"

  api      = aws/api-gateway "API Gateway"
  handler  = aws/lambda      "Inference Handler" { subtitle: "Lambda" }
  features = aws/dynamodb    "Feature Store" datastore
  endpoint = aws/sagemaker   "Model Endpoint"

  schedule = aws/eventbridge "Nightly Schedule"
  retrain  = aws/lambda      "Retrain Job" { subtitle: "Batch" }
  training = aws/s3          "Training Data" datastore

  api -> handler
  handler -> endpoint "predict"
  handler -> features "lookup features"

  schedule ~> retrain "nightly trigger"
  retrain -> training "read training data"
  retrain ~> endpoint "deploy retrained model"

  layout {
    rows [schedule] [api] [retrain handler] [training features endpoint]
  }
}

clients -> inference.api "request"
