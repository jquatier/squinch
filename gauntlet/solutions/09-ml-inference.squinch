pack aws

client = sys/smartphone "Client Apps"
gw     = aws/api-gateway "API Gateway"
fn     = aws/lambda "Front-end Lambda"
ep     = aws/sagemaker "SageMaker Endpoint"
feat   = aws/dynamodb "Feature Store" datastore
train  = aws/s3 "Training Data" datastore
batch  = sys/clock "Nightly Batch Job" { subtitle: "Retraining" }

client -> gw "request"
gw -> fn
fn -> ep "predict"
fn -> feat "get features"
batch -> train "read training data"
batch ~> ep "retrain model"

view landscape {
  title "Realtime ML Inference"
  include *
  legend {
    -> "Request"
    ~> "Async"
  }
}
