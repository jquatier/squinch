pack aws

client = sys/app-window "Client Apps"
gw     = aws/api-gateway "API Gateway"
fn     = aws/lambda "Front-end Lambda"
ep     = aws/sagemaker "SageMaker Endpoint"
fs     = aws/dynamodb "Feature Store" datastore
train  = aws/s3 "Training Data" datastore
batch  = sys/workflow "Nightly Batch Job" { subtitle: "Retrains the model" }

client -> gw "request"
gw -> fn
fn -> ep "inference"
fn -> fs "features"
batch -> train "reads"
batch ~> ep "retrains model"

view landscape {
  title "Realtime ML Inference"
  include *
}
