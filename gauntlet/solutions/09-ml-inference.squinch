pack aws

person client "Client App"

system ml_inference "ML Inference Service" {
  description: "Realtime inference with feature lookup"
  glyph: aws/sagemaker

  api = aws/api-gateway "API Gateway"
  handler = aws/lambda "Inference Handler"
  model = aws/sagemaker "Model Endpoint"
  features = aws/dynamodb "Feature Store" datastore

  api -> handler
  handler -> model "predict"
  handler -> features "fetch features"
}

system training "Model Training Pipeline" {
  description: "Nightly batch retraining"
  glyph: sys/workflow

  job = aws/lambda "Training Job"
  data = aws/s3 "Training Data" datastore

  job -> data "read training set"
  job ~> ml_inference.model "deploy updated model"
}

client -> ml_inference.api "inference request"

view landscape {
  title "ML Inference Architecture"
  include *
}

view inference {
  scope ml_inference
  title "Real-time Inference Flow"
}

flow request "Inference Request" {
  client -> ml_inference.api -> ml_inference.handler -> ml_inference.model
  ml_inference.handler -> ml_inference.features
}

view inference_flow {
  scope ml_inference
  title "Inference Request Flow"
  show flow request
}
