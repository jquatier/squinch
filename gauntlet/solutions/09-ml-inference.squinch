pack aws

person client "Client App"

gw = aws/api-gateway "API Gateway"
fn = aws/lambda "Inference Handler" {
  subtitle: "Lambda"
}
endpoint = aws/sagemaker "SageMaker Endpoint" {
  description: "Real-time inference"
}
features = aws/dynamodb "Feature Store" datastore

batch = aws/batch "Batch Training Job" {
  subtitle: "Nightly"
}
training_data = aws/s3 "Training Data" datastore

client -> gw "inference request"
gw -> fn
fn -> features "fetch features"
fn -> endpoint "predict"
batch ~> endpoint "retrain model"
batch -> training_data "read training data"

view landscape {
  title "ML Inference Architecture"
  include *
  layout {
    rows [client] [gw] [fn] [features] [endpoint batch] [training_data]
  }
}
