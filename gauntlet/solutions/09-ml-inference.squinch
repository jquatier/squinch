// ML Inference System
pack aws

person client "Client App"

gw = aws/api-gateway "API Gateway"
inference = aws/lambda "Inference Handler"
model = aws/sagemaker "ML Model Endpoint"
features = aws/dynamodb "Feature Store" datastore

training_data = aws/s3 "Training Data" datastore
batch_job = aws/batch "Retrain Job"

// Real-time inference flow
client -> gw "inference request"
gw -> inference
inference -> features "fetch features"
inference -> model "predict"

// Async batch training flow
batch_job ~> training_data "reads"
batch_job ~> model "retrain"
