pack aws

person client "Client App"

api    = aws/api-gateway "API Gateway"
infer  = aws/lambda      "Inference Handler"
model  = aws/sagemaker   "ML Model Endpoint"
feats  = aws/dynamodb    "Feature Store" datastore

train_data = aws/s3         "Training Data" datastore
batch      = aws/batch      "Nightly Retrain Job"

client -> api "prediction request"
api -> infer
infer -> model "get prediction"
infer -> feats "fetch features"

batch ~> train_data "read training data"
batch ~> model      "update model"

view overview {
  title "Real-time ML Inference"
  layout {
    rows [client] [api] [infer] [model feats batch] [train_data]
  }
}
