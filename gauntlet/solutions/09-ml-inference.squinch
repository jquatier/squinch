pack aws

person client "Client App"

gw     = aws/api-gateway "API Gateway"
lambda = aws/lambda      "Inference Handler"
sm     = aws/sagemaker   "Model Endpoint"
feat   = aws/dynamodb    "Feature Store" datastore
s3     = aws/s3          "Training Data" datastore
batch  = aws/batch       "Retrain Job"

// Realtime inference flow
client -> gw "inference request"
gw -> lambda
lambda -> feat "fetch features"
lambda -> sm "predict"

// Async training flow
batch ~> s3 "read training data"
batch ~> sm "update model"

view landscape {
  title "ML Inference System"
  include *
  layout {
    rows [client] [gw] [lambda] [feat] [sm batch] [s3]
  }
}
