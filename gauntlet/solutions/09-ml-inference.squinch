pack aws

person client "Client App"

system rt "Realtime Inference" {
  description: "Serves live predictions"

  api      = aws/api-gateway "API Gateway"
  front    = aws/lambda      "Inference Handler" { subtitle: "Lambda" }
  endpoint = aws/sagemaker   "Inference Endpoint"
  features = aws/dynamodb    "Feature Store" datastore

  api -> front
  front -> endpoint "predict"
  front -> features "fetch features"
}

system training "Nightly Retraining" {
  description: "Retrains the model offline"

  scheduler = aws/eventbridge "Nightly Schedule"
  job       = aws/batch       "Retraining Job"
  data      = aws/s3          "Training Data" datastore

  scheduler ~> job "trigger"
  job -> data "read training data"
}

client -> rt.api "request prediction"
training.job ~> rt.endpoint "deploy new model"

view landscape {
  title "ML Inference Platform"
  include *
}
