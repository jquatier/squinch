pack aws

client = sys/smartphone "Client Apps"
gw     = aws/api-gateway "API Gateway"
fn     = aws/lambda "Inference Front End"
sm     = aws/sagemaker "SageMaker Endpoint"
fs     = aws/dynamodb "Feature Store" datastore
batch  = aws/batch "Nightly Retraining Job" { subtitle: "Nightly" }
s3     = aws/s3 "Training Data" datastore

client -> gw "request"
gw -> fn
fn -> sm "query"
fn -> fs "fetch features"
batch -> s3 "reads"
batch ~> sm "retrains model"

view landscape {
  title "Realtime ML Inference"
  include *
  legend auto
}
