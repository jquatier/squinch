// ML Inference System
pack aws

person client "Client App"

system ml_inference "ML Inference System" {
  tags: #realtime

  api = aws/api-gateway "API Gateway"
  infer = aws/lambda "Inference Handler" {
    description: "Queries model with features"
  }
  features = aws/dynamodb "Feature Store" datastore {
    description: "Real-time feature lookup"
  }
  model = aws/sagemaker "ML Endpoint" {
    description: "Hosted model inference"
  }

  api -> infer
  infer -> features
  infer -> model
}

system training "Model Training" {
  tags: #batch

  job = aws/batch "Nightly Retrain Job" {
    description: "Scheduled model training"
  }
  data = aws/s3 "Training Data" datastore {
    description: "Historical training set"
  }

  job -> data
  job ~> ml_inference.model "deploys new model"
}

client -> ml_inference.api "inference request"

view landscape {
  title "ML System Overview"
  include *
  show descriptions
  legend auto
}

view ml_inference {
  title "Real-time Inference Path"
  show descriptions
  legend auto

  layout {
    rows [api] [infer] [features model]
    place model right-of features
  }
}

view training {
  title "Batch Training Pipeline"
  scope training
  detail ml_inference.model
  show descriptions
  legend auto

  layout {
    rows [job] [data]
  }
}
