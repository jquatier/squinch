pack aws

person client "Client Apps"

system inference "ML Inference API" {
  api = aws/api-gateway "API Gateway"
  predict = aws/lambda "Predict Handler" {
    description: "Serves inference requests"
  }
  features = aws/dynamodb "Feature Store" datastore {
    description: "Real-time features"
  }
  model = aws/sagemaker "SageMaker Endpoint" {
    description: "Inference endpoint"
  }

  api -> predict
  predict -> features "fetch features"
  predict -> model "predict"
}

system training "Model Training" {
  batch = aws/batch "Nightly Job" {
    description: "Retrains model"
  }
  data = aws/s3 "Training Data" datastore

  batch -> data "read training data"
  batch ~> inference.model "update model"
}

client -> inference.api "inference request"
