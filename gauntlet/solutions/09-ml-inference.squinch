pack aws

person client "Client App"

system inference "ML Inference" {
  description: "Realtime model serving"

  gw     = aws/api-gateway "API Gateway"
  lambda = aws/lambda      "Inference Handler"
  model  = aws/sagemaker   "Model Endpoint"

  gw -> lambda
  lambda -> model
}

features = aws/dynamodb "Feature Store" datastore
training = aws/s3       "Training Data" datastore
batch    = aws/batch    "Nightly Retrain Job"

client -> inference.gw "prediction request"
inference.lambda -> features "fetch features"
batch ~> inference.model "retrain"
batch -> training "read training data"

view landscape {
  title "ML Inference Architecture"
  layout {
    rows [client] [inference batch] [features training]
  }
}
