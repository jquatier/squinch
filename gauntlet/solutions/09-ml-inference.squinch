pack aws

person client "Client App"

system ml_inference "ML Inference System" {
  tags: #realtime

  api = aws/api-gateway "API Gateway"
  handler = aws/lambda "Inference Handler" {
    description: "Queries model endpoint"
  }
  model = aws/sagemaker "ML Model Endpoint" {
    description: "Realtime predictions"
  }
  features = aws/dynamodb "Feature Store" datastore {
    description: "Feature lookup"
  }
  training = aws/s3 "Training Data" datastore {
    description: "Historical data"
  }
  batch = aws/batch "Nightly Training Job" {
    description: "Retrains model"
    tags: #batch
  }

  api -> handler
  handler -> model "predict"
  handler -> features "get features"
  training ~> batch "training data"
  batch ~> model "retrain"
}

client -> ml_inference.api "inference request"

view landscape {
  title "ML Inference System"
  include *
}

view ml_inference {
  title "ML Inference Architecture"
  scope ml_inference
  layout {
    rows [api] [handler] [model features] [training]
  }
}
