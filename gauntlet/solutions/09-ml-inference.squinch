pack aws

person client "Client Apps"

gw = aws/api-gateway "API Gateway"
fn = aws/lambda "Inference Handler" {
  subtitle: "Lambda · Python"
}
endpoint = aws/sagemaker "ML Endpoint" {
  description: "Realtime model serving"
}
features = aws/dynamodb "Feature Store" datastore

training_data = aws/s3 "Training Data" datastore
batch = aws/batch "Nightly Retrain Job" {
  subtitle: "Batch"
}

client -> gw "inference request"
gw -> fn
fn -> endpoint "predict"
fn -> features "get features"
endpoint -> fn "prediction"

batch ~> endpoint "update model"
batch -> training_data "read training data"
