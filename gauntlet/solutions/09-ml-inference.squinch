pack aws

client = sys/smartphone "Client Apps"
gw     = aws/api-gateway "API Gateway"
fn     = aws/lambda "Front-End Lambda"
ep     = aws/sagemaker "SageMaker Endpoint" { subtitle: "Realtime inference" }
feat   = aws/dynamodb "Feature Store" datastore { subtitle: "DynamoDB" }
train  = aws/s3 "Training Data" datastore { subtitle: "S3" }
retrain = sys/clock "Nightly Retrain Job" { subtitle: "Batch · nightly" }

client -> gw "request"
gw -> fn
fn -> ep "query"
fn -> feat "get features"
retrain -> train "read data"
retrain ~> ep "retrain model"

view landscape {
  title "Realtime ML Inference"
  include *
  legend auto
}
