pack aws

person client "Client Apps"

system ml "Realtime ML Inference" {
  description: "Realtime inference endpoint plus nightly model retraining"

  api      = aws/api-gateway "API Gateway"
  infer    = aws/lambda      "Inference Handler"
  sm       = aws/sagemaker   "SageMaker Endpoint"
  features = aws/dynamodb    "Feature Store"

  retrain  = aws/batch       "Nightly Retrain Job"
  training = aws/s3          "Training Data"

  api -> infer "invoke"
  infer -> features "fetch features"
  infer -> sm "predict"

  retrain -> training "read training data"
  retrain ~> sm "deploy retrained model"
}

client -> ml.api "request"

view ml {
  layout {
    density spacious
    rows [api] [infer retrain] [sm features]
    place training right-of retrain
    route retrain -> training from east to west
  }
}
