pack aws

person client "Client Apps"

system inference "ML Inference Service" {
  description: "Real-time predictions"
  glyph: aws/sagemaker

  api = aws/api-gateway "API Gateway"
  handler = aws/lambda "Inference Handler" {
    description: "Coordinates feature lookup and prediction"
  }
  features = aws/dynamodb "Feature Store" datastore {
    description: "Real-time feature cache"
  }
  model = aws/sagemaker "SageMaker Endpoint" {
    description: "Hosted model for inference"
  }

  api -> handler
  handler -> features "fetch features"
  handler -> model "predict"
}

system training "Model Training Pipeline" {
  description: "Nightly batch retraining"
  glyph: sys/cog

  job = aws/batch "Training Job" {
    description: "Nightly model retraining"
  }
  data = aws/s3 "Training Data" datastore

  job -> data "read training data"
}

client -> inference.api "inference request"
training.job ~> inference.model "update model"
