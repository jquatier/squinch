pack aws

system pipeline "Serverless Image Pipeline" {
  description: "Labels uploaded images and notifies subscribers"

  bucket       = aws/s3          "Uploads Bucket"
  handler      = aws/lambda      "Image Processor"
  rekognition  = aws/rekognition "Rekognition"
  table        = aws/dynamodb    "Image Metadata"
  topic        = aws/sns         "Notifications"
  subscribers  = box             "Subscribers" external

  bucket ~> handler "object created"
  handler -> rekognition "detect labels"
  handler -> table "write metadata"
  handler -> topic "publish"
  topic ~> subscribers "notify"
}

view pipeline {
  layout {
    rows [bucket] [handler] [rekognition table topic] [subscribers]
  }
}
