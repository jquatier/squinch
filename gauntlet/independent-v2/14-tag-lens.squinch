pack aws

system payments "Payments Platform" {
  description: "Card payment processing"

  api       = aws/lambda   "API Lambda" {
    description: "Public entrypoint for payment requests"
    tags: #pci
  }
  tokenizer = aws/lambda   "Tokenizer Lambda" {
    description: "Tokenizes raw card numbers"
    tags: #pci
  }
  vault     = aws/dynamodb "Card Vault" {
    description: "Stores tokenized card data"
    tags: #pci
  }
  analytics = aws/lambda   "Analytics Lambda" {
    description: "Aggregates anonymized transaction metrics"
  }
  warehouse = aws/redshift "Data Warehouse" {
    description: "Business analytics warehouse"
  }

  api -> tokenizer "tokenize card"
  tokenizer -> vault "store token"
  api -> analytics "emit anonymized event"
  analytics -> warehouse "load metrics"
}

view full {
  scope payments
  title "Payments Platform — Full Picture"

  layout {
    rows [api] [tokenizer analytics] [vault warehouse]
  }
}

view auditor {
  scope payments
  title "Auditor View — PCI Scope"
  exclude analytics, warehouse

  layout {
    rows [api] [tokenizer] [vault]
  }
}
