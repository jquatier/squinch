pack aws

system orders "Orders API" {
  description: "Lambda-based API for managing orders"

  api      = aws/api-gateway "API Gateway"
  create   = aws/lambda      "Create Handler"
  get      = aws/lambda      "Get Handler"
  search   = aws/lambda      "Search Handler"

  db       = aws/dynamodb    "Orders Table"
  files    = aws/s3          "Attachments"
  idx      = aws/opensearch  "Search Index"

  indexer  = aws/lambda      "Search Indexer" {
    description: "Async: keeps OpenSearch in sync with the Orders Table"
  }

  api -> create, get, search

  create -> db "put item"
  create -> files "store attachment"
  get -> db "get item"
  get -> files "fetch attachment"
  search -> idx "query"

  db ~> indexer "stream"
  indexer -> idx "reindex"
}

view orders {
  scope orders

  layout {
    rows [api] [create get search] [db files idx]
    place indexer right-of idx
    route db ~> indexer from east to west
    route indexer -> idx from west to east
  }
}
