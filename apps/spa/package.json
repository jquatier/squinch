{
  "name": "@squinch/spa",
  "version": "0.15.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run sync-examples && npm run sync-packs && npm run sync-lookbook && npm run sync-media && vite",
    "build": "npm run sync-examples && npm run sync-packs && npm run sync-lookbook && npm run sync-media && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sync-examples": "tsx scripts/sync-examples.ts",
    "sync-packs": "tsx scripts/sync-packs.ts",
    "sync-lookbook": "tsx scripts/sync-lookbook.ts",
    "sync-media": "tsx scripts/sync-media.ts",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@squinch/pack-aws": "workspace:*",
    "@squinch/pack-azure": "workspace:*",
    "@squinch/pack-gcp": "workspace:*",
    "@squinch/pack-k8s": "workspace:*",
    "@squinch/pack-logos": "workspace:*",
    "@squinch/pack-sys": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@squinch/core": "workspace:*",
    "codemirror": "^6.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
