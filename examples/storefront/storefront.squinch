// SPEC §10.2-style nesting example: landscape altitude + zoom + context.
pack aws

person customer "Customer"

system web "Storefront" {
  description: "Customer-facing web experience"
  glyph: sys/app-window

  cdn = aws/cloudfront "CDN"         { subtitle: "CloudFront" }
  app = aws/amplify    "Next.js App" { subtitle: "Amplify · Next.js 15" }
  cdn -> app
}

system orders "Order Service" {
  glyph: sys/code
  tags: #core

  api = aws/api-gateway "API Gateway" { subtitle: "REST" }
  container handlers "API Handlers" {
    create = aws/lambda "Create" { subtitle: "Lambda · Node 20", tags: #pci }
    get    = aws/lambda "Get"    { subtitle: "Lambda · Node 20" }
  }
  db = aws/dynamodb "Orders Table" {
    subtitle: "DynamoDB"
    description: "Single-table design"
    tags: #pci
  }
  api -> handlers.create, handlers.get
  handlers.create -> db
  handlers.get    -> db
}

customer -> web.cdn "browses"
web.app  -> orders.api "REST"

view landscape {
  title "System Landscape"
  include *
}

view orders {
  scope orders
}

view orders-pci {
  scope orders
  title "PCI Surface"
  highlight #pci
  show descriptions
  note right-of db "Encrypted at rest (KMS); see ADR-31"
  note top-right "Audit scope: Q3 2026" { style: warning }
}

view orders-detail {
  scope orders
  title "Order Service — detail"
  expand handlers
}
