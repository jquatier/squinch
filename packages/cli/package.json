{
  "name": "squinch",
  "version": "0.8.0",
  "description": "Architecture diagrams as code for coding agents: install the skill, then check, render, diff and watch .squinch projects — clean, zoomable diagrams with real cloud icons, as deterministic SVG, PNG or interactive HTML.",
  "keywords": [
    "architecture",
    "architecture-diagrams",
    "diagrams",
    "diagrams-as-code",
    "c4",
    "system-design",
    "svg",
    "aws",
    "azure",
    "gcp",
    "google cloud",
    "kubernetes",
    "ai",
    "llm",
    "agents",
    "agent-skill",
    "claude-code",
    "codex"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/jquatier/squinch.git",
    "directory": "packages/cli"
  },
  "homepage": "https://squinch.cc/",
  "bugs": {
    "url": "https://github.com/jquatier/squinch/issues"
  },
  "files": [
    "dist",
    "bin",
    "LICENSE"
  ],
  "type": "module",
  "bin": {
    "squinch": "./bin/squinch.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@squinch/core": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
