{
  "name": "@squinch/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "grammar": "lezer-generator src/grammar/squinch.grammar -o src/grammar/parser.js",
    "build": "npm run grammar && tsc -p tsconfig.build.json && mkdir -p dist/grammar && cp src/grammar/parser.js src/grammar/parser.terms.js dist/grammar/",
    "typecheck": "tsc --noEmit",
    "test": "npm run grammar && vitest run",
    "demo": "npm run grammar && tsx scripts/demo.ts"
  },
  "dependencies": {
    "@lezer/common": "^1.5.2",
    "@lezer/lr": "^1.4.10",
    "elkjs": "^0.12.0",
    "fast-xml-parser": "^5.10.1"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@lezer/generator": "^1.8.0",
    "fontkit": "^2.0.4",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "metrics.json"
  ]
}