{
  "name": "@squinch/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "grammar": "lezer-generator src/grammar/squinch.grammar -o src/grammar/parser.js",
    "build": "npm run grammar && tsc -p tsconfig.build.json && mkdir -p dist/grammar && cp src/grammar/parser.js src/grammar/parser.terms.js dist/grammar/",
    "typecheck": "tsc --noEmit",
    "test": "npm run grammar && vitest run",
    "demo": "npm run grammar && tsx scripts/demo.ts",
    "gen-metrics": "tsx scripts/gen-metrics.ts && tsx scripts/gen-metrics-module.ts",
    "test:e2e": "playwright test",
    "gen-html-runtime": "tsx scripts/gen-html-runtime.ts",
    "gen-fonts": "tsx scripts/gen-fonts.ts",
    "bench": "npm run grammar && tsx scripts/bench.ts"
  },
  "dependencies": {
    "@lezer/common": "^1.5.2",
    "@lezer/lr": "^1.4.10",
    "@squinch/pack-aws": "workspace:*",
    "@squinch/pack-azure": "workspace:*",
    "@squinch/pack-k8s": "workspace:*",
    "@squinch/pack-logos": "workspace:*",
    "@squinch/pack-sys": "workspace:*",
    "elkjs": "^0.12.0",
    "fast-xml-parser": "^5.10.1",
    "roughjs": "^4.6.6"
  },
  "devDependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@lezer/generator": "^1.8.0",
    "@playwright/test": "^1.62.1",
    "esbuild": "^0.28.1",
    "fontkit": "^2.0.4",
    "subset-font": "^2.5.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./grammar": {
      "default": "./dist/grammar/parser.js"
    },
    "./fonts/*": "./fonts/*"
  },
  "files": [
    "dist",
    "fonts",
    "metrics.json"
  ]
}
