// Squinch DSL — Lezer grammar, v1 slice (SPEC §8 minus [v1.1]/[v2] constructs).
// Statements end at newline or ';'. Comments are // only — '#' belongs to tags.

@top File { list<item> }

item {
  PackStmt |
  PersonDecl |
  Container |
  NodeDecl |
  EdgeStmt |
  ZoneDecl |
  FlowDecl |
  View |
  FileTheme
}

s { nl | ";" }
// statements separated by newline/';' — required, per SPEC.
// Shape avoids adjacent separator runs: leading seps, then items each eating
// their trailing seps, with an optional final unterminated item.
list<x> { s* (x s+)* x? }

// @extend (not @specialize): keywords stay valid as ordinary identifiers,
// so a node can be called `view`, an icon can be `builtin/person`, etc.
kw<term> { @extend[@name={term}]<Ident, term> }

PackStmt { kw<"pack"> Ident (kw<"from"> String)? }
FileTheme { kw<"theme"> Ident }
// Tag* for the same reason NodeDecl and Container have it: rounds 15-16
// legalized the kind-position tag everywhere else, and `person vip "V" #gold`
// erroring while `vip = person "V" #gold` parses is exactly the
// "positional tags, except on X" exception that change existed to remove.
PersonDecl { kw<"person"> Ident String? Tag* }

// A kind on the container itself: DESIGN §3 hangs the hatched surface off
// `external`, and "someone else's system" is a property of the whole system,
// not of one node inside it. Only `external` means anything here — the model
// builder rejects the other two, which have no card treatment.
Container {
  (kw<"system"> | kw<"container">) Ident String? (NodeKind | Tag)* ContainerBody
}

// flow id "Label" { a -> b -> c }  — numbered path over existing edges
FlowDecl { kw<"flow"> Ident String? FlowBody }
FlowBody { "{" list<FlowChain> "}" }
FlowChain { Path (Arrow Path)+ }

// zone id "Label" kind { contains a, b.c }  — deployment boundary (SPEC §Zones)
ZoneDecl { kw<"zone"> Ident String? ZoneKind? ZoneBody }
ZoneKind { Ident }
ZoneBody { "{" list<ContainsStmt | Attr> "}" }
ContainsStmt { kw<"contains"> PathList }
ContainerBody { "{" list<NodeDecl | Container | EdgeStmt | Attr> "}" }

// Kind and attr block in either order. The model builder reads them with
// getChildren/getChild and never cared about the sequence; only the grammar
// did, and `"L" { tags: #x } datastore` — the order people actually reach
// for — died as a cascade of syntax errors pointing at the brace.
// `= person "Name"` alongside `= box`: `person id "Label"` is a top-level
// form only, so inside a system the only way to draw a human was
// `= box "Name" person`, and what agents reach for is `= person "Name"`.
// `#tag` in kind position: five of five cold agents shown one example wrote
// `db = aws/dynamodb "L" datastore #pci` — a hashtag reads like a kind, and
// nobody reached for `tags: #pci` unprompted. Same fix as `= person` and
// either-order attr blocks: the unanimous guess becomes the syntax.
NodeDecl { Ident "=" (IconRef | kw<"box"> | kw<"person">) String? (NodeKind | AttrBlock | Tag)* }
// `person` was here too and nobody ever wrote it: across every example, the
// lookbook and nine gauntlet rounds, all 20 occurrences of the word were the
// `person id "Label"` declaration form (or `= person "Name"`), both of which
// set the kind themselves. It stays a kind on the model — `squinch diff`
// compares it — it is just no longer a word you can type in kind position.
NodeKind { kw<"external"> | kw<"datastore"> }
IconRef { Ident "/" Ident }

// A tag in trailing position, exactly as on a node. Round 16: an agent wrote
// `handler -> db #sensitive` twice in one file, having been given positional
// tags on nodes the round before — the generalisation is the obvious one, and
// refusing it here would make the rule "positional tags, except on edges".
EdgeStmt { Path Arrow PathList String? (AttrBlock | Tag)* }
PathList { Path ("," Path)* }
Path { Ident ("." Ident)* }

// Attrs separate by newline, `;` — or `,`, which SPEC §1 promised from v0
// and the parser never delivered: `{ style: dashed, animate: slow }` is the
// JS-object prior and it cost real iterations (three times in one session).
// A separate separator set, NOT `s`: a comma as a *statement* separator
// conflicts with PathList's commas in edge fan-out. Trailing comma legal.
as { nl | ";" | "," }
AttrBlock { "{" as* (Attr as+)* Attr? "}" }
Attr { Ident ":" Value }
Value { String | Number | Tag+ | IconRef | Path }

View { kw<"view"> Path ViewBody }
ViewBody { "{" list<viewStmt> "}" }
viewStmt {
  TitleStmt | ThemeStmt | ScopeStmt | OnlyStmt | IncludeStmt | ExcludeStmt |
  DetailStmt | ExpandStmt | ContextStmt | HighlightStmt | ShowStmt | NoteStmt |
  LegendStmt | TitleBlockStmt | LayoutBlock
}
TitleStmt { kw<"title"> String }
ThemeStmt { kw<"theme"> Ident }
ScopeStmt { kw<"scope"> Path }
OnlyStmt { kw<"only"> TargetList }
IncludeStmt { kw<"include"> (Star | TargetList) }
DetailStmt { kw<"detail"> Path }
ExcludeStmt { kw<"exclude"> TargetList }
ExpandStmt { kw<"expand"> Path }
ContextStmt { kw<"context"> (kw<"auto"> | kw<"off">) }
HighlightStmt { kw<"highlight"> Tag (","? Tag)* }
ShowStmt { kw<"show"> (kw<"descriptions"> | kw<"flow"> Ident) }
LegendStmt { kw<"legend"> (kw<"auto"> | kw<"off">) }
TitleBlockStmt { kw<"titleblock"> AttrBlock }
NoteStmt { kw<"note"> NoteAnchor String AttrBlock? }
NoteAnchor { RelPos Path | kw<"on"> Path Arrow Path | Corner }
Corner {
  kw<"top-left"> | kw<"top-right"> | kw<"bottom-left"> | kw<"bottom-right">
}
TargetList { Target ("," Target)* }
Target { Path | Tag }
Star { "*" }

LayoutBlock { kw<"layout"> "{" list<layoutStmt> "}" }
layoutStmt {
  DirectionStmt | LinesStmt | DensityStmt |
  RowsStmt | ColsStmt | PlaceStmt | AlignStmt | RouteStmt | ChannelStmt
}
DirectionStmt { kw<"direction"> (kw<"down"> | kw<"right">) }
LinesStmt { kw<"lines"> Ident }
DensityStmt { kw<"density"> Ident }
RowsStmt { kw<"rows"> Rank+ }
ColsStmt { kw<"cols"> Rank+ }
Rank { "[" Path (","? Path)* "]" }
PlaceStmt { kw<"place"> Path RelPos Path }
AlignStmt { kw<"align"> Path (","? Path)+ }
// channel a, b, c -> db  — several edges share one trunk into the target
ChannelStmt { kw<"channel"> PathList Arrow Path }
RouteStmt {
  kw<"route"> Path Arrow Path String?
  (kw<"from"> Side)? (kw<"to"> Side)?
}
RelPos { kw<"right-of"> | kw<"left-of"> | kw<"above"> | kw<"below"> }
Side { kw<"north"> | kw<"south"> | kw<"east"> | kw<"west"> }

@skip { space | Comment }

@tokens {
  space { $[ \t\r]+ }
  nl { "\n" }
  Comment { "//" ![\n]* }
  // hyphen must be followed by alnum so `a->b` tokenizes as Ident Arrow Ident
  Ident { $[a-zA-Z_] ($[a-zA-Z0-9_] | "-" $[a-zA-Z0-9_])* }
  String { '"' !["\n]* '"' }
  Number { $[0-9]+ ("." $[0-9]+)? }
  Tag { "#" $[a-zA-Z0-9_-]+ }
  Arrow { "->" | "~>" | "<->" | "--" }
  "{" "}" "[" "]" "," "=" ":" "/" "*" ";"
  @precedence { Comment, "/" }
}

@detectDelim
