// What the grid engine draws that the ELK engine refuses, warns about or
// silently gives up on. Render both side by side:
//   npx tsx spike/grid/render-pair.ts spike/grid/showcase.squinch out.html

system loop "Review loop" {
  draft = box "Draft"
  review = box "Review"
  publish = box "Publish"
  draft -> review "submit"
  review -> publish "approve"
  review -> draft "changes requested"
  publish -> draft "next version"
}

system areas "Areas on one row, a bus between them" {
  identity = box "Identity"
  catalog = box "Catalog"
  orders = box "Orders"
  shipping = box "Shipping"
  bus = box "Event bus"
  identity ~> bus
  catalog ~> bus
  bus ~> orders
  bus ~> shipping
}

system farm "Two schedulers, eight workers" {
  a = box "Scheduler A"
  b = box "Scheduler B"
  w1 = box "Worker 1"
  w2 = box "Worker 2"
  w3 = box "Worker 3"
  w4 = box "Worker 4"
  w5 = box "Worker 5"
  w6 = box "Worker 6"
  w7 = box "Worker 7"
  w8 = box "Worker 8"
  store = box "Results"
  a -> w1
  b -> w2
  a -> w3
  b -> w4
  a -> w5
  b -> w6
  a -> w7
  b -> w8
  w1 -> store
  w2 -> store
  w3 -> store
  w4 -> store
  w5 -> store
  w6 -> store
  w7 -> store
  w8 -> store
}

view upward {
  scope loop
  layout { rows [loop.draft] [loop.review] [loop.publish] }
}

view band {
  scope areas
  layout { rows [areas.identity areas.catalog areas.orders areas.shipping] }
}

view folded {
  scope farm
  layout { wrap 4 }
}
