// Furniture. `legend { }` says what the marks mean, in the author's words —
// each view shows the entries it draws, so one block serves both; `titleblock`
// stamps the drawing. Four keys are drawn canonically —
// `subtitle` under the title, `version`, mono `commit` and a dimmed `date` in
// the meta chip — and every other key appends as its own chip segment.
pack aws

person ops "Operator"

system pay "Payments" {
  description: "Settlement and payouts"
  glyph: sys/hexagon
  api = aws/lambda "Payment API"
  q   = aws/sqs "Settlement Queue" datastore
  w   = aws/lambda "Settlement Worker"
  api ~> q "capture"
  q ~> w "drain"
  api -> w "health"
}

system ledger "Ledger" {
  description: "Money movement of record"
  glyph: sys/database
  db = aws/aurora "Ledger DB" datastore
}

ops -> pay.api "reconciles"
pay.w -> ledger.db "posts"
pay.api -> ledger.db "balance check"

view overview {
  title "Payments — money path"
  include *
  legend {
    ->         "Synchronous call"
    ~>         "Queued, asynchronous"
    aggregated "Calls merged into one"
    context    "Outside this view"
  }
  titleblock {
    subtitle: "Settlement path, capture to ledger"
    version: "2026-07"
    commit: "9f31c2e"
    date: "2026-07-18"
    owner: team-payments
    status: "reviewed"
  }
}

view pay {
  title "Payments internals"
  // one alignment hint: label dummies join crossing minimization, and without
  // a spine this small view drifted into a staircase — the DSL's own remedy
  layout { align api w ledger.db }
  legend {
    ->         "Synchronous call"
    ~>         "Queued, asynchronous"
    aggregated "Calls merged into one"
    context    "Outside this view"
  }
  titleblock {
    version: "2026-07"
  }
}
