// Footer furniture. `legend auto` explains the line styles the diagram actually
// uses and nothing else; `titleblock` adds a drafting-style corner block for
// version, owner and anything else worth stamping on a drawing.
pack aws

person ops "Operator"

system pay "Payments" {
  description: "Settlement and payouts"
  glyph: sys/hexagon
  api = aws/lambda "Payment API"
  q   = aws/sqs "Settlement Queue" datastore
  w   = aws/lambda "Settlement Worker"
  api ~> q "capture"
  q ~> w "drain"
  api -> w "health"
}

system ledger "Ledger" {
  description: "Money movement of record"
  glyph: sys/database
  db = aws/aurora "Ledger DB" datastore
}

ops -> pay.api "reconciles"
pay.w -> ledger.db "posts"
pay.api -> ledger.db "balance check"

view overview {
  title "Payments — money path"
  include *
  legend auto
  titleblock {
    version: "2026-07"
    owner: team-payments
    status: "reviewed"
  }
}

view pay {
  title "Payments internals"
  // one alignment hint: label dummies join crossing minimization, and without
  // a spine this small view drifted into a staircase — the DSL's own remedy
  layout { align api w ledger.db }
  legend auto
  titleblock {
    version: "2026-07"
  }
}
