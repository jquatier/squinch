// `zone` draws a deployment boundary — a cloud, a VPC, an on-premises site —
// around whatever sits inside it, cutting across the ownership structure, and
// zones nest. `detail:` adds a hard fact — a CIDR block, an account — as a
// mono segment on the chip.
pack aws

person ops "Operators"
erp = box "Legacy ERP" external

system ingest "Ingestion" {
  description: "Batch intake and normalization"
  glyph: sys/list
  gw = aws/api-gateway "Gateway"
  fn = aws/lambda "Sync Worker"
  gw -> fn
}

system core "Core Platform" {
  description: "APIs and the system of record"
  glyph: sys/code
  api = aws/lambda "API"
  db  = aws/aurora "Database" datastore
  api -> db
}

erp ~> ingest.gw "nightly batch"
ingest.fn -> core.api "normalized events"
ops -> core.api "operates"

zone onprem "On-Premises" onprem {
  contains erp, ops
}
zone cloud "AWS Cloud" cloud {
  contains ingest, core
  icon: aws/cloud
  label: bottom-right
  detail: "acct 4821-7730"
}
zone vpc1 "VPC prod-main" vpc {
  contains core
  icon: aws/vpc
  detail: "10.0.0.0/16"
}

view landscape {
  title "Hybrid Estate"
  include *
  legend auto
}
