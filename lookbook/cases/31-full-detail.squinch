// `expand *` opens every container to leaf depth on one page — the one place the
// diagram shows everything at once. Frames nest so containment stays legible;
// only the outermost carries the recessed fill, since stacking it would make
// depth read as darkness, and inner boundaries are the line and the label.
pack aws

system edge "Edge" {
  cdn = aws/cloudfront "CDN"
  gw  = aws/api-gateway "Gateway"
  cdn -> gw
}

system platform "Platform" {
  container ingest "Ingestion" {
    recv  = aws/lambda "Receiver"
    queue = aws/sqs    "Buffer" datastore
    recv ~> queue
  }
  container store "Storage" {
    writer = aws/lambda   "Writer"
    tbl    = aws/dynamodb "Events" datastore
    container index "Indexing" {
      idx = aws/opensearch "Search" datastore
    }
    writer -> tbl
    tbl ~> index.idx "stream"
  }
  ingest.queue ~> store.writer "drain"
}

edge.gw -> platform.ingest.recv "POST /events"

view full {
  expand *
}
