// The `lines` setting, three ways over the same diagram: how an edge *travels*.
// `orthogonal` turns square corners, `curved` rounds them off, and `straight`
// runs point to point. How an edge is *drawn and moves* is the other axis —
// `style:` and `animate:`, case 29-edge-styles.
pack aws

system fanout "Ingest" {
  gw  = aws/api-gateway "Gateway"
  a   = aws/lambda      "Validate"
  b   = aws/lambda      "Enrich"
  c   = aws/lambda      "Persist"
  db  = aws/dynamodb    "Store" datastore

  gw -> a, b, c
  a -> db
  b -> db
  c -> db
}

view orthogonal {
  title "lines orthogonal (default)"
  scope fanout
  layout { lines orthogonal
           rows [gw] [a b c] [db] }
}

view curved {
  title "lines curved"
  scope fanout
  layout { lines curved
           rows [gw] [a b c] [db] }
}

view straight {
  title "lines straight"
  scope fanout
  layout { lines straight
           rows [gw] [a b c] [db] }
}
