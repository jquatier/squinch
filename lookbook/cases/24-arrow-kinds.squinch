// The four kinds of connection — one-way, two-way, asynchronous, and
// undirected — and how each one is drawn.
pack aws

system mesh "Service Mesh" {
  a = aws/lambda "Caller"
  b = aws/lambda "Callee"
  c = aws/lambda "Peer A"
  d = aws/lambda "Peer B"
  e = aws/lambda "Publisher"
  f = aws/sqs    "Queue"
  g = aws/ec2    "Node 1"
  h = aws/ec2    "Node 2"

  a -> b  "request"          // one way
  c <-> d "sync both ways"   // both ways
  e ~> f  "publishes"        // asynchronous — dashed, and it drifts
  g -- h  "peers"            // undirected — related, no direction implied
}

view mesh {
  title "Arrow kinds"
  scope mesh
  legend auto
  layout {
    rows [a c e g] [b d f h]
  }
}
