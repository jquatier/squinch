// Declaration shapes the rest of the lookbook never uses, each of which had
// zero coverage anywhere in the repo.
//
//   - `pack <name> from "..."`   the from-clause
//   - `theme <name>`             at file level, not inside a view
//   - `container`                the other spelling of `system`
//   - a node with BOTH a kind and an attr block, in that order — the shape two
//     cold agents guessed wrong in two separate rounds because no example had
//     ever shown it
//   - an edge carrying its own `tags:`, which the renderer ignored until the
//     tags were threaded into the view graph
pack aws from "https://squinch.dev/packs/aws.json"
theme light

person operator "Operator"

container platform "Platform" {
  description: "`container` and `system` are the same construct"

  edge = aws/api-gateway "Edge"
  // kind first, then the attr block: `"Label" datastore { … }`
  store = aws/dynamodb "State" datastore {
    description: "Single-table"
    tags: #pci
  }
  legacy = box "Mainframe" external datastore {
    description: "Two kinds at once"
  }

  edge -> store "writes" { tags: #hot-path }
  edge -> legacy "batch"
}

operator -> platform.edge "operates"

view platform {
  title "Declaration forms"
  scope platform
  show descriptions
  // the edge-level tag lights its own wire, even though neither endpoint carries it
  highlight #hot-path
}
