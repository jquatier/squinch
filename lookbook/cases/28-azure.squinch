// The azure pack: Microsoft's official Architecture Icons, drawn full-colour
// like aws and k8s. Long marketing names alias to the short forms people type
// (`azure/vnet`, `azure/aks`, `azure/cosmos`). A virtual network draws as a
// zone with `icon: azure/vnet`.
pack azure

person user "Customer"

fd = azure/front-door "Front Door"

system shop "storefront" {
  aks = azure/aks "shop-aks"
  fn = azure/functions "checkout-fn"
  bus = azure/service-bus "orders-bus"
  db = azure/cosmos "catalog-db"
  kv = azure/key-vault "shop-secrets"
  img = azure/blob "product-images"

  aks -> db
  aks -> img
  aks ~> bus "order placed"
  bus ~> fn
  fn -> kv "reads certs"
}

zone vnet_shop "shop-vnet" network {
  contains shop
  icon: azure/vnet
}

user -> fd
fd -> shop.aks

view storefront {
  title "Storefront on Azure"
  include *
  expand shop
  legend auto
}
