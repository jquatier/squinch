// One entry point feeding many handlers. Connections spread evenly along the
// edge of a node rather than stacking at a single point, so a wide fan stays
// readable.
pack aws

system fan "Fan-out" {
  gw = aws/api-gateway "Gateway"
  h01 = aws/lambda "Orders"
  h02 = aws/lambda "Refunds"
  h03 = aws/lambda "Catalog"
  h04 = aws/lambda "Search"
  h05 = aws/lambda "Pricing"
  h06 = aws/lambda "Sessions"
  h07 = aws/lambda "Profiles"
  h08 = aws/lambda "Carts"
  h09 = aws/lambda "Reviews"
  h10 = aws/lambda "Shipping"
  h11 = aws/lambda "Taxes"
  h12 = aws/lambda "Emails"
  gw -> h01, h02, h03, h04, h05, h06, h07, h08, h09, h10, h11, h12
}
