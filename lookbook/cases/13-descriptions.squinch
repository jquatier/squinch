// `description:` carries a node's one-line explanation and `show descriptions`
// puts it under the label. It is a per-view choice, so the same source renders
// as a bare map or an annotated one.
pack aws

system obs "Observability" {
  agent = aws/lambda "Collector" {
    description: "Scrapes and batches metrics"
  }
  stream = aws/kinesis "Firehose" {
    description: "Buffered delivery stream"
  }
  store = aws/s3 "Metrics Lake" datastore {
    description: "Partitioned by day and service"
  }
  alarm = aws/lambda "Alerter" {
    description: "Evaluates SLO burn rates"
  }

  agent ~> stream "batches"
  stream ~> store "delivers"
  store ~> alarm "hourly scan"
}

view obs {
  show descriptions
}
