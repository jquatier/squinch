// `description:` is prose — a sentence about what a thing does. It shows as a
// system's tagline on its collapsed card and never draws inside a leaf, whose
// second line is `subtitle:`. The landscape shows the taglines; the scoped
// view shows the same leaves with their subtitles.
pack aws

system obs "Observability" {
  description: "Metrics and SLO burn alarms"
  agent = aws/lambda "Collector" {
    subtitle: "Lambda · every 60s"
    description: "Scrapes and batches metrics"
  }
  stream = aws/kinesis "Firehose" {
    subtitle: "Kinesis Firehose"
    description: "Buffered delivery stream"
  }
  store = aws/s3 "Metrics Lake" datastore {
    subtitle: "S3 · daily partitions"
    description: "Partitioned by day and service"
  }
  alarm = aws/lambda "Alerter" {
    subtitle: "Lambda · hourly"
    description: "Evaluates SLO burn rates"
  }

  agent ~> stream "batches"
  stream ~> store "delivers"
  store ~> alarm "hourly scan"
}

system pager "On-call" {
  description: "Pages the team that owns the burning SLO"
  route = aws/sns "Escalation" { subtitle: "SNS topic" }
}

obs.alarm ~> pager.route "pages"

view landscape {
  title "Descriptions as taglines"
  include *
}

view obs {
  title "Subtitles on the leaves"
  scope obs
}
