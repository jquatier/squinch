// The same diagram at all three `density` settings, from compact to spacious.
pack aws

system svc "Service" {
  gw = aws/api-gateway "Gateway"
  a  = aws/lambda "Create"
  b  = aws/lambda "Get"
  db = aws/dynamodb "Table" datastore
  gw -> a, b
  a -> db "writes"
  b -> db "reads"
}

view compact {
  scope svc
  layout { density compact }
}

view comfortable {
  scope svc
  layout { density comfortable }
}

view spacious {
  scope svc
  layout { density spacious }
}
