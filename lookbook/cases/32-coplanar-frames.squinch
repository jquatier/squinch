// The row that used to break: expanded systems side by side with calls
// running between them. Same-rank cross-frame edges route wall-to-wall
// through reserved gutters — straight when the endpoints share a height,
// a mid-gutter jog when they don't (coplanar.md, approach #5). Before this,
// ELK saw the calls and silently re-layered the row into a stack.
pack aws

person customer "Customer"

gw = aws/api-gateway "Gateway"

system catalog "Catalog" {
  api = aws/lambda   "Catalog API"
  db  = aws/dynamodb "Products" datastore
  api -> db
}

system orders "Orders" {
  api    = aws/lambda "Orders API"
  worker = aws/lambda "Worker"
  db     = aws/dynamodb "Orders" datastore
  api ~> worker "enqueue"
  worker -> db
}

system accounts "Accounts" {
  api = aws/lambda "Accounts API"
}

customer -> gw
gw -> catalog.api "browse"
gw -> orders.api "checkout"
gw -> accounts.api "profile"
orders.api -> catalog.api "price check"
orders.worker -> catalog.api "decrement stock"
orders.api -> accounts.api "verify identity"

view row {
  expand *
  layout {
    rows [customer] [gw] [catalog orders accounts]
  }
}
