// `badge:` composites a vendor mark onto a node's icon plate, for platforms
// with no icon pack: a `sys/*` icon says what the thing is and a `logos/*`
// mark says whose it is. Here every Databricks-owned node carries the mark.
pack aws

system lakehouse "Customer 360" {
  events = logos/apachekafka "order events"
  landing = aws/s3 "raw landing" datastore

  ingest = sys/stream "Auto Loader" { badge: logos/databricks }
  bronze = sys/table "bronze.orders" datastore { badge: logos/databricks }
  silver = sys/table "silver.customers" datastore { badge: logos/databricks }
  job = sys/workflow "nightly job" { badge: logos/databricks }
  uc = sys/catalog "Unity Catalog" { badge: logos/databricks }
  wh = sys/database "SQL warehouse" { badge: logos/databricks }
  nb = sys/notebook "analysis" { badge: logos/databricks }
  vs = sys/waypoints "vector search" { badge: logos/databricks }
  serving = sys/model "model serving" { badge: logos/databricks }

  bi = logos/looker "dashboards" external

  events ~> ingest "stream"
  landing -> ingest "backfill" { style: dotted }
  ingest -> bronze "append"
  bronze -> silver "merge"
  job -> silver "orchestrates" { style: dotted }
  uc -> silver "governs" { style: dotted }
  silver -> wh "serves"
  silver -> vs "embeds"
  vs -> serving "retrieval"
  wh -> nb "query"
  wh -> bi "JDBC"
}

view lakehouse {
  title "One platform, two licences"
  scope lakehouse
  layout {
    rows [events landing] [ingest] [bronze] [uc silver job] [wh vs nb] [serving bi]
  }
}
