// `rows` pins ranks, `cols` pins the cross axis, and together they are the grid
// the language has no third construct for. Here `rows [ingress hot] [store]`
// composed with `cols [ingress store] [hot]` is a 2×2 with one corner empty:
// without the `cols` line the store would stand centred under the pair.
// Rows are a statement about where things stand, not about which way every
// connection runs: in the second view a retry runs back up the pinned rows.
pack aws

system quad "Quadrants" {
  ingress = aws/api-gateway "Ingress"
  hot     = aws/lambda "Hot Path"
  store   = aws/aurora "Store" datastore

  ingress -> hot "live"
  hot -> store "writes"
  ingress ~> store "spill"
}

view quad {
  layout {
    rows [ingress hot] [store]
    cols [ingress store] [hot]
  }
}

system jobs "Import Jobs" {
  intake   = aws/sqs "Intake Queue"
  validate = aws/lambda "Validate"
  load     = aws/lambda "Load Rows"
  table    = aws/dynamodb "Imports" datastore

  intake -> validate
  validate -> load
  load -> table
  load ~> intake "retry"
}

view loop {
  title "A retry runs back up the rows"
  scope jobs
  layout {
    rows [intake] [validate] [load] [table]
  }
}
