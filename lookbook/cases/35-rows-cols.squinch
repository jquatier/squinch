// `rows` pins ranks, `cols` pins the cross axis, and together they are the grid
// the language has no third construct for. Here `rows [ingress hot] [store]`
// composed with `cols [ingress store] [hot]` is a 2×2 with one corner empty:
// without the `cols` line the store would stand centred under the pair.
pack aws

system quad "Quadrants" {
  ingress = aws/api-gateway "Ingress"
  hot     = aws/lambda "Hot Path"
  store   = aws/aurora "Store" datastore

  ingress -> hot "live"
  hot -> store "writes"
  ingress ~> store "spill"
}

view quad {
  layout {
    rows [ingress hot] [store]
    cols [ingress store] [hot]
  }
}
