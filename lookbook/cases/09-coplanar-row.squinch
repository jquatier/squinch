// Connections between things on the same row. Neighbours join straight across;
// ones that reach past a node drop into a lane underneath so they never run
// through anything.
pack aws

system row "One Row" {
  a = aws/lambda "Alpha"
  b = aws/lambda "Bravo"
  c = aws/lambda "Charlie"
  d = aws/lambda "Delta"
  e = aws/lambda "Echo"
  f = aws/lambda "Foxtrot"

  a -> b
  b -> c
  c -> d
  d -> e
  e -> f
  a -> d "skip"
  b -> f "far skip"
}

view row {
  layout {
    rows [a b c d e f]
  }
}
