// The reverse shape: many producers all feeding one destination. Written as
// separate edges rather than a fan-out list, because an edge has one source —
// this is what several of them arriving at the same point looks like.
pack aws

system fanin "Fan-in" {
  q = aws/sqs "Ingest Queue" datastore
  p1 = aws/lambda "Web Events"
  p2 = aws/lambda "Mobile"
  p3 = aws/lambda "POS"
  p4 = aws/lambda "Partners"
  p5 = aws/lambda "Returns"
  p1 ~> q
  p2 ~> q
  p3 ~> q
  p4 ~> q
  p5 ~> q
}
