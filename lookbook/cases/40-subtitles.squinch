// `subtitle:` — a leaf's short second line, always drawn: what it runs on, who
// owns it, where it lives. A caption, not prose, so it sets a step quieter than
// a label and the check warns past 24 characters. A `description:` on the same
// leaf never draws inside it — that is prose, for the hover card — so the two
// never compete for the line.
pack aws

system shop "Storefront" {
  cdn = aws/cloudfront "CDN"     { subtitle: "CloudFront · edge cache" }
  app = aws/lambda     "Web App" { subtitle: "Lambda · Node 20", description: "Server-rendered pages" }
  db  = aws/dynamodb   "Catalog" datastore { subtitle: "DynamoDB", description: "Single-table design" }
  idx = aws/opensearch "Search"  datastore { subtitle: "OpenSearch 2.x" }
  cdn -> app
  app -> db
  app -> idx "search"
}
ops = person "Operator"
ops -> shop.app "deploys"

view captions {
  title "Subtitles"
  scope shop
}
