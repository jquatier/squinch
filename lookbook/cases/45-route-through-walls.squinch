// A `route` side carries through walls. Asked to leave by its east side, the
// API leaves the Shop frame by its east wall as well, and the zone around it —
// through each boundary in turn, for as long as nothing stands between the
// node and that wall. In the second view Cache has been put east of the API,
// so the side stops at the node: it still leaves by the east, and the edge
// takes its ordinary way out of the frame. Nothing warns there — the node was
// given the side it was asked for. An edge declared on the system itself
// (`shop -> archive`) is asked of the frame's own wall.
system shop "Shop" {
  api   = sys/server   "API"
  cache = sys/database "Cache"
  svc   = sys/server   "Orders"

  api -> svc
  svc -> cache
}
db      = sys/database "Orders DB" datastore
audit   = sys/database "Audit Log" datastore
archive = sys/database "Archive" datastore

zone vpc "VPC" { contains shop }

shop.svc -> db
shop.api -> audit "audit"
shop -> archive "nightly"

view carried {
  title "A side carries through the frame and the zone"
  expand shop
  layout {
    rows [shop] [archive db audit]
    place shop.cache left-of shop.api
    route shop.api -> audit from east
    route shop -> archive from west
  }
}

view stopped {
  title "With a row-mate in the way, the side stops at the node"
  expand shop
  layout {
    rows [shop] [archive db audit]
    place shop.cache right-of shop.api
    route shop.api -> audit from east
  }
}
