// A `route` side carries through walls. Asked to leave by its east side, the
// API leaves the Shop frame by its east wall as well, and the zone around it —
// through each boundary in turn. In the second view Cache has been put east of
// the API: the edge still leaves the API by the east, goes over what stands in
// the row, and leaves the frame and the zone by their east walls. A side wall
// takes any number of edges — in the third view two leave the API by the east,
// one to a node inside the frame and one on through its wall. An edge declared
// on the system itself (`shop -> archive`) is asked of the frame's own wall.
system shop "Shop" {
  api   = sys/server   "API"
  cache = sys/database "Cache"
  svc   = sys/server   "Orders"

  api -> svc
  svc -> cache
}
db      = sys/database "Orders DB" datastore
audit   = sys/database "Audit Log" datastore
archive = sys/database "Archive" datastore

zone vpc "VPC" { contains shop }

shop.svc -> db
shop.api -> audit "audit"
shop -> archive "nightly"

view carried {
  title "A side carries through the frame and the zone"
  expand shop
  layout {
    rows [shop] [archive db audit]
    place shop.cache left-of shop.api
    route shop.api -> audit from east
    route shop -> archive from west
  }
}

view past {
  title "With a row-mate in the way, the edge goes round it"
  expand shop
  layout {
    rows [shop] [archive db audit]
    place shop.cache right-of shop.api
    route shop.api -> audit from east
  }
}

view shared {
  title "Several edges out of one side"
  expand shop
  layout {
    rows [shop] [archive db audit]
    place shop.cache left-of shop.api
    route shop.api -> shop.svc from east
    route shop.api -> audit from east
  }
}
