// One model, three routings. The same graph three times, so the `lines` setting
// is the only thing changing on screen: `orthogonal` turns square corners,
// `curved` rounds them wide, `straight` runs point to point and ignores the
// grid entirely.
pack aws

system fanout "Ingest" {
  gw  = aws/api-gateway "Gateway"
  a   = aws/lambda      "Validate"
  b   = aws/lambda      "Enrich"
  c   = aws/lambda      "Persist"
  db  = aws/dynamodb    "Store" datastore

  gw -> a, b, c
  a -> db
  b -> db
  c -> db
}

view orthogonal {
  title "lines orthogonal (default)"
  scope fanout
  layout { lines orthogonal
           rows [gw] [a b c] [db] }
}

view curved {
  title "lines curved"
  scope fanout
  layout { lines curved
           rows [gw] [a b c] [db] }
}

view straight {
  title "lines straight"
  scope fanout
  layout { lines straight
           rows [gw] [a b c] [db] }
}
