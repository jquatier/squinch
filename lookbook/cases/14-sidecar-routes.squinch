// The side-car idiom, three times over. `place` is the whole of it: it puts the
// pair on one row, and same-rank edges route themselves side to side. A
// `route … from east to west` here would be silently ignored — see 26-route-label
// for the case where sides actually apply.
pack aws

system app "Order Service" {
  api   = aws/api-gateway "API"
  fn    = aws/lambda "Handler"
  db    = aws/dynamodb "Orders" datastore
  cache = aws/elasticache "Cache"
  sync  = aws/lambda "Search Sync"
  idx   = aws/opensearch "Index" datastore

  api -> fn
  fn -> db "writes"
  fn -> cache "reads through"
  db ~> sync "stream"
  sync -> idx "indexes"
}

view app {
  layout {
    rows [api] [fn] [db]
    place cache right-of fn
    place sync right-of db
    place idx right-of sync
  }
}
