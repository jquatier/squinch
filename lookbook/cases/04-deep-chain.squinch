// A pipeline read left to right. Set `direction right` on a view and the stages
// run across the page instead of down it; the same source with no layout block
// reads top to bottom.
pack aws

system pipe "Pipeline" {
  ingest    = aws/kinesis "Ingest"
  validate  = aws/lambda  "Validate"
  transform = aws/lambda  "Transform"
  land      = aws/s3      "Data Lake" datastore
  catalog   = aws/glue    "Catalog"

  ingest ~> validate
  validate -> transform
  transform -> land "parquet"
  land ~> catalog "crawl"
}

view pipe {
  layout {
    direction right
  }
}
