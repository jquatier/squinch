// Every place a note can go: beside, above or below a node, attached to a
// connection, or pinned to one of the four corners of the diagram.
pack aws

system svc "Payments" {
  api   = aws/api-gateway "API"
  fn    = aws/lambda      "Handler"
  db    = aws/dynamodb    "Ledger" datastore
  queue = aws/sqs         "Retries"

  api -> fn
  fn -> db "writes"
  fn ~> queue "on failure"
}

view svc {
  title "Note anchors"
  scope svc
  // beside a node, with a leader line back to it
  note above api    "above"
  note below db     "below"
  note left-of fn   "left-of"
  note right-of queue "right-of"
  // attached to a connection, halfway along it
  note on api -> fn "on an edge"
  // pinned to a corner of the diagram, with no leader line
  note top-left     "top-left"
  note top-right    "top-right" { style: warning }
  note bottom-left  "bottom-left"
  note bottom-right "bottom-right"
}
