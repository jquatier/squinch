// Annotation. `highlight` picks out everything carrying a tag and dims the
// rest, and `note` pins explanatory text to a node, a connection, or a corner
// of the diagram. Tag a connection itself and that wire lights up even when the
// things it joins stay dim.
pack aws

system pay "Payments" {
  api   = aws/lambda "Payment API" { tags: #pci }
  token = aws/lambda "Tokenizer"   { tags: #pci }
  vault = aws/dynamodb "Card Vault" datastore { tags: #pci }
  queue = aws/sqs "Settlement Queue" datastore
  settle = aws/lambda "Settlement Worker"
  ledger = aws/aurora "Ledger" datastore

  api -> token "tokenize"
  token -> vault "store"
  api ~> queue "capture events"
  queue ~> settle "drain"
  settle -> ledger "post" { tags: #pci }
}

view pci {
  scope pay
  highlight #pci
  note below vault "Tokens only; PANs never stored"
  note on api -> token "p99 8ms"
  note top-right "PCI DSS scope, audited quarterly" { style: warning }
}
