// `align` puts two nodes on exactly the same axis. Left alone, a node stands
// under whatever it is wired to — here the record store would sit off to the
// right, under the one handler that writes to it; `align gw db` puts it on
// the gateway's axis instead, down the middle of the diagram.
pack aws

system s "Aligned + Hopped" {
  gw = aws/api-gateway "Edge Gateway"
  a  = aws/lambda "Alpha"
  b  = aws/lambda "Bravo"
  c  = aws/lambda "Charlie"
  db = aws/aurora "System of Record" datastore

  gw -> a, b, c
  c -> db "writes"
}

view s {
  layout {
    rows [gw] [a b c] [db]
    align gw db
  }
}
