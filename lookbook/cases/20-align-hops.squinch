// `align` puts two nodes on exactly the same axis, for when the automatic
// layout leaves them a few pixels apart and the near-miss looks like a mistake.
pack aws

system s "Aligned + Hopped" {
  gw = aws/api-gateway "Edge Gateway"
  a  = aws/lambda "Alpha"
  b  = aws/lambda "Bravo"
  c  = aws/lambda "Charlie"
  db = aws/aurora "System of Record" datastore

  gw -> a, b, c
  b -> db
  a -> db "writes"
  c -> db "reads"
}

view s {
  layout {
    rows [gw] [a b c] [db]
    align gw db
  }
}
