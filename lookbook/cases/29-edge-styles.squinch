// How an edge is drawn and how it moves: `style: solid | dashed | dotted` and
// `animate: flow | reverse | slow | fast | packets | pulse | comet`, one hub with
// each spoke showing one thing. Travelling dashes need a pattern to travel, so a
// synchronous edge animates by declaring `style: dotted` first — dashed is the
// convention for async edges and asking for it on a sync one warns. `pulse`
// breathes rather than travels, so it works on a solid line. `comet` is the
// exception: it rides a dot along the route instead of moving the stroke, which
// makes it the way to show motion on a plain synchronous call.
//
// How an edge *travels* between nodes is the other axis — `lines`, case
// 25-edge-routing.
pack aws

system estate "Edge styles" {
  hub = aws/eventbridge "Bus"

  plain   = aws/lambda "request"
  dashed  = aws/lambda "backfill"
  dotted  = aws/lambda "optional call"
  flow    = aws/lambda "stream"
  rev     = aws/sqs    "acks"
  slowfn  = aws/s3     "nightly batch" datastore
  fastfn  = aws/lambda "click stream"
  pkts    = aws/lambda "telemetry"
  beat    = aws/lambda "healthcheck"
  combo   = aws/dynamodb "replica" datastore
  trace   = aws/lambda "traced call"

  hub -> plain  "sync, solid"
  hub -> dashed "style: dashed (warns)" { style: dashed }
  hub -> dotted "style: dotted" { style: dotted }
  hub ~> flow   "async default"
  hub ~> rev    "reverse" { animate: reverse }
  hub ~> slowfn "slow" { animate: slow }
  hub ~> fastfn "fast" { animate: fast }
  hub ~> pkts   "packets" { animate: packets }
  hub -> beat   "pulse" { animate: pulse }
  hub -> trace  "comet" { animate: comet }
  hub -> combo  "dotted + flow" {
    style:   dotted
    animate: flow
  }
}

view styles {
  title "Edge styles and motion"
  scope estate
  legend auto
  layout {
    rows [hub] [plain dashed dotted flow rev] [slowfn fastfn pkts beat combo trace]
  }
}
