// A bus that one area both publishes to and consumes from — `catalog -> bus`
// and `bus ~> catalog` lift to a mutual pair with no `rows` anywhere. Ranks
// break the cycle the way ELK does (the first-declared edge wins), so the
// pair lands on two ranks and both edges are ELK's. Before that, the rank
// relaxation ran out its pass budget on the cycle, the pair tied by
// accident, the router classified both edges same-rank and drew each
// straight at its own height — ending in canvas beside the other card.
pack logos

identity = sys/lock "Identity"
bus = sys/database "Event Bus" {
  badge: logos/kafka
}
catalog = sys/search "Catalog"
commerce = sys/store "Commerce"
fulfilment = sys/package "Fulfilment"
engagement = sys/mail "Engagement"
analytics = sys/chart-line "Analytics"
gw = sys/router "API Gateway"

identity -> bus "user events"
catalog -> bus "product events"
bus ~> catalog "products updated"
commerce -> bus "order events"
fulfilment -> bus "return events"
bus ~> fulfilment "shipment events"
bus ~> engagement
bus ~> analytics
gw -> catalog
gw -> commerce
commerce -> fulfilment

view landscape {
  title "Event bus, mutual pair"
  include *
}
