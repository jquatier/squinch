// `route` controls which side of a node a connection leaves and enters by. When
// two connections join the same pair of nodes, naming one of their labels picks
// the one you mean.
pack aws

system api "Order API" {
  gw    = aws/api-gateway "Gateway"
  fn    = aws/lambda      "Handler"
  db    = aws/dynamodb    "Orders" datastore
  audit = aws/s3          "Audit Log" datastore

  gw -> fn "request"
  fn -> db "read"          // two connections between the same pair
  fn -> db "write"
  fn -> audit "append"
}

view api {
  title "Route sides and label disambiguation"
  scope api
  layout {
    rows [gw] [fn] [db audit]
    // pick one of the pair by its label, and send it out sideways
    route fn -> db "write" from east to west
    // and steer another one the long way round
    route fn -> audit from west to north
  }
}
