// Where `route` sides actually apply — the case 14-sidecar-routes points at.
//
// Sides are fed to ELK, and ELK only routes edges that SPAN rows. A same-rank
// edge bypasses it for our own coplanar router, which picks its own sides, so a
// `from`/`to` there is ignored and now warns. Everything below crosses rows, so
// every hint bites.
//
// Also the parallel-edge disambiguator: two edges between the same pair are
// legal, and a bare `route a -> b` cannot say which one you meant — that is a
// check error. The label picks one.
pack aws

system api "Order API" {
  gw    = aws/api-gateway "Gateway"
  fn    = aws/lambda      "Handler"
  db    = aws/dynamodb    "Orders" datastore
  audit = aws/s3          "Audit Log" datastore

  gw -> fn "request"
  fn -> db "read"          // a parallel pair: same endpoints, different labels
  fn -> db "write"
  fn -> audit "append"
}

view api {
  title "Route sides and label disambiguation"
  scope api
  layout {
    rows [gw] [fn] [db audit]
    // one of the parallel pair, chosen by label, leaves and enters sideways
    route fn -> db "write" from east to west
    // and an unambiguous edge steered the long way round
    route fn -> audit from west to north
  }
}
